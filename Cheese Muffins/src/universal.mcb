                    block { with storage minecraft:universal stable_player_display
                        $execute as @n[tag=aj.$(branch).item_display.helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"$(helmet)","minecraft:enchantment_glint_override":$(head_glint),"minecraft:custom_model_data":{strings:["$(head_base)","$(head_pattern)","$(head_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_body)","minecraft:enchantment_glint_override":$(chest_glint),"minecraft:custom_model_data":{strings:["$(chest_base)","$(chest_pattern)","$(chest_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms_flipped)","minecraft:enchantment_glint_override":$(chest_glint),"minecraft:custom_model_data":{strings:["$(chest_base)","$(chest_pattern)","$(chest_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms)","minecraft:enchantment_glint_override":$(chest_glint),"minecraft:custom_model_data":{strings:["$(chest_base)","$(chest_pattern)","$(chest_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_pants)","minecraft:enchantment_glint_override":$(legs_glint),"minecraft:custom_model_data":{strings:["$(legs_base)","$(legs_pattern)","$(legs_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper)","minecraft:enchantment_glint_override":$(legs_glint),"minecraft:custom_model_data":{strings:["$(legs_base)","$(legs_pattern)","$(legs_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower)","minecraft:enchantment_glint_override":$(legs_glint),"minecraft:custom_model_data":{strings:["$(legs_base)","$(legs_pattern)","$(legs_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper_flipped)","minecraft:enchantment_glint_override":$(legs_glint),"minecraft:custom_model_data":{strings:["$(legs_base)","$(legs_pattern)","$(legs_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower_flipped)","minecraft:enchantment_glint_override":$(legs_glint),"minecraft:custom_model_data":{strings:["$(legs_base)","$(legs_pattern)","$(legs_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots)","minecraft:enchantment_glint_override":$(feet_glint),"minecraft:custom_model_data":{strings:["$(feet_base)","$(feet_pattern)","$(feet_material)"]}}}}
                        $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots_flipped)","minecraft:enchantment_glint_override":$(feet_glint),"minecraft:custom_model_data":{strings:["$(feet_base)","$(feet_pattern)","$(feet_material)"]}}}}
                    }
                }
            }
        }

        dir mount {
            function player {
                # function universal:ability/rig/mount/player {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
                $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
                $data merge storage minecraft:universal {ability:{rig:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                block { with storage minecraft:universal ability.rig
                    $ride @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] mount @p[tag=$(user),scores={$(objective)=$(id)}]
                }
            }
        }

        function dismount {
            # function universal:ability/rig/dismount {rig:"billy",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.dismount.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{dismount:{objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:universal ability.dismount
                $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run ride @s dismount
            }
        }

        function rotate {
            # function universal:ability/rig/rotate {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:universal ability.rig
                $execute as @a[tag=$(user),scores={$(objective)=$(id)}] store result storage minecraft:universal ability.rig.rotation float 0.1 run data get entity @s Rotation[0] 10
                block { with storage minecraft:universal ability.rig
                    $data modify entity @s Rotation[0] set value $(rotation)
                }
                $execute unless entity @a[tag=$(user),scores={$(objective)=$(id)}] run function ability:$(rig)/toggle/off
            }
        }

        function as_player {
            # function universal:ability/rig/as_player {player:"abilityBilly.User",objective:"universalAbility.ID",output:"tag @s remove universalAbility.HideUI"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{player:"$(player)",objective:"$(objective)",output:"$(output)"}}}
            block { with storage minecraft:universal ability.rig
                $execute as @p[tag=$(player),scores={$(objective)=$(id)}] at @s run $(output)
            }
        }

        function spectate_camera {
            # function universal:ability/rig/spectate_camera {player:"abilityBilly.User",camera:"aj.billy.camera",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.camera.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{camera:{player:"$(player)",camera:"$(camera)",objective:"$(objective)"}}}
            block { with storage minecraft:universal ability.camera
                $execute as @p[tag=$(player),scores={$(objective)=$(id)}] at @s run spectate @n[type=minecraft:item_display,tag=$(camera),scores={$(objective)=$(id)}] @s
            }
        }

        function visibility {
            # function universal:ability/rig/visibility {target:"aj.billy.root",objective:"universalAbility.ID",state:"disable",perspective:"inline_perspective",mounted:"hide_passengers"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{objective:"$(objective)",target:"$(target)",state:"$(state)",perspective:"$(perspective)",mounted:"$(mounted)"}}}
            block { with storage minecraft:universal ability.rig
                $visibility $(state) @n[type=minecraft:item_display,tag=$(target),scores={$(objective)=$(id)}] @s $(perspective) $(mounted)
            }
        }

        function text {
            # EXAMPLE #
                # data modify storage minecraft:universal ability.rig.text.arguments.animation set value "billy"
                # data modify storage minecraft:universal ability.rig.text.arguments.text set value "{text:{"color":"red","italic":false,"text":"Billy"}}"
                # data modify storage minecraft:universal ability.rig.text.arguments.output set value "ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"
            # OR #
                # data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{text:{"color":"red","italic":false,"text":"Billy"}},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
            # THEN #
                # function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments

            $function aj:text_display/summon {args:{animation:'$(animation)',start_animation: true}}

            execute store result storage minecraft:universal ability.rig.text.id int 1 run scoreboard players get @s universalAbility.ID

            # as the text node
            execute as @n[type=minecraft:text_display,tag=aj.text_display.text_display.display,tag=!universalText.IDAssigned] run block { with storage minecraft:universal ability.rig.text
                data modify entity @s text set from storage minecraft:universal ability.rig.text.arguments.text
                $scoreboard players set @s universalText.ID $(id)
                tag @s add universalText.IDAssigned
            }

            # as the text root
            execute as @n[type=minecraft:item_display,tag=aj.text_display.root,tag=!universalText.IDAssigned] run block { with storage minecraft:universal ability.rig.text
                $scoreboard players set @s universalText.ID $(id)
                tag @s add universalText.IDAssigned

                execute if data storage minecraft:universal ability.rig.text.arguments.output run block { with storage minecraft:universal ability.rig.text.arguments
                    $$(output)
                }
            }
            data remove storage minecraft:universal ability.rig.text.arguments
        }

        function pair {
            # function universal:ability/rig/pair {target:"type=minecraft:item_display,tag=aj.billy.root",objective_before:"universalAbility.ID",objective_target:"universalAbility.ID"}
            $data merge storage minecraft:universal {ability:{rig:{target:"$(target)",objective_before:"$(objective_before)",objective_target:"$(objective_target)"}}}
            block { with storage minecraft:universal ability.rig
                $scoreboard players operation @n[$(target)] $(objective_target) = @s $(objective_before)
            }
        }
    }

    dir play {
        function animation {
            # function universal:ability/play/animation {arguments:{rig:"the_world",animation:"knife_throw_default",objective:"universalAbility.ID",style:"play"}}
            # or
            # function universal:ability/play/animation {arguments:{rig:"the_world",animation:"knife_throw_default",objective:"universalAbility.ID",style:"tween",tweened_frame:10,tween_duration:5}}
            # EXTRA ARGS
            # interrupt_viewmodel:1b

            $data modify storage minecraft:universal ability.play.animation merge value $(arguments)

            execute if entity @s[type=minecraft:item_display] run block { with storage minecraft:universal ability.play.animation
                $execute store result storage minecraft:universal ability.play.animation.id int 1 run scoreboard players get @s $(objective)
                block { with storage minecraft:universal ability.play.animation
                    $execute as @n[type=!minecraft:item_display,scores={$(objective)=$(id)}] run scoreboard players operation .fetchSize traitShrinkray.Size = @s traitShrinkray.Size
                }
            }
            execute if entity @s[type=minecraft:player] run scoreboard players operation .fetchSize traitShrinkray.Size = @s traitShrinkray.Size

            # playing animation WITHOUT tweening
            execute unless data storage minecraft:universal ability.play.animation{style:"tween"} run block { with storage minecraft:universal ability.play.animation
                $execute unless score .fetchSize traitShrinkray.Size matches 1.. run function aj:$(rig)/animations/$(animation)/$(style)
                $execute if score .fetchSize traitShrinkray.Size matches 1 run function aj:$(rig)/animations/shrink_$(animation)/$(style)
                $execute if score .fetchSize traitShrinkray.Size matches 2 run function aj:$(rig)/animations/grow_$(animation)/$(style)
            }
            # playing animation WITH tweening
            execute if data storage minecraft:universal ability.play.animation{style:"tween"} run {
                block { with storage minecraft:universal ability.play.animation
                    $scoreboard players set .tweenFrame traitShrinkray.Frame $(tweened_frame)
                }

                execute if score .fetchSize traitShrinkray.Size matches 1 run {
                    function universal:math/multiply {value:2,score:".tweenFrame",objective:"traitShrinkray.Frame"}
                    function universal:math/divide {value:3,score:".tweenFrame",objective:"traitShrinkray.Frame"}
                }

                execute if score .fetchSize traitShrinkray.Size matches 2 run {
                    function universal:math/multiply {value:4,score:".tweenFrame",objective:"traitShrinkray.Frame"}
                    function universal:math/divide {value:3,score:".tweenFrame",objective:"traitShrinkray.Frame"}
                }

                execute store result storage minecraft:universal ability.play.animation.adjusted_frame int 1 run scoreboard players get .tweenFrame traitShrinkray.Frame

                block { with storage minecraft:universal ability.play.animation
                    $execute unless score .fetchSize traitShrinkray.Size matches 1.. run function aj:$(rig)/animations/$(animation)/tween {to_frame:$(adjusted_frame),duration:$(tween_duration)}
                    $execute if score .fetchSize traitShrinkray.Size matches 1 run function aj:$(rig)/animations/shrink_$(animation)/tween {to_frame:$(adjusted_frame),duration:$(tween_duration)}
                    $execute if score .fetchSize traitShrinkray.Size matches 2 run function aj:$(rig)/animations/grow_$(animation)/tween {to_frame:$(adjusted_frame),duration:$(tween_duration)}
                }

                scoreboard players reset .tweenFrame traitShrinkray.Frame
            }

            # check for viewmodel
            execute unless entity @s[tag=aj.viewmodel.root] run block { with storage minecraft:universal ability.play.animation
                $function aj:viewmodel/animations/$(rig)_$(animation)/check
                execute if score .isViewModel traitShrinkray.Size matches 1 run block { with storage minecraft:universal ability.play.animation
                    $execute as @p[scores={universalAbility.ID=$(id)}] unless entity @s[tag=abilitySettings.ViewmodelDisabled] run block { with storage minecraft:universal ability.play.animation
                        $execute unless data storage minecraft:universal ability.play.animation{interrupt_viewmodel:1b} run function universal:ability/play/viewmodel {arguments:{animation:"$(rig)_$(animation)",rig:"$(rig)"}}
                        execute if data storage minecraft:universal ability.play.animation{interrupt_viewmodel:1b} run block { with storage minecraft:universal ability.play.animation
                            $execute as @n[type=minecraft:item_display,tag=aj.viewmodel.root,scores={universalAbility.ID=$(id)}] at @s run block { with storage minecraft:universal ability.play.animation
                                $function universal:ability/play/animation {arguments:{rig:"viewmodel",animation:"$(rig)_$(animation)",objective:"universalAbility.ID",style:"tween",tweened_frame:$(adjusted_frame),tween_duration:$(tween_duration)}}
                            }
                        }
                    }
                    scoreboard players reset .isViewModel traitShrinkray.Size
                }
            }

            data remove storage minecraft:universal ability.play.animation
            scoreboard players reset .fetchSize traitShrinkray.Size
        }

        function sfx {
            # function universal:ability/play/sfx {sfx:"minecraft:ability.the_world.toggle.spawn",selector:"@a",volume:1,objective:"universalAbility.ID"}

            scoreboard players set .fetchSize traitShrinkray.Size 0
            execute if entity @s[type=minecraft:player] run scoreboard players operation .fetchSize traitShrinkray.Size = @s traitShrinkray.Size

            $data modify storage minecraft:universal ability.play.objective set value "$(objective)"
            execute if entity @s[type=minecraft:item_display] run block { with storage minecraft:universal ability.play
                $execute store result storage minecraft:universal ability.play.id int 1 run scoreboard players get @s $(objective)
                block { with storage minecraft:universal ability.play
                    $execute as @p[scores={$(objective)=$(id)}] run scoreboard players operation .fetchSize traitShrinkray.Size = @s traitShrinkray.Size
                }
            }

            $execute unless score .fetchSize traitShrinkray.Size matches 1.. at @s run playsound $(sfx) player $(selector) ~ ~ ~ $(volume) 1.00
            $execute if score .fetchSize traitShrinkray.Size matches 1 at @s run playsound $(sfx) player $(selector) ~ ~ ~ $(volume) 1.50
            $execute if score .fetchSize traitShrinkray.Size matches 2 at @s run playsound $(sfx) player $(selector) ~ ~ ~ $(volume) 0.75
        }

        function viewmodel {
            # function universal:ability/play/viewmodel {arguments:{animation:"shrinkray_shoot"}}
            function aj:viewmodel/summon {args:{}}

            $data modify storage minecraft:universal ability.play.viewmodel merge value $(arguments)
            execute store result storage minecraft:universal ability.play.viewmodel.id int 1 run scoreboard players get @s universalAbility.ID
            execute store result storage minecraft:universal ability.play.viewmodel.skin_id int 1 run scoreboard players get @s universalAbility.EquippedSkinID
            block { with storage minecraft:universal ability.play.viewmodel
                execute as @e[type=minecraft:item_display,tag=aj.viewmodel.root] unless score @s universalAbility.ID matches 1.. run block { with storage minecraft:universal ability.play.viewmodel
                    $scoreboard players set @s universalAbility.ID $(id)
                    $scoreboard players set @s universalAbility.EquippedSkinID $(skin_id)
                    $function ability:$(rig)/skin_index {rig:"viewmodel"}
                    scoreboard players display name @s universalAbility.ID {"color":"light_purple","text":"Viewport"}
                    $function universal:ability/play/animation {arguments:{rig:"viewmodel",animation:"$(animation)",objective:"universalAbility.ID",style:"play"}}
                }
                $viewmodel @n[type=minecraft:item_display,tag=aj.viewmodel.root,scores={universalAbility.ID=$(id)}]
                function universal:ability/rig/stable_player_display/main {branch:"viewmodel",split:""}
            }
        }
    }

    dir setup {
        dir cooldown {
            function 8x {
                $scoreboard players set .$(name)Cooldown universalAbility.MoveCooldown$(move) $(cooldown)
                $function universal:math/multiply {value:20,score:".$(name)Cooldown",objective:"universalAbility.MoveCooldown$(move)"}
                $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $function universal:math/divide {value:9,score:".$(name)CooldownDivided",objective:"universalAbility.MoveCooldown$(move)"}

                $execute store result storage minecraft:ability $(storage).cooldown.move$(path).9 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

                REPEAT (8,1) as i {
                    $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
                    $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>a int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
                    $scoreboard players remove .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) 1
                    $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>b int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
                }

                $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
                $execute store result storage minecraft:ability $(storage).cooldown.move$(path).1 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

                $data merge storage minecraft:ability {$(storage):{cooldown:{move$(path):{slot:$(move)}}}}
            }

            function 10x {
                $scoreboard players set .$(name)Cooldown universalAbility.MoveCooldown$(move) $(cooldown)
                $function universal:math/multiply {value:20,score:".$(name)Cooldown",objective:"universalAbility.MoveCooldown$(move)"}
                $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
                $function universal:math/divide {value:11,score:".$(name)CooldownDivided",objective:"universalAbility.MoveCooldown$(move)"}

                $execute store result storage minecraft:ability $(storage).cooldown.move$(path).11 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

                REPEAT (10,1) as i {
                    $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
                    $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>a int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
                    $scoreboard players remove .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) 1
                    $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>b int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
                }

                $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
                $execute store result storage minecraft:ability $(storage).cooldown.move$(path).1 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

                $data merge storage minecraft:ability {$(storage):{cooldown:{move$(path):{slot:$(move)}}}}
            }
        }

        function meter {
            # function universal:ability/setup/meter {name:"Yuji",storage:"yuji",duration:145}
            $scoreboard players set .$(name)Duration universalAbility.AwakeningDuration $(duration)
            $function universal:math/multiply {value:20,score:".$(name)Duration",objective:"universalAbility.AwakeningDuration"}
            $scoreboard players operation .$(name)DurationDivided universalAbility.AwakeningDuration = .$(name)Duration universalAbility.AwakeningDuration
            $scoreboard players operation .$(name)DurationThresholds universalAbility.AwakeningDuration = .$(name)Duration universalAbility.AwakeningDuration
            $scoreboard players operation .$(name)DurationDivided universalAbility.AwakeningDuration = .$(name)Duration universalAbility.AwakeningDuration
            $function universal:math/divide {value:16,score:".$(name)DurationDivided",objective:"universalAbility.AwakeningDuration"}

            $execute store result storage minecraft:ability $(storage).awakening.16 int 1 run scoreboard players get .$(name)DurationThresholds universalAbility.AwakeningDuration

            REPEAT (15,1) as i {
                $scoreboard players operation .$(name)DurationThresholds universalAbility.AwakeningDuration -= .$(name)DurationDivided universalAbility.AwakeningDuration
                $execute store result storage minecraft:ability $(storage).awakening.<%i%>a int 1 run scoreboard players get .$(name)DurationThresholds universalAbility.AwakeningDuration
                $scoreboard players remove .$(name)DurationThresholds universalAbility.AwakeningDuration 1
                $execute store result storage minecraft:ability $(storage).awakening.<%i%>b int 1 run scoreboard players get .$(name)DurationThresholds universalAbility.AwakeningDuration
            }

            $scoreboard players operation .$(name)DurationThresholds universalAbility.AwakeningDuration -= .$(name)DurationDivided universalAbility.AwakeningDuration
            $execute store result storage minecraft:ability $(storage).awakening.1 int 1 run scoreboard players get .$(name)DurationThresholds universalAbility.AwakeningDuration

            # $data merge storage minecraft:ability {$(storage):{awakening:{move$(path):{slot:$(move)}}}}
        }

        function variables {
            $data modify storage minecraft:ability $(ability).variables.$(name) merge value $(variables)
        }
    }

    dir restraint {
        function cooldown {
            # function universal:ability/restraint/cooldown {arguments:{ability_name:"Shrinkray",split_name:"Self",move:1,split_path:1}}
            # function universal:ability/restraint/cooldown {arguments:{ability_name:"Shrinkray",split_name:"Other",move:1,split_path:2}}

            $data modify storage minecraft:universal ability.restraint.arguments set value $(arguments)

            execute unless entity @s[tag=abilitySettings.DisabledCooldowns] run block { with storage minecraft:universal ability.restraint.arguments
                execute if data storage minecraft:universal ability.restraint.arguments.split_name run block { with storage minecraft:universal ability.restraint.arguments
                    $scoreboard players operation @s universalAbility.MoveCooldown$(move) = .$(ability_name)_$(split_name)Cooldown universalAbility.MoveCooldown$(move)
                    $scoreboard players set @s universalAbility.MoveSplit$(move) $(split_path)
                }

                execute unless data storage minecraft:universal ability.restraint.arguments.split_name run block { with storage minecraft:universal ability.restraint.arguments
                    $scoreboard players operation @s universalAbility.MoveCooldown$(move) = .$(ability_name)Cooldown universalAbility.MoveCooldown$(move)
                    $scoreboard players set @s universalAbility.MoveSplit$(move) 1
                }
            }

            data remove storage minecraft:universal ability.restraint.arguments
        }

        function cancelable {
            # function universal:ability/restraint/cancelable {move:1}
            tag @s add universalAbility.ModifierCancelable
            $scoreboard players set @s universalAbility.MovePrevious $(move)
        }
    }

    dir revoke {
        function cancelable {
            # function universal:ability/revoke/cancelable {player:"abilityBilly.User"}
            $data merge storage minecraft:universal {ability:{revoke:{player:"$(player)"}}}
            execute store result storage minecraft:universal ability.revoke.id int 1 run scoreboard players get @s universalAbility.ID
            block { with storage minecraft:universal ability.revoke
                $execute as @p[tag=$(player),scores={universalAbility.ID=$(id)}] at @s run {
                    tag @s remove universalAbility.ModifierCancelable
                    scoreboard players reset @s universalAbility.MovePrevious
                }
            }
        }
    }

    function toggle {
        execute if entity @s[tag=universalAbility.User] unless entity @s[tag=universalAbility.Animating] unless score @s universalAbility.ToggleDelay matches 1.. run {
            # find which ability is active
            execute store result storage minecraft:universal toggle.equipped_id int 1 run scoreboard players get @s universalAbility.EquippedID
            block { with storage minecraft:universal toggle
                $data modify storage minecraft:universal toggle.ability set from storage minecraft:ability index.$(equipped_id).path
            }

            # toggle handling
            execute unless score @s universalAbility.ToggleState matches 1.. run {
                scoreboard players set @s universalAbility.ToggleState 1
                tag @s add temp

                data modify storage minecraft:universal toggle.state set value "on"
                execute unless score @s universalAbility.ID matches 1.. run {
                    scoreboard players add .global universalAbility.ID 1
                    scoreboard players operation @s universalAbility.ID = .global universalAbility.ID

                    function universal:fetch/username {storage:"minecraft:ability",path:"username"}
                    block { with storage minecraft:ability
                        $scoreboard players display name @s universalAbility.ID {"color":"aqua","text":"$(username)"}
                    }
                }
            }
            execute if score @s universalAbility.ToggleState matches 1.. unless entity @s[tag=temp] run {
                scoreboard players set @s universalAbility.ToggleState 0
                data modify storage minecraft:universal toggle.state set value "off"
            }
            tag @s remove temp

            # apply
            block { with storage minecraft:universal toggle
                $function ability:$(ability)/toggle/$(state)
            }
        }
        scoreboard players reset @s universalAbility.ToggleTrigger
    }

    function death {
        execute if score @s universalAbility.ToggleState matches 1 run {
            execute store result storage minecraft:universal death.equipped_id int 1 run scoreboard players get @s universalAbility.EquippedID
            block { with storage minecraft:universal death
                $data modify storage minecraft:universal death.path set from storage minecraft:ability index.$(equipped_id).path
                $data modify storage minecraft:universal death.real_path set from storage minecraft:ability index.$(equipped_id).real_path
                execute store result storage minecraft:universal death.id int 1 run scoreboard players get @s universalAbility.ID
                block { with storage minecraft:universal damage
                    $execute as @n[type=minecraft:item_display,tag=aj.$(path).root,scores={universalAbility.ID=$(id)}] at @s run block { with storage minecraft:universal death
                        $function ability:$(path)/moves/reset/all
                        $function universal:ability/rig/mount/player {user:"ability$(real_path).User",rig:"$(path)",objective:"universalAbility.ID"}
                    }
                }
            }
        }
        scoreboard players reset @s universalDamage.DeathCount
    }

    function award_interaction {
        # function universal:ability/award_interaction {ability_id:4,interaction_number:1}
        data remove storage minecraft:universal secret_interaction
        $data modify storage minecraft:universal secret_interaction.ability_id set value $(ability_id)
        $data modify storage minecraft:universal secret_interaction.interaction_number set value $(interaction_number)
        block { with storage minecraft:universal secret_interaction
            $data modify storage minecraft:universal secret_interaction.required_tag set from storage minecraft:ability index.$(ability_id).secret.interaction$(interaction_number).required_tag
            $data modify storage minecraft:universal secret_interaction.advancement set from storage minecraft:ability index.$(ability_id).secret.interaction$(interaction_number).advancement
            block { with storage minecraft:universal secret_interaction
                $execute unless entity @s[tag=$(required_tag)] run block { with storage minecraft:universal secret_interaction
                    $tag @s add $(required_tag)
                    $function ability:generate/secret_interaction {ability_id:$(ability_id),interaction_number:$(interaction_number)}
                    block { with storage minecraft:universal secret_interaction
                        $tellraw @a[tag=$(required_tag)] ["",{"selector":"@s"},{"text":" has discovered a "},{"text":"[Secret Interaction]","color":"light_purple","hover_event":{"action":"show_text","value":$(interaction_hover_unlocked)}}]

                        $tellraw @a[tag=!$(required_tag)] ["",{"selector":"@s"},{"text":" has discovered a "},{"text":"[Secret Interaction]","color":"light_purple","hover_event":{"action":"show_text","value":$(interaction_hover_locked)}}]
                    }
                    playsound minecraft:universal.ability.discover_interaction player @a ~ ~ ~ 1
                    $advancement grant @s only $(advancement)
                }
            }
        }
    }
}

function scenario_setup {
    # function universal:scenario_setup {scenario:"Ability",sub_scenario:"Billy",objective:"abilityTheWorld.TimeskipGreyscale",duration:5}
    $scoreboard players set @s $(objective) $(duration)
    tag @s add scenarioTick.Enable
    $tag @s add scenarioTick.$(scenario)
    $tag @s add scenarioTick.$(scenario)$(sub_scenario)

}

dir attribute {
    function grant {
        # function universal:attribute/grant {type:"minecraft:movement_speed",path:"ability:billy.encourage",strength:0.25,operation:"add_multiplied_base"}
        # OPERATION TYPES #
            # add_multiplied_base
            # add_multiplied_total
            # add_value
        # OPTIONAL ARGUMENTS #
            # data merge storage minecraft:universal {attribute:{scenario:"Ability",objective:"abilityBilly.EncourageBuff",duration:60,extra:"tag @s add scenarioTick.AbilityBilly"}}
        $attribute @s $(type) modifier add $(path) $(strength) $(operation)
        execute if data storage minecraft:universal attribute run block { with storage minecraft:universal attribute
            $scoreboard players set @s $(objective) $(duration)
            $function universal:math/multiply {value:20,score:"@s",objective:"$(objective)"}
            tag @s add scenarioTick.Enable
            $tag @s add scenarioTick.$(scenario)
            execute if data storage minecraft:universal attribute.extra run block { with storage minecraft:universal attribute
                $$(extra)
            }
        }
        data remove storage minecraft:universal attribute
    }

    function revoke {
        # function universal:attribute/revoke {type:"minecraft:movement_speed",path:"ability:billy.encourage"}
        $attribute @s $(type) modifier remove $(path)
    }
}

dir error_messages {
    function constant {
        execute if entity @s[tag=customGojo.RidingBlue] run function custom:universal/error_messages/find {error:100}
        execute if entity @s[tag=customGojo.InfiniteVoided] run function custom:universal/error_messages/find {error:101}
        execute if entity @s[tag=customTheWorld.TimeLocked] run function custom:universal/error_messages/find {error:102}
        execute if score @s customTheWorld.BarrageStun matches 1.. run function custom:universal/error_messages/find {error:103}
    }

    function setup {
        # function universal:error_messages/setup {id:1}
        $tag @s add universalError.$(id)
        scoreboard players set @s universalError.FailReturn 1
    }

    function clear {
        REPEAT (1,102) as i {
            tag @s remove universalError.<%i%>
        }
        scoreboard players reset @s universalError.FailReturn
    }

    function cooldown {
        $scoreboard players operation .cooldownTicks universalError.Math = @s universalAbility.MoveCooldown$(move)

        scoreboard players operation .cooldownMinutes universalError.Math = .cooldownTicks universalError.Math
        scoreboard players operation .cooldownSeconds universalError.Math = .cooldownTicks universalError.Math

        scoreboard players set .ticksPerMinute universalError.Math 1200
        scoreboard players set .ticksPerSecond universalError.Math 20
        scoreboard players set .ticksPerDecimal universalError.Math 2

        scoreboard players operation .cooldownMinutes universalError.Math /= .ticksPerMinute universalError.Math
        scoreboard players operation .cooldownSeconds universalError.Math %= .ticksPerMinute universalError.Math
        scoreboard players operation .cooldownSeconds universalError.Math /= .ticksPerDecimal universalError.Math

        scoreboard players operation .cooldownDecimal universalError.Math = .cooldownSeconds universalError.Math
        scoreboard players set .decimalBase universalError.Math 10

        scoreboard players operation .cooldownSeconds universalError.Math /= .decimalBase universalError.Math
        scoreboard players operation .cooldownDecimal universalError.Math %= .decimalBase universalError.Math

        execute store result storage minecraft:universal error.cooldown_minutes int 1 run scoreboard players get .cooldownMinutes universalError.Math
        execute store result storage minecraft:universal error.cooldown_seconds int 1 run scoreboard players get .cooldownSeconds universalError.Math
        execute store result storage minecraft:universal error.cooldown_decimal int 1 run scoreboard players get .cooldownDecimal universalError.Math

        data modify storage minecraft:universal error.cooldown_display set value []

        execute if score .cooldownMinutes universalError.Math matches 1.. run block { with storage minecraft:universal error
            $data modify storage minecraft:universal error.cooldown_display append value {"text":"$(cooldown_minutes)m ","color":"#ffca0a"}
        }

        execute if score .cooldownMinutes universalError.Math matches 0 run block { with storage minecraft:universal error
            $data modify storage minecraft:universal error.cooldown_display append value {"text":"$(cooldown_seconds).$(cooldown_decimal)s","color":"#ffca0a"}
        }

        execute if score .cooldownMinutes universalError.Math matches 1.. run block { with storage minecraft:universal error
            $data modify storage minecraft:universal error.cooldown_display append value {"text":"$(cooldown_seconds)s","color":"#ffca0a"}
        }
    }

    function fail {
        $data merge storage minecraft:universal {error:{name:"$(name)",move:$(move)}}
        execute unless entity @s[tag=universalError.Hide] run block { with storage minecraft:universal error
            tellraw @s ""
            $tellraw @s ["",{"text":"[","color":"gray"},{"text":"!","color":"#F6FF2A"},{"text":"] ","color":"gray"},{"text":"$(name) ","color":"gold"},{"text":"[","color":"gray"},{"text":"!","color":"#F6FF2A"},{"text":"]","color":"gray"}]

            # very universal errors
            execute if entity @s[tag=universalError.1] run block { with storage minecraft:universal error
                $function universal:error_messages/cooldown {move:$(move)}
                block { with storage minecraft:universal error
                    $tellraw @s ["",{"text":"> ","color":"#5c5c5c"},{"text":"Cooldown: ","color":"gray"},{"text":"","extra":$(cooldown_display)}]
                }
            }
            execute if entity @s[tag=universalError.2] run tellraw @s ["",{"text":"> ","color":"#5c5c5c"},{"text":"Finish your ","color":"gray"},{"text":"current move","color":"#40DBF0"},{"text":" before ","color":"gray"},{"text":"casting another!","color":"#BA65FF"}]

            # Shrinkray
            execute if entity @s[tag=universalError.3] run tellraw @s ["",{"text":"> ","color":"#5C5C5C"},{"text":"You need ","color":"gray"},{"text":"ammo","color":"#E2A3FF"},{"text":" to fire the ","color":"gray"},{"text":"Shrinkray!","color":"#0FFF12"}]


            # execute if entity @s[tag=universalError.3] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" This move is ","color":"gray"},{"text":"BANNED ","color":"red"},{"text":"in the ","color":"gray"},{"text":"Pocket Dimension","color":"red"}]
            # execute if entity @s[tag=universalError.4] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"be looking at an entity to use ","color":"gray"},{"text":"this ","color":"aqua"},{"text":"move!","color":"gray"}]
            # execute if entity @s[tag=universalError.5] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You can't use ","color":"gray"},{"text":"Domain Expansion","color":"dark_purple"},{"text":" - ","color":"gray"},{"text":"Infinite Void","color":"light_purple"},{"text":" whilst nearby someone ","color":"gray"},{"text":"currently using","color":"gold"},{"text":" or ","color":"red"},{"text":"performing ","color":"gold"},{"text":"this move!","color":"gray"}]
            # execute if entity @s[tag=universalError.6] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You must be on ","color":"gray"},{"text":"solid ground ","color":"green"},{"text":"to cast this ","color":"gray"},{"text":"move!","color":"gold"}]
            # execute if entity @s[tag=universalError.7] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use this attack whilst it's ","color":"gray"},{"text":"currently casting!","color":"aqua"}]
            # execute if entity @s[tag=universalError.8] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"CAN'T","color":"red"},{"text":" use this move whilst being targeted by ","color":"gray"},{"text":"Pact!","color":"aqua"}]

            # execute if entity @s[tag=universalError.9] run {
            #     scoreboard players operation @s universalAbility.MoveCooldownMath = @s customEren.ShiftCooldown
            #     scoreboard players operation @s universalAbility.MoveCooldownMath /= #divide universalAbility.MoveCooldownMath
            #     tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You can't attempt to ","color":"gray"},{"text":"shift","color":"gold"},{"text":" into the ","color":"gray"},{"text":"Attack Titan","color":"aqua"},{"text":" for another ","color":"gray"},{"score":{"name":"@s","objective":"universalAbility.MoveCooldownMath"},"color":"red"},{"text":"s!","color":"red"}]
            # }

            # execute if entity @s[tag=universalError.10] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"roll the dice before ","color":"gray"},{"text":"storing ","color":"aqua"},{"text":"a move!","color":"gray"}]
            # execute if entity @s[tag=universalError.11] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"must ","color":"red"},{"text":"be looking at a ","color":"gray"},{"text":"block in range","color":"aqua"},{"text":" in order to use ","color":"gray"},{"text":"Acrobatics","color":"light_purple"}]
            # execute if entity @s[tag=universalError.12] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You've reached the ","color":"gray"},{"text":"maximum ","color":"red"},{"text":"number of ","color":"gray"},{"text":"traps!","color":"aqua"}]
            # execute if entity @s[tag=universalError.13] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" Traps must be spaced ","color":"gray"},{"text":"at least 4 meters apart","color":"light_purple"},{"text":" from eachother!","color":"gray"}]
            # execute if entity @s[tag=universalError.14] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"can't ","color":"red"},{"text":"cast this move inside the ","color":"gray"},{"text":"Pocket Dimension!","color":"aqua"}]
            # execute if entity @s[tag=universalError.15] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"can't","color":"red"},{"text":" cast moves while ","color":"gray"},{"text":"disguised","color":"light_purple"},{"text":" as a ","color":"gray"},{"text":"Turtle!","color":"green"}]
            # execute if entity @s[tag=universalError.16] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"can't ","color":"red"},{"text":"use this move whilst inside someone elses ","color":"gray"},{"text":"Pocket Dimension!","color":"aqua"}]
            # execute if entity @s[tag=universalError.17] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"must ","color":"red"},{"text":"be holding a valid ","color":"gray"},{"text":"tool ","color":"gold"},{"text":"to use this move!","color":"gray"}]
            # execute if entity @s[tag=universalError.18] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"must ","color":"red"},{"text":"have ","color":"gray"},{"text":"ammo ","color":"gold"},{"text":"to fire the ","color":"gray"},{"text":"Shrinkray!","color":"green"}]

            # execute if entity @s[tag=universalError.100] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use moves when ","color":"gray"},{"text":"picked up","color":"gold"},{"text":" by ","color":"gray"},{"text":"Lapis Blue","color":"aqua"}]
            # execute if entity @s[tag=universalError.101] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"CAN'T ","color":"red"},{"text":"use moves when in ","color":"gray"},{"text":"Domain Expansion ","color":"dark_purple"},{"text":"-","color":"gray"},{"text":" Infinite Void!","color":"light_purple"}]
            # execute if entity @s[tag=universalError.102] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You can't use moves when ","color":"gray"},{"text":"frozen ","color":"red"},{"text":"in ","color":"gray"},{"text":"time!","color":"aqua"}]
            # execute if entity @s[tag=universalError.103] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"can't","color":"red"},{"text":" cast moves whilst being ","color":"gray"},{"text":"barraged!","color":"aqua"}]
            playsound minecraft:entity.villager.no player @s ~ ~ ~ 0.5
            tellraw @s ""
        }

        REPEAT (1,102) as i {
            tag @s remove universalError.<%i%>
        }

        tag @s remove universalError.Hide
        
        scoreboard players set @s universalAbility.MoveDelay 4
        scoreboard players set @s universalError.FailReturn 0
    }
}

dir debug_log {
    function create {
        # function universal:debug/create {duration:10,text:"Math"}
        $execute if entity @s[tag=abilitySettings.DebugLog] run block { {duration:$(duration),text:"$(text)"}
            $tellraw @s {"text":"$(text) Debug","color":"gold"}
            tag @s add scenarioTick.Enable
            tag @s add scenarioTick.Universal
            $scoreboard players set @s universalDebug.Duration $(duration)
        }
    }

    function text {
        # function universal:debug_log/text {text:"Mode: Multiplication",color:"white"}
        $execute if entity @s[tag=abilitySettings.DebugLog] run block { {text:"$(text)",color:"$(color)"}
            $tellraw @s {"text":"$(text)","color":"$(color)"}
        }
    }

    dir entry {
        function score {
            # $function universal:debug_log/entry/score {text:"Input: ",score:"$(score)",objective:"$(objective)"}
            $execute if entity @s[tag=abilitySettings.DebugLog] run block { {text:"$(text)",score:"$(score)",objective:"$(objective)"}
                $tellraw @s ["",{"text":"$(text)","color":"gray"},{"score":{"name":"$(score)","objective":"$(objective)"},"color":"yellow"}]
            }
        }
    }

    function skip_line {
        execute if entity @s[tag=abilitySettings.DebugLog] run tellraw @s {"text":""}
    }
}

dir math {
    function multiply {
        # function universal:math/multiply {value:3,score:"@s",objective:"abilityEren.ShiftDuration"}
        # function universal:debug_log/create {duration:1,text:"Math"}
        # function universal:debug_log/text {text:"Mode: Multiplication",color:"white"}
        # $function universal:debug_log/entry/score {text:"Input: ",score:"$(score)",objective:"$(objective)"}
        $scoreboard players set .operation $(objective) $(value)
        $scoreboard players operation $(score) $(objective) *= .operation $(objective)
        $scoreboard players reset .operation $(objective)
        # $function universal:debug_log/entry/score {text:"Result: ",score:"$(score)",objective:"$(objective)"}
    }

    function divide {
        # function universal:math/divide {value:2,score:"@s",objective:"abilityEren.ShiftDuration"}
        # function universal:debug_log/create {duration:1,text:"Math"}
        # function universal:debug_log/text {text:"Mode: Division",color:"white"}
        # $function universal:debug_log/entry/score {text:"Input: ",score:"$(score)",objective:"$(objective)"}
        $scoreboard players set .operation $(objective) $(value)
        $scoreboard players operation $(score) $(objective) /= .operation $(objective)
        $scoreboard players reset .operation $(objective)
        # $function universal:debug_log/entry/score {text:"Result: ",score:"$(score)",objective:"$(objective)"}
    }

    function modulo {
        # function universal:math/modulo {value:60,score:".cooldownSeconds",objective:"uiAbility.Moveset"}
        # function universal:debug_log/create {duration:1,text:"Math"}
        # function universal:debug_log/text {text:"Mode: Modulo",color:"white"}
        # $function universal:debug_log/entry/score {text:"Input: ",score:"$(score)",objective:"$(objective)"}
        $scoreboard players set .operation $(objective) $(value)
        $scoreboard players operation $(score) $(objective) %= .operation $(objective)
        $scoreboard players reset .operation $(objective)
        # $function universal:debug_log/entry/score {text:"Result: ",score:"$(score)",objective:"$(objective)"}
    }

    function square_root {
        # function universal:math/square_root {score:"@s",objective:"abilityEren.ShiftDuration"}
        function universal:debug_log/create {duration:1,text:"Math"}
        function universal:debug_log/text {text:"Mode: Square Root",color:"white"}
        $function universal:debug_log/entry/score {text:"Input: ",score:"$(score)",objective:"$(objective)"}
        
        # not adding ts yet
    }
}

dir fetch {
    function username {
        # function universal:fetch/username {storage:"minecraft:cassette",path:"party.username"}
        loot insert 0 -63 0 loot universal:player_head
        $data modify storage $(storage) $(path) set string block 0 -63 0 Items[0].components."minecraft:profile".name
        item replace block 0 -63 0 container.0 with minecraft:air
    }

    function block {
        # function universal:fetch/block {storage:"minecraft:ability",path:"billy.toggle.land"}
        loot insert 0 -63 0 mine ~ ~ ~ minecraft:stick[tool={can_destroy_blocks_in_creative:true,default_mining_speed:90,damage_per_block:90,rules:[]},enchantments={"minecraft:silk_touch":1}]
        $data modify storage $(storage) $(path) set string block 0 -63 0 Items[0].id
        item replace block 0 -63 0 container.0 with minecraft:air
    }
}