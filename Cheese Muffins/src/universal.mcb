function on_load minecraft:load{
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy

    # universal scores
    scoreboard objectives add universalDebug.Duration dummy
    scoreboard objectives add universalDamage.DeathCount deathCount
    scoreboard objectives add universalError.FailReturn dummy
    scoreboard objectives add universalError.Math dummy
    scoreboard objectives add universalText.ID dummy
    scoreboard objectives add universalVFX.ID dummy
    scoreboard objectives add universalVFX.Conditions dummy
    scoreboard objectives add universalDisconnect.Check minecraft.custom:minecraft.leave_game
    


    # ability universals
    REPEAT (1,8) as i {
        scoreboard objectives add universalAbility.MoveCooldown<%i%> dummy
        scoreboard objectives add universalAbility.MoveSplit<%i%> dummy
        scoreboard objectives add universalAbility.MoveTrigger<%i%> dummy
    }
    scoreboard objectives add universalAbility.AwakeningDuration dummy
    scoreboard objectives add universalAbility.ID dummy
    scoreboard objectives add universalAbility.EquippedID dummy
    scoreboard objectives add universalAbility.EquippedSkinID dummy
    scoreboard objectives add universalAbility.MoveCooldownMath dummy
    scoreboard objectives add universalAbility.MoveDelay dummy
    scoreboard objectives add universalAbility.MovePrevious dummy
    scoreboard objectives add universalAbility.ToggleTrigger dummy
    scoreboard objectives add universalAbility.ToggleState dummy
    scoreboard objectives add universalAbility.ToggleDelay dummy
    scoreboard objectives add universalAbility.HotbarSlot dummy
}

dir tick {
    function main {
        execute as @a at @s run {
            # ability ticks
            function ability:tick/player

            # cassette ticks
            function ui:logic/player/tick
            function cassette:tick/main

            # scenario ticks
            execute if score @s universalAbility.ToggleTrigger matches 1.. run function universal:ability/toggle
            execute if score @s universalDisconnect.Check matches 1.. run function universal:disconnect
            execute if score @s universalDamage.DeathCount matches 1.. run function universal:ability/death
        }

        execute as @e[type=!#universal:misc_mob] at @s run {
            execute as @s[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/tick
            execute if entity @s[tag=scenarioTick.Enable] run function universal:tick/scenario/main
        }
    }

    dir scenario {
        function main {
            # scenario ticking relevant specifically to this compiler
            execute if entity @s[tag=scenarioTick.Universal] run {
                function universal:tick/scenario/debug
            }

            # scenario ticking relevant to other compilers
            execute if entity @s[tag=scenarioTick.Cassette] run function cassette:tick/scenario/core
            execute if entity @s[tag=scenarioTick.Ability] run function ability:tick/scenario/index
            execute if entity @s[tag=scenarioTick.Trait] run function trait:tick/scenario/index

            execute if entity @s[tag=!scenarioTick.Universal,tag=!scenarioTick.Ability,tag=!scenarioTick.Trait,tag=!scenarioTick.Cassette] run tag @s remove scenarioTick.Enable
        }

        function debug {
            execute if score @s universalDebug.Duration matches 1.. run {
                scoreboard players remove @s universalDebug.Duration 1
            } else run {
                scoreboard players reset @s universalDebug.Duration
                tag @s remove scenarioTick.Universal
            }
        }
    }
}

function disconnect {
    # ability disconnection
    execute if score @s universalAbility.ToggleState matches 1 run {
        execute store result storage minecraft:universal disconnect.equipped_id int 1 run scoreboard players get @s universalAbility.EquippedID
        block { with storage minecraft:universal disconnect
            $data modify storage minecraft:universal disconnect.path set from storage minecraft:ability index.$(equipped_id).path
            block { with storage minecraft:universal disconnect
                $function ability:$(path)/toggle/on
                $function ability:$(path)/disconnected
            }
        }
    }

    scoreboard players reset @s universalDisconnect.Check
}

dir damage {
    function check {
        execute if entity @s[tag=universalAbility.ModifierCancelable] run function universal:damage/cancel
        advancement revoke @s only universal:recieve_damage
    }

    function cancel {
        execute store result storage minecraft:universal damage.equipped_id int 1 run scoreboard players get @s universalAbility.EquippedID
        block { with storage minecraft:universal damage
            $data modify storage minecraft:universal damage.path set from storage minecraft:ability index.$(equipped_id).path
            $data modify storage minecraft:universal damage.real_path set from storage minecraft:ability index.$(equipped_id).real_path
        }

        execute store result storage minecraft:universal damage.id int 1 run scoreboard players get @s universalAbility.ID
        execute store result storage minecraft:universal damage.move int 1 run scoreboard players get @s universalAbility.MovePrevious
        block { with storage minecraft:universal damage
            $execute as @n[type=minecraft:item_display,tag=aj.$(path).root,scores={universalAbility.ID=$(id)}] at @s run block { with storage minecraft:universal damage
                playsound minecraft:universal.ability.cancel player @a ~ ~ ~ 1
                $function ability:$(path)/moves/reset/all
            }
        }
    }

    function apply {
        $data modify storage minecraft:universal damage.apply merge value $(import)

        gamerule show_death_messages false
        scoreboard players operation .initial universalDamage.DeathCount = @s universalDamage.DeathCount
        block { with storage minecraft:universal damage.apply
            attribute @s minecraft:knockback_resistance modifier add universal:damage.apply 1 add_value
            $damage @s $(damage) $(type) by @p[$(user_tags),scores={$(objective)=$(user_id)}]

            execute unless score .initial universalDamage.DeathCount = @s universalDamage.DeathCount run block { with storage minecraft:universal damage.apply
                $function ability:generate/death_message {ability_id:$(ability_id),move:$(move_number),variation:$(move_variation)}

                block { with storage minecraft:universal damage.apply
                    $tellraw @a ["",{"selector":"@s"},{"text":" $(death_message) "},{"selector":"@p[$(user_tags),scores={$(objective)=$(user_id)}]"},{"text":" using "},{"text":"","extra":$(move_name),"hover_event":{"action":"show_text","value":$(move_hover)}}]
                }
            }
        }
        attribute @s minecraft:knockback_resistance modifier remove universal:damage.apply
        gamerule show_death_messages true
    }
}

dir hotbar {
    function time {
        $execute store result storage minecraft:universal hotbar.time int 0.05 run scoreboard players get @s universalAbility.MoveCooldown$(slot)
        $data merge storage minecraft:universal {hotbar:{ability:"$(ability)",slot:$(slot)}}
        block { with storage minecraft:universal hotbar
            $execute if score @s universalAbility.MoveCooldown$(slot) matches 2000.. store result storage minecraft:ability $(ability).hotbar.time int 0.05 run scoreboard players get @s universalAbility.MoveCooldown$(slot)
            $execute if score @s universalAbility.MoveCooldown$(slot) matches 200..1999 run data merge storage minecraft:ability {$(ability):{hotbar:{time:"0$(time)"}}}
            $execute unless score @s universalAbility.MoveCooldown$(slot) matches 199.. run data merge storage minecraft:ability {$(ability):{hotbar:{time:"00$(time)"}}}
        }
    }
}

dir vfx {
    function initialize {
        #  --   Required Args  --   #
        #   --   Mode: 0 - 1  --    # 

        # Arguments default as follows #
            # mode:                  - Defaults to 0
            #                         - 0: Completely controlled by the rig itself.
            #                         - 1: Uses the rig, but the spawning location is randomized based upon rX rY rZ values.
            #                          - rx:""          - Randomly set the X position (REQUIRED)
            #                          - ry:""          - Randomly set the Y position (REQUIRED)
            #                          - rz:""          - Randomly set the Z position (REQUIRED)
            #                          - rx_rotation:1b - Randomly set rotation for the X axis
            #                          - ry_rotation:1b - Randomly set rotation for the Y axis
            # count:                 - Defaults to 1
            # speed:                 - Does not run
            # duration:              - Does not run
            # branch:""              - REQUIRED to run
            # animation:""           - REQUIRED to run
            # output:""              - Does not run
            # objective_override:1b  - Remove the hinge on obj: universalAbility.ID
            # ride_executor:1b       - VFX mounts the executing entity
        
        # EXAMPLE 1 #
            # function universal:vfx/initialize {arguments:{branch:"billy",animation:"appear",output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.position]"}}
        # EXAMPLE 2 #
            # execute rotated ~ 0 run function universal:vfx/initialize {arguments:{mode:1,branch:"shrinkray",animation:"emit",rx:1.50,ry:0.00,rz:1.50}}

        # Modes
            # 0: NO Offset / Speed to be applied. As basic as it comes!

        $data modify storage minecraft:universal vfx merge value $(arguments)

        # arguments to relevant scores.
        scoreboard players set .Count universalVFX.Conditions 1
        execute if data storage minecraft:universal vfx.mode store result score .Mode universalVFX.Conditions run data get storage minecraft:universal vfx.mode
        execute if data storage minecraft:universal vfx.count store result score .Count universalVFX.Conditions run data get storage minecraft:universal vfx.count
        execute if data storage minecraft:universal vfx.speed store result score .Speed universalVFX.Conditions run data get storage minecraft:universal vfx.speed
        execute if data storage minecraft:universal vfx.duration store result score .Duration universalVFX.Conditions run data get storage minecraft:universal vfx.duration
        
        # Makes sure VFX are spawned ONLY if the branch and animation are provided.
        execute unless data storage minecraft:universal vfx.branch run scoreboard players set .invalidArgs universalVFX.Conditions 1
        execute unless data storage minecraft:universal vfx.animation run scoreboard players set .invalidArgs universalVFX.Conditions 1
        execute unless score .invalidArgs universalVFX.Conditions matches 1 run function universal:vfx/create
        scoreboard players reset .invalidArgs universalVFX.Conditions


        data remove storage minecraft:universal vfx
        scoreboard players reset .Mode universalVFX.Conditions
        scoreboard players reset .Count universalVFX.Conditions
        scoreboard players reset .Speed universalVFX.Conditions
        scoreboard players reset .Duration universalVFX.Conditions
    }

    function create {
        execute unless score .Mode universalVFX.Conditions matches 1.. run function universal:vfx/mode/0 with storage minecraft:universal vfx
        execute if score .Mode universalVFX.Conditions matches 1 run function universal:vfx/mode/1 with storage minecraft:universal vfx

        block { with storage minecraft:universal vfx
            execute store result storage minecraft:universal vfx.id int 1 run scoreboard players get @s universalAbility.ID
            execute if data storage minecraft:universal vfx{objective_override:1b} run {
                scoreboard players add .globalOverride universalVFX.ID 1
                scoreboard players operation @s universalVFX.ID = .globalOverride universalVFX.ID
                execute store result storage minecraft:universal vfx.id int 1 run scoreboard players get @s universalVFX.ID
            }


            $execute as @e[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless score @s universalVFX.ID matches 1.. run block { with storage minecraft:universal vfx
                $scoreboard players set @s universalVFX.ID $(id)
                $function universal:ability/play/animation {arguments:{rig:"$(branch)_vfx",animation:"$(animation)",style:"play",objective:"universalVFX.ID"}}

                execute if data storage minecraft:universal vfx{ride_executor:1b} run block { with storage minecraft:universal vfx
                    $execute unless data storage minecraft:universal vfx{objective_override:1b} run ride @s mount @n[type=!minecraft:item_display,scores={universalAbility.ID=$(id)}]
                    $execute if data storage minecraft:universal vfx{objective_override:1b} run ride @s mount @n[type=!minecraft:item_display,scores={universalVFX.ID=$(id)}]
                }

                # if an output argument is present
                execute if data storage minecraft:universal vfx.output run block { with storage minecraft:universal vfx
                    $$(output)
                }
            }
            execute if data storage minecraft:universal vfx.objective_override run scoreboard players reset @s universalVFX.ID
        }

        scoreboard players remove .Count universalVFX.Conditions 1
        execute if score .Count universalVFX.Conditions matches 1.. run function universal:vfx/create
    }

    dir mode {
        function 0 {
            $function aj:$(branch)_vfx/summon {args:{}}
        }

        function 1 {
            execute store result storage minecraft:universal vfx.rx float 1 run data get storage minecraft:universal vfx.rx 1000
            execute store result storage minecraft:universal vfx.ry float 1 run data get storage minecraft:universal vfx.ry 1000
            execute store result storage minecraft:universal vfx.rz float 1 run data get storage minecraft:universal vfx.rz 1000

            execute if score @s traitShrinkray.Size matches 1 run {
                execute store result storage minecraft:universal vfx.rx float 1 run data get storage minecraft:universal vfx.rx 0.25
                execute store result storage minecraft:universal vfx.ry float 1 run data get storage minecraft:universal vfx.ry 0.25
                execute store result storage minecraft:universal vfx.rz float 1 run data get storage minecraft:universal vfx.rz 0.25
            }
            execute if score @s traitShrinkray.Size matches 2 run {
                execute store result storage minecraft:universal vfx.rx float 1 run data get storage minecraft:universal vfx.rx 1.50
                execute store result storage minecraft:universal vfx.ry float 1 run data get storage minecraft:universal vfx.ry 1.50
                execute store result storage minecraft:universal vfx.rz float 1 run data get storage minecraft:universal vfx.rz 1.50
            }

            block { with storage minecraft:universal vfx
                $execute store result storage minecraft:universal vfx.rx float 0.001 run random value -$(rx)..$(rx)
                $execute store result storage minecraft:universal vfx.ry float 0.001 run random value -$(ry)..$(ry)
                $execute store result storage minecraft:universal vfx.rz float 0.001 run random value -$(rz)..$(rz)
                block { with storage minecraft:universal vfx
                    # $say ~$(rx) ~$(ry) ~$(rz)
                    $execute positioned ~$(rx) ~$(ry) ~$(rz) run function aj:$(branch)_vfx/summon {args:{}}
                }
            }
        }
    }
}

dir ability {
    dir rig {
        dir stable_player_display {
            function main {
                $data modify storage minecraft:universal stable_player_display.branch set value "$(branch)"
                $data modify storage minecraft:universal stable_player_display.split set value "$(split)"
                execute unless entity @s[tag=abilitySettings.EnabledSPD] run function universal:ability/rig/stable_player_display/state/model with storage minecraft:universal stable_player_display
                execute if entity @s[tag=abilitySettings.EnabledSPD] run function universal:ability/rig/stable_player_display/state/skin with storage minecraft:universal stable_player_display
            }

            dir state {
                function model {
                    $execute as @n[tag=aj.$(branch).root] run block { with storage minecraft:universal stable_player_display
                        $function ability:$(branch)/skin_index with storage minecraft:universal stable_player_display
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)head] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)right_arm] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)right_forearm] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)left_arm] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)left_forearm] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)waist] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)right_leg] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)lower_right_leg] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)left_leg] hotbar.0 with minecraft:air
                        $item replace entity @n[tag=aj.$(branch).bone.$(split)lower_left_leg] hotbar.0 with minecraft:air
                        $execute as @n[tag=aj.$(branch).item_display.$(split)helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.$(split)chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                        $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    }
                }

                function skin {
                    $execute as @n[tag=aj.$(branch).root] run function aj:$(branch)/variants/player_model/apply
                    $loot replace entity @n[tag=aj.$(branch).bone.head] hotbar.0 loot minecraft:player/head
                    $loot replace entity @n[tag=aj.$(branch).bone.right_arm] hotbar.0 loot minecraft:player/right_arm
                    $loot replace entity @n[tag=aj.$(branch).bone.right_forearm] hotbar.0 loot minecraft:player/right_forearm
                    $loot replace entity @n[tag=aj.$(branch).bone.left_arm] hotbar.0 loot minecraft:player/left_arm
                    $loot replace entity @n[tag=aj.$(branch).bone.left_forearm] hotbar.0 loot minecraft:player/left_forearm
                    $loot replace entity @n[tag=aj.$(branch).bone.waist] hotbar.0 loot minecraft:player/waist
                    $loot replace entity @n[tag=aj.$(branch).bone.right_leg] hotbar.0 loot minecraft:player/right_leg
                    $loot replace entity @n[tag=aj.$(branch).bone.lower_right_leg] hotbar.0 loot minecraft:player/lower_right_leg
                    $loot replace entity @n[tag=aj.$(branch).bone.left_leg] hotbar.0 loot minecraft:player/left_leg
                    $loot replace entity @n[tag=aj.$(branch).bone.lower_left_leg] hotbar.0 loot minecraft:player/lower_left_leg

                    # Reset every slot so removing armor or trims clears previous display data.
                    data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:empty","chestplate_body":"minecraft:empty","chestplate_arms":"minecraft:empty","leggings_pants":"minecraft:empty","leggings_upper":"minecraft:empty","leggings_lower":"minecraft:empty","boots":"minecraft:empty","head_base":"","head_pattern":"","head_material":"","chest_base":"","chest_pattern":"","chest_material":"","legs_base":"","legs_pattern":"","legs_material":"","feet_base":"","feet_pattern":"","feet_material":"","chestplate_arms_flipped":"minecraft:empty","leggings_upper_flipped":"minecraft:empty","leggings_lower_flipped":"minecraft:empty","boots_flipped":"minecraft:empty"}}

                    # Detect head armor and its vanilla trim component on the source entity (@s).
                    execute if items entity @s armor.head minecraft:netherite_helmet run data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:item/armor/helmet","head_base":"netherite"}}
                    execute if items entity @s armor.head minecraft:diamond_helmet run data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:item/armor/helmet","head_base":"diamond"}}
                    execute if items entity @s armor.head minecraft:iron_helmet run data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:item/armor/helmet","head_base":"iron"}}
                    execute if items entity @s armor.head minecraft:chainmail_helmet run data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:item/armor/helmet","head_base":"chainmail"}}
                    execute if items entity @s armor.head minecraft:golden_helmet run data merge storage minecraft:universal {"stable_player_display":{"helmet":"minecraft:item/armor/helmet","head_base":"gold"}}
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:bolt"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "bolt"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:coast"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "coast"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:dune"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "dune"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:eye"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "eye"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:flow"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "flow"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:host"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "host"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:raiser"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "raiser"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:rib"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "rib"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:sentry"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "sentry"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:shaper"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "shaper"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:silence"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "silence"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:snout"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "snout"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:spire"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "spire"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:tide"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "tide"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:vex"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "vex"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:ward"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "ward"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:wayfinder"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "wayfinder"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"pattern":"minecraft:wild"}}}}} run data modify storage minecraft:universal stable_player_display.head_pattern set value "wild"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:quartz"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "quartz"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:iron"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "iron"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:netherite"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "netherite"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:redstone"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "redstone"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:copper"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "copper"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:gold"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "gold"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:emerald"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "emerald"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:diamond"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "diamond"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:lapis"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "lapis"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:amethyst"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "amethyst"
                    execute if data entity @s {"equipment":{"head":{"components":{"minecraft:trim":{"material":"minecraft:resin"}}}}} run data modify storage minecraft:universal stable_player_display.head_material set value "resin"

                    # Detect chest armor and its vanilla trim component on the source entity (@s).
                    execute if items entity @s armor.chest minecraft:netherite_chestplate run data merge storage minecraft:universal {"stable_player_display":{"chestplate_body":"minecraft:item/armor/chestplate/body","chestplate_arms":"minecraft:item/armor/chestplate/arms","chest_base":"netherite","chestplate_arms_flipped":"minecraft:item/armor/chestplate/arms_flipped"}}
                    execute if items entity @s armor.chest minecraft:diamond_chestplate run data merge storage minecraft:universal {"stable_player_display":{"chestplate_body":"minecraft:item/armor/chestplate/body","chestplate_arms":"minecraft:item/armor/chestplate/arms","chest_base":"diamond","chestplate_arms_flipped":"minecraft:item/armor/chestplate/arms_flipped"}}
                    execute if items entity @s armor.chest minecraft:iron_chestplate run data merge storage minecraft:universal {"stable_player_display":{"chestplate_body":"minecraft:item/armor/chestplate/body","chestplate_arms":"minecraft:item/armor/chestplate/arms","chest_base":"iron","chestplate_arms_flipped":"minecraft:item/armor/chestplate/arms_flipped"}}
