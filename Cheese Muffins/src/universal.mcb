function on_load minecraft:load{
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy

    # universal scores
    scoreboard objectives add universalDebug.Duration dummy
    scoreboard objectives add universalError.FailReturn dummy
    scoreboard objectives add universalText.ID dummy
    scoreboard objectives add universalVFX.ID dummy
    scoreboard objectives add universalVFX.Conditions dummy
    


    # ability universals
    REPEAT (1,8) as i {
        scoreboard objectives add universalAbility.MoveCooldown<%i%> dummy
        scoreboard objectives add universalAbility.MoveTrigger<%i%> dummy
    }
    scoreboard objectives add universalAbility.ID dummy
    scoreboard objectives add universalAbility.MoveCooldownMath dummy
    scoreboard objectives add universalAbility.MoveDelay dummy
    scoreboard objectives add universalAbility.MovePrevious dummy
    scoreboard objectives add universalAbility.ToggleTrigger dummy
    scoreboard objectives add universalAbility.ToggleState dummy
    scoreboard objectives add universalAbility.ToggleDelay dummy
    scoreboard objectives add universalAbility.HotbarSlot dummy

    function ability:billy/install
}

dir tick {
    function main {
        execute as @a at @s run {
            # ability ticks
            function ability:tick/player

            # cassette ticks
            function ui:logic/player/tick
            function cassette:tick/main

            # scenario ticks
            execute if entity @s[tag=scenarioTick.Enable] run function universal:tick/scenario/main
            execute if score @s universalAbility.ToggleTrigger matches 1.. run function universal:toggle_ability
        }

        execute as @e[type=!#universal:misc_mob] at @s run {
            execute as @s[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/tick
        }
    }

    dir scenario {
        function main {
            # scenario ticking relevant specifically to this compiler
            execute if entity @s[tag=scenarioTick.Universal] run {
                function universal:tick/scenario/debug
            }

            # scenario ticking relevant to other compilers
            execute if entity @s[tag=scenarioTick.Cassette] run function cassette:tick/scenario/core
            execute if entity @s[tag=scenarioTick.Ability] run function ability:tick/scenario/index

            execute if entity @s[tag=!scenarioTick.Universal,tag=!scenarioTick.Ability,tag=!scenarioTick.Cassette] run tag @s remove scenarioTick.Enable
        }

        function debug {
            execute if score @s universalDebug.Duration matches 1.. run {
                scoreboard players remove @s universalDebug.Duration 1
            } else run {
                scoreboard players reset @s universalDebug.Duration
                tag @s remove scenarioTick.Universal
            }
        }
    }
}

function toggle_ability {
    execute if entity @s[tag=universalAbility.User] unless entity @s[tag=universalAbility.Animating] unless score @s universalAbility.ToggleDelay matches 1.. run {
        # toggle on
        execute unless score @s universalAbility.ToggleState matches 1.. run {
            scoreboard players set @s universalAbility.ToggleState 1
            tag @s add temp

            execute unless score @s universalAbility.ID matches 1.. run {
                scoreboard players add .global universalAbility.ID 1
                scoreboard players operation @s universalAbility.ID = .global universalAbility.ID

                function universal:fetch/username {storage:"minecraft:ability",path:"username"}
                block { with storage minecraft:ability
                    $scoreboard players display name @s universalAbility.ID {"color":"aqua","text":"$(username)"}
                }
            }

            execute if entity @s[tag=abilityBilly.User] run function ability:billy/toggle/on
        }

        # toggle off
        execute if score @s universalAbility.ToggleState matches 1.. unless entity @s[tag=temp] run {
            scoreboard players set @s universalAbility.ToggleState 0

            execute if entity @s[tag=abilityBilly.User] run function ability:billy/toggle/off
        }
        tag @s remove temp
    }
    scoreboard players reset @s universalAbility.ToggleTrigger
}

dir damage {
    function check {
        execute if entity @s[tag=universalAbility.ModifierCancelable] run function universal:damage/cancel
        advancement revoke @s only universal:recieve_damage
    }

    function cancel {
        execute if entity @s[tag=abilityBilly.User] run data merge storage minecraft:universal {damage:{namespace:"Billy",ability:"billy"}}

        execute store result storage minecraft:universal damage.id int 1 run scoreboard players get @s universalAbility.ID
        execute store result storage minecraft:universal damage.move int 1 run scoreboard players get @s universalAbility.MovePrevious
        block { with storage minecraft:universal damage
            $execute as @n[type=minecraft:item_display,tag=aj.$(ability).root,scores={universalAbility.ID=$(id)}] at @s run block { with storage minecraft:universal damage
                playsound minecraft:universal.ability.cancel player @a ~ ~ ~ 1
                function ability:billy/moves/reset/all
            }
        }
    } 
}

dir hotbar {
    function time {
        $execute store result storage minecraft:universal hotbar.time int 0.05 run scoreboard players get @s universalAbility.MoveCooldown$(slot)
        $data merge storage minecraft:universal {hotbar:{ability:"$(ability)",slot:$(slot)}}
        block { with storage minecraft:universal hotbar
            $execute if score @s universalAbility.MoveCooldown$(slot) matches 2000.. store result storage minecraft:ability $(ability).hotbar.time int 0.05 run scoreboard players get @s universalAbility.MoveCooldown$(slot)
            $execute if score @s universalAbility.MoveCooldown$(slot) matches 200..1999 run data merge storage minecraft:ability {$(ability):{hotbar:{time:"0$(time)"}}}
            $execute unless score @s universalAbility.MoveCooldown$(slot) matches 199.. run data merge storage minecraft:ability {$(ability):{hotbar:{time:"00$(time)"}}}
        }
    }
}

dir cooldown {
    function 8x {
        $scoreboard players set .$(name)Cooldown universalAbility.MoveCooldown$(move) $(cooldown)
        $function universal:math/multiply {value:20,score:".$(name)Cooldown",objective:"universalAbility.MoveCooldown$(move)"}
        $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
        $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
        $scoreboard players operation .$(name)CooldownDivided universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
        $function universal:math/divide {value:9,score:".$(name)CooldownDivided",objective:"universalAbility.MoveCooldown$(move)"}

        $execute store result storage minecraft:ability $(storage).cooldown.move$(path).9 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

        REPEAT (8,1) as i {
            $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
            $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>a int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
            $scoreboard players remove .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) 1
            $execute store result storage minecraft:ability $(storage).cooldown.move$(path).<%i%>b int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)
        }

        $scoreboard players operation .$(name)CooldownThresholds universalAbility.MoveCooldown$(move) -= .$(name)CooldownDivided universalAbility.MoveCooldown$(move)
        $execute store result storage minecraft:ability $(storage).cooldown.move$(path).1 int 1 run scoreboard players get .$(name)CooldownThresholds universalAbility.MoveCooldown$(move)

        $data merge storage minecraft:ability {$(storage):{cooldown:{move$(path):{slot:$(move)}}}}
    }
}

dir vfx {
    function spawn {
        #  --   Required Args  --   #
        #   --   Mode: 0 - 1  --    # 

        # Arguments default as follows #
            # Mode: Defaults to 0
            # Count: Defaults to 1
            # Speed: Does not run
            # Duration: Does not run
            # Branch: Does not run
            # Animation: Does not run
            # Output: Does not run
        
        # EXAMPLE #
            # data modify storage minecraft:universal vfx.arguments.branch set value "billy"
            # data modify storage minecraft:universal vfx.arguments.animation set value "appear"
            # data modify storage minecraft:universal vfx.arguments.output set value "appear"

            # function universal:vfx/spawn with storage minecraft:universal vfx.arguments

        # Modes
            # 0: NO Offset / Speed to be applied. As basic as it comes

        $scoreboard players set .Mode universalVFX.Conditions $(mode)
        $scoreboard players set .Count universalVFX.Conditions $(count)
        execute if data storage minecraft:universal vfx.arguments.speed run block { with storage minecraft:universal vfx.arguments
            $scoreboard players set .Speed universalVFX.Conditions $(speed)
        }
        execute if data storage minecraft:universal vfx.arguments.duration run block { with storage minecraft:universal vfx.arguments
            $scoreboard players set .Duration universalVFX.Conditions $(duration)
        }

        function universal:vfx/create
        data modify storage minecraft:universal vfx.arguments set value {mode:0,count:1}
    }

    function create {
        execute if score .Mode universalVFX.Conditions matches 0 run function universal:vfx/mode/0 with storage minecraft:universal vfx.arguments

        scoreboard players remove .Count universalVFX.Conditions 1
        execute if score .Count universalVFX.Conditions matches 1.. run function universal:vfx/create
    }

    dir mode {
        function 0 {
            $function aj:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}

            execute store result storage minecraft:universal vfx.id int 1 run scoreboard players get @s universalAbility.ID
            $execute as @n[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless score @s universalVFX.ID matches 1.. run block { with storage minecraft:universal vfx
                $scoreboard players set @s universalVFX.ID $(id)

                # if an output argument is present
                execute if data storage minecraft:universal vfx.arguments.output run block { with storage minecraft:universal vfx.arguments
                    $$(output)
                }
            }
        }
    }
}

dir ability {
    dir rig {
        dir mount {
            function player {
                # function universal:ability/rig/mount/player {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
                $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
                $data merge storage minecraft:universal {ability:{rig:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                block { with storage minecraft:universal ability.rig
                    $ride @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] mount @p[tag=$(user),scores={$(objective)=$(id)}]
                }
            }
        }

        function dismount {
            # function universal:ability/rig/dismount {rig:"billy",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.dismount.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{dismount:{objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:universal ability.dismount
                $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run ride @s dismount
            }
        }

        function rotate {
            # function universal:ability/rig/rotate {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:universal ability.rig
                $execute as @a[tag=$(user),scores={$(objective)=$(id)}] store result storage minecraft:universal ability.rig.rotation float 0.1 run data get entity @s Rotation[0] 10
                block { with storage minecraft:universal ability.rig
                    $data modify entity @s Rotation[0] set value $(rotation)
                }
                # $execute unless entity @a[tag=$(user),scores={$(objective)=$(id)}] run function custom:abilities/$(rig)/toggle/off
            }
        }

        function as_player {
            # function universal:ability/rig/as_player {player:"abilityBilly.User",objective:"universalAbility.ID",output:"tag @s remove universalAbility.HideUI"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{player:"$(player)",objective:"$(objective)",output:"$(output)"}}}
            block { with storage minecraft:universal ability.rig
                $execute as @p[tag=$(player),scores={$(objective)=$(id)}] at @s run $(output)
            }
        }

        function spectate_camera {
            # function universal:ability/rig/spectate_camera {camera:"aj.billy.camera",objective:"universalAbility.ID"}
            $execute store result storage minecraft:universal ability.camera.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{camera:{camera:"$(camera)",objective:"$(objective)"}}}
            block { with storage minecraft:universal ability.camera
                $spectate @n[type=minecraft:item_display,tag=$(camera),scores={$(objective)=$(id)}] @s
            }
        }

        function visibility {
            # function universal:ability/rig/visibility {target:"aj.billy.root",objective:"universalAbility.ID",state:"disable",perspective:"inline_perspective",mounted:"hide_passengers"}
            $execute store result storage minecraft:universal ability.rig.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:universal {ability:{rig:{objective:"$(objective)",target:"$(target)",state:"$(state)",perspective:"$(perspective)",mounted:"$(mounted)"}}}
            block { with storage minecraft:universal ability.rig
                $visibility $(state) @n[type=minecraft:item_display,tag=$(target),scores={$(objective)=$(id)}] @s $(perspective) $(mounted)
            }
        }

        function text {
            # EXAMPLE #
                # data modify storage minecraft:universal ability.rig.text.arguments.animation set value "billy"
                # data modify storage minecraft:universal ability.rig.text.arguments.text set value "{text:{"color":"red","italic":false,"text":"Billy"}}"
                # data modify storage minecraft:universal ability.rig.text.arguments.output set value "ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"
            # OR #
                # data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{text:{"color":"red","italic":false,"text":"Billy"}},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
            # THEN #
                # function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments

            $function aj:text_display/summon {args:{animation:'$(animation)',start_animation: true}}

            execute store result storage minecraft:universal ability.rig.text.id int 1 run scoreboard players get @s universalAbility.ID

            # as the text node
            execute as @n[type=minecraft:text_display,tag=aj.text_display.text_display.display,tag=!universalText.IDAssigned] run block { with storage minecraft:universal ability.rig.text
                data modify entity @s text set from storage minecraft:universal ability.rig.text.arguments.text
                $scoreboard players set @s universalText.ID $(id)
                tag @s add universalText.IDAssigned
            }

            # as the text root
            execute as @n[type=minecraft:item_display,tag=aj.text_display.root,tag=!universalText.IDAssigned] run block { with storage minecraft:universal ability.rig.text
                $scoreboard players set @s universalText.ID $(id)
                tag @s add universalText.IDAssigned

                execute if data storage minecraft:universal ability.rig.text.arguments.output run block { with storage minecraft:universal ability.rig.text.arguments
                    $$(output)
                }
            }
            data remove storage minecraft:universal ability.rig.text.arguments
        }

        function pair {
            # function universal:ability/rig/pair {target:"type=minecraft:item_display,tag=aj.billy.root",objective_before:"universalAbility.ID",objective_target:"universalAbility.ID"}
            $data merge storage minecraft:universal {ability:{rig:{target:"$(target)",objective_before:"$(objective_before)",objective_target:"$(objective_target)"}}}
            block { with storage minecraft:universal ability.rig
                $scoreboard players operation @n[$(target)] $(objective_target) = @s $(objective_before)
            }
        }
    }

    dir restraint {
        function cooldown {
            # function universal:ability/restraint/cooldown {move:1,name:"Billy"}
            $execute unless entity @s[tag=abilitySettings.DisabledCooldowns] run scoreboard players operation @s universalAbility.MoveCooldown$(move) = .$(name)Cooldown universalAbility.MoveCooldown$(move)
        }

        function cancelable {
            # function universal:ability/restraint/cancelable {move:1}
            tag @s add universalAbility.ModifierCancelable
            $scoreboard players set @s universalAbility.MovePrevious $(move)
        }
    }

    dir revoke {
        function cancelable {
            # function universal:ability/revoke/cancelable {player:"abilityBilly.User"}
            $data merge storage minecraft:universal {ability:{revoke:{player:"$(player)"}}}
            execute store result storage minecraft:universal ability.revoke.id int 1 run scoreboard players get @s universalAbility.ID
            block { with storage minecraft:universal ability.revoke
                $execute as @p[tag=$(player),scores={universalAbility.ID=$(id)}] at @s run {
                    tag @s remove universalAbility.ModifierCancelable
                    scoreboard players reset @s universalAbility.MovePrevious
                }
            }
        }
    }
}

dir attribute {
    function grant {
        # function universal:attribute/grant {type:"minecraft:movement_speed",path:"ability:billy.encourage",strength:0.25,operation:"add_multiplied_base"}
        # OPERATION TYPES #
            # add_multiplied_base
            # add_multiplied_total
            # add_value
        # OPTIONAL ARGUMENTS #
            # data merge storage minecraft:universal {attribute:{scenario:"Ability",objective:"abilityBilly.EncourageBuff",duration:60,extra:"tag @s add scenarioTick.AbilityBilly"}}
        $attribute @s $(type) modifier add $(path) $(strength) $(operation)
        execute if data storage minecraft:universal attribute run block { with storage minecraft:universal attribute
            $scoreboard players set @s $(objective) $(duration)
            $function universal:math/multiply {value:20,score:"@s",objective:"$(objective)"}
            tag @s add scenarioTick.Enable
            $tag @s add scenarioTick.$(scenario)
            execute if data storage minecraft:universal attribute.extra run block { with storage minecraft:universal attribute
                $$(extra)
            }
        }
        data remove storage minecraft:universal attribute
    }

    function revoke {
        # function universal:attribute/revoke {type:"minecraft:movement_speed",path:"ability:billy.encourage"}
        $attribute @s $(type) modifier remove $(path)
    }
}

dir error_messages {
    function constant {
        execute if entity @s[tag=customGojo.RidingBlue] run function custom:universal/error_messages/find {error:100}
        execute if entity @s[tag=customGojo.InfiniteVoided] run function custom:universal/error_messages/find {error:101}
        execute if entity @s[tag=customTheWorld.TimeLocked] run function custom:universal/error_messages/find {error:102}
        execute if score @s customTheWorld.BarrageStun matches 1.. run function custom:universal/error_messages/find {error:103}
    }

    function setup {
        # function universal:error_messages/setup {id:1}
        $tag @s add universalError.$(id)
        scoreboard players set @s universalError.FailReturn 1
    }

    function fail {
        $data merge storage minecraft:universal {error:{name:"$(name)",unicode:"$(unicode)"}}
        $execute store result storage minecraft:universal error.cooldown double 0.05 run scoreboard players get @s universalAbility.MoveCooldown$(move)
        execute unless entity @s[tag=universalError.Hide] run block { with storage minecraft:universal error
            $tellraw @s ["",{"text":"\n\$(unicode) ","color":"white"},{"text":" $(name)","color":"gold"}]
            $execute if entity @s[tag=universalError.1] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" On cooldown for","color":"gray"},{"text":" $(cooldown)","color":"red"},{"text":"s","color":"red"}]
            execute if entity @s[tag=universalError.2] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" Another move is ","color":"gray"},{"text":"currently casting!","color":"blue"}]
            # execute if entity @s[tag=universalError.3] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" This move is ","color":"gray"},{"text":"BANNED ","color":"red"},{"text":"in the ","color":"gray"},{"text":"Pocket Dimension","color":"red"}]
            # execute if entity @s[tag=universalError.4] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"be looking at an entity to use ","color":"gray"},{"text":"this ","color":"aqua"},{"text":"move!","color":"gray"}]
