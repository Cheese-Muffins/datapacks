function on_load minecraft:load{
    scoreboard objectives add cassettePlay.Last dummy
    scoreboard objectives add cassettePlay.Duration dummy
    scoreboard objectives add cassettePlay.ID dummy
    scoreboard objectives add cassettePlay.FeedbackStyle dummy
    scoreboard objectives add cassettePlay.Incremental dummy
    scoreboard objectives add cassettePlay.MaxDuration dummy

    # Party #
    scoreboard objectives add cassetteParty.Disconnected dummy

    # Error #
    scoreboard objectives add cassetteError.Delay dummy
}

dir tick {
    function main {
        scoreboard players operation .Previous cassetteParty.Disconnected = .Players cassetteParty.Disconnected
        execute store result score .Players cassetteParty.Disconnected if entity @a[tag=customCassette.PartyUser]
        execute if score .Previous cassetteParty.Disconnected > .Players cassetteParty.Disconnected run function ui:cassette/party/disconnect/main

        execute unless entity @s[scores={cassetteError.Delay=0}] run {
            execute if score @s cassetteError.Delay matches 1.. run scoreboard players remove @s cassetteError.Delay 1
        }
        
        execute at @s run function cassette:award/challenge/main
        execute if entity @s[tag=cassettePlayed.Song] run function cassette:playing/main

        execute if score @s cassetteParty.Disconnected matches 1.. run function ui:cassette/party/reconnect
    }
}

dir playing {
    function main {
        scoreboard players add @s cassettePlay.Duration 1
        execute if score @s cassettePlay.Duration matches 1..60 run function cassette:playing/text_display
        # execute if score @s cassettePlay.Duration matches 61 run title @s actionbar ""
        execute if score @s cassettePlay.Duration >= @s cassettePlay.MaxDuration run {
            # play styles
            function ui:cassette/menu/play/main
        }
    }

    function text_display {
        execute store result storage minecraft:custom cassette.play.lookup int 1 run scoreboard players get @s cassettePlay.ID
        block { with storage minecraft:custom cassette.play
            $data modify storage minecraft:custom cassette.play merge from storage minecraft:custom cassette.index.$(lookup)
        }
        data modify storage minecraft:custom cassette.play.display_name set value [""]
        data modify storage minecraft:custom cassette.play.display_name append from storage minecraft:custom cassette.play.name[]
        data remove storage minecraft:custom cassette.play.display_name[].color
        execute if score @s cassettePlay.Duration matches 1 run data modify storage minecraft:custom cassette.play.display_color set value "red"
        execute if score @s cassettePlay.Duration matches 2 run data modify storage minecraft:custom cassette.play.display_color set value "#ff5e4c"
        execute if score @s cassettePlay.Duration matches 3 run data modify storage minecraft:custom cassette.play.display_color set value "#ff6842"
        execute if score @s cassettePlay.Duration matches 4 run data modify storage minecraft:custom cassette.play.display_color set value "#ff7139"
        execute if score @s cassettePlay.Duration matches 5 run data modify storage minecraft:custom cassette.play.display_color set value "#ff7b2f"
        execute if score @s cassettePlay.Duration matches 6 run data modify storage minecraft:custom cassette.play.display_color set value "#ff8426"
        execute if score @s cassettePlay.Duration matches 7 run data modify storage minecraft:custom cassette.play.display_color set value "#ff8e1c"
        execute if score @s cassettePlay.Duration matches 8 run data modify storage minecraft:custom cassette.play.display_color set value "#ff9713"
        execute if score @s cassettePlay.Duration matches 9 run data modify storage minecraft:custom cassette.play.display_color set value "#ffa109"
        execute if score @s cassettePlay.Duration matches 10 run data modify storage minecraft:custom cassette.play.display_color set value "gold"
        execute if score @s cassettePlay.Duration matches 11 run data modify storage minecraft:custom cassette.play.display_color set value "gold"
        execute if score @s cassettePlay.Duration matches 12 run data modify storage minecraft:custom cassette.play.display_color set value "#ffb309"
        execute if score @s cassettePlay.Duration matches 13 run data modify storage minecraft:custom cassette.play.display_color set value "#ffbd13"
        execute if score @s cassettePlay.Duration matches 14 run data modify storage minecraft:custom cassette.play.display_color set value "#ffc61c"
        execute if score @s cassettePlay.Duration matches 15 run data modify storage minecraft:custom cassette.play.display_color set value "#ffd026"
        execute if score @s cassettePlay.Duration matches 16 run data modify storage minecraft:custom cassette.play.display_color set value "#ffd92f"
        execute if score @s cassettePlay.Duration matches 17 run data modify storage minecraft:custom cassette.play.display_color set value "#ffe339"
        execute if score @s cassettePlay.Duration matches 18 run data modify storage minecraft:custom cassette.play.display_color set value "#ffec42"
        execute if score @s cassettePlay.Duration matches 19 run data modify storage minecraft:custom cassette.play.display_color set value "#fff64c"
        execute if score @s cassettePlay.Duration matches 20 run data modify storage minecraft:custom cassette.play.display_color set value "yellow"
        execute if score @s cassettePlay.Duration matches 21 run data modify storage minecraft:custom cassette.play.display_color set value "yellow"
        execute if score @s cassettePlay.Duration matches 22 run data modify storage minecraft:custom cassette.play.display_color set value "#ecff55"
        execute if score @s cassettePlay.Duration matches 23 run data modify storage minecraft:custom cassette.play.display_color set value "#d9ff55"
        execute if score @s cassettePlay.Duration matches 24 run data modify storage minecraft:custom cassette.play.display_color set value "#c6ff55"
        execute if score @s cassettePlay.Duration matches 25 run data modify storage minecraft:custom cassette.play.display_color set value "#b3ff55"
