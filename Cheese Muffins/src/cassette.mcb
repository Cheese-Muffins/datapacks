    # generate special data #
    <%%
    const fs = require("fs");
    const source = fs.readFileSync("src/cassette.mcb", "utf8");

    const start = source.indexOf("function generate_index");
    const end = source.indexOf("# BONUS SONGS!!!", start);
    const songIndexSource = source.slice(start, end);

    const byId = new Map();

    for (const match of songIndexSource.matchAll(/^\s*#\s*0*(\d+)\s*-\s*(.+?)(?:\s*#)?\s*$/gm)) {
        const id = Number(match[1]);
        const name = match[2].trim();

        if (id >= 1 && id <= 105) {
            byId.set(id, { id, name, artist: "???" });
        }
    }

    for (const match of songIndexSource.matchAll(/index:\{(\d+):\{artist:"((?:\\"|[^"])*)"/g)) {
        const id = Number(match[1]);
        const song = byId.get(id);

        if (song) {
            song.artist = match[2].replace(/\\"/g, '"');
        }
    }

    const compareText = (a, b) => a.localeCompare(b, undefined, {
        sensitivity: "base",
        numeric: true
    });

    const compareUnknownLast = (a, b, key) => {
        const aUnknown = a[key] === "???";
        const bUnknown = b[key] === "???";

        if (aUnknown && !bUnknown) return 1;
        if (!aUnknown && bUnknown) return -1;

        return compareText(a[key], b[key]);
    };

    const songs = [...byId.values()];

    const alphabetical = [...songs].sort((a, b) =>
        compareUnknownLast(a, b, "name")
    );

    const artist = [...songs].sort((a, b) => {
        const artistResult = compareUnknownLast(a, b, "artist");

        if (artistResult !== 0) {
            return artistResult;
        }

        return compareUnknownLast(a, b, "name");
    });

    const emitOrder = (path, list) => {
        emit(`data remove storage minecraft:cassette index.${path}`);

        for (let i = 0; i < list.length; i++) {
            emit(`data merge storage minecraft:cassette {index:{${path}:{${i + 1}:{id:${list[i].id}}}}}`);
        }
    };

    emit(`scoreboard players set .alphabeticalTotal uiCassette.CollectionBroad ${alphabetical.length}`);
    emit(`scoreboard players set .artistTotal uiCassette.CollectionBroad ${artist.length}`);
    emitOrder("alphabetical", alphabetical);
    emitOrder("artist", artist);
    %%>


    # BONUS SONGS!!! #

    # 106 - Vanilla Bundle #
    data merge storage minecraft:cassette {index:{106:{artist:"Minecraft",duration:0,rating:4,song_id:106}}}
    data merge storage minecraft:cassette {index:{106:{name:[{"text":"Vanilla Bundle","italic":false,"color":"green"}]}}}
    data merge storage minecraft:cassette {index:{106:{obtainment:[{"text":"i dont know","italic":false,"color":"gray"}]}}}

