                        particle dust{color:[0.478,0.000,0.478],scale:1} ~0.5 ~0.5 ~0.5 0 0 0 0 1 force
                    }
                }
            }
        }

        function slay_zombie {
            scoreboard players add @s cassetteChallenge.DefeatZombies 1
            execute if score @s cassetteChallenge.DefeatZombies matches 100.. run function cassette:award/give {id:24}
            advancement revoke @s only cassette:challenge/slay_zombie
        }

        function come_as_you_are {
            tag @s add scenarioTick.Enable
            tag @s add scenarioTick.Cassette
            tag @s add cassetteChallenge.ComeAsYouAre
        }

        function dealt_damage {
            execute if entity @s[tag=cassetteChallenge.ComeAsYouAre] run function cassette:tick/scenario/come_as_you_are/fail
            advancement revoke @s only cassette:challenge/dealt_damage
        }

        function hammer {
            tag @s add scenarioTick.Enable
            tag @s add scenarioTick.Cassette
            tag @s add cassetteChallenge.Hammer
            execute store result score @s cassetteChallenge.HammerRotationX run data get entity @s Rotation[0] 10
            execute store result score @s cassetteChallenge.HammerRotationY run data get entity @s Rotation[1] 10
            scoreboard players reset @s cassetteChallenge.UsedAnvil
        }

        function hurt_by_anvil {
            execute if entity @s[tag=cassetteChallenge.Hammer] unless entity @s[tag=cassetteUnlocked.Song38] run function cassette:award/give {id:38}
            advancement revoke @s only cassette:challenge/hurt_by_anvil
        }

        function slay_monster_night {
            scoreboard players add @s cassetteChallenge.SlayMonsterNight 1
            execute if score @s cassetteChallenge.SlayMonsterNight matches 500.. unless entity @s[tag=cassetteUnlocked.Song44] run function cassette:award/give {id:44}
        }

        function slay_spiderjockey {
            tag @s add cassetteChallenge.KilledSpiderJockey
            advancement revoke @s only cassette:challenge/slay_spiderjockey
        }
    }

    function give {
        $block { with storage minecraft:cassette index.$(id)
            $playsound $(sfx) player @s ~ ~ ~
            $tellraw @a ["",{"selector":"@s"},{"text":" has collected the cassette "},{"text":"","color":"$(targeted_color)","extra":$(built_announce_name),"hover_event":{"action":"show_text","value":$(built_hover)}}]
            $give @s minecraft:phantom_membrane[lore=$(built_lore),item_name=$(name),food={nutrition:0,saturation:0,can_always_eat:1b},consumable={consume_seconds:999999},max_stack_size=1,item_model="minecraft:cassettes/$(song_id)",custom_model_data={floats:[0]},custom_data={cassette_tape:1b,id:$(song_id)}]
        }
        $tag @s add cassetteUnlocked.Song$(id)
    }

    function summon {
        $block { with storage minecraft:cassette index.$(id)
            $summon item ~ ~ ~ {Item:{id:"minecraft:phantom_membrane",count:1,components:{"minecraft:item_name":$(name),"minecraft:food":{nutrition:0,saturation:0,can_always_eat:true},"minecraft:consumable":{consume_seconds:999999},"minecraft:max_stack_size":1,"minecraft:item_model":"minecraft:cassettes/$(song_id)","minecraft:custom_model_data":{floats:[0]},"minecraft:custom_data":{cassette_tape:1b,id:$(song_id)},"minecraft:lore":$(built_lore)}}}
        }
        $tag @s add cassetteUnlocked.Song$(id)
    }

    function announce {
        $data modify storage minecraft:cassette fetch merge from storage minecraft:cassette index.$(id)
        block { with storage minecraft:cassette fetch
            $playsound $(sfx) player @s ~ ~ ~
            $tellraw @a ["",{"selector":"@s"},{"text":" has collected the cassette "},{"text":"","color":"$(targeted_color)","extra":$(built_announce_name),"hover_event":{"action":"show_text","value":$(built_hover)}}]
        }
        $tag @s add cassetteUnlocked.Song$(id)
    }
}

dir playing {
    function main {
        scoreboard players add @s cassettePlay.Duration 1
        execute if score @s cassettePlay.Duration matches 1..60 run function cassette:playing/text_display
        # execute if score @s cassettePlay.Duration matches 61 run title @s actionbar ""
        execute if score @s cassettePlay.Duration >= @s cassettePlay.MaxDuration run {
            # play styles
            function ui:cassette/menu/play/main
        }
    }

    function text_display {
        execute store result storage minecraft:cassette play.lookup int 1 run scoreboard players get @s cassettePlay.ID
        block { with storage minecraft:cassette play
            $data modify storage minecraft:cassette play merge from storage minecraft:cassette index.$(lookup)
        }
        data modify storage minecraft:cassette play.display_name set value [""]
        data modify storage minecraft:cassette play.display_name append from storage minecraft:cassette play.name[]
        data remove storage minecraft:cassette play.display_name[].color
        execute if score @s cassettePlay.Duration matches 1 run data modify storage minecraft:cassette play.display_color set value "red"
        execute if score @s cassettePlay.Duration matches 2 run data modify storage minecraft:cassette play.display_color set value "#ff5e4c"
        execute if score @s cassettePlay.Duration matches 3 run data modify storage minecraft:cassette play.display_color set value "#ff6842"
