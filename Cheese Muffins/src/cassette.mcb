        execute if score @s cassettePlay.Duration matches 46 run data modify storage minecraft:custom cassette.play.display_color set value "#b355ff"
        execute if score @s cassettePlay.Duration matches 47 run data modify storage minecraft:custom cassette.play.display_color set value "#c655ff"
        execute if score @s cassettePlay.Duration matches 48 run data modify storage minecraft:custom cassette.play.display_color set value "#d955ff"
        execute if score @s cassettePlay.Duration matches 49 run data modify storage minecraft:custom cassette.play.display_color set value "#ec55ff"
        execute if score @s cassettePlay.Duration matches 50 run data modify storage minecraft:custom cassette.play.display_color set value "light_purple"
        execute if score @s cassettePlay.Duration matches 51 run data modify storage minecraft:custom cassette.play.display_color set value "light_purple"
        execute if score @s cassettePlay.Duration matches 52 run data modify storage minecraft:custom cassette.play.display_color set value "#f64cf6"
        execute if score @s cassettePlay.Duration matches 53 run data modify storage minecraft:custom cassette.play.display_color set value "#ec42ec"
        execute if score @s cassettePlay.Duration matches 54 run data modify storage minecraft:custom cassette.play.display_color set value "#e339e3"
        execute if score @s cassettePlay.Duration matches 55 run data modify storage minecraft:custom cassette.play.display_color set value "#d92fd9"
        execute if score @s cassettePlay.Duration matches 56 run data modify storage minecraft:custom cassette.play.display_color set value "#d026d0"
        execute if score @s cassettePlay.Duration matches 57 run data modify storage minecraft:custom cassette.play.display_color set value "#c61cc6"
        execute if score @s cassettePlay.Duration matches 58 run data modify storage minecraft:custom cassette.play.display_color set value "#bd13bd"
        execute if score @s cassettePlay.Duration matches 59 run data modify storage minecraft:custom cassette.play.display_color set value "#b309b3"
        execute if score @s cassettePlay.Duration matches 60 run data modify storage minecraft:custom cassette.play.display_color set value "dark_purple"
        function cassette:playing/color_hue with storage minecraft:custom cassette.play
    }

    function color_hue {
        $title @s actionbar ["",{"text":"Now Playing: ","color":"$(display_color)"},{"text":"","color":"$(display_color)","extra":$(display_name)},{"text":" - $(artist)","color":"$(display_color)"}]
    }
}