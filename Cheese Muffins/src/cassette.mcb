        execute if score @s cassettePlay.Duration matches 33 run data modify storage minecraft:custom cassette.play.display_color set value "#55d97b"
        execute if score @s cassettePlay.Duration matches 34 run data modify storage minecraft:custom cassette.play.display_color set value "#55c68e"
        execute if score @s cassettePlay.Duration matches 35 run data modify storage minecraft:custom cassette.play.display_color set value "#55b3a1"
        execute if score @s cassettePlay.Duration matches 36 run data modify storage minecraft:custom cassette.play.display_color set value "#55a1b3"
        execute if score @s cassettePlay.Duration matches 37 run data modify storage minecraft:custom cassette.play.display_color set value "#558ec6"
        execute if score @s cassettePlay.Duration matches 38 run data modify storage minecraft:custom cassette.play.display_color set value "#557bd9"
        execute if score @s cassettePlay.Duration matches 39 run data modify storage minecraft:custom cassette.play.display_color set value "#5568ec"
        execute if score @s cassettePlay.Duration matches 40 run data modify storage minecraft:custom cassette.play.display_color set value "blue"
