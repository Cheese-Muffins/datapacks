    data merge storage minecraft:cassette {index:{107:{name:[{"text":"I Want It That Way","italic":false,"color":"blue"}]}}}
    data merge storage minecraft:cassette {index:{107:{obtainment:[{"text":"i dont know","italic":false,"color":"gray"}]}}}





    # VANILLA BUNDLE!!!! #

