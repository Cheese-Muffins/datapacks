    data merge storage minecraft:cassette {index:{122:{obtainment:[{"text":"V","italic":false,"color":"gray"}]}}}

    REPEAT (1,135) as i {
        function cassette:calculate/data with storage minecraft:cassette index.<%i%>
    }
}