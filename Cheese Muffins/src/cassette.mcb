        execute if score @s cassettePlay.Duration matches 57 run data modify storage minecraft:cassette play.display_color set value "#c61cc6"
        execute if score @s cassettePlay.Duration matches 58 run data modify storage minecraft:cassette play.display_color set value "#bd13bd"
        execute if score @s cassettePlay.Duration matches 59 run data modify storage minecraft:cassette play.display_color set value "#b309b3"
        execute if score @s cassettePlay.Duration matches 60 run data modify storage minecraft:cassette play.display_color set value "dark_purple"
        function cassette:playing/color_hue with storage minecraft:cassette play
    }

    function color_hue {
        $title @s actionbar ["",{"text":"Now Playing: ","color":"$(display_color)"},{"text":"","color":"$(display_color)","extra":$(display_name)},{"text":" - $(artist)","color":"$(display_color)"}]
    }
}

dir calculate {
    function data {
        $function cassette:calculate/rating with storage minecraft:cassette index.$(song_id)
        $function cassette:calculate/lore with storage minecraft:cassette index.$(song_id)
        $function cassette:calculate/hover with storage minecraft:cassette index.$(song_id)
        $function cassette:calculate/real_time with storage minecraft:cassette index.$(song_id)
    }

    function rating {
        $scoreboard players set .Rating uiCassette.CollectionBroad $(rating)
        $execute if score .Rating uiCassette.CollectionBroad matches 0 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"",rating2:"⭐⭐⭐⭐",rating_color:"light_purple"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 1 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"⭐",rating2:"⭐⭐⭐",rating_color:"light_purple"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 2 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"⭐⭐",rating2:"⭐⭐",rating_color:"light_purple"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 3 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"⭐⭐⭐",rating2:"⭐",rating_color:"light_purple"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 4 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"⭐⭐⭐⭐",rating2:"",rating_color:"light_purple"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 5 run data merge storage minecraft:cassette {index:{$(song_id):{rating1:"⭐⭐⭐⭐⭐",rating2:"",rating_color:"yellow"}}}
    }

    function lore {
        $data remove storage minecraft:cassette index.$(song_id).built_lore
        $data modify storage minecraft:cassette index.$(song_id).built_lore set value []

        $data modify storage minecraft:cassette index.$(song_id).built_lore append value ["",{"text":"$(artist) ","italic":false,"color":"gray"},{"text":"$(rating1)","italic":false,"color":"$(rating_color)"},{"text":"$(rating2)","italic":false,"color":"gray"}]

        $execute unless score .incrementIndex uiCassette.CollectionBroad matches 121.. run block { with storage minecraft:cassette index.$(song_id)
            $data modify storage minecraft:cassette index.$(song_id).built_lore append value ""

            $data modify storage minecraft:cassette index.$(song_id).built_lore append value ["",{"text":"Obtainment","italic":false,"color":"gold"}]
            REPEAT (0,20) as i {
                $data modify storage minecraft:cassette index.$(song_id).built_lore append from storage minecraft:cassette index.$(song_id).obtainment[<%i%>]
            }
        }
    }

    function hover {
        $data remove storage minecraft:cassette index.$(song_id).built_hover

        $execute if score .Rating uiCassette.CollectionBroad matches 0..2 run data merge storage minecraft:cassette {index:{$(song_id):{targeted_color:"green",sfx:"minecraft:cassette.award.easy"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 3..4 run data merge storage minecraft:cassette {index:{$(song_id):{targeted_color:"dark_purple",sfx:"minecraft:cassette.award.medium"}}}
        $execute if score .Rating uiCassette.CollectionBroad matches 5 run data merge storage minecraft:cassette {index:{$(song_id):{targeted_color:"yellow",sfx:"minecraft:cassette.award.hard"}}}

        $block { with storage minecraft:cassette index.$(song_id)
            $data modify storage minecraft:cassette index.$(song_id).built_hover set value [""]
            $data modify storage minecraft:cassette index.$(song_id).built_hover append from storage minecraft:cassette index.$(song_id).name[]
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value "\n"
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value {"text":"$(artist) ","italic":false,"color":"gray"}
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value {"text":"$(rating1)","italic":false,"color":"$(rating_color)"}
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value {"text":"$(rating2)","italic":false,"color":"gray"}
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value "\n"
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value "\n"
            $data modify storage minecraft:cassette index.$(song_id).built_hover append value {"text":"Obtainment","italic":false,"color":"gold"}

            $data modify storage minecraft:cassette index.$(song_id).built_announce_name set value [{"text":"","italic":false,"color":"$(targeted_color)"},{"text":"["}]
            $data modify storage minecraft:cassette index.$(song_id).built_announce_name append from storage minecraft:cassette index.$(song_id).name[]
            $data modify storage minecraft:cassette index.$(song_id).built_announce_name append value {"text":"]"}

            $data remove storage minecraft:cassette index.$(song_id).built_announce_name[].color
            $data modify storage minecraft:cassette index.$(song_id).built_announce_name[0].color set value "$(targeted_color)"
        }

        REPEAT (0,20) as i {
            $execute if data storage minecraft:cassette index.$(song_id).obtainment[<%i%>] run block { with storage minecraft:cassette index.$(song_id)
                $data modify storage minecraft:cassette index.$(song_id).built_hover append value "\n"
                $data modify storage minecraft:cassette index.$(song_id).built_hover append from storage minecraft:cassette index.$(song_id).obtainment[<%i%>]
            }
        }
    }

    function real_time {
        $execute store result storage minecraft:cassette index.$(song_id).real_duration int 20 run data get storage minecraft:cassette index.$(song_id).duration
    }
}

function generate_index {
    # 1 - YOUSEEBIGGIRL/T:T
    data merge storage minecraft:cassette {index:{1:{artist:"Hiroyuki Sawano",duration:163,rating:1,song_id:1}}}
    data merge storage minecraft:cassette {index:{1:{name:[{"text":"YOU","italic":false,"color":"#ecbd5f"},{"text":"SEEB","italic":false,"color":"#ffe7b3"},{"text":"IG","italic":false,"color":"#ffe7b3"},{"text":"GIRL","italic":false,"color":"#ecbd5f"},{"text":"/","italic":false,"color":"gray"},{"text":"T","italic":false,"color":"#ecbd5f"},{"text":":","italic":false,"color":"#ffe7b3"},{"text":"T","italic":false,"color":"#ecbd5f"}]}}}
    data merge storage minecraft:cassette {index:{1:{obtainment:[[{"text":"Complete the Advancement(s): ","italic":false,"color":"gray"},{"text":"[","italic":false,"color":"dark_purple"},{"text":"We Need to Go Deeper","italic":false,"color":"light_purple"},{"text":"]","italic":false,"color":"dark_purple"}]]}}}

    # 2 - Fallen Kingdom
    data merge storage minecraft:cassette {index:{2:{artist:"TryHardNinja",duration:254,rating:3,song_id:2}}}
