function on_load minecraft:load{
    scoreboard objectives add traitShrinkray.Size dummy
	scoreboard objectives add traitShrinkray.Frame dummy
	scoreboard objectives add traitShrinkray.Duration dummy
}

dir tick {
	dir scenario {
		function index {
			execute if entity @s[tag=scenarioTick.TraitShrinkray] run function trait:tick/scenario/shrinkray

            execute if entity @s[tag=!scenarioTick.TraitShrinkray] run tag @s remove scenarioTick.Trait
		}

		function shrinkray {
			scoreboard players remove @s traitShrinkray.Duration 1
			execute unless score @s traitShrinkray.Duration matches 1.. run {
				execute if score @s traitShrinkray.Size matches 1 run function trait:index/shrink/reset
				execute if score @s traitShrinkray.Size matches 2 run function trait:index/grow/reset
				tag @s remove scenarioTick.TraitShrinkray

				function trait:size/change
			}
		}
	}
}

function apply {
	# function trait:apply {args:{type:"shrink",proper:"Shrinkray",duration:"infinite"}}
	$data modify storage minecraft:trait args merge value $(args)
	block { with storage minecraft:trait args
		$function trait:index/$(type)/setup with storage minecraft:trait args
		execute unless data storage minecraft:trait args{duration:"infinite"} run block { with storage minecraft:trait args
			$scoreboard players set @s trait$(proper).Duration $(duration)
			$function universal:math/multiply {value:20,score:"@s",objective:"trait$(proper).Duration"}

			tag @s add scenarioTick.Enable
			tag @s add scenarioTick.Trait
			$tag @s add scenarioTick.Trait$(proper)
		}
	}
}

dir index {
	dir shrink {
		function setup {
			execute if score @s traitShrinkray.Size matches 2 run function trait:index/grow/reset
			attribute @s minecraft:scale modifier add trait:ability/shrinkray -0.75 add_multiplied_total
			attribute @s minecraft:movement_speed modifier add trait:ability/shrinkray 0.15 add_multiplied_total
			attribute @s minecraft:safe_fall_distance modifier add trait:ability/shrinkray -0.33 add_multiplied_total
			attribute @s minecraft:max_health modifier add trait:ability/shrinkray -0.2 add_multiplied_total
			attribute @s minecraft:block_interaction_range modifier add trait:ability/shrinkray -0.33 add_multiplied_total
			attribute @s minecraft:entity_interaction_range modifier add trait:ability/shrinkray -0.33 add_multiplied_total

			scoreboard players set @s traitShrinkray.Size 1
			function trait:size/change
		}

		function reset {
			attribute @s minecraft:scale modifier remove trait:ability/shrinkray
			attribute @s minecraft:movement_speed modifier remove trait:ability/shrinkray
			attribute @s minecraft:safe_fall_distance modifier remove trait:ability/shrinkray
			attribute @s minecraft:max_health modifier remove trait:ability/shrinkray
			attribute @s minecraft:block_interaction_range modifier remove trait:ability/shrinkray
			attribute @s minecraft:entity_interaction_range modifier remove trait:ability/shrinkray
			scoreboard players reset @s traitShrinkray.Size
		}
	}

	dir grow {
		function setup {
			execute if score @s traitShrinkray.Size matches 1 run function trait:index/shrink/reset
			attribute @s minecraft:scale modifier add trait:ability/shrinkray 0.5 add_multiplied_total
			attribute @s minecraft:movement_speed modifier add trait:ability/shrinkray -0.15 add_multiplied_total
			attribute @s minecraft:safe_fall_distance modifier add trait:ability/shrinkray 0.5 add_multiplied_total
			attribute @s minecraft:max_health modifier add trait:ability/shrinkray 0.2 add_multiplied_total
			attribute @s minecraft:block_interaction_range modifier add trait:ability/shrinkray 0.33 add_multiplied_total
			attribute @s minecraft:entity_interaction_range modifier add trait:ability/shrinkray 0.33 add_multiplied_total
			attribute @s minecraft:jump_strength modifier add trait:ability/shrinkray 0.5 add_multiplied_total
			attribute @s minecraft:step_height modifier add trait:ability/shrinkray 1 add_multiplied_total 

			scoreboard players set @s traitShrinkray.Size 2
			function trait:size/change
		}

		function reset {
			attribute @s minecraft:scale modifier remove trait:ability/shrinkray
			attribute @s minecraft:movement_speed modifier remove trait:ability/shrinkray
			attribute @s minecraft:safe_fall_distance modifier remove trait:ability/shrinkray
			attribute @s minecraft:max_health modifier remove trait:ability/shrinkray
			attribute @s minecraft:block_interaction_range modifier remove trait:ability/shrinkray
			attribute @s minecraft:entity_interaction_range modifier remove trait:ability/shrinkray
			attribute @s minecraft:jump_strength modifier remove trait:ability/shrinkray
			attribute @s minecraft:step_height modifier remove trait:ability/shrinkray
			scoreboard players reset @s traitShrinkray.Size
		}
	}
}

dir size {
	function change {
		execute if score @s universalAbility.ToggleState matches 1 run {
			execute store result storage minecraft:trait size.id int 1 run scoreboard players get @s universalAbility.ID
			execute store result storage minecraft:trait size.mode int 1 run scoreboard players get @s traitShrinkray.Size
			execute store result storage minecraft:trait size.equipped_id int 1 run scoreboard players get @s universalAbility.EquippedID
			block { with storage minecraft:trait size
				$data modify storage minecraft:trait size.path set from storage minecraft:ability index.$(equipped_id).path
				block { with storage minecraft:trait size
					$execute as @n[type=minecraft:item_display,tag=aj.$(path).root,scores={universalAbility.ID=$(id)}] run block { with storage minecraft:trait size
						scoreboard players operation .currentSize traitShrinkray.Size = @s traitShrinkray.Size
						$scoreboard players set @s traitShrinkray.Size $(mode)
						$execute store result score @s traitShrinkray.Frame run function aj:$(path)/animations/get_frame_by_id

						# 0 = default
						# 1 = small
						# 2 = large
						# for the default size being changed
						execute if score .currentSize traitShrinkray.Size matches 0 run function trait:size/calculate/default
						execute if score .currentSize traitShrinkray.Size matches 1 run function trait:size/calculate/small
						execute if score .currentSize traitShrinkray.Size matches 2 run function trait:size/calculate/large
						execute store result storage minecraft:trait size.frame int 1 run scoreboard players get @s traitShrinkray.Frame

						$execute unless score @s traitShrinkray.Size matches 1.. run function aj:$(path)/animations/play_by_id
						$execute if score @s traitShrinkray.Size matches 1 run function aj:$(path)/animations/shrink_by_id
						$execute if score @s traitShrinkray.Size matches 2 run function aj:$(path)/animations/grow_by_id

						block { with storage minecraft:trait size
							$function aj:$(path)/animations/set_frame_by_id {frame:$(frame)}
						}
					}
					scoreboard players reset .currentSize traitShrinkray.Size
				}
			}
		}
	}

	dir calculate {
		function default {
			execute if score @s traitShrinkray.Size matches 1 run {
				function universal:math/multiply {value:100,score:"@s",objective:"traitShrinkray.Frame"}
				function universal:math/divide {value:200,score:"@s",objective:"traitShrinkray.Frame"}
			}
			execute if score @s traitShrinkray.Size matches 2 run {
				function universal:math/multiply {value:500,score:"@s",objective:"traitShrinkray.Frame"}
				function universal:math/divide {value:400,score:"@s",objective:"traitShrinkray.Frame"}
			}
		}

		function small {
			execute if score @s traitShrinkray.Size matches 0 run {
				function universal:math/multiply {value:150,score:"@s",objective:"traitShrinkray.Frame"}
				function universal:math/divide {value:100,score:"@s",objective:"traitShrinkray.Frame"}
			}
			execute if score @s traitShrinkray.Size matches 2 run function universal:math/multiply {value:2,score:"@s",objective:"traitShrinkray.Frame"}
		}

		function large {
			execute if score @s traitShrinkray.Size matches 0 run {
				function universal:math/multiply {value:150,score:"@s",objective:"traitShrinkray.Frame"}
				function universal:math/divide {value:200,score:"@s",objective:"traitShrinkray.Frame"}
			}
			execute if score @s traitShrinkray.Size matches 1 run function universal:math/divide {value:2,score:"@s",objective:"traitShrinkray.Frame"}
		}
	}
}