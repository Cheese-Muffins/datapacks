function on_load minecraft:load{
    # typically all abilities will use these variables
    
    function ability:generate/index
    function ability:billy/install
    function ability:yuji/install
    function ability:president/install
}

dir tick {
    function player {
        execute if entity @s[tag=abilityBilly.User] run function ability:billy/tick/main
        execute if entity @s[tag=abilityYuji.User] run function ability:yuji/tick/main
    }

    dir scenario {
        function index {
            execute if entity @s[tag=scenarioTick.AbilityBilly] run function ability:billy/tick/scenario/core
            execute if entity @s[tag=scenarioTick.AbilityYuji] run function ability:yuji/tick/scenario/core

            execute if entity @s[tag=!scenarioTick.AbilityBilly,tag=!scenarioTick.AbilityYuji] run tag @s remove scenarioTick.Ability
        }
    }
}

dir billy {
    dir tick {
        function main {
            execute if score @s universalAbility.ToggleState matches 1 unless score @s universalAbility.ToggleDelay matches 1.. run function ability:billy/active

            REPEAT (1,3) as i {
                execute at @s if score @s universalAbility.MoveTrigger<%i%> matches 1.. run {
                    scoreboard players reset @s universalAbility.MoveTrigger<%i%>
                    execute if score @s universalAbility.ToggleState matches 1 unless score @s universalAbility.ToggleDelay matches 1.. unless score @s universalAbility.MoveDelay matches 1.. run function ability:billy/moves/<%i%>/core
                }
            }

            execute unless entity @s[scores={universalAbility.MoveCooldown1=0,universalAbility.MoveCooldown2=0,universalAbility.MoveCooldown3=0,universalAbility.MoveDelay=0,universalAbility.ToggleDelay=0,abilityBilly.ToggleOnText=0}] unless entity @s[tag=traitIndex.TimeLocked] run {
                REPEAT (1,3) as i {
                    execute if score @s universalAbility.MoveCooldown<%i%> matches 1.. run scoreboard players remove @s universalAbility.MoveCooldown<%i%> 1
                }

                execute if score @s abilityBilly.ToggleOnText matches 1.. run {
                    function ability:billy/toggle/text

                    scoreboard players remove @s abilityBilly.ToggleOnText 1
                }

                execute if score @s universalAbility.ToggleDelay matches 1.. run scoreboard players remove @s universalAbility.ToggleDelay 1
                execute if score @s universalAbility.MoveDelay matches 1.. run scoreboard players remove @s universalAbility.MoveDelay 1
            }
        }

        dir scenario {
            function core {
                execute if score @s abilityBilly.EncourageBuff matches 1.. run function ability:billy/tick/scenario/encourage

                execute unless entity @s[scores={abilityBilly.EncourageBuff=1..}] run tag @s remove scenarioTick.AbilityBilly
            }

            function encourage {
                scoreboard players remove @s abilityBilly.EncourageBuff 1
                execute if score @s abilityBilly.EncourageBuff matches 0 run {
                    function universal:attribute/revoke {type:"minecraft:movement_speed",path:"ability:billy.encourage"}
                    function universal:attribute/revoke {type:"minecraft:jump_strength",path:"ability:billy.encourage"}
                    scoreboard players reset @s abilityBilly.EncourageBuff
                }
            }
        }
    }

    function install {
        scoreboard objectives add abilityBilly.DiscoveredInteractions dummy
        scoreboard objectives add abilityBilly.UnlockedSkins dummy
        scoreboard objectives add abilityBilly.FlagID dummy
        scoreboard objectives add abilityBilly.ToggleOnText dummy
        scoreboard objectives add abilityBilly.EncourageBuff dummy
        scoreboard objectives add abilityBilly.PhaseDisconnectX dummy
        scoreboard objectives add abilityBilly.PhaseDisconnectY dummy
        scoreboard objectives add abilityBilly.PhaseDisconnectZ dummy


        function universal:ability/setup/cooldown/8x {name:"Billy",storage:"billy",path:"1a",move:1,cooldown:30}
        function universal:ability/setup/cooldown/8x {name:"Billy_Homeland",storage:"billy",path:"1b",move:1,cooldown:30}
        
        function universal:ability/setup/cooldown/8x {name:"Billy",storage:"billy",path:"2a",move:2,cooldown:30}
        function universal:ability/setup/cooldown/8x {name:"Billy",storage:"billy",path:"3a",move:3,cooldown:30}
    }

    function active {
        function ability:billy/hotbar/main

        execute unless entity @s[tag=abilityBilly.FlagOverride] run function ability:billy/flags/index
    }

    dir moves {
        function setup {
            $data merge storage minecraft:ability {billy:{setup:{rig:'$(rig)',animation:'$(animation)'}}}
            execute store result storage minecraft:ability billy.setup.id int 1 run scoreboard players get @s universalAbility.ID
            block { with storage minecraft:ability billy.setup
                $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={universalAbility.ID=$(id)}] run block { with storage minecraft:ability billy.setup
                    $function aj:billy/animations/$(animation)/play
                }
            }
            tag @s add abilityBilly.FlagOverride
            function ability:billy/flags/clear
        }

        dir 1 {
            function core {
                execute if score @s universalAbility.MoveCooldown1 matches 1.. run function universal:error_messages/setup {id:1}
                execute if entity @s[tag=universalAbility.Animating] run function universal:error_messages/setup {id:2}
                function universal:error_messages/constant

                scoreboard players set @s universalAbility.HotbarSlot 1
                execute unless score @s universalError.FailReturn matches 1 run function ability:billy/moves/1/pass
                execute if score @s universalError.FailReturn matches 1 run function universal:error_messages/fail {move:1,name:"Encourage",unicode:"u50A1"}
            }

            function pass {
                # setup
                function ability:billy/moves/setup {rig:"billy",animation:'encourage'}

                # restraints
                function universal:ability/restraint/cooldown {move:1,name:"Billy"}
                function universal:ability/restraint/cancelable {move:1}
                tag @s add universalAbility.Animating
            }

            function encourage {
                data modify storage minecraft:universal vfx.arguments.branch set value "billy"
                data modify storage minecraft:universal vfx.arguments.animation set value "encourage"
                data modify storage minecraft:universal vfx.arguments.output set value "ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.mouth]"
                function universal:vfx/spawn with storage minecraft:universal vfx.arguments
            }

            function range {
                data modify storage minecraft:universal vfx.arguments.branch set value "billy"
                data modify storage minecraft:universal vfx.arguments.animation set value "range"
                function universal:vfx/spawn with storage minecraft:universal vfx.arguments
            }

            function buff {
                execute at @s as @a[distance=..4] run {
                    data merge storage minecraft:universal {attribute:{scenario:"Ability",objective:"abilityBilly.EncourageBuff",duration:60,extra:"tag @s add scenarioTick.AbilityBilly"}}
                    function universal:attribute/grant {type:"minecraft:movement_speed",path:"ability:billy.encourage",strength:0.25,operation:"add_multiplied_base"}
                    function universal:attribute/grant {type:"minecraft:jump_strength",path:"ability:billy.encourage",strength:0.5,operation:"add_multiplied_base"}
                    effect give @s minecraft:haste 60 1 true
                }
            }
        }

        dir 2 {
            function core {
                execute if score @s universalAbility.MoveCooldown2 matches 1.. run function universal:error_messages/setup {id:1}
                execute if entity @s[tag=universalAbility.Animating] run function universal:error_messages/setup {id:2}
                function universal:error_messages/constant

                scoreboard players set @s universalAbility.HotbarSlot 2
                execute unless score @s universalError.FailReturn matches 1 run function ability:billy/moves/2/pass
                execute if score @s universalError.FailReturn matches 1 run function universal:error_messages/fail {move:2,name:"Phase",unicode:"u50A1"}
            }

            function pass {
                # setup
                function ability:billy/moves/setup {rig:"billy",animation:'phase'}

                # restraints
                function universal:ability/restraint/cooldown {move:1,name:"Billy"}
                tag @s add universalAbility.Animating

                # specific
                execute store result score @s abilityBilly.PhaseDisconnectX run data get entity @s Pos[0] 1
                execute store result score @s abilityBilly.PhaseDisconnectY run data get entity @s Pos[1] 1
                execute store result score @s abilityBilly.PhaseDisconnectZ run data get entity @s Pos[2] 1

                execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
                block { with storage minecraft:ability billy
                    $tp @n[type=minecraft:item_display,tag=aj.billy.root,scores={universalAbility.ID=$(id)}] ~ ~ ~
                }


                gamemode spectator @s
                function universal:ability/rig/dismount {rig:"billy",objective:"universalAbility.ID"}
                function universal:ability/rig/spectate_camera {camera:"aj.billy.camera",objective:"universalAbility.ID"}
            }
        }

        dir 3 {
            function core {
                scoreboard players set @s universalAbility.HotbarSlot 3
            }
        }

        dir reset {
            function all {
                function universal:ability/rig/as_player {player:"abilityBilly.User",objective:"universalAbility.ID",output:"function ability:billy/moves/reset/player"}
                function ability:billy/moves/reset/rig
            }

            function rig {

            }

            function player {
                function universal:ability/revoke/cancelable {player:"abilityBilly.User"}
                tag @s remove abilityBilly.FlagOverride
                tag @s remove universalAbility.Animating
            }
        }
    }

    dir hotbar {
        function main {
            REPEAT (1,3) as i {
                execute unless entity @s[tag=abilityBilly.PassiveHomeland] run function ability:billy/hotbar/progress with storage minecraft:ability billy.cooldown.move<%i%>a
                execute if entity @s[tag=abilityBilly.PassiveHomeland] run function ability:billy/hotbar/progress with storage minecraft:ability billy.cooldown.move<%i%>b
            }
            
            REPEAT (1,3) as i {
                execute if score @s universalAbility.HotbarSlot matches <%i%> run {
                    function universal:hotbar/time {ability:"billy",slot:<%i%>}
                }
            }

            execute if score @s universalAbility.HotbarSlot matches 1 run block { with storage minecraft:ability billy.hotbar
                $title @s actionbar [{"text":"\uF895\u05A0\uF85F"},{"text":"\uF867\$(move1)"},{"text":"\uF863\$(move2)"},{"text":"\uF863\$(move3)"},{"text":"\uF862\u05A1"},{"text":"\uF86C\u01A0"},{"text":"\uF84A$(time)","color":"yellow"}]
            }

            execute if score @s universalAbility.HotbarSlot matches 2 run block { with storage minecraft:ability billy.hotbar
                $title @s actionbar [{"text":"\uF895\u05A0\uF85F"},{"text":"\uF867\$(move1)"},{"text":"\uF863\$(move2)"},{"text":"\uF863\$(move3)"},{"text":"\uF862\u05A1"},{"text":"\uF86C\u01A0"},{"text":"\uF84A$(time)","color":"yellow"}]
            }

            execute if score @s universalAbility.HotbarSlot matches 3 run block { with storage minecraft:ability billy.hotbar
                $title @s actionbar [{"text":"\uF895\u05A0\uF85F"},{"text":"\uF867\$(move1)"},{"text":"\uF863\$(move2)"},{"text":"\uF863\$(move3)"},{"text":"\uF862\u05A1"},{"text":"\uF86C\u01A0"},{"text":"\uF84A$(time)","color":"yellow"}]
            }
        }

        function progress {
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A2"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A3"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A4"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A5"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A6"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A7"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A8"
            $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05A9"
            $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability billy.hotbar.move$(slot) set value "u05B0"
        }
    }

    dir toggle {
        function on {
            execute rotated ~ 0 run function aj:billy/summon {args:{animation: 'summon', start_animation: true}}
                
            execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
            execute as @n[type=minecraft:item_display,tag=aj.billy.root] unless score @s universalAbility.ID matches 1.. run block { with storage minecraft:ability billy
                $scoreboard players set @s universalAbility.ID $(id)
            }

            function universal:ability/rig/mount/player {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
            function universal:ability/rig/visibility {target:"aj.billy.root",objective:"universalAbility.ID",state:"disable",perspective:"inline_perspective",mounted:"hide_passengers"}
            function universal:ability/rig/pair {target:"type=minecraft:item_display,tag=aj.billy.locator.text_location",objective_before:"universalAbility.ID",objective_target:"universalAbility.ID"}
            function universal:ability/rig/pair {target:"type=minecraft:item_display,tag=aj.billy.camera",objective_before:"universalAbility.ID",objective_target:"universalAbility.ID"}

            tag @s add universalAbility.HideUI
            scoreboard players set @s universalAbility.ToggleDelay 40
        }

        function appear {
            data modify storage minecraft:universal vfx.arguments.branch set value "billy"
            data modify storage minecraft:universal vfx.arguments.animation set value "appear"
            data modify storage minecraft:universal vfx.arguments.output set value "ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.position]"
            function universal:vfx/spawn with storage minecraft:universal vfx.arguments
        }

        function land {
            execute positioned ~ ~-1 ~ run function universal:fetch/block {storage:"minecraft:ability",path:"billy.toggle.land"}
            block { with storage minecraft:ability billy.toggle
                $particle block{block_state:"$(id)"} ^ ^0.5 ^0.25 0.75 0 0.75 1 50 normal
                particle minecraft:snowflake ~ ~ ~ 0 0 0 0.25 50 force @a
            }
        }

        function text {
            execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
            execute if score @s abilityBilly.ToggleOnText matches 54 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"red","italic":false,"text":"Billy"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 44 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"gold","italic":false,"text":"Demetrius"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 35 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"yellow","italic":false,"text":"Demarcus"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 25 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"green","italic":false,"text":"Bartholomew"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 15 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"blue","italic":false,"text":"James"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 8 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"light_purple","italic":false,"text":"the"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }

            execute if score @s abilityBilly.ToggleOnText matches 1 run block { with storage minecraft:ability billy
                $data merge storage minecraft:universal {ability:{rig:{text:{arguments:{animation:"billy",text:{"color":"dark_purple","italic":false,"text":"III"},output:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={universalAbility.ID=$(id)}]"}}}}}
                function universal:ability/rig/text with storage minecraft:universal ability.rig.text.arguments
            }
        }

        function off {
            title @s actionbar ""
            execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
            block { with storage minecraft:ability billy
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={universalAbility.ID=$(id)}] at @s run {
                    playsound minecraft:entity.polar_bear.death player @a ~ ~ ~ 0.5
                    function aj:billy/animations/idle/stop
                    function aj:billy/animations/withdraw/play
                }
            }
            scoreboard players reset @s abilityBilly.ToggleOnText
            scoreboard players set @s universalAbility.ToggleDelay 20 
        }
    }

    dir flags {
        function index {
            execute unless entity @s[tag=abilityBilly.FlagJump] run {
                execute if predicate universal:flags/walk unless predicate universal:flags/sprint unless entity @s[tag=abilityBilly.FlagWalk] run function ability:billy/flags/setup {type:"walk",animation:"Walk",variation:1}
                execute if predicate universal:flags/sprint unless entity @s[tag=abilityBilly.FlagSprint] run function ability:billy/flags/setup {type:"sprint",animation:"Sprint",variation:2}
                execute if predicate universal:flags/jump unless predicate universal:flags/flying run function ability:billy/flags/setup {type:"jump",animation:"Jump",variation:3}
            }
            execute if entity @s[tag=abilityBilly.FlagJump] run {
                execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
                block { with storage minecraft:ability billy
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={universalAbility.ID=$(id)}] run {
                        function universal:ability/rig/rotate {user:"abilityBilly.User",rig:"billy",objective:"universalAbility.ID"}
                    }
                }

                execute unless entity @s[tag=abilityBilly.FlagLanding] run function ability:billy/flags/jump/falling
            }

            execute unless predicate universal:flags/walk unless predicate universal:flags/sprint unless entity @s[tag=abilityBilly.FlagIdle] unless entity @s[tag=abilityBilly.FlagJump] run function ability:billy/flags/setup {type:"idle",animation:"Idle",variation:4}
        }

        function setup {
            $data merge storage minecraft:ability {billy:{type:"$(type)",adjust:1,tween:3}}
            $scoreboard players set @s abilityBilly.FlagID $(variation)

            block { with storage minecraft:ability billy
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={universalAbility.ID=$(id)}] rotated as @p[tag=abilityBilly.User,scores={universalAbility.ID=$(id)}] run block { with storage minecraft:ability billy
                    $function aj:billy/animations/$(type)/tween {to_frame:$(adjust),duration:$(tween)}
                }
            }

            function ability:billy/flags/clear
            $tag @s add abilityBilly.Flag$(animation)
        }

        dir jump {
            function falling {
                execute if predicate universal:flags/flying run function ability:billy/flags/jump/land
                execute if predicate universal:flags/grounded run function ability:billy/flags/jump/land 
            }

            function land {
                tag @s add abilityBilly.FlagLanding

                execute store result storage minecraft:ability billy.id int 1 run scoreboard players get @s universalAbility.ID
                block { with storage minecraft:ability billy
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={universalAbility.ID=$(id)}] run {
                        function aj:billy/animations/jump/tween {to_frame:6,duration:1}
                    }
                }
            }

            function end {
                tag @s remove abilityBilly.FlagLanding
                tag @s remove abilityBilly.FlagJump
            }
        }

        function clear {
            tag @s remove abilityBilly.FlagWalk
            tag @s remove abilityBilly.FlagSprint
            tag @s remove abilityBilly.FlagIdle
        }

        # function adjust {
        #     tag @s remove temp
        #     $data merge storage minecraft:ability {billy:{tween:"$(tween)"}}
        #     $execute as @n[type=minecraft:item_display,tag=aj.eren.root,scores={universalAbility.ID=$(id)}] run block { {objective:"$(objective)"}
        #         $scoreboard players add @s aj.$(objective).frame 2
        #         $execute store result storage minecraft:ability billy.adjust int 1 run scoreboard players get @s aj.$(objective).frame
        #     }
        # }
    }
}

dir yuji {
    dir tick {
        function main {
            execute if score @s universalAbility.ToggleState matches 1 run function ability:yuji/active
            REPEAT (1,3) as i {
                execute at @s if score @s universalAbility.MoveTrigger<%i%> matches 1.. run {
                    scoreboard players reset @s universalAbility.MoveTrigger<%i%>
                    execute if score @s universalAbility.ToggleState matches 1 unless score @s universalAbility.ToggleDelay matches 1.. unless score @s universalAbility.MoveDelay matches 1.. run function ability:yuji/moves/<%i%>/core
                }
            }

            execute unless entity @s[scores={universalAbility.MoveCooldown1=0,universalAbility.MoveCooldown2=0,universalAbility.MoveCooldown3=0,universalAbility.MoveDelay=0,universalAbility.ToggleDelay=0}] unless entity @s[tag=traitIndex.TimeLocked] run {
                REPEAT (1,3) as i {
                    execute if score @s universalAbility.MoveCooldown<%i%> matches 1.. run scoreboard players remove @s universalAbility.MoveCooldown<%i%> 1
                }

                execute if score @s universalAbility.ToggleDelay matches 1.. run scoreboard players remove @s universalAbility.ToggleDelay 1
                execute if score @s universalAbility.MoveDelay matches 1.. run scoreboard players remove @s universalAbility.MoveDelay 1
            }
        }

        dir scenario {
            function core {
                execute if score @s abilityYuji.NaturalTalentBuff matches 1.. run function ability:yuji/tick/scenario/natural_talent

                execute unless entity @s[scores={abilityYuji.NaturalTalentBuff=1..}] run tag @s remove scenarioTick.AbilityYuji
            }

            function natural_talent {
                scoreboard players remove @s abilityYuji.NaturalTalentBuff 1
                execute if score @s abilityYuji.NaturalTalentBuff matches 0 run {
                    function universal:attribute/revoke {type:"minecraft:movement_speed",path:"ability:yuji.natural_talent"}
                    function universal:attribute/revoke {type:"minecraft:jump_strength",path:"ability:yuji.natural_talent"}
                    scoreboard players reset @s abilityYuji.NaturalTalentBuff
                }
            }
        }
    }

    function install {
        scoreboard objectives add abilityYuji.NaturalTalentBuff dummy

        function universal:ability/setup/cooldown/10x {name:"Yuji",storage:"yuji",path:"1a",move:1,cooldown:30}
        function universal:ability/setup/cooldown/10x {name:"Sukuna_King",storage:"yuji",path:"1b",move:1,cooldown:30}
        function universal:ability/setup/cooldown/10x {name:"Sukuna_Fuga",storage:"yuji",path:"1c",move:1,cooldown:30}
        
        function universal:ability/setup/cooldown/10x {name:"Yuji",storage:"yuji",path:"2a",move:2,cooldown:30}
        function universal:ability/setup/cooldown/10x {name:"Sukuna",storage:"yuji",path:"2b",move:2,cooldown:30}

        function universal:ability/setup/cooldown/10x {name:"Yuji",storage:"yuji",path:"3a",move:3,cooldown:30}
        function universal:ability/setup/cooldown/10x {name:"Sukuna",storage:"yuji",path:"3b",move:3,cooldown:30}

        function universal:ability/setup/cooldown/10x {name:"Yuji",storage:"yuji",path:"4a",move:4,cooldown:30}
        function universal:ability/setup/cooldown/10x {name:"Sukuna",storage:"yuji",path:"4b",move:4,cooldown:30}
    }

    function active {
        function ability:yuji/hotbar/main
    }

    dir moves {
        function setup {
            $execute rotated ~ 0 run function aj:yuji/summon {args:{animation: '$(animation)', start_animation: true}}
                
            execute store result storage minecraft:ability yuji.id int 1 run scoreboard players get @s universalAbility.ID
            execute as @n[type=minecraft:item_display,tag=aj.yuji.root] unless score @s universalAbility.ID matches 1.. run block { with storage minecraft:ability yuji
                $scoreboard players set @s universalAbility.ID $(id)
            }

            visibility disable @s @a ignore_perspective render_passengers
            function universal:ability/rig/stable_player_display/main {branch:"yuji"}
            function universal:ability/rig/mount/player {user:"abilityYuji.User",rig:"yuji",objective:"universalAbility.ID"}
            function universal:ability/rig/visibility {target:"aj.yuji.root",objective:"universalAbility.ID",state:"disable",perspective:"inline_perspective",mounted:"hide_passengers"}
            function universal:ability/rig/pair {target:"type=minecraft:item_display,tag=aj.yuji.camera",objective_before:"universalAbility.ID",objective_target:"universalAbility.ID"}
        }

        dir 1 {
            function core {
                execute if score @s universalAbility.MoveCooldown1 matches 1.. run function universal:error_messages/setup {id:1}
                execute if entity @s[tag=universalAbility.Animating] run function universal:error_messages/setup {id:2}
                function universal:error_messages/constant

                scoreboard players set @s universalAbility.HotbarSlot 1
                execute unless score @s universalError.FailReturn matches 1 run function ability:yuji/moves/1/pass
                execute if score @s universalError.FailReturn matches 1 run function universal:error_messages/fail {move:1,name:"Natural Talent",unicode:"u50A1"}
            }

            function pass {
                # setup
                function ability:yuji/moves/setup {rig:"yuji",animation:'natural_talent'}

                # restraints
                function universal:ability/restraint/cooldown {name:"Yuji",move:1}
                function universal:ability/restraint/cancelable {move:1}
                tag @s add universalAbility.Animating
            }

            function buff {
                data merge storage minecraft:universal {attribute:{scenario:"Ability",objective:"abilityYuji.NaturalTalentBuff",duration:60,extra:"tag @s add scenarioTick.AbilityYuji"}}
                function universal:attribute/grant {type:"minecraft:movement_speed",path:"ability:yuji.natural_talent",strength:0.25,operation:"add_multiplied_base"}
                function universal:attribute/grant {type:"minecraft:jump_strength",path:"ability:yuji.natural_talent",strength:0.5,operation:"add_multiplied_base"}
                effect give @s minecraft:haste 60 1 true
            }
        }

        dir reset {
            function all {
                function universal:ability/rig/as_player {player:"abilityYuji.User",objective:"universalAbility.ID",output:"function ability:yuji/moves/reset/player"}
                function ability:yuji/moves/reset/rig
            }

            function rig {
                function aj:yuji/remove/all
            }

            function player {
                visibility enable @s @a
                function universal:ability/revoke/cancelable {player:"abilityBilly.User"}
                tag @s remove universalAbility.Animating
            }
        }
    }

    dir hotbar {
        function main {
            function ability:yuji/hotbar/meter with storage minecraft:ability yuji.awakening

            # base mode
            execute unless entity @s[tag=abilityYuji.SukunaAwakening] run {
                function ability:yuji/hotbar/slot/1 with storage minecraft:ability yuji.cooldown.move1a
                function ability:yuji/hotbar/slot/2 with storage minecraft:ability yuji.cooldown.move2a
                function ability:yuji/hotbar/slot/3a with storage minecraft:ability yuji.cooldown.move3a

                # scoreboard players operation @s customUniversal.Move1Cooldown = @s customYuji.SplitMove1Natural_Talent
                # scoreboard players operation @s customUniversal.Move2Cooldown = @s customYuji.SplitMove2Majin_Kick
                # scoreboard players operation @s customUniversal.Move3Cooldown = @s customYuji.SplitMove3Black_Flash_Assault

                REPEAT (1,3) as i {
                    execute if score @s universalAbility.HotbarSlot matches <%i%> run {
                        function universal:hotbar/time {ability:"yuji",slot:<%i%>}
                    }
                }

                block { with storage minecraft:ability yuji.hotbar
                    $title @s actionbar [{"text":"\uF869\uF895\u02A0"},{"text":"\uF87C\uF84C"},{"text":"\uF863\$(move1)"},{"text":"\uF863\$(move2)"},{"text":"\uF863\$(move3)"},{"text":"\uF828\$(awakening)"},{"text":"\uF867\u02A1"},{"text":"\uF86C\u01A0"},{"text":"\uF84A$(time)","color":"yellow"}]
                }
            }

            # sukuna mode
            execute if entity @s[tag=abilityYuji.SukunaAwakening] run {
                scoreboard players operation @s customUniversal.Move1Cooldown = @s customYuji.SplitMove1King_of_Curses
                scoreboard players operation @s customUniversal.Move2Cooldown = @s customYuji.SplitMove2Cleave
                scoreboard players operation @s customUniversal.Move3Cooldown = @s customYuji.SplitMove3Dismantle
                function custom:abilities/yuji/hotbar/slot/1 with storage minecraft:custom yuji.cooldowns.move1b
                function custom:abilities/yuji/hotbar/slot/2 with storage minecraft:custom yuji.cooldowns.move2b
                function custom:abilities/yuji/hotbar/slot/3b with storage minecraft:custom yuji.cooldowns.move3b
                function custom:abilities/yuji/hotbar/slot/4 with storage minecraft:custom yuji.cooldowns.move4

                REPEAT (1,3) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"yuji",selected:<%i%>}
                    }
                }

                block { with storage minecraft:custom yuji.hotbar
                    $title @s actionbar [{"text":"\uF820\uF807\u02A0"},{"text":"\uF839\uF816"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF840\$(awakening)"},{"text":"\uF841\u02A1"},{"text":"\uF806\u02A3"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }
        }

        dir slot {
            function 1 {
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(10a)..$(11) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D1"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D2"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D3"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D4"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D5"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D6"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D7"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D8"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02D9"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E0"
                $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E1"
            }

            function 2 {
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(10a)..$(11) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E2"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E3"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E4"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E5"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E6"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E7"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E8"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02E9"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F0"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F1"
                $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F2"
            }

            function 3a {
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(10a)..$(11) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F3"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F4"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F5"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F6"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F7"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F8"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u02F9"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0200"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0201"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0202"
                $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0203"
            }

            function 3b {
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(10a)..$(11) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0204"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0205"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0206"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0207"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0208"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0209"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0210"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0211"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0212"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0213"
                $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0214"
            }

            function 4 {
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(10a)..$(11) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0215"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0216"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0217"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0218"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0219"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0220"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0221"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0222"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0223"
                $execute if score @s universalAbility.MoveCooldown$(slot) matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0224"
                $execute unless score @s universalAbility.MoveCooldown$(slot) matches 1.. run data modify storage minecraft:ability yuji.hotbar.move$(slot) set value "u0225"
            }
        }

        function meter {
            $execute if score @s universalAbility.AwakeningDuration matches $(15a)..$(16) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B9"
            $execute if score @s universalAbility.AwakeningDuration matches $(14a)..$(15b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B8"
            $execute if score @s universalAbility.AwakeningDuration matches $(13a)..$(14b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B7"
            $execute if score @s universalAbility.AwakeningDuration matches $(12a)..$(13b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B6"
            $execute if score @s universalAbility.AwakeningDuration matches $(11a)..$(12b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B5"
            $execute if score @s universalAbility.AwakeningDuration matches $(10a)..$(11b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B4"
            $execute if score @s universalAbility.AwakeningDuration matches $(9a)..$(10b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B3"
            $execute if score @s universalAbility.AwakeningDuration matches $(8a)..$(9b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B2"
            $execute if score @s universalAbility.AwakeningDuration matches $(7a)..$(8b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B1"
            $execute if score @s universalAbility.AwakeningDuration matches $(6a)..$(7b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02B0"
            $execute if score @s universalAbility.AwakeningDuration matches $(5a)..$(6b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A9"
            $execute if score @s universalAbility.AwakeningDuration matches $(4a)..$(5b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A8"
            $execute if score @s universalAbility.AwakeningDuration matches $(3a)..$(4b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A7"
            $execute if score @s universalAbility.AwakeningDuration matches $(2a)..$(3b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A6"
            $execute if score @s universalAbility.AwakeningDuration matches $(1)..$(2b) run data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A5"
            execute unless score @s universalAbility.AwakeningDuration matches 1.. run {
                data modify storage minecraft:ability yuji.hotbar.awakening set value "u02A4"
                tag @s remove abilityYuji.SukunaAwakening
            }
        }
    }

    dir toggle {
        function on {
            playsound minecraft:ability.yuji.toggle_on player @s ~ ~ ~ 1
            scoreboard players set @s universalAbility.ToggleDelay 10
        }

        function off {
            title @s actionbar ""
            playsound minecraft:ability.yuji.toggle_off player @s ~ ~ ~ 0.5

            scoreboard players set @s universalAbility.ToggleDelay 10
        }
    }
}

dir president {
    function install {
        scoreboard objectives add abilityPresident.DiscoveredInteractions dummy
        scoreboard objectives add abilityPresident.UnlockedSkins dummy
    }
}

dir generate {
    function data {
        $function ability:generate/ratings with storage minecraft:ability index.$(ability_id)
        $function ui:generate/move/main {ability_id:$(ability_id)}
    }

    function ratings {
        # obtainment
        $scoreboard players set .ObtainmentRating uiAbility.SelectionBroad $(obtainment_rating_raw)
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 0 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"",obtainment_rating_2:"⭐⭐⭐⭐⭐",obtainment_rating_color:"light_purple"}}}
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 1 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"⭐",obtainment_rating_2:"⭐⭐⭐⭐",obtainment_rating_color:"light_purple"}}}
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 2 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"⭐⭐",obtainment_rating_2:"⭐⭐⭐",obtainment_rating_color:"light_purple"}}}
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 3 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"⭐⭐⭐",obtainment_rating_2:"⭐⭐",obtainment_rating_color:"light_purple"}}}
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 4 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"⭐⭐⭐⭐",obtainment_rating_2:"⭐",obtainment_rating_color:"light_purple"}}}
        $execute if score .ObtainmentRating uiAbility.SelectionBroad matches 5 run data merge storage minecraft:ability {index:{$(ability_id):{obtainment_rating_1:"⭐⭐⭐⭐⭐",obtainment_rating_2:"",obtainment_rating_color:"yellow"}}}

        # versatility
        $scoreboard players set .VersatilityRating uiAbility.SelectionBroad $(versatility_rating_raw)
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 0 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"",versatility_rating_2:"⭐⭐⭐⭐⭐",versatility_rating_color:"light_purple"}}}
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 1 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"⭐",versatility_rating_2:"⭐⭐⭐⭐",versatility_rating_color:"light_purple"}}}
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 2 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"⭐⭐",versatility_rating_2:"⭐⭐⭐",versatility_rating_color:"light_purple"}}}
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 3 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"⭐⭐⭐",versatility_rating_2:"⭐⭐",versatility_rating_color:"light_purple"}}}
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 4 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"⭐⭐⭐⭐",versatility_rating_2:"⭐",versatility_rating_color:"light_purple"}}}
        $execute if score .VersatilityRating uiAbility.SelectionBroad matches 5 run data merge storage minecraft:ability {index:{$(ability_id):{versatility_rating_1:"⭐⭐⭐⭐⭐",versatility_rating_2:"",versatility_rating_color:"yellow"}}}

        # difficulty
        $scoreboard players set .DifficultyRating uiAbility.SelectionBroad $(difficulty_rating_raw)
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 0 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"",difficulty_rating_2:"⭐⭐⭐⭐⭐",difficulty_rating_color:"light_purple"}}}
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 1 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"⭐",difficulty_rating_2:"⭐⭐⭐⭐",difficulty_rating_color:"light_purple"}}}
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 2 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"⭐⭐",difficulty_rating_2:"⭐⭐⭐",difficulty_rating_color:"light_purple"}}}
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 3 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"⭐⭐⭐",difficulty_rating_2:"⭐⭐",difficulty_rating_color:"light_purple"}}}
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 4 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"⭐⭐⭐⭐",difficulty_rating_2:"⭐",difficulty_rating_color:"light_purple"}}}
        $execute if score .DifficultyRating uiAbility.SelectionBroad matches 5 run data merge storage minecraft:ability {index:{$(ability_id):{difficulty_rating_1:"⭐⭐⭐⭐⭐",difficulty_rating_2:"",difficulty_rating_color:"yellow"}}}
    }

    function death_message {
        data remove storage minecraft:ui generate.death_message
        data modify storage minecraft:ui generate.death_message set value {}

        $data modify storage minecraft:ui generate.death_message.ability set value "$(ability)"
        $data modify storage minecraft:ui generate.death_message.move set value $(move)
        $data modify storage minecraft:ui generate.death_message.variation set value $(variation)

        block { with storage minecraft:ui generate.death_message
            data modify storage minecraft:ui generate.death_message.lore set value []

            $data modify storage minecraft:ui generate.death_message.lore append from storage minecraft:ability index.$(ability).moveset.slot$(move).move$(variation).description[]

            data modify storage minecraft:ui generate.death_message.lore append value ""

            $execute store result score .cooldownRaw uiAbility.Moveset run data get storage minecraft:ability index.$(ability).moveset.slot$(move).move$(variation).cooldown

            scoreboard players operation .cooldownMinutes uiAbility.Moveset = .cooldownRaw uiAbility.Moveset
            scoreboard players operation .cooldownSeconds uiAbility.Moveset = .cooldownRaw uiAbility.Moveset

            function universal:math/divide {value:60,score:".cooldownMinutes",objective:"uiAbility.Moveset"}
            function universal:math/modulo {value:60,score:".cooldownSeconds",objective:"uiAbility.Moveset"}

            execute store result storage minecraft:ui generate.death_message.cooldown_minutes int 1 run scoreboard players get .cooldownMinutes uiAbility.Moveset
            execute store result storage minecraft:ui generate.death_message.cooldown_seconds int 1 run scoreboard players get .cooldownSeconds uiAbility.Moveset

            data modify storage minecraft:ui generate.death_message.lore append value ["",{"text":"Cooldown: ","italic":false,"color":"gray"}]

            execute if score .cooldownMinutes uiAbility.Moveset matches 1.. run block { with storage minecraft:ui generate.death_message
                $data modify storage minecraft:ui generate.death_message.lore[-1] append value ["",{"text":"$(cooldown_minutes)m ","italic":false,"color":"#ffca0a"}]
            }

            execute if score .cooldownSeconds uiAbility.Moveset matches 1.. run block { with storage minecraft:ui generate.death_message
                $data modify storage minecraft:ui generate.death_message.lore[-1] append value ["",{"text":"$(cooldown_seconds)s","italic":false,"color":"#ffca0a"}]
            }

            scoreboard players reset .cooldownMinutes uiAbility.Moveset
            scoreboard players reset .cooldownSeconds uiAbility.Moveset
            scoreboard players reset .cooldownRaw uiAbility.Moveset

            data modify storage minecraft:ui generate.death_message.cancelable_text set value "Yes"
            data modify storage minecraft:ui generate.death_message.cancelable_color set value "990000"

            $execute if data storage minecraft:ability index.$(ability).moveset.slot$(move).move$(variation){cancelable:false} run data modify storage minecraft:ui generate.death_message.cancelable_text set value "No"
            $execute if data storage minecraft:ability index.$(ability).moveset.slot$(move).move$(variation){cancelable:false} run data modify storage minecraft:ui generate.death_message.cancelable_color set value "00ff40"

            block { with storage minecraft:ui generate.death_message
                $data modify storage minecraft:ui generate.death_message.lore append value ["",{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"$(cancelable_text)","italic":false,"color":"#$(cancelable_color)"}]
            }

            $data modify storage minecraft:ability index.$(ability).moveset.slot$(move).move$(variation).generated set from storage minecraft:ui generate.death_message.lore
        }
    }

