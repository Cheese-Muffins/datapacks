                                $execute if score @s uiCassette.CollectionOperation matches 3 if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] run data merge storage minecraft:ui {cassette:{collection:{slot$(number)_overlay:3}}}
                            }
