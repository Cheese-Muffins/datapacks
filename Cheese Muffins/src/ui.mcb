function on_load minecraft:load{
    scoreboard objectives add uiLogic.Broad dummy
    scoreboard objectives add uiLogic.ID dummy
    scoreboard objectives add uiLogic.CurrentHotbar dummy
    scoreboard objectives add uiLogic.PreviousHotbar dummy

    # Collection #
    scoreboard objectives add uiCassette.CollectionSort dummy
    scoreboard objectives add uiCassette.CollectionBroad dummy

    # Settings #
    scoreboard objectives add uiCassette.SettingsTargeting dummy
    scoreboard objectives add uiCassette.SettingsFeedback dummy
    scoreboard objectives add uiCassette.SettingsParty dummy
}

dir logic {
    dir player {
        function tick {
            execute if items entity @s weapon.* *[minecraft:custom_data~{custom_ui:1b}] run function ui:logic/player/teleport
            execute unless items entity @s weapon.* *[minecraft:custom_data~{custom_ui:1b}] if score @s uiLogic.ID matches 0.. run function ui:logic/player/close
        }

        function teleport {
            function ui:logic/player/check_swap
            execute if items entity @s weapon.* *[minecraft:custom_data~{ability_tome:1b}] unless score @s uiLogic.ID matches 0.. run function ui:logic/player/ability_open
            execute if items entity @s weapon.* *[minecraft:custom_data~{cassette_player:1b}] unless score @s uiLogic.ID matches 0.. run function ui:logic/player/cassette_open

            scoreboard players operation #search uiLogic.ID = @s uiLogic.ID
            execute at @s as @e[type=minecraft:item_display,tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run tp @s ~ ~1 ~
        }

        function ability_open {
            summon minecraft:item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}
            execute as @n[type=minecraft:item_display,tag=new] run visibility disable @s @a

            scoreboard players add .global uiLogic.ID 1
            scoreboard players operation @s uiLogic.ID = .global uiLogic.ID
            scoreboard players operation @e[tag=new] uiLogic.ID = .global uiLogic.ID

            scoreboard players set .type uiLogic.Broad 1
            execute as @e[type=minecraft:chest_minecart,tag=new] run {
                function ui:ability/menu/open
                function ui:logic/minecart/load_page
            }
            tag @e remove new
        }

        function cassette_open {
            summon item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}
            execute as @n[type=minecraft:item_display,tag=new] run visibility disable @s @a

            scoreboard players add .global uiLogic.ID 1
            scoreboard players operation @s uiLogic.ID = .global uiLogic.ID
            scoreboard players operation @e[tag=new] uiLogic.ID = .global uiLogic.ID

            scoreboard players set .type uiLogic.Broad 1
            execute as @e[type=minecraft:chest_minecart,tag=new] run {
                function ui:cassette/menu/open
                function ui:logic/minecart/load_page
            }
            tag @e remove new
        }

        function check_swap {
            execute store result score @s uiLogic.CurrentHotbar run data get entity @s SelectedItemSlot
            execute unless score @s uiLogic.CurrentHotbar = @s uiLogic.PreviousHotbar if score @s uiLogic.ID matches 0.. run function ui:logic/player/close
            execute store result score @s uiLogic.PreviousHotbar run data get entity @s SelectedItemSlot
        }

        function return {
            data remove block 0 -64 0 Items
            data modify block 0 -64 0 Items set from storage ui in
            loot give @s mine 0 -64 0 stick[minecraft:custom_data={drop_contents:1b}]
            item replace block 0 -64 0 container.0 with air
            data remove storage minecraft:ui current
            data remove storage minecraft:ui in
        }

        function close {
            scoreboard players operation #search uiLogic.ID = @s uiLogic.ID
            execute as @e[type=minecraft:chest_minecart,tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run data remove entity @s Items
            execute as @e[tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run kill @s
            scoreboard players reset @s uiLogic.ID
            function ui:logic/minecart/cleanup
        }
    }

    dir minecart {
        function tick {
            data modify storage ui current set from entity @s Items
            execute on passengers run data modify storage ui previous set from entity @s data.previous
            
            execute on passengers store result score #bool uiLogic.Broad run data modify entity @s data.previous set from storage ui current

            execute if score #bool uiLogic.Broad matches 1 run function ui:logic/minecart/on_change
        }

        function on_change {
            # broad button links
            execute at @s as @p run {
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/menu/pages/cassettes/settings/default/flip
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_cassettes
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_cassettes

                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main

                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main

                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{purchaseable_item:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/shop

                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/menu/pages/abilities/settings/default/flip
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_abilities
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_abilities

                scoreboard players reset @s[tag=!customUI.TempClick] customUI.PurchaseConfirm
                tag @s remove customUI.TempClick
            }

            clear @a *[minecraft:custom_data~{ui_item:{}}]
            kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{ui_item:{}}}}}]

            # hopper flow prevention
            execute positioned ~ ~-1 ~ run {
                execute positioned ~1 ~ ~ if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~ if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~ ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~ ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper

                execute positioned ~1 ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~1 ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
            }

            data remove storage minecraft:ui custom
            scoreboard players set .type uiLogic.Broad 1

            data modify storage ui in set from storage ui current
            data remove storage ui in[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0] run return run function ui:logic/load/on_input

            data modify storage ui temp set from storage ui previous
            data modify storage ui temp[].components."minecraft:custom_data" merge value {prev:1b}
            data modify entity @s Items insert 0 from storage ui temp[]
            data remove storage ui temp
            data modify storage ui temp append from entity @s Items[{components:{"minecraft:custom_data":{prev:1b}}}]
            data remove storage ui in
            data modify storage ui in append from storage ui temp[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0].components."minecraft:custom_data".ui_item.empty run data remove storage ui in[0]
            execute if data storage ui in[0] unless data storage ui in[1] run return run function ui:logic/load/on_click

            function ui:logic/load/refresh
        }

        dir click {
            function shop {
                execute at @s as @p in minecraft:overworld run {
                    item replace block 0 -64 0 container.0 from entity @s player.cursor
                    data modify storage minecraft:ui custom.purchase.price set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.price
                    data modify storage minecraft:ui custom.purchase.context set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.context
                    data modify storage minecraft:ui custom.purchase.name set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.name
                    data modify storage minecraft:ui custom.purchase.tag set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.tag
                    data modify storage minecraft:ui custom.purchase.toggle set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.toggle
                    data modify storage minecraft:ui custom.purchase.namespace set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.namespace
                }

                execute at @s as @p run function ui:logic/menu/pages/abilities/selection/purchase/main with storage minecraft:ui custom.purchase
            }

            dir settings {
                function admin_abilities {
                    execute if entity @p[tag=customUI.AdminAccess] run {
                        function ui:logic/menu/pages/abilities/settings/administrator/flip
                    } else run {
                        execute at @s as @p run {
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're not an ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"r","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"o","color":"blue"},{"text":"r","color":"light_purple"},{"text":",","color":"dark_purple"},{"text":" and ","color":"gray"},{"text":"cannot","color":"red"},{"text":" access this page.","color":"gray"}]
                        }
                        function ui:logic/player/close
                    }
                }

                function admin_cassettes {
                    execute if entity @p[tag=customUI.AdminAccess] run {
                        function ui:logic/menu/pages/cassettes/settings/administrator/flip
                    } else run {
                        execute at @s as @p run {
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're not an ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"r","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"o","color":"blue"},{"text":"r","color":"light_purple"},{"text":",","color":"dark_purple"},{"text":" and ","color":"gray"},{"text":"cannot","color":"red"},{"text":" access this page.","color":"gray"}]
                        }
                        function ui:logic/player/close
                    }
                }
            }
        }

        function load_page {
            data modify entity @s Items set from storage ui current

            data modify storage ui current set from entity @s Items
            execute on passengers run data modify entity @s data.previous set from storage ui current
        }

        function clear_hopper {
            data remove block ~ ~ ~ Items[{components:{"minecraft:custom_data":{ui_item:{}}}}]
        }

        function cleanup {
            data remove storage minecraft:ui current
            data remove storage minecraft:ui previous
            data remove storage minecraft:ui temp
            data remove storage minecraft:ui in
            data remove storage minecraft:ui mask
            data remove storage minecraft:ui custom
        }
    }

    dir load {
        function run_cmd {
            $$(cmd)
        }

        function get_mask {
            $$(mask)
        }

        function on_click {
            function ui:logic/load/run_cmd with storage ui in[0].components."minecraft:custom_data".ui_item

            execute if score .type ui matches 1 run function ui:logic/minecart/load_page
        }

        function on_input {
            execute as @p run function ui:logic/player/return

            function ui:logic/load/refresh
        }

        function refresh {
            data modify storage ui mask set from storage ui current
            execute on passengers run function ui:logic/load/get_mask with entity @s data.page
            data modify storage ui current set from storage ui mask

            execute if score .type ui matches 1 run function ui:logic/minecart/load_page
        }
    }
}

dir ability {

}

dir cassette {
    dir menu {
        function mask {
            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"P","italic":false,"color":"#00cc4e"},{"text":"l","italic":false,"color":"#00c645"},{"text":"a","italic":false,"color":"#00bf3c"},{"text":"y","italic":false,"color":"#00b933"},{"text":" ","italic":false,"color":"#00b32a"},{"text":"S","italic":false,"color":"#00ac20"},{"text":"o","italic":false,"color":"#00a617"},{"text":"n","italic":false,"color":"#009f0e"},{"text":"g","italic":false,"color":"#009905"}],"minecraft:lore":$(play_display),"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/play/main"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"S","italic":false,"color":"#ff6666"},{"text":"t","italic":false,"color":"#f6595e"},{"text":"o","italic":false,"color":"#ec4d56"},{"text":"p","italic":false,"color":"#e3404d"},{"text":" ","italic":false,"color":"#d93345"},{"text":"S","italic":false,"color":"#d0263d"},{"text":"o","italic":false,"color":"#c61a35"},{"text":"n","italic":false,"color":"#bd0d2c"},{"text":"g","italic":false,"color":"#b30024"}],"minecraft:lore":[[{"text":"Cease all ","italic":false,"color":"gray"},{"text":"feedback","italic":false,"color":"yellow"},{"text":" from the","italic":false,"color":"gray"}],[{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/stop"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"C","italic":false,"color":"#4a4a4a"},{"text":"o","italic":false,"color":"#a5a12f"},{"text":"nfig ","italic":false,"color":"#fff714"},{"text":"M","italic":false,"color":"#e8e473"},{"text":"en","italic":false,"color":"#d1d1d1"},{"text":"u","italic":false,"color":"#ff5cdc"}],"minecraft:lore":[[{"text":"Customize various ","italic":false,"color":"gray"},{"text":"behaviors","italic":false,"color":"yellow"}],[{"text":"of the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],"",["",{"text":"Click","italic":false,"color":"blue"},{"text":" for ","italic":false,"color":"gray"},{"text":"Generic","italic":false,"color":"green"},{"text":" access","italic":false,"color":"gray"}],["",{"text":"Shift-Click","italic":false,"color":"blue"},{"text":" with ","italic":false,"color":"gray"},{"text":"OP","italic":false,"color":"yellow"},{"text":" for ","italic":false,"color":"gray"},{"text":"A","italic":false,"color":"red"},{"text":"d","italic":false,"color":"#ff802b"},{"text":"mi","italic":false,"color":"gold"},{"text":"ni","italic":false,"color":"yellow"},{"text":"st","italic":false,"color":"green"},{"text":"ra","italic":false,"color":"blue"},{"text":"to","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"},{"text":" access","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cassette_settings:1b,empty:1b}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"C","italic":false,"color":"red"},{"text":"ol","italic":false,"color":"gold"},{"text":"le","italic":false,"color":"yellow"},{"text":"ct","italic":false,"color":"green"},{"text":"io","italic":false,"color":"blue"},{"text":"n","italic":false,"color":"light_purple"}],"minecraft:lore":[[{"text":"Browse the ","italic":false,"color":"gray"},{"text":"complete list","italic":false,"color":"aqua"},{"text":" of all","italic":false,"color":"gray"}],[{"text":"obtainable ","italic":false,"color":"gray"},{"text":"cassettes","italic":false,"color":"yellow"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui:cassette/collection/flip"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"dark_aqua","italic":false,"text":"Listening Parties"},"minecraft:lore":[[{"text":"Share unlocked ","italic":false,"color":"gray"},{"text":"songs ","italic":false,"color":"yellow"},{"text":"with other","italic":false,"color":"gray"}],[{"text":"players by ","italic":false,"color":"gray"},{"text":"creating ","italic":false,"color":"green"},{"text":"a ","italic":false,"color":"gray"},{"text":"party ","italic":false,"color":"aqua"},{"text":"or","italic":false,"color":"gray"}],[{"text":"joining ","italic":false,"color":"green"},{"text":"an ongoing one","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/party/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Sta","italic":false,"color":"red"},{"text":"t","italic":false,"color":"yellow"},{"text":"ist","italic":false,"color":"yellow"},{"text":"i","italic":false,"color":"green"},{"text":"cs","italic":false,"color":"green"}],"minecraft:lore":[[{"text":"Monitor the ","italic":false,"color":"gray"},{"text":"remainder ","italic":false,"color":"aqua"},{"text":"of ","italic":false,"color":"gray"},{"text":"cassettes","italic":false,"color":"yellow"}],[{"text":"required for ","italic":false,"color":"gray"},{"text":"completion","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/statistics/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/cassette/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/same"}}}}]
        }

        function open {
            tag @s remove uiCassette.PartyMenu
            execute at @s as @p run function ui:cassette/menu/player
            function ui:cassette/menu/mask with storage minecraft:ui cassette.menu
            data modify storage ui current set from storage ui mask
            execute on passengers run data modify entity @s data.page.mask set value "function ui:cassette/menu/mask"
        }

        function player {
            execute unless score @s uiCassette.SettingsFeedback matches 1.. run scoreboard players set @s uiCassette.SettingsFeedback 1
            execute unless score @s uiCassette.SettingsParty matches 1.. run scoreboard players set @s uiCassette.SettingsParty 1
            execute unless score @s uiCassette.SettingsTargeting matches 1.. run scoreboard players set @s uiCassette.SettingsTargeting 1
            execute unless score @s uiCassette.CollectionSort matches 1.. run scoreboard players set @s uiCassette.CollectionSort 1
            execute unless score @s cassettePlay.Last matches 1.. run scoreboard players set @s cassettePlay.Last 1

            function ui:cassette/menu/play/display     
        }

        function same {
            execute at @s as @p run playsound minecraft:cassette.ui.error record @s ~ ~ ~
            function ui:cassette/menu/open
        }

        function flip {
            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
            function ui:cassette/menu/open
        }

        function stop {
            execute at @s as @p run {
                stopsound @s record
                tag @s remove cassettePlayed.Song
                scoreboard players reset @s cassettePlay.Duration
                scoreboard players reset @s cassettePlay.ID
                scoreboard players reset @s cassettePlay.FeedbackStyle
                playsound minecraft:cassette.menu.stop record @s ~ ~ ~

                execute if entity @s[tag=cassetteParty.Host] run {
                    execute as @e[type=minecraft:chest_minecart,tag=ui,tag=uiCassette.PartyMenu] at @s run {
                        function ui:cassette/party/open
                        function ui:logic/load/on_input
                    }
                }
            }
            function ui:cassette/menu/open
        }
        
        dir play {
            function main {
                execute at @s as @p run {
                    scoreboard players reset @s cassettePlay.Duration
                    scoreboard players reset @s cassettePlay.Incremental
                    playsound minecraft:cassette.menu.play record @s ~ ~ ~
                    execute if score @s uiCassette.SettingsTargeting matches 1 run {
                        execute if score @s uiCassette.CollectionSort matches 1..6 run function ui:cassette/menu/play/target/all
                        execute if score @s uiCassette.CollectionSort matches 7 run function ui:cassette/menu/play/target/playlist1
                        execute if score @s uiCassette.CollectionSort matches 8 run function ui:cassette/menu/play/target/playlist2
                    }
                    execute if score @s uiCassette.SettingsTargeting matches 2 run function ui:cassette/menu/play/target/all
                    execute if score @s uiCassette.SettingsTargeting matches 3 run function ui:cassette/menu/play/target/playlist1
                    execute if score @s uiCassette.SettingsTargeting matches 4 run function ui:cassette/menu/play/target/playlist2
                }
                function ui:cassette/menu/open
            }

            function display {
                execute if score @s uiCassette.SettingsTargeting matches 1 run {
                    execute if score @s uiCassette.CollectionSort matches 1..6 run data merge storage minecraft:ui {cassette:{menu:{play_type:"All"}}}
                    execute if score @s uiCassette.CollectionSort matches 7 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #1"}}}
                    execute if score @s uiCassette.CollectionSort matches 8 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #2"}}}
                }
                execute if score @s uiCassette.SettingsTargeting matches 2 run data merge storage minecraft:ui {cassette:{menu:{play_type:"All"}}}
                execute if score @s uiCassette.SettingsTargeting matches 3 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #1"}}}
                execute if score @s uiCassette.SettingsTargeting matches 4 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #2"}}}

                execute if score @s uiCassette.SettingsFeedback matches 1 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Random"}}}
                execute if score @s uiCassette.SettingsFeedback matches 2 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Increment"}}}
                execute if score @s uiCassette.SettingsFeedback matches 3 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Loop"}}}

                block { with storage minecraft:ui cassette.menu
                    $data merge storage minecraft:ui {cassette:{menu:{play_display:[[{"text":"Listen to songs from your","italic":false,"color":"gray"}],{"text":"current collection","italic":false,"color":"gray"},"",[{"text":"Behavior Style","italic":false,"color":"gold"}],["",{"text":"Song: ","italic":false,"color":"gray"},{"text":"N","italic":false,"color":"#9e9e9e"},{"text":"o","italic":false,"color":"#919191"},{"text":"t","italic":false,"color":"#858585"},{"text":"h","italic":false,"color":"#787878"},{"text":"i","italic":false,"color":"#6b6b6b"},{"text":"n","italic":false,"color":"#5e5e5e"},{"text":"g","italic":false,"color":"#525252"},{"text":" :(","italic":false,"color":"#454545"}],["",{"text":"Playing from: ","italic":false,"color":"gray"},{"text":"$(play_type)","italic":false,"color":"green"}],["",{"text":"Feedback: ","italic":false,"color":"gray"},{"text":"$(feedback_type)","italic":false,"color":"green"}]]}}}

                    execute if entity @s[tag=cassettePlayed.Song] run {
                        execute store result storage minecraft:ui cassette.menu.lookup int 1 run scoreboard players get @s cassettePlay.ID
                        block { with storage minecraft:ui cassette.menu
                            $data modify storage minecraft:ui cassette.menu.name set from storage minecraft:custom cassette.index.$(lookup).name
                            $data modify storage minecraft:ui cassette.menu.artist set from storage minecraft:custom cassette.index.$(lookup).artist
                            data modify storage minecraft:ui cassette.menu.song_line set value [""]
                            data modify storage minecraft:ui cassette.menu.song_line append from storage minecraft:ui cassette.menu.name[]
                            block { with storage minecraft:ui cassette.menu
                                $data modify storage minecraft:ui cassette.menu.song_line append value [{"text":" by ","italic":false,"color":"gray"},{"text":"$(artist)","italic":false,"color":"yellow"}]
                                block { with storage minecraft:ui cassette.menu
                                    $data merge storage minecraft:ui {cassette:{menu:{play_display:[[{"text":"Listen to songs from your","italic":false,"color":"gray"}],{"text":"current collection","italic":false,"color":"gray"},"",[{"text":"Behavior Style","italic":false,"color":"gold"}],["",{"text":"Song: ","italic":false,"color":"gray"},$(song_line)],["",{"text":"Playing from: ","italic":false,"color":"gray"},{"text":"$(play_type)","italic":false,"color":"green"}],["",{"text":"Feedback: ","italic":false,"color":"gray"},{"text":"$(feedback_type)","italic":false,"color":"green"}]]}}}
                                }
                            }
                        }
                    }
                }
            }

            dir feedback {
                dir random {
                    function main {
                        execute store result score @s cassettePlay.ID run random value 1..105
                        execute store result storage minecraft:custom cassette.play.lookup int 1 run scoreboard players get @s cassettePlay.ID
                        execute store result storage minecraft:custom cassette.play.last_played int 1 run scoreboard players get @s cassettePlay.Last

                        execute if score @s uiCassette.SettingsTargeting matches 1 run block { with storage minecraft:custom cassette.play
                            $execute if score @s uiCassette.CollectionSort matches 1..6 if entity @s[advancements={cassette:ownership/$(lookup)=true}] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play

                            $execute if score @s uiCassette.CollectionSort matches 7 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist1_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play

                            $execute if score @s uiCassette.CollectionSort matches 8 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play
                        }
                        execute if score @s uiCassette.SettingsTargeting matches 2..4 run block { with storage minecraft:custom cassette.play
                            $execute if score @s uiCassette.SettingsTargeting matches 2 if entity @s[advancements={cassette:ownership/$(lookup)=true}] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play

                            $execute if score @s uiCassette.SettingsTargeting matches 3 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist1_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play

                            $execute if score @s uiCassette.SettingsTargeting matches 4 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:custom cassette.play
                        }
                    }

                    function found {
                        $data modify storage minecraft:custom cassette.play merge from storage minecraft:custom cassette.index.$(lookup)
                        function ui:cassette/menu/play/found with storage minecraft:custom cassette.play
                    }
                }

                function increment {
                    tag @s add cassettePlay.FeedbackIncrementing
                    scoreboard players add @s cassettePlay.FeedbackStyle 1
                    scoreboard players reset .cassetteSlot uiCassette.CollectionBroad
                    scoreboard players reset .incrementIndex uiCassette.CollectionBroad
                    scoreboard players reset .totalEntries uiCassette.CollectionBroad
                    scoreboard players reset .totalPassed uiCassette.CollectionBroad
                    scoreboard players set .targetedRating uiCassette.CollectionBroad 0
                    execute if score @s uiCassette.CollectionBroad matches 1 run scoreboard players reset .indexOffset uiCassette.CollectionBroad
                    execute if score @s uiCassette.CollectionBroad matches 2 run scoreboard players set .indexOffset uiCassette.CollectionBroad 21
                    execute if score @s uiCassette.CollectionBroad matches 3 run scoreboard players set .indexOffset uiCassette.CollectionBroad 42
                    execute if score @s uiCassette.CollectionBroad matches 4 run scoreboard players set .indexOffset uiCassette.CollectionBroad 63
                    execute if score @s uiCassette.CollectionBroad matches 5 run scoreboard players set .indexOffset uiCassette.CollectionBroad 84
                    
                    execute if score @s uiCassette.CollectionSort matches 1..3 run function ui:cassette/collection/sort/default
                    execute if score @s uiCassette.CollectionSort matches 4 run function ui:cassette/collection/sort/rating
                    execute if score @s uiCassette.CollectionSort matches 5 run function ui:cassette/collection/sort/alphabetical
                    execute if score @s uiCassette.CollectionSort matches 6 run function ui:cassette/collection/sort/artist
                    execute if score @s uiCassette.CollectionSort matches 7 run function ui:cassette/collection/sort/playlist1
                    execute if score @s uiCassette.CollectionSort matches 8 run function ui:cassette/collection/sort/playlist2
                    tag @s remove cassettePlay.FeedbackIncrementing

                    execute if score @s cassettePlay.FeedbackReturn matches 1.. run {
                        execute store result storage minecraft:custom cassette.play.lookup int 1 run scoreboard players get @s cassettePlay.FeedbackReturn
                        execute store result storage minecraft:custom cassette.play.last_played int 1 run scoreboard players get @s cassettePlay.Last
                        block { with storage minecraft:custom cassette.play
                            $scoreboard players set @s cassettePlay.ID $(lookup)
                            $data modify storage minecraft:custom cassette.play merge from storage minecraft:custom cassette.index.$(lookup)
                            function ui:cassette/menu/play/found with storage minecraft:custom cassette.play
                        }
                    }
                    execute unless score @s cassettePlay.FeedbackReturn matches 1.. run {
                        scoreboard players reset @s cassettePlay.FeedbackStyle
                        function ui:cassette/menu/play/reshuffle {style:"all"}
                    }
                    scoreboard players reset @s cassettePlay.FeedbackReturn
                }
            }

            dir target {
                function all {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/all
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"all"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }

                function playlist1 {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/playlist1
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"playlist1"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }

                function playlist2 {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/playlist2
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"playlist2"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }
            }

            function reshuffle {
                scoreboard players reset @s cassettePlay.Incremental
                REPEAT (1,105) as i {
                    tag @s remove cassettePlayed.<%i%>
                }
                $function ui:cassette/menu/play/$(style)
            }

            function found {
                $scoreboard players set @s cassettePlay.MaxDuration $(real_duration)
                $stopsound @s record minecraft:cassette.$(last_played)
                $playsound minecraft:cassette.$(lookup) record @s
                tag @s add cassettePlayed.Song

                execute if entity @s[tag=cassetteParty.Host] run function ui:cassette/menu/play/party

                $tag @s add cassettePlayed.$(lookup)
                $scoreboard players set @s cassettePlay.Last $(lookup)
                tag @s add temp
            }

            function party {
                execute as @e[type=minecraft:chest_minecart,tag=ui,tag=uiCassette.PartyMenu] at @s run {
                    function custom:ui/menu/pages/cassettes/party/open
                    function custom:ui/menu/on_input
                }

                execute store result storage minecraft:custom cassette.play.partyID int 1 run scoreboard players get @s customUI.CassetteParty
                block { with storage minecraft:custom cassette.play
                    $execute as @a[tag=customCassette.Party$(partyID)Member] at @s run block { with storage minecraft:custom cassette.play
                        $stopsound @s record minecraft:cassette.$(last_played)
                        $playsound minecraft:cassette.$(lookup) record @s ~ ~ ~ 9999999999999
                    }
                }
            }
        }
    }

    dir settings {

    }

    dir collection {

    }

    dir party {

    }

    dir statistics {

    }
}