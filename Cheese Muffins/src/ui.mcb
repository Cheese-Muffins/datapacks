            }

            function same {
                execute at @s as @p run playsound minecraft:cassette.ui.error record @s ~ ~ ~
                function ui:cassette/settings/default/open
            }

            function flip {
                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                function ui:cassette/settings/default/open
            }

            function feedback {
                execute at @s as @p run {
                    scoreboard players add @s uiCassette.SettingsFeedback 1
                    scoreboard players reset @s cassettePlay.ID
                    scoreboard players reset @s cassettePlay.FeedbackIncrement
                    execute if score @s uiCassette.SettingsFeedback matches 4.. run scoreboard players set @s uiCassette.SettingsFeedback 1

                    playsound minecraft:cassette.ui.cycle record @s ~ ~ ~
                }
                function ui:cassette/settings/default/open
            }

            function party {
                execute at @s as @p run {
                    scoreboard players add @s uiCassette.SettingsParty 1
                    execute if score @s uiCassette.SettingsParty matches 5.. run scoreboard players set @s uiCassette.SettingsParty 1

                    playsound minecraft:cassette.ui.cycle record @s ~ ~ ~
                }
                function ui:cassette/settings/default/open
            }

            function targeting {
                execute at @s as @p run {
                    scoreboard players add @s uiCassette.SettingsTargeting 1
                    execute if score @s uiCassette.SettingsTargeting matches 5.. run scoreboard players set @s uiCassette.SettingsTargeting 1

                    playsound minecraft:cassette.ui.cycle record @s ~ ~ ~
                }
                function ui:cassette/settings/default/open
            }
        }

        dir administrator {
            function mask {
                $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"dark_aqua","italic":false,"text":"Show Collection ID"},"minecraft:lore":[["",{"text":"Toggle the presence of ","italic":false,"color":"gray"},{"text":"IDs","italic":false,"color":"yellow"},{"text":" in the","italic":false,"color":"gray"}],[{"text":"collection menu","italic":false,"color":"gray"}],"",["",{"text":"Collection IDs: ","italic":false,"color":"gray"},{"text":"$(collection_id_state)","italic":false,"color":"$(collection_id_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/settings/administrator/collection_id"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/cassette/administrator_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/settings/default/same"}}}}]
            }

            function open {
                execute at @s as @p run function ui:cassette/settings/administrator/player
                function ui:cassette/settings/administrator/mask with storage minecraft:ui cassette.settings.administrator
                data modify storage ui current set from storage ui mask
                execute on passengers run data modify entity @s data.page.mask set value "function ui:cassette/settings/administrator/mask"
            }

            function player {
                data merge storage minecraft:ui {cassette:{settings:{administrator:{collection_id_state:"Disabled"}}}}
                data merge storage minecraft:ui {cassette:{settings:{administrator:{collection_id_color:"red"}}}}
                
                execute if entity @s[tag=cassetteSettings.ShowCollectionID] run {
                    data merge storage minecraft:ui {cassette:{settings:{administrator:{collection_id_state:"Enabled"}}}}
                    data merge storage minecraft:ui {cassette:{settings:{administrator:{collection_id_color:"green"}}}}
                }
            }

            function same {
                execute at @s as @p run playsound minecraft:cassette.ui.error record @s ~ ~ ~
                function ui:cassette/settings/administrator/open
            }

            function flip {
                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                function ui:cassette/settings/administrator/open
            }

            function collection_id {
                execute at @s as @p run {
                    execute unless entity @s[tag=cassetteSettings.ShowCollectionID] run {
                        tag @s add cassetteSettings.ShowCollectionID
                        tag @s add temp
                    }

                    execute if entity @s[tag=cassetteSettings.ShowCollectionID] unless entity @s[tag=temp] run {
                        tag @s remove cassetteSettings.ShowCollectionID
                    }

                    tag @s remove temp
                }
                function ui:cassette/settings/administrator/open
            }

            function check_permissions {
                execute if entity @p[tag=uiAdministrator.Access] run {
                    function ui:cassette/settings/administrator/flip
                } else run {
                    execute at @s as @p run {
                        playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                        tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're not an ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"r","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"o","color":"blue"},{"text":"r","color":"light_purple"},{"text":",","color":"dark_purple"},{"text":" and ","color":"gray"},{"text":"cannot","color":"red"},{"text":" access this page.","color":"gray"}]
                    }
                    function ui:logic/player/close
                }
            }
        }

        function enhanced_button {
            # default settings
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:cassette/settings/default/flip

            # administrator settings
            execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:cassette/settings/administrator/check_permissions
            execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:cassette/settings/administrator/check_permissions
        }
    }

    dir collection {
