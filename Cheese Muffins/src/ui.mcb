function on_load minecraft:load{
    scoreboard objectives add uiLogic.Broad dummy
    scoreboard objectives add uiLogic.ID dummy
    scoreboard objectives add uiLogic.CurrentHotbar dummy
    scoreboard objectives add uiLogic.PreviousHotbar dummy

    # Collection #
    scoreboard objectives add uiCassette.CollectionSort dummy
    scoreboard objectives add uiCassette.CollectionBroad dummy
    scoreboard objectives add uiCassette.CollectionMaximumPage dummy
    scoreboard objectives add uiCassette.CollectionOperation dummy
    scoreboard objectives add uiAbility.SelectionBroad dummy
    scoreboard objectives add uiAbility.SelectionChoice dummy
    scoreboard objectives add uiAbility.ChoicePage dummy
    scoreboard objectives add uiPurchase.ItemCount dummy
    scoreboard objectives add uiPurchase.ProductID dummy
    scoreboard objectives add uiPurchase.SkinRarity dummy
    scoreboard objectives add uiPurchase.Confirm dummy

    # Parties #
    scoreboard objectives add uiCassette.PartyLogic dummy

    # Settings #
    scoreboard objectives add uiCassette.SettingsTargeting dummy
    scoreboard objectives add uiCassette.SettingsFeedback dummy
    scoreboard objectives add uiCassette.SettingsParty dummy
}

function administrator_access {
    tag @s add uiAdministrator.Access
    playsound minecraft:cassette.award.hard player @s ~ ~ ~
    tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"You now have complete ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"a","color":"gold"},{"text":"t","color":"yellow"},{"text":"o","color":"green"},{"text":"r","color":"blue"},{"text":" access to everything relating to ","color":"gray"},{"text":"Custom Abilities!","color":"aqua"}]
}

dir logic {
    dir player {
        function tick {
            execute if items entity @s weapon.* *[minecraft:custom_data~{custom_ui:1b}] run function ui:logic/player/teleport
            execute unless items entity @s weapon.* *[minecraft:custom_data~{custom_ui:1b}] if score @s uiLogic.ID matches 0.. run function ui:logic/player/close
        }

        function teleport {
            function ui:logic/player/check_swap
            execute if items entity @s weapon.* *[minecraft:custom_data~{ability_tome:1b}] unless score @s uiLogic.ID matches 0.. run function ui:logic/player/ability_open
            execute if items entity @s weapon.* *[minecraft:custom_data~{cassette_player:1b}] unless score @s uiLogic.ID matches 0.. run function ui:logic/player/cassette_open

            scoreboard players operation #search uiLogic.ID = @s uiLogic.ID
            execute at @s as @e[type=minecraft:item_display,tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run tp @s ~ ~1 ~
        }

        function ability_open {
            summon minecraft:item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}
            execute as @n[type=minecraft:item_display,tag=new] run visibility disable @s @a

            scoreboard players add .global uiLogic.ID 1
            scoreboard players operation @s uiLogic.ID = .global uiLogic.ID
            scoreboard players operation @e[tag=new] uiLogic.ID = .global uiLogic.ID

            scoreboard players set .type uiLogic.Broad 1
            execute as @e[type=minecraft:chest_minecart,tag=new] run {
                function ui:ability/menu/open
                function ui:logic/minecart/load_page
            }
            tag @e remove new
        }

        function cassette_open {
            summon item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}
            execute as @n[type=minecraft:item_display,tag=new] run visibility disable @s @a

            scoreboard players add .global uiLogic.ID 1
            scoreboard players operation @s uiLogic.ID = .global uiLogic.ID
            scoreboard players operation @e[tag=new] uiLogic.ID = .global uiLogic.ID

            scoreboard players set .type uiLogic.Broad 1
            execute as @e[type=minecraft:chest_minecart,tag=new] run {
                function ui:cassette/menu/open
                function ui:logic/minecart/load_page
            }
            tag @e remove new
        }

        function check_swap {
            execute store result score @s uiLogic.CurrentHotbar run data get entity @s SelectedItemSlot
            execute unless score @s uiLogic.CurrentHotbar = @s uiLogic.PreviousHotbar if score @s uiLogic.ID matches 0.. run function ui:logic/player/close
            execute store result score @s uiLogic.PreviousHotbar run data get entity @s SelectedItemSlot
        }

        function return {
            data remove block 0 -64 0 Items
            data modify block 0 -64 0 Items set from storage ui in
            loot give @s mine 0 -64 0 stick[minecraft:custom_data={drop_contents:1b}]
            item replace block 0 -64 0 container.0 with air
            data remove storage minecraft:ui current
            data remove storage minecraft:ui in
        }

        function close {
            scoreboard players operation #search uiLogic.ID = @s uiLogic.ID
            execute as @e[type=minecraft:chest_minecart,tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run data remove entity @s Items
            execute as @e[tag=ui] if score @s uiLogic.ID = #search uiLogic.ID run kill @s
            scoreboard players reset @s uiLogic.ID
            function ui:logic/minecart/cleanup
        }
    }

    dir minecart {
        function tick {
            data modify storage ui current set from entity @s Items
            execute on passengers run data modify storage ui previous set from entity @s data.previous
            
            execute on passengers store result score #bool uiLogic.Broad run data modify entity @s data.previous set from storage ui current

            execute if score #bool uiLogic.Broad matches 1 run function ui:logic/minecart/on_change
        }

        function enhanced_button {
            # cassette settings check
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] run function ui:cassette/settings/enhanced_button
            execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_settings:1b}}] run function ui:cassette/settings/enhanced_button

            # cassette collection entries #
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{collection_entry:1b}}] run function ui:cassette/collection/operation/main
            execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{collection_entry:1b}}] run function ui:cassette/collection/operation/main

            # party entries #
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{party_entry:1b}}] run function ui:cassette/party/interact/main
            execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{party_entry:1b}}] run function ui:cassette/party/interact/main

            # ability selections #
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{selection_entry:1b}}] run function ui:ability/selection/expand
            execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{selection_entry:1b}}] run function ui:ability/selection/expand

            # purchase choice #
            execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{purchase_choice:1b}}] run function ui:purchase/click
            execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{purchase_choice:1b}}] run function ui:purchase/click
            

            # execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main
            # execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main
            # execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{cassette_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/collection/operation/main

            # execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main
            # execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main
            # execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{party_item:1b}}] in minecraft:overworld run function ui:logic/menu/pages/cassettes/party/interact/main

            # execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{purchaseable_item:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/shop

            # execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/menu/pages/abilities/settings/default/flip
            # execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_abilities
            # execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function ui:logic/minecart/click/settings/admin_abilities

            # scoreboard players reset @s[tag=!customUI.TempClick] customUI.PurchaseConfirm
            # tag @s remove customUI.TempClick
        }

        function on_change {
            # enhanced button check
            execute at @s as @p run {
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{enhanced_button:1b}}] run function ui:logic/minecart/enhanced_button
                execute if items entity @s container.* minecraft:arrow[minecraft:custom_data~{ui_item:{enhanced_button:1b}}] run function ui:logic/minecart/enhanced_button
            }

            # removal of ui elements in the physical world
            clear @a *[minecraft:custom_data~{ui_item:{}}]
            kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{ui_item:{}}}}}]

            # hopper flow prevention
            execute positioned ~ ~-1 ~ run {
                execute positioned ~1 ~ ~ if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~ if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~ ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~ ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper

                execute positioned ~1 ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~1 ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
                execute positioned ~-1 ~ ~-1 if block ~ ~ ~ minecraft:hopper run function ui:logic/minecart/clear_hopper
            }

            # data remove storage minecraft:ui
            scoreboard players set .type uiLogic.Broad 1

            data modify storage ui in set from storage ui current
            data remove storage ui in[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0] run return run function ui:logic/load/on_input

            data modify storage ui temp set from storage ui previous
            data modify storage ui temp[].components."minecraft:custom_data" merge value {prev:1b}
            data modify entity @s Items insert 0 from storage ui temp[]
            data remove storage ui temp
            data modify storage ui temp append from entity @s Items[{components:{"minecraft:custom_data":{prev:1b}}}]
            data remove storage ui in
            data modify storage ui in append from storage ui temp[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0].components."minecraft:custom_data".ui_item.empty run data remove storage ui in[0]
            execute if data storage ui in[0] unless data storage ui in[1] run return run function ui:logic/load/on_click

            function ui:logic/load/refresh
        }

        dir click {
            function shop {
                execute at @s as @p in minecraft:overworld run {
                    item replace block 0 -64 0 container.0 from entity @s player.cursor
                    data modify storage minecraft:ui purchase.price set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.price
                    data modify storage minecraft:ui purchase.context set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.context
                    data modify storage minecraft:ui purchase.name set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.name
                    data modify storage minecraft:ui purchase.tag set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.tag
                    data modify storage minecraft:ui purchase.toggle set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.toggle
                    data modify storage minecraft:ui purchase.namespace set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.namespace
                }

                execute at @s as @p run function ui:logic/menu/pages/abilities/selection/purchase/main with storage minecraft:ui purchase
            }
        }

        function load_page {
            data modify entity @s Items set from storage ui current

            data modify storage ui current set from entity @s Items
            execute on passengers run data modify entity @s data.previous set from storage ui current
        }

        function clear_hopper {
            data remove block ~ ~ ~ Items[{components:{"minecraft:custom_data":{ui_item:{}}}}]
        }

        function cleanup {
            data remove storage minecraft:ui current
            data remove storage minecraft:ui previous
            data remove storage minecraft:ui temp
            data remove storage minecraft:ui in
            data remove storage minecraft:ui mask
        }
    }

    dir load {
        function run_cmd {
            $$(cmd)
        }

        function get_mask {
            $$(mask)
        }

        function on_click {
            function ui:logic/load/run_cmd with storage ui in[0].components."minecraft:custom_data".ui_item

            execute if score .type ui matches 1 run function ui:logic/minecart/load_page
        }

        function on_input {
            execute as @p run function ui:logic/player/return

            function ui:logic/load/refresh
        }

        function refresh {
            data modify storage ui mask set from storage ui current
            execute on passengers run function ui:logic/load/get_mask with entity @s data.page
            data modify storage ui current set from storage ui mask

            execute if score .type ui matches 1 run function ui:logic/minecart/load_page
        }
    }
}

dir ability {
    function give {
        give @s phantom_membrane[lore=[[{"text":"Browse and unlock traits linked to","italic":false,"color":"gray"}],[{"text":"your character","italic":false,"color":"gray"}]],item_name=[{"text":"A","italic":false,"color":"#ffdb94"},{"text":"b","italic":false,"color":"#fad793"},{"text":"i","italic":false,"color":"#f4d392"},{"text":"l","italic":false,"color":"#efcf91"},{"text":"i","italic":false,"color":"#e9cb90"},{"text":"t","italic":false,"color":"#e4c78f"},{"text":"y","italic":false,"color":"#dec48d"},{"text":" ","italic":false,"color":"#d9c08c"},{"text":"T","italic":false,"color":"#d3bc8b"},{"text":"o","italic":false,"color":"#ceb88a"},{"text":"m","italic":false,"color":"#c8b489"},{"text":"e","italic":false,"color":"#c3b088"}],max_stack_size=1,item_model="minecraft:interactables/ability_tome",custom_data={custom_ui:1b,ability_tome:1b}]
    }

    dir menu {
        function mask {
            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(model)","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":$(name),"minecraft:lore":$(selection_lore),"minecraft:custom_data":{ui_item:{cmd:"$(ability_selection_page)"}}}},{Slot:9b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Config M","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"yellow"},{"text":"n","italic":false,"color":"#b0b0b0"},{"text":"u","italic":false,"color":"#ff57f9"}],"minecraft:lore":[[{"text":"Customize various ","italic":false,"color":"gray"},{"text":"behaviors","italic":false,"color":"yellow"}],[{"text":"of the ","italic":false,"color":"gray"},{"text":"A","italic":false,"color":"red"},{"text":"bi","italic":false,"color":"gold"},{"text":"li","italic":false,"color":"yellow"},{"text":"ty","italic":false,"color":"green"},{"text":" T","italic":false,"color":"blue"},{"text":"om","italic":false,"color":"light_purple"},{"text":"e","italic":false,"color":"dark_purple"}],"",["",{"text":"Click","italic":false,"color":"blue"},{"text":" for ","italic":false,"color":"gray"},{"text":"Generic","italic":false,"color":"green"},{"text":" access","italic":false,"color":"gray"}],["",{"text":"Shift-Click","italic":false,"color":"blue"},{"text":" with ","italic":false,"color":"gray"},{"text":"OP","italic":false,"color":"yellow"},{"text":" for ","italic":false,"color":"gray"},{"text":"A","italic":false,"color":"red"},{"text":"d","italic":false,"color":"#ff802b"},{"text":"mi","italic":false,"color":"gold"},{"text":"ni","italic":false,"color":"yellow"},{"text":"st","italic":false,"color":"green"},{"text":"ra","italic":false,"color":"blue"},{"text":"to","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"},{"text":" access","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{settings_button:1b,empty:1b}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"I","italic":false,"color":"#d60000"},{"text":"n","italic":false,"color":"#d90606"},{"text":"f","italic":false,"color":"#db0c0c"},{"text":"o","italic":false,"color":"#de1111"},{"text":"r","italic":false,"color":"#e01717"},{"text":"m","italic":false,"color":"#e31d1d"},{"text":"a","italic":false,"color":"#e52323"},{"text":"t","italic":false,"color":"#e82828"},{"text":"i","italic":false,"color":"#eb2e2e"},{"text":"o","italic":false,"color":"#ed3434"},{"text":"n","italic":false,"color":"#f03a3a"},{"text":" ","italic":false,"color":"#f23f3f"},{"text":"G","italic":false,"color":"#f54545"},{"text":"u","italic":false,"color":"#f74b4b"},{"text":"i","italic":false,"color":"#fa5151"},{"text":"d","italic":false,"color":"#fc5656"},{"text":"e","italic":false,"color":"#ff5c5c"}],"minecraft:lore":[[{"text":"Explanations on ","italic":false,"color":"gray"},{"text":"specific conditions","italic":false,"color":"#ffb057"}],[{"text":"derived from ","italic":false,"color":"gray"},{"text":"Abilities","italic":false,"color":"#e629ff"}],[{"text":">","italic":false,"color":"#5c5c5c"},{"text":" ","italic":false,"color":"gray"},{"text":"Traits","italic":false,"color":"#6bd1c0"}],[{"text":">","italic":false,"color":"#5c5c5c"},{"text":" ","italic":false,"color":"gray"},{"text":"Tokens / Stacks","italic":false,"color":"#8adcff"}],[{"text":"> ","italic":false,"color":"#5c5c5c"},{"text":"Canceling","italic":false,"color":"#d10049"}],[{"text":"> ","italic":false,"color":"#5c5c5c"},{"text":"Combat Logging","italic":false,"color":"#e66565"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"P","italic":false,"color":"#b841c8"},{"text":"a","italic":false,"color":"#bf4bce"},{"text":"s","italic":false,"color":"#c556d4"},{"text":"s","italic":false,"color":"#cc60da"},{"text":"i","italic":false,"color":"#d36ae0"},{"text":"v","italic":false,"color":"#d975e7"},{"text":"e","italic":false,"color":"#e07fed"},{"text":"(","italic":false,"color":"#e789f3"},{"text":"s","italic":false,"color":"#ed94f9"},{"text":") ","italic":false,"color":"#f49eff"},{"text":"&","italic":false,"color":"gray"},{"text":" ","italic":false,"color":"#ff5cc3"},{"text":"A","italic":false,"color":"#99e0ff"},{"text":"w","italic":false,"color":"#93dcfc"},{"text":"a","italic":false,"color":"#8cd7f8"},{"text":"k","italic":false,"color":"#86d3f5"},{"text":"e","italic":false,"color":"#80cff1"},{"text":"n","italic":false,"color":"#7acbee"},{"text":"i","italic":false,"color":"#73c6ea"},{"text":"n","italic":false,"color":"#6dc2e7"},{"text":"g","italic":false,"color":"#67bee3"},{"text":"(","italic":false,"color":"#61bae0"},{"text":"s","italic":false,"color":"#5ab5dc"},{"text":")","italic":false,"color":"#54b1d9"}],"minecraft:lore":$(passive),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"Moveset","italic":false,"color":"#83cb48"}],"minecraft:lore":[[{"text":"Access ","italic":false,"color":"gray"},{"text":"all","italic":false,"color":"#ce47ff"},{"text":" of the ","italic":false,"color":"gray"},{"text":"available moves","italic":false,"color":"#5ee4bb"}],[{"text":"for ","italic":false,"color":"gray"},{"text":"$(proper_name)","italic":false,"color":"#fffb85"}]],"minecraft:custom_data":{ui_item:{cmd:"$(ability_moveset_page)"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"S","italic":false,"color":"#fffc99"},{"text":"k","italic":false,"color":"#fffc8d"},{"text":"i","italic":false,"color":"#fffb81"},{"text":"n","italic":false,"color":"#fffb76"},{"text":"(","italic":false,"color":"#fffa6a"},{"text":"s","italic":false,"color":"#fffa5e"},{"text":")","italic":false,"color":"#fff952"}],"minecraft:lore":[[{"text":"Browse ","italic":false,"color":"gray"},{"text":"all","italic":false,"color":"#ce47ff"},{"text":" available options to ","italic":false,"color":"gray"},{"text":"modify","italic":false,"color":"#5ee4bb"}],[{"text":"the ","italic":false,"color":"gray"},{"text":"appearance","italic":false,"color":"#5ee4bb"},{"text":" of ","italic":false,"color":"gray"},{"text":"$(proper_name)","italic":false,"color":"#fffb85"}]],"minecraft:custom_data":{ui_item:{cmd:"$(ability_skin_page)"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"A","italic":false,"color":"red"},{"text":"b","italic":false,"color":"#ff802b"},{"text":"il","italic":false,"color":"gold"},{"text":"i","italic":false,"color":"#ffd52b"},{"text":"ty","italic":false,"color":"yellow"},{"text":" ","italic":false,"color":"#aaff55"},{"text":"Se","italic":false,"color":"green"},{"text":"l","italic":false,"color":"#55aaaa"},{"text":"ec","italic":false,"color":"blue"},{"text":"t","italic":false,"color":"#aa55ff"},{"text":"io","italic":false,"color":"light_purple"},{"text":"n","italic":false,"color":"dark_purple"}],"minecraft:lore":[[{"text":"Browse the ","italic":false,"color":"gray"},{"text":"complete list","italic":false,"color":"#2bc5c2"},{"text":" of","italic":false,"color":"gray"}],[{"text":"all ","italic":false,"color":"gray"},{"text":"available ","italic":false,"color":"gray"},{"text":"Abilities","italic":false,"color":"#e629ff"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/flip"}}}},{Slot:17b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Sta","italic":false,"color":"red"},{"text":"t","italic":false,"color":"yellow"},{"text":"ist","italic":false,"color":"yellow"},{"text":"i","italic":false,"color":"green"},{"text":"cs","italic":false,"color":"green"}],"minecraft:lore":[[{"text":"Observe various different sets of data","italic":false,"color":"gray"}],[{"text":"ranging from ","italic":false,"color":"gray"},{"text":"general ","italic":false,"color":"green"},{"text":"or specific to the","italic":false,"color":"gray"}],[{"text":"currently equipped ability.","italic":false,"color":"yellow"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/statistics/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/ability/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/same"}}}}]
        }

        function open {
            execute at @s as @p run function ui:ability/menu/player
            function ui:ability/menu/mask with storage minecraft:ui ability.menu
            data modify storage ui current set from storage ui mask
            execute on passengers run data modify entity @s data.page.mask set value "function ui:ability/menu/mask"
        }

        function same {
            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
            function ui:ability/menu/open
        }

        function flip {
            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
            function ui:ability/menu/open
        }

        function player {
            block {
                data merge storage minecraft:ui {ability:{menu:{name:"No Ability"}}}
                data merge storage minecraft:ui {ability:{menu:{subtext:"Select one for more features!"}}}
                data merge storage minecraft:ui {ability:{menu:{model:"minecraft:empty"}}}
                data merge storage minecraft:ui {ability:{menu:{ability_selection_page:"function custom:ui/menu/pages/abilities/menu/same"}}}
                data merge storage minecraft:ui {ability:{menu:{ability_moveset_page:"function custom:ui/menu/pages/abilities/menu/same"}}}
                data merge storage minecraft:ui {ability:{menu:{ability_skin_page:"function custom:ui/menu/pages/abilities/menu/same"}}}
            }

            function ui:ability/menu/selected {id:1}
            # execute if entity @s[tag=abilityBilly.User] run function ui:ability/menu/selected {id:1}
            execute if entity @s[tag=abilityPresident.User] run function ui:ability/menu/selected {id:2}
            execute if entity @s[tag=abilityAvatar.User] run function ui:ability/menu/selected {id:3}
            execute if entity @s[tag=abilityTheWorld.User] run function ui:ability/menu/selected {id:4}



            # ts needs to be fixed
            
        }

        function selected {
            $function ability:generate/selection_lore with storage minecraft:ability index.$(id)
            $data modify storage minecraft:ui ability.menu merge from storage minecraft:ability index.$(id)
        }
    }

    dir selection {
        function mask {
            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot1_model)","minecraft:tooltip_style":"minecraft:$(slot1_tooltip)","minecraft:item_name":$(slot1_name),"minecraft:lore":$(slot1_lore),"minecraft:custom_data":{ui_item:{enhanced_button:1b,selection_entry:1b,ability_id:$(slot1_id)}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot2_model)","minecraft:tooltip_style":"minecraft:$(slot2_tooltip)","minecraft:item_name":$(slot2_name),"minecraft:lore":$(slot2_lore),"minecraft:custom_data":{ui_item:{enhanced_button:1b,selection_entry:1b,ability_id:$(slot2_id)}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot3_model)","minecraft:tooltip_style":"minecraft:$(slot3_tooltip)","minecraft:item_name":$(slot3_name),"minecraft:lore":$(slot3_lore),"minecraft:custom_data":{ui_item:{enhanced_button:1b,selection_entry:1b,ability_id:$(slot3_id)}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot4_model)","minecraft:tooltip_style":"minecraft:$(slot4_tooltip)","minecraft:item_name":$(slot4_name),"minecraft:lore":$(slot4_lore),"minecraft:custom_data":{ui_item:{enhanced_button:1b,selection_entry:1b,ability_id:$(slot4_id)}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/ability/selection1","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/same"}}}}]
        }

        function open {
            execute at @s as @p run function ui:ability/selection/player
            function ui:ability/selection/mask with storage minecraft:ui ability.selection
            data modify storage ui current set from storage ui mask
            execute on passengers run data modify entity @s data.page.mask set value "function ui:ability/selection/mask"
        }

        function player {
            execute unless score @s uiAbility.SelectionBroad matches 1.. run scoreboard players set @s uiAbility.SelectionBroad 1

            function ui:ability/selection/generate/slot/initialize
        }

        dir generate {
            dir slot {
                function initialize {
                    scoreboard players reset .totalEntries uiAbility.SelectionBroad
                    scoreboard players reset .incrementIndex uiAbility.SelectionBroad
                    scoreboard players reset .abilitySlot uiAbility.SelectionBroad
                    
                    execute if score @s uiAbility.SelectionBroad matches 1 run scoreboard players reset .indexOffset uiAbility.SelectionBroad
                    execute if score @s uiAbility.SelectionBroad matches 2 run scoreboard players set .indexOffset uiAbility.SelectionBroad 7

                    function ui:ability/selection/generate/slot/index
                }

                function index {
                    scoreboard players add .totalEntries uiAbility.SelectionBroad 1
                    scoreboard players add .incrementIndex uiAbility.SelectionBroad 1

                    execute store result storage minecraft:ability fetch.lookup int 1 run scoreboard players get .incrementIndex uiAbility.SelectionBroad
                    execute unless score .indexOffset uiAbility.SelectionBroad matches 1.. run {
                        execute unless score .abilitySlot uiAbility.SelectionBroad matches 7.. run block { with storage minecraft:ability fetch
                            scoreboard players add .abilitySlot uiAbility.SelectionBroad 1

                            execute store result storage minecraft:ability fetch.number int 1 run scoreboard players get .abilitySlot uiAbility.SelectionBroad

                            $function ability:generate/selection_lore with storage minecraft:ability index.$(lookup)
                            $data modify storage minecraft:ability fetch merge from storage minecraft:ability index.$(lookup)
                            block { with storage minecraft:ability fetch
                                $data modify storage minecraft:ui ability.selection.slot$(number)_name set from storage minecraft:ability index.$(lookup).name
                                $data modify storage minecraft:ui ability.selection.slot$(number)_lore set from storage minecraft:ability index.$(lookup).selection_lore
                                $data modify storage minecraft:ui ability.selection.slot$(number)_model set from storage minecraft:ability index.$(lookup).model
                                $data modify storage minecraft:ui ability.selection.slot$(number)_id set from storage minecraft:ability index.$(lookup).ability_id
                                $data modify storage minecraft:ui ability.selection.slot$(number)_tooltip set from storage minecraft:ability index.$(lookup).path
                            }
                        } 
                    }
                    
                    execute if score .indexOffset uiAbility.SelectionBroad matches 1.. run scoreboard players remove .indexOffset uiAbility.SelectionBroad 1

                    execute unless score .incrementIndex uiAbility.SelectionBroad matches 7.. run function ui:ability/selection/generate/slot/index
                }

                function default {
                    # found correct page
                    scoreboard players add .totalEntries uiCassette.CollectionBroad 1
                    scoreboard players add .incrementIndex uiCassette.CollectionBroad 1
                    execute store result storage minecraft:cassette fetch.lookup int 1 run scoreboard players get .incrementIndex uiCassette.CollectionBroad
                    block { with storage minecraft:cassette fetch
                        $execute if entity @s[advancements={cassette:ownership/$(lookup)=true}] run {
                            scoreboard players add .totalPassed uiCassette.CollectionBroad 1
                            execute if entity @s[tag=cassettePlay.FeedbackIncrementing] if score @s cassettePlay.FeedbackIncrement = .totalPassed uiCassette.CollectionBroad run block { with storage minecraft:cassette fetch
                                $scoreboard players set @s cassettePlay.FeedbackReturn $(lookup)
                            }
                        }
                    }

                    execute store result storage minecraft:cassette fetch.entry int 1 run scoreboard players get .totalPassed uiCassette.CollectionBroad
                    execute unless score .indexOffset uiCassette.CollectionBroad matches 1.. run {
                        execute unless score .cassetteSlot uiCassette.CollectionBroad matches 21.. run block { with storage minecraft:cassette fetch
                            scoreboard players add .cassetteSlot uiCassette.CollectionBroad 1
                            execute store result storage minecraft:cassette fetch.number int 1 run scoreboard players get .cassetteSlot uiCassette.CollectionBroad

                            $data modify storage minecraft:cassette fetch merge from storage minecraft:cassette index.$(lookup)
                            block { with storage minecraft:cassette fetch
                                $data modify storage minecraft:ui cassette.collection.slot$(number)_name set from storage minecraft:cassette index.$(lookup).name
                                $execute if entity @s[tag=cassetteSettings.ShowCollectionID] run data modify storage minecraft:ui cassette.collection.slot$(number)_name append value {"text":" ID $(lookup)","italic":false,"color":"gray"}

                                $data modify storage minecraft:ui cassette.collection.slot$(number)_lore set from storage minecraft:cassette fetch.built_lore
                                $data merge storage minecraft:ui {cassette:{collection:{slot$(number)_color:"red",slot$(number)_model:"minecraft:cassettes/$(lookup)",slot$(number)_visibility:"false",slot$(number)_id:$(lookup),slot$(number)_entry:$(entry),slot$(number)_overlay:1}}}
                                $execute if entity @s[advancements={cassette:ownership/$(lookup)=true}] run block { with storage minecraft:cassette fetch
                                    $data merge storage minecraft:ui {cassette:{collection:{slot$(number)_color:"green",slot$(number)_overlay:0}}}
                                    $execute if score @s uiCassette.CollectionOperation matches 2 if entity @s[tag=cassettePlayed.Playlist1_$(lookup)] run data merge storage minecraft:ui {cassette:{collection:{slot$(number)_overlay:3}}}
                                    $execute if score @s uiCassette.CollectionOperation matches 3 if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] run data merge storage minecraft:ui {cassette:{collection:{slot$(number)_overlay:3}}}
                                }
                            }
                        }
                    }
                    # searching for right page
                    execute if score .indexOffset uiCassette.CollectionBroad matches 1.. run scoreboard players remove .indexOffset uiCassette.CollectionBroad 1

                    # continue the search
                    execute unless score .incrementIndex uiCassette.CollectionBroad matches 105.. run function ui:cassette/collection/sort/default
                }
            }
        }

        function expand {
            execute in minecraft:overworld run item replace block 0 -64 0 container.0 from entity @s player.cursor
            execute in minecraft:overworld run data modify storage minecraft:ability fetch.click_id set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.ability_id
            block { with storage minecraft:ability fetch
                $scoreboard players set @s uiAbility.SelectionChoice $(click_id)
                function ui:ability/selection/choice/flip
                # $data modify storage minecraft:ability fetch.target set from storage minecraft:ability index.$(click_id).path
                # block { with storage minecraft:ability fetch
                #     $function ui:ability/selection/$(target)/flip
                # }
            }
        }

        function flip {
            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
            function ui:ability/selection/open
        }

        dir choice {
            function mask {
                $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/flip"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"P","italic":false,"color":"#b841c8"},{"text":"a","italic":false,"color":"#bf4bce"},{"text":"s","italic":false,"color":"#c556d4"},{"text":"s","italic":false,"color":"#cc60da"},{"text":"i","italic":false,"color":"#d36ae0"},{"text":"v","italic":false,"color":"#d975e7"},{"text":"e","italic":false,"color":"#e07fed"},{"text":"(","italic":false,"color":"#e789f3"},{"text":"s","italic":false,"color":"#ed94f9"},{"text":") ","italic":false,"color":"#f49eff"},{"text":"&","italic":false,"color":"gray"},{"text":" ","italic":false,"color":"#ff5cc3"},{"text":"A","italic":false,"color":"#99e0ff"},{"text":"w","italic":false,"color":"#93dcfc"},{"text":"a","italic":false,"color":"#8cd7f8"},{"text":"k","italic":false,"color":"#86d3f5"},{"text":"e","italic":false,"color":"#80cff1"},{"text":"n","italic":false,"color":"#7acbee"},{"text":"i","italic":false,"color":"#73c6ea"},{"text":"n","italic":false,"color":"#6dc2e7"},{"text":"g","italic":false,"color":"#67bee3"},{"text":"(","italic":false,"color":"#61bae0"},{"text":"s","italic":false,"color":"#5ab5dc"},{"text":")","italic":false,"color":"#54b1d9"}],"minecraft:lore":$(passive),"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/choice/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"Moveset","italic":false,"color":"#83cb48"}],"minecraft:lore":[[{"text":"Access ","italic":false,"color":"gray"},{"text":"all","italic":false,"color":"#ce47ff"},{"text":" of the ","italic":false,"color":"gray"},{"text":"available moves","italic":false,"color":"#5ee4bb"}],[{"text":"for ","italic":false,"color":"gray"},{"text":"$(proper_name)","italic":false,"color":"#fffb85"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/choice/moveset"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":[{"text":"S","italic":false,"color":"#fffc99"},{"text":"k","italic":false,"color":"#fffc8d"},{"text":"i","italic":false,"color":"#fffb81"},{"text":"n","italic":false,"color":"#fffb76"},{"text":"(","italic":false,"color":"#fffa6a"},{"text":"s","italic":false,"color":"#fffa5e"},{"text":")","italic":false,"color":"#fff952"}],"minecraft:lore":[[{"text":"Browse ","italic":false,"color":"gray"},{"text":"all","italic":false,"color":"#ce47ff"},{"text":" available options to ","italic":false,"color":"gray"},{"text":"modify","italic":false,"color":"#5ee4bb"}],[{"text":"the ","italic":false,"color":"gray"},{"text":"appearance","italic":false,"color":"#5ee4bb"},{"text":" of ","italic":false,"color":"gray"},{"text":"$(proper_name)","italic":false,"color":"#fffb85"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/choice/skin/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_style":"minecraft:$(path)","minecraft:item_name":$(ability_name),"minecraft:lore":$(ability_price),"minecraft:custom_data":{ui_item:{enhanced_button:1b,purchase_choice:1b,product:"ability"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/ability/$(path)/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/choice/same"}}}}]
            }

            function open {
                execute at @s as @p run function ui:ability/selection/choice/player

                function ui:ability/selection/choice/mask with storage minecraft:ui ability.choice
                data modify storage ui current set from storage ui mask
                execute on passengers run data modify entity @s data.page.mask set value "function ui:ability/selection/choice/mask"
            }

            function player {
                scoreboard players set @s uiAbility.ChoicePage 1
                execute store result storage minecraft:ui ability.choice.ability_id int 1 run scoreboard players get @s uiAbility.SelectionChoice
                block { with storage minecraft:ui ability.choice
                    $function ui:purchase/generate/product {ability_id:$(ability_id),product_name:"ability"}
                    $data modify storage minecraft:ui ability.choice merge from storage minecraft:ability index.$(ability_id)
                }
            }

            function flip {
                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                function ui:ability/selection/choice/open
            }

            function same {
                execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                function ui:ability/selection/choice/open
            }

            dir skin {
                function mask {
                    $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(skin1_model)","minecraft:tooltip_style":"minecraft:$(path)","minecraft:tooltip_display":{hide_tooltip:$(skin1_display)},"minecraft:item_name":$(skin1_name),"minecraft:lore":$(skin1_price),"minecraft:custom_data":{ui_item:{enhanced_button:1b,purchase_choice:1b,product:"skin1"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(skin2_model)","minecraft:tooltip_style":"minecraft:$(path)","minecraft:tooltip_display":{hide_tooltip:$(skin2_display)},"minecraft:item_name":$(skin2_name),"minecraft:lore":$(skin2_price),"minecraft:custom_data":{ui_item:{enhanced_button:1b,purchase_choice:1b,product:"skin2"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(skin3_model)","minecraft:tooltip_style":"minecraft:$(path)","minecraft:tooltip_display":{hide_tooltip:$(skin3_display)},"minecraft:item_name":$(skin3_name),"minecraft:lore":$(skin3_price),"minecraft:custom_data":{ui_item:{enhanced_button:1b,purchase_choice:1b,product:"skin3"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(skin4_model)","minecraft:tooltip_style":"minecraft:$(path)","minecraft:tooltip_display":{hide_tooltip:$(skin4_display)},"minecraft:item_name":$(skin4_name),"minecraft:lore":$(skin4_price),"minecraft:custom_data":{ui_item:{enhanced_button:1b,purchase_choice:1b,product:"skin4"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/ability/$(path)/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:ability/selection/choice/skin/same"}}}}]
                }

                function open {
                    execute at @s as @p run function ui:ability/selection/choice/skin/player

                    function ui:ability/selection/choice/skin/mask with storage minecraft:ui ability.choice
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function ui:ability/selection/choice/skin/mask"
                }

                function player {
                    scoreboard players set @s uiAbility.ChoicePage 3
                    execute store result storage minecraft:ui ability.choice.ability_id int 1 run scoreboard players get @s uiAbility.SelectionChoice
                    block { with storage minecraft:ui ability.choice
                        REPEAT (1,4) as i {
                            $function ui:purchase/generate/product {ability_id:$(ability_id),product_name:"skin<%i%>"}
                        }
                        $data modify storage minecraft:ui ability.choice merge from storage minecraft:ability index.$(ability_id)
                    }
                }

                function flip {
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    function ui:ability/selection/choice/skin/open
                }
            }
        }
    }
}

dir cassette {
    function give {
        give @s phantom_membrane[lore=[[{"text":"Collect and listen to various genres of Cassettes!","italic":false,"color":"gray"}]],item_name=[{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],max_stack_size=1,item_model="minecraft:interactables/cassette_player",custom_data={custom_ui:1b,cassette_player:1b}]
    }

    dir menu {
        function mask {
            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"P","italic":false,"color":"#00cc4e"},{"text":"l","italic":false,"color":"#00c645"},{"text":"a","italic":false,"color":"#00bf3c"},{"text":"y","italic":false,"color":"#00b933"},{"text":" ","italic":false,"color":"#00b32a"},{"text":"S","italic":false,"color":"#00ac20"},{"text":"o","italic":false,"color":"#00a617"},{"text":"n","italic":false,"color":"#009f0e"},{"text":"g","italic":false,"color":"#009905"}],"minecraft:lore":$(play_display),"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/play/main"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"S","italic":false,"color":"#ff6666"},{"text":"t","italic":false,"color":"#f6595e"},{"text":"o","italic":false,"color":"#ec4d56"},{"text":"p","italic":false,"color":"#e3404d"},{"text":" ","italic":false,"color":"#d93345"},{"text":"S","italic":false,"color":"#d0263d"},{"text":"o","italic":false,"color":"#c61a35"},{"text":"n","italic":false,"color":"#bd0d2c"},{"text":"g","italic":false,"color":"#b30024"}],"minecraft:lore":[[{"text":"Cease all ","italic":false,"color":"gray"},{"text":"feedback","italic":false,"color":"yellow"},{"text":" from the","italic":false,"color":"gray"}],[{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/stop"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Config M","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"yellow"},{"text":"n","italic":false,"color":"#b0b0b0"},{"text":"u","italic":false,"color":"#ff57f9"}],"minecraft:lore":[[{"text":"Customize various ","italic":false,"color":"gray"},{"text":"behaviors","italic":false,"color":"yellow"}],[{"text":"of the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],"",["",{"text":"Click","italic":false,"color":"blue"},{"text":" for ","italic":false,"color":"gray"},{"text":"Generic","italic":false,"color":"green"},{"text":" access","italic":false,"color":"gray"}],["",{"text":"Shift-Click","italic":false,"color":"blue"},{"text":" with ","italic":false,"color":"gray"},{"text":"OP","italic":false,"color":"yellow"},{"text":" for ","italic":false,"color":"gray"},{"text":"A","italic":false,"color":"red"},{"text":"d","italic":false,"color":"#ff802b"},{"text":"mi","italic":false,"color":"gold"},{"text":"ni","italic":false,"color":"yellow"},{"text":"st","italic":false,"color":"green"},{"text":"ra","italic":false,"color":"blue"},{"text":"to","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"},{"text":" access","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{enhanced_button:1b,cassette_settings:1b}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"C","italic":false,"color":"red"},{"text":"ol","italic":false,"color":"gold"},{"text":"le","italic":false,"color":"yellow"},{"text":"ct","italic":false,"color":"green"},{"text":"io","italic":false,"color":"blue"},{"text":"n","italic":false,"color":"light_purple"}],"minecraft:lore":[[{"text":"Browse the ","italic":false,"color":"gray"},{"text":"complete list","italic":false,"color":"aqua"},{"text":" of all","italic":false,"color":"gray"}],[{"text":"obtainable ","italic":false,"color":"gray"},{"text":"cassettes","italic":false,"color":"yellow"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/collection/flip"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"dark_aqua","italic":false,"text":"Listening Parties"},"minecraft:lore":[[{"text":"Share unlocked ","italic":false,"color":"gray"},{"text":"songs ","italic":false,"color":"yellow"},{"text":"with other","italic":false,"color":"gray"}],[{"text":"players by ","italic":false,"color":"gray"},{"text":"creating ","italic":false,"color":"green"},{"text":"a ","italic":false,"color":"gray"},{"text":"party ","italic":false,"color":"aqua"},{"text":"or","italic":false,"color":"gray"}],[{"text":"joining ","italic":false,"color":"green"},{"text":"an ongoing one","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/party/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Sta","italic":false,"color":"red"},{"text":"t","italic":false,"color":"yellow"},{"text":"ist","italic":false,"color":"yellow"},{"text":"i","italic":false,"color":"green"},{"text":"cs","italic":false,"color":"green"}],"minecraft:lore":[[{"text":"Monitor the ","italic":false,"color":"gray"},{"text":"remainder ","italic":false,"color":"aqua"},{"text":"of ","italic":false,"color":"gray"},{"text":"cassettes","italic":false,"color":"yellow"}],[{"text":"required for ","italic":false,"color":"gray"},{"text":"completion","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/statistics/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/cassette/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/same"}}}}]
        }

        function open {
            tag @s remove uiCassette.PartyMenu
            execute at @s as @p run function ui:cassette/menu/player
            function ui:cassette/menu/mask with storage minecraft:ui cassette.menu
            data modify storage ui current set from storage ui mask
            execute on passengers run data modify entity @s data.page.mask set value "function ui:cassette/menu/mask"
        }

        function player {
            execute unless score @s uiCassette.SettingsFeedback matches 1.. run scoreboard players set @s uiCassette.SettingsFeedback 1
            execute unless score @s uiCassette.SettingsParty matches 1.. run scoreboard players set @s uiCassette.SettingsParty 1
            execute unless score @s uiCassette.SettingsTargeting matches 1.. run scoreboard players set @s uiCassette.SettingsTargeting 1
            execute unless score @s uiCassette.CollectionSort matches 1.. run scoreboard players set @s uiCassette.CollectionSort 1
            execute unless score @s cassettePlay.Last matches 1.. run scoreboard players set @s cassettePlay.Last 1

            function ui:cassette/menu/play/display     
        }

        function same {
            execute at @s as @p run playsound minecraft:cassette.ui.error record @s ~ ~ ~
            function ui:cassette/menu/open
        }

        function flip {
            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
            function ui:cassette/menu/open
        }

        function stop {
            execute at @s as @p run {
                stopsound @s record
                tag @s remove cassettePlayed.Song
                scoreboard players reset @s cassettePlay.Duration
                scoreboard players reset @s cassettePlay.ID
                scoreboard players reset @s cassettePlay.FeedbackIncrement
                playsound minecraft:cassette.menu.stop record @s ~ ~ ~

                execute if entity @s[tag=cassetteParty.Host] run {
                    execute as @e[type=minecraft:chest_minecart,tag=ui,tag=uiCassette.PartyMenu] at @s run {
                        function ui:cassette/party/open
                        function ui:logic/load/on_input
                    }
                }
            }
            function ui:cassette/menu/open
        }
        
        dir play {
            function main {
                execute at @s as @p run {
                    scoreboard players reset @s cassettePlay.Duration
                    scoreboard players reset @s cassettePlay.Incremental
                    playsound minecraft:cassette.menu.play record @s ~ ~ ~
                    execute if score @s uiCassette.SettingsTargeting matches 1 run {
                        execute if score @s uiCassette.CollectionSort matches 1..6 run function ui:cassette/menu/play/target/all
                        execute if score @s uiCassette.CollectionSort matches 7 run function ui:cassette/menu/play/target/playlist1
                        execute if score @s uiCassette.CollectionSort matches 8 run function ui:cassette/menu/play/target/playlist2
                    }
                    execute if score @s uiCassette.SettingsTargeting matches 2 run function ui:cassette/menu/play/target/all
                    execute if score @s uiCassette.SettingsTargeting matches 3 run function ui:cassette/menu/play/target/playlist1
                    execute if score @s uiCassette.SettingsTargeting matches 4 run function ui:cassette/menu/play/target/playlist2
                }
                function ui:cassette/menu/open
            }

            function display {
                execute if score @s uiCassette.SettingsTargeting matches 1 run {
                    execute if score @s uiCassette.CollectionSort matches 1..6 run data merge storage minecraft:ui {cassette:{menu:{play_type:"All"}}}
                    execute if score @s uiCassette.CollectionSort matches 7 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #1"}}}
                    execute if score @s uiCassette.CollectionSort matches 8 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #2"}}}
                }
                execute if score @s uiCassette.SettingsTargeting matches 2 run data merge storage minecraft:ui {cassette:{menu:{play_type:"All"}}}
                execute if score @s uiCassette.SettingsTargeting matches 3 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #1"}}}
                execute if score @s uiCassette.SettingsTargeting matches 4 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #2"}}}

                execute if score @s uiCassette.SettingsFeedback matches 1 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Random"}}}
                execute if score @s uiCassette.SettingsFeedback matches 2 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Increment"}}}
                execute if score @s uiCassette.SettingsFeedback matches 3 run data merge storage minecraft:ui {cassette:{menu:{feedback_type:"Loop"}}}

                block { with storage minecraft:ui cassette.menu
                    $data merge storage minecraft:ui {cassette:{menu:{play_display:[[{"text":"Listen to songs from your","italic":false,"color":"gray"}],[{"text":"current collection","italic":false,"color":"gray"}],"",[{"text":"Behavior Style","italic":false,"color":"gold"}],["",{"text":"Song: ","italic":false,"color":"gray"},{"text":"Nothing Playing","italic":false,"color":"red"}],[{"text":"Playing from: ","italic":false,"color":"gray"},{"text":"$(play_type)","italic":false,"color":"green"}],["",{"text":"Feedback: ","italic":false,"color":"gray"},{"text":"$(feedback_type)","italic":false,"color":"green"}]]}}}

                    execute if entity @s[tag=cassettePlayed.Song] run {
                        execute store result storage minecraft:ui cassette.menu.lookup int 1 run scoreboard players get @s cassettePlay.ID
                        block { with storage minecraft:ui cassette.menu
                            $data modify storage minecraft:ui cassette.menu.name set from storage minecraft:cassette index.$(lookup).name
                            $data modify storage minecraft:ui cassette.menu.artist set from storage minecraft:cassette index.$(lookup).artist
                            data modify storage minecraft:ui cassette.menu.song_line set value [""]
                            data modify storage minecraft:ui cassette.menu.song_line append from storage minecraft:ui cassette.menu.name[]
                            block { with storage minecraft:ui cassette.menu
                                $data modify storage minecraft:ui cassette.menu.song_line append value [{"text":" by ","italic":false,"color":"gray"},{"text":"$(artist)","italic":false,"color":"yellow"}]
                                block { with storage minecraft:ui cassette.menu
                                    $data merge storage minecraft:ui {cassette:{menu:{play_display:[[{"text":"Listen to songs from your","italic":false,"color":"gray"}],{"text":"current collection","italic":false,"color":"gray"},"",[{"text":"Behavior Style","italic":false,"color":"gold"}],["",{"text":"Song: ","italic":false,"color":"gray"},$(song_line)],["",{"text":"Playing from: ","italic":false,"color":"gray"},{"text":"$(play_type)","italic":false,"color":"green"}],["",{"text":"Feedback: ","italic":false,"color":"gray"},{"text":"$(feedback_type)","italic":false,"color":"green"}]]}}}
                                }
                            }
                        }
                    }
                }
            }

            dir feedback {
                dir random {
                    function main {
                        execute store result score @s cassettePlay.ID run random value 1..105
                        execute store result storage minecraft:cassette play.lookup int 1 run scoreboard players get @s cassettePlay.ID
                        execute store result storage minecraft:cassette play.last_played int 1 run scoreboard players get @s cassettePlay.Last

                        execute if score @s uiCassette.SettingsTargeting matches 1 run block { with storage minecraft:cassette play
                            $execute if score @s uiCassette.CollectionSort matches 1..6 if entity @s[advancements={cassette:ownership/$(lookup)=true}] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play

                            $execute if score @s uiCassette.CollectionSort matches 7 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist1_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play

                            $execute if score @s uiCassette.CollectionSort matches 8 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play
                        }
                        execute if score @s uiCassette.SettingsTargeting matches 2..4 run block { with storage minecraft:cassette play
                            $execute if score @s uiCassette.SettingsTargeting matches 2 if entity @s[advancements={cassette:ownership/$(lookup)=true}] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play

                            $execute if score @s uiCassette.SettingsTargeting matches 3 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist1_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play

                            $execute if score @s uiCassette.SettingsTargeting matches 4 if entity @s[advancements={cassette:ownership/$(lookup)=true}] if entity @s[tag=cassettePlayed.Playlist2_$(lookup)] unless entity @s[tag=cassettePlayed.$(lookup)] run function ui:cassette/menu/play/feedback/random/found with storage minecraft:cassette play
                        }
                    }

                    function found {
                        $data modify storage minecraft:cassette play merge from storage minecraft:cassette index.$(lookup)
                        function ui:cassette/menu/play/found with storage minecraft:cassette play
                    }
                }

                function increment {
                    tag @s add cassettePlay.FeedbackIncrementing
                    scoreboard players add @s cassettePlay.FeedbackIncrement 1
                    scoreboard players reset .cassetteSlot uiCassette.CollectionBroad
                    scoreboard players reset .incrementIndex uiCassette.CollectionBroad
                    scoreboard players reset .totalEntries uiCassette.CollectionBroad
                    scoreboard players reset .totalPassed uiCassette.CollectionBroad
                    scoreboard players set .targetedRating uiCassette.CollectionBroad 0
                    execute if score @s uiCassette.CollectionBroad matches 1 run scoreboard players reset .indexOffset uiCassette.CollectionBroad
                    execute if score @s uiCassette.CollectionBroad matches 2 run scoreboard players set .indexOffset uiCassette.CollectionBroad 21
                    execute if score @s uiCassette.CollectionBroad matches 3 run scoreboard players set .indexOffset uiCassette.CollectionBroad 42
                    execute if score @s uiCassette.CollectionBroad matches 4 run scoreboard players set .indexOffset uiCassette.CollectionBroad 63
                    execute if score @s uiCassette.CollectionBroad matches 5 run scoreboard players set .indexOffset uiCassette.CollectionBroad 84
                    
                    execute if score @s uiCassette.CollectionSort matches 1..3 run function ui:cassette/collection/sort/default
                    execute if score @s uiCassette.CollectionSort matches 4 run function ui:cassette/collection/sort/rating
                    execute if score @s uiCassette.CollectionSort matches 5 run function ui:cassette/collection/sort/alphabetical
                    execute if score @s uiCassette.CollectionSort matches 6 run function ui:cassette/collection/sort/artist
                    execute if score @s uiCassette.CollectionSort matches 7 run function ui:cassette/collection/sort/playlist1
                    execute if score @s uiCassette.CollectionSort matches 8 run function ui:cassette/collection/sort/playlist2
                    tag @s remove cassettePlay.FeedbackIncrementing

                    execute if score @s cassettePlay.FeedbackReturn matches 1.. run {
                        execute store result storage minecraft:cassette play.lookup int 1 run scoreboard players get @s cassettePlay.FeedbackReturn
                        execute store result storage minecraft:cassette play.last_played int 1 run scoreboard players get @s cassettePlay.Last
                        block { with storage minecraft:cassette play
                            $scoreboard players set @s cassettePlay.ID $(lookup)
                            $data modify storage minecraft:cassette play merge from storage minecraft:cassette index.$(lookup)
                            function ui:cassette/menu/play/found with storage minecraft:cassette play
                        }
                    }
                    execute unless score @s cassettePlay.FeedbackReturn matches 1.. run {
                        scoreboard players reset @s cassettePlay.FeedbackIncrement
                        function ui:cassette/menu/play/reshuffle {style:"all"}
                        function ui:cassette/menu/play/feedback/increment
                    }
                    scoreboard players reset @s cassettePlay.FeedbackReturn
                }
            }

            dir target {
                function all {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/all
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"all"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }

                function playlist1 {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/playlist1
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"playlist1"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }

                function playlist2 {
                    # random search
                    execute if score @s uiCassette.SettingsFeedback matches 1 run {
                        scoreboard players add @s cassettePlay.Incremental 1
                        execute unless score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/feedback/random/main

                            execute unless entity @s[tag=temp] run function ui:cassette/menu/play/target/playlist2
                            tag @s remove temp
                        }
                        execute if score @s cassettePlay.Incremental matches 200.. run {
                            function ui:cassette/menu/play/reshuffle {style:"playlist2"}
                        }
                    }

                    # increment search
                    execute if score @s uiCassette.SettingsFeedback matches 2 run function ui:cassette/menu/play/feedback/increment
                }
            }

            function reshuffle {
                scoreboard players reset @s cassettePlay.Incremental
                REPEAT (1,105) as i {
                    tag @s remove cassettePlayed.<%i%>
                }
                $function ui:cassette/menu/play/$(style)
            }

            function found {
                $scoreboard players set @s cassettePlay.MaxDuration $(real_duration)
                $stopsound @s record minecraft:cassette.$(last_played)
                $playsound minecraft:cassette.$(lookup) record @s
                tag @s add cassettePlayed.Song

                execute if entity @s[tag=cassetteParty.Host] run function ui:cassette/menu/play/party

                $tag @s add cassettePlayed.$(lookup)
                $scoreboard players set @s cassettePlay.Last $(lookup)
                tag @s add temp
            }

            function party {
                execute as @e[type=minecraft:chest_minecart,tag=ui,tag=uiCassette.PartyMenu] at @s run {
                    function ui:cassette/party/open
                    function custom:ui/menu/on_input
                }

                execute store result storage minecraft:cassette play.partyID int 1 run scoreboard players get @s uiCassette.PartyLogic
                block { with storage minecraft:cassette play
                    $execute as @a[tag=customCassette.Party$(partyID)Member] at @s run block { with storage minecraft:cassette play
                        $stopsound @s record minecraft:cassette.$(last_played)
                        $playsound minecraft:cassette.$(lookup) record @s ~ ~ ~ 9999999999999
                    }
                }
            }
        }
    }

    dir settings {
        dir default {
            function mask {
                $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"blue","italic":false,"text":"Feedback Style"},"minecraft:lore":$(feedback_style),"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/settings/default/feedback"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Targeting ","italic":false,"color":"red"},{"text":"Style","italic":false,"color":"white"}],"minecraft:lore":$(targeting_style),"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/settings/default/targeting"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"dark_aqua","italic":false,"text":"Party Behavior"},"minecraft:lore":$(party_behavior),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/cassettes/settings/default/party"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/cassette/default_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function ui:cassette/settings/default/same"}}}}]
            }

            function open {
                execute at @s as @p run function ui:cassette/settings/default/player
                function ui:cassette/settings/default/mask with storage minecraft:ui cassette.settings.default
                data modify storage ui current set from storage ui mask
                execute on passengers run data modify entity @s data.page.mask set value "function ui:cassette/settings/default/mask"
            }

            function player {
                # Feedback
                data merge storage minecraft:ui {cassette:{settings:{default:{feedback_style:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"behaves","italic":false,"color":"yellow"},{"text":" following the ","italic":false,"color":"gray"},{"text":"ending","italic":false,"color":"red"},{"text":" of a","italic":false,"color":"gray"}],[{"text":"song","italic":false,"color":"gray"}],"",[{"text":"Feedback Variation","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Randomize Song","italic":false,"color":"green"}],[{"text":"[X] Increment Song","italic":false,"color":"gray"}],[{"text":"[X] Loop Song","italic":false,"color":"gray"}]]}}}}
                execute if score @s uiCassette.SettingsFeedback matches 2 run data merge storage minecraft:ui {cassette:{settings:{default:{feedback_style:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"behaves","italic":false,"color":"yellow"},{"text":" following the ","italic":false,"color":"gray"},{"text":"ending","italic":false,"color":"red"},{"text":" of a","italic":false,"color":"gray"}],[{"text":"song","italic":false,"color":"gray"}],"",[{"text":"Feedback Variation","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Randomize Song","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Increment Song","italic":false,"color":"green"}],[{"text":"[X] Loop Song","italic":false,"color":"gray"}]]}}}}
                execute if score @s uiCassette.SettingsFeedback matches 3 run data merge storage minecraft:ui {cassette:{settings:{default:{feedback_style:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"behaves","italic":false,"color":"yellow"},{"text":" following the ","italic":false,"color":"gray"},{"text":"ending","italic":false,"color":"red"},{"text":" of a","italic":false,"color":"gray"}],[{"text":"song","italic":false,"color":"gray"}],"",[{"text":"Feedback Variation","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Randomize Song","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Increment Song","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Loop Song","italic":false,"color":"green"}]]}}}}

                # Party
                data merge storage minecraft:ui {cassette:{settings:{default:{party_behavior:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"notifies","italic":false,"color":"yellow"},{"text":" ","italic":false,"color":"yellow"},{"text":"the user about ","italic":false,"color":"gray"},{"text":"party","italic":false,"color":"aqua"}],[{"text":"changes","italic":false,"color":"aqua"}],"",[{"text":"Party Behavior","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Default","italic":false,"color":"green"}],[{"text":"[X] Disable Toast Notifications","italic":false,"color":"gray"}],["",{"text":"[X] Disable P","italic":false,"color":"gray"},{"text":"a","italic":false,"color":"gray"},{"text":"r","italic":false,"color":"gray"},{"text":"t","italic":false,"color":"gray"},{"text":"y","italic":false,"color":"gray"},{"text":" ","italic":false,"color":"gray"},{"text":"SFX","italic":false,"color":"gray"}],[{"text":"[X] Disable All","italic":false,"color":"gray"}]]}}}}
                execute if score @s uiCassette.SettingsParty matches 2 run data merge storage minecraft:ui {cassette:{settings:{default:{party_behavior:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"notifies","italic":false,"color":"yellow"},{"text":" ","italic":false,"color":"yellow"},{"text":"the user about ","italic":false,"color":"gray"},{"text":"party","italic":false,"color":"aqua"}],[{"text":"changes","italic":false,"color":"aqua"}],"",[{"text":"Party Behavior","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Default","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Disable Toast Notifications","italic":false,"color":"green"}],[{"text":"[X] Disable Party SFX","italic":false,"color":"gray"}],[{"text":"[X] Disable All","italic":false,"color":"gray"}]]}}}}
                execute if score @s uiCassette.SettingsParty matches 3 run data merge storage minecraft:ui {cassette:{settings:{default:{party_behavior:[["",{"text":"Determine how the ","italic":false,"color":"gray"},{"text":"C","italic":false,"color":"red"},{"text":"a","italic":false,"color":"#ff802b"},{"text":"ss","italic":false,"color":"gold"},{"text":"e","italic":false,"color":"#ffd52b"},{"text":"tt","italic":false,"color":"yellow"},{"text":"e","italic":false,"color":"#aaff55"},{"text":" P","italic":false,"color":"green"},{"text":"la","italic":false,"color":"blue"},{"text":"ye","italic":false,"color":"light_purple"},{"text":"r","italic":false,"color":"dark_purple"}],["",{"text":"notifies","italic":false,"color":"yellow"},{"text":" ","italic":false,"color":"yellow"},{"text":"the user about ","italic":false,"color":"gray"},{"text":"party","italic":false,"color":"aqua"}],[{"text":"changes","italic":false,"color":"aqua"}],"",[{"text":"Party Behavior","italic":false,"color":"gold"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Default","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"gray"},{"text":"X] Disable Toast Notifications","italic":false,"color":"gray"}],["",{"text":"[","italic":false,"color":"dark_green"},{"text":"X","italic":false,"color":"green"},{"text":"]","italic":false,"color":"dark_green"},{"text":" Disable Party SFX","italic":false,"color":"green"}],[{"text":"[X] Disable All","italic":false,"color":"gray"}]]}}}}
