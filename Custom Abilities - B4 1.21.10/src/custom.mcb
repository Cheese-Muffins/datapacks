advancement connect {
  "criteria": {
    "join": {
      "trigger": "minecraft:tick"
    }
  },
  "requirements": [
    [
      "join"
    ]
  ],
  "rewards": {
    "function": "custom:connect"
  }
}

advancement taken_damage {
    "criteria": {
      "requirement": {
        "trigger": "minecraft:entity_hurt_player"
      }
    },
    "rewards": {
      "function": "custom:universal/damage/self"
    }
}
  


function on_load {
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy

    scoreboard objectives add ui dummy
    scoreboard objectives add ui.id dummy
    scoreboard objectives add customUI.PurchaseConfirm dummy
    scoreboard objectives add customUI.PurchaseItemCount dummy
    scoreboard objectives add customUI.SkinLastPatchID dummy
    scoreboard objectives add customUI.SkinPatchID dummy
    scoreboard objectives add customUI.PlayerOP dummy
    scoreboard objectives add customUI.SelectedOdds dummy

    scoreboard objectives add customUniversal.GlobalCounter dummy
    scoreboard objectives add customUniversal.RigID dummy
    scoreboard objectives add customUniversal.AwakeningDuration dummy
    scoreboard players set div16 customUniversal.AwakeningDuration 16
    scoreboard players set x20 customUniversal.AwakeningDuration 20
    scoreboard objectives add customUniversal.Toggle dummy
    scoreboard objectives add customUniversal.ToggleDelay dummy
    scoreboard objectives add customUniversal.CooldownMath dummy
    scoreboard objectives add customUniversal.MoveLastUsed dummy
    scoreboard players set div20 customUniversal.CooldownMath 20
    scoreboard players set mult50 customUniversal.CooldownMath 50
    scoreboard players set div100 customUniversal.CooldownMath 100
    scoreboard objectives add customUniversal.FailReturn dummy
    scoreboard objectives add customUniversal.ActiveHotbar dummy
    REPEAT (1,9) as i {
        scoreboard objectives add customUniversal.Move<%i%>Cooldown dummy
        scoreboard objectives add customUniversal.Move<%i%>CooldownConverted dummy
        scoreboard objectives add customUniversal.Delay<%i%> dummy
    }
    REPEAT (1,6) as i {
        scoreboard objectives add customUniversal.Move<%i%>Trigger trigger
    }
    scoreboard objectives add customUniversal.ToggleTrigger trigger
    scoreboard objectives add customUniversal.MoveDelay dummy
    scoreboard objectives add customUniversal.MoveCooldowns dummy
    scoreboard players set x20 customUniversal.MoveCooldowns 20
    scoreboard players set div11 customUniversal.MoveCooldowns 11
    scoreboard objectives add customUniversal.VFXCount dummy
    scoreboard objectives add customUniversal.VFXSpeed dummy
    scoreboard objectives add customUniversal.SecretInteractionCount dummy
    scoreboard objectives add customUniversal.QuestID dummy
    scoreboard objectives add customUniversal.QuestDialogue dummy

    # Gojo Satoru #
    scoreboard objectives add customGojo.InfinityPassive dummy
    scoreboard objectives add customGojo.LapisBlueID dummy
    scoreboard objectives add customGojo.ReversalRedID dummy
    scoreboard objectives add customGojo.HollowPurpleID dummy
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:1,move:1,cooldown:120}
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:2,move:2,cooldown:15}
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:3,move:3,cooldown:18}
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:4,move:4,cooldown:25}
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:5,move:5,cooldown:40}
    function custom:universal/cooldowns {ability:"Gojo",storage:"gojo",path:6,move:6,cooldown:90}
    function custom:abilities/gojo/awakening/duration {duration:240}

    # Yuji Itadori #
    scoreboard objectives add customYuji.DomainID dummy
    scoreboard objectives add customYuji.ShrineDelay dummy
    scoreboard objectives add customYuji.DomainX dummy
    scoreboard objectives add customYuji.DomainY dummy
    scoreboard objectives add customYuji.DomainZ dummy

    scoreboard objectives add customYuji.DomainDimension dummy
    function custom:universal/cooldowns {ability:"Yuji",storage:"yuji",path:1,move:1,cooldown:30}
    function custom:universal/cooldowns {ability:"Yuji",storage:"yuji",path:2,move:2,cooldown:30}
    function custom:universal/cooldowns {ability:"Yuji",storage:"yuji",path:3,move:3,cooldown:30}
    function custom:abilities/yuji/awakening/duration {duration:240}

    # The World #
    scoreboard objectives add customTheWorld.RigID dummy
    scoreboard objectives add customTheWorld.IdleMode dummy
    scoreboard objectives add customTheWorld.Timeskip dummy
    scoreboard objectives add customTheWorld.BarrageID dummy
    scoreboard objectives add customTheWorld.ImpaleID dummy
    scoreboard objectives add customTheWorld.ImpaleRotationX dummy
    scoreboard objectives add customTheWorld.ImpaleX dummy
    scoreboard objectives add customTheWorld.ImpaleY dummy
    scoreboard objectives add customTheWorld.ImpaleZ dummy
    scoreboard objectives add customTheWorld.KnifeThrowID dummy
    scoreboard objectives add customTheWorld.KnifeMovement dummy
    function custom:universal/cooldowns {ability:"The_World",storage:"the_world",path:1,move:1,cooldown:7}
    function custom:universal/cooldowns {ability:"The_World",storage:"the_world",path:2,move:2,cooldown:19}
    function custom:universal/cooldowns {ability:"The_World",storage:"the_world",path:3,move:3,cooldown:35}
    function custom:universal/cooldowns {ability:"The_World",storage:"the_world",path:4,move:4,cooldown:6}

    # Dice #
    scoreboard objectives add customDice.RollValue dummy
    scoreboard objectives add customDice.RollDelay dummy
    scoreboard objectives add customDice.PreviousRoll dummy
    scoreboard objectives add customDice.SecondaryRollValue dummy
    scoreboard objectives add customDice.TertiaryRollValue dummy
    scoreboard objectives add customDice.TranslocationX dummy
    scoreboard objectives add customDice.TranslocationZ dummy

        # Passives #
        scoreboard objectives add customDice.ActivePassive dummy
        scoreboard objectives add customDice.PassiveRepetitiveTimer dummy


    function custom:universal/cooldowns {ability:"Dice",storage:"dice",path:1,move:1,cooldown:30}
    function custom:universal/cooldowns {ability:"Dice",storage:"dice",path:2,move:2,cooldown:30}
    function custom:universal/cooldowns {ability:"Dice",storage:"dice",path:3,move:3,cooldown:30}
    function custom:universal/cooldowns {ability:"Dice",storage:"dice",path:3,move:4,cooldown:1}






    # Billy #
    scoreboard objectives add customBilly.RigID dummy
    scoreboard objectives add customBilly.ToggleOnText dummy
    scoreboard objectives add customBilly.PassiveSnowParticles dummy
    scoreboard objectives add customBilly.PassiveMaul dummy
    scoreboard objectives add customBilly.EncourageBuffDuration dummy
    scoreboard objectives add customBilly.PhaseMovement dummy
    scoreboard objectives add customBilly.TrapDuration dummy
    scoreboard objectives add customBilly.TrapLinger dummy
    scoreboard objectives add customBilly.TrapSuccess dummy
    scoreboard objectives add customBilly.DevourID dummy
    scoreboard objectives add customBilly.DevourX dummy
    scoreboard objectives add customBilly.DevourY dummy
    scoreboard objectives add customBilly.DevourZ dummy
    scoreboard objectives add customBilly.DevourRotationX dummy

    function custom:universal/cooldowns {ability:"Billy",storage:"billy",path:1,move:1,cooldown:30}
    function custom:universal/cooldowns {ability:"Billy",storage:"billy",path:2,move:2,cooldown:30}
    function custom:universal/cooldowns {ability:"Billy",storage:"billy",path:3,move:3,cooldown:30}

    # Toji #
    scoreboard objectives add customToji.QuestProgress dummy
    scoreboard objectives add customToji.ObtainmentMonsterKills dummy
    scoreboard objectives add customToji.PassiveBloodlust dummy
    scoreboard objectives add customToji.AcrobaticsX dummy
    scoreboard objectives add customToji.AcrobaticsY dummy
    scoreboard objectives add customToji.AcrobaticsZ dummy
    scoreboard objectives add customToji.AcrobaticsRotationX dummy
    scoreboard objectives add customToji.AcrobaticsAnimation dummy
    scoreboard objectives add customToji.SpringX dummy
    scoreboard objectives add customToji.SpringY dummy
    scoreboard objectives add customToji.SpringZ dummy
    scoreboard objectives add customToji.SpringRotationX dummy
    scoreboard objectives add customToji.SpringMath dummy
    scoreboard players set div15 customToji.SpringMath 15
    scoreboard players set div15 customToji.SpringMath 15
    scoreboard objectives add customToji.Spring2DIncrements dummy
    scoreboard objectives add customToji.SpringYIncrements dummy
    
    function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:1,move:1,cooldown:30}
    function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:2,move:2,cooldown:30}
    function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:3,move:3,cooldown:30}
    function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:4,move:4,cooldown:30}

    # The Avatar #
    scoreboard objectives add customAvatar.PassiveAirMotion dummy
    function custom:universal/cooldowns {ability:"Avatar",storage:"avatar",path:1,move:1,cooldown:30}
    function custom:universal/cooldowns {ability:"Avatar",storage:"avatar",path:2,move:2,cooldown:30}
    function custom:universal/cooldowns {ability:"Avatar",storage:"avatar",path:3,move:3,cooldown:30}
    function custom:universal/cooldowns {ability:"Avatar",storage:"avatar",path:4,move:4,cooldown:30}
}

function tick {
    execute as @a[tag=CustomAbility.User] run {
        execute if entity @s[tag=customAbility.Gojo] run function custom:abilities/gojo/tick
        execute if entity @s[tag=customAbility.TheWorld] run function custom:abilities/the_world/tick
        execute if entity @s[tag=customAbility.Dice] run function custom:abilities/dice/tick
        execute if entity @s[tag=customAbility.Billy] run function custom:abilities/billy/tick
        execute if entity @s[tag=customAbility.Toji] run function custom:abilities/toji/tick
        execute if entity @s[tag=customAbility.Yuji] run function custom:abilities/yuji/tick
        execute if entity @s[tag=customAbility.Avatar] run function custom:abilities/avatar/tick

        execute if score @s customUniversal.ToggleTrigger matches 1.. run {
            execute at @s run function custom:universal/toggle/main
            scoreboard players reset @s customUniversal.ToggleTrigger
            scoreboard players enable @s customUniversal.ToggleTrigger
        }
    }

    execute as @e[type=!#custom:not_mob,tag=customUniversal.ConstantCheck] at @s run {
        execute if entity @s[tag=customTheWorld.BarrageVictim] unless entity @e[type=minecraft:item_display,tag=aj.the_world.locator.hitbox,tag=customTheWorld.BarrageAnchor,distance=..2.5] run {
            attribute @s minecraft:movement_speed base reset
            attribute @s minecraft:jump_strength base reset
            effect clear @s minecraft:weakness
            tag @s remove customUniversal.ConstantCheck
            tag @s remove customTheWorld.BarrageVictim
        }

        execute if score @s customBilly.EncourageBuffDuration matches 1.. run {
            scoreboard players remove @s customBilly.EncourageBuffDuration 1

            execute unless score @s customBilly.EncourageBuffDuration matches 1.. run {
                attribute @s minecraft:movement_speed modifier remove custom:billy.encourage
            }
        }

        execute if entity @s[type=minecraft:item_display,tag=aj.yuji_vfx.root,tag=customYuji.ShrineIDAssigned] if score @s customYuji.ShrineDelay matches 1.. run {
            scoreboard players remove @s customYuji.ShrineDelay 1
            execute if score @s customYuji.ShrineDelay matches 0 run {
                function animated_java:yuji_vfx/animations/shrine_spawn/play
                tag @s add customYuji.ShrinePlaying
                tag @s remove customUniversal.ConstantCheck
            }
        }
    }

    execute as @e[type=minecraft:item_display,tag=customUniversal.Tick] at @s run {
        execute if entity @s[tag=customBilly.Trap] run {
            scoreboard players remove @s customBilly.TrapDuration 1
            scoreboard players add @s customBilly.TrapLinger 1

            execute if score @s customBilly.TrapLinger matches 20.. run {
                execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                block { with storage minecraft:custom universal.fetch_block
                    $particle block{block_state:"$(id)"} ~ ~ ~ 0.75 0 0.75 1 15 normal
                }
                scoreboard players reset @s customBilly.TrapLinger
            }

            execute if entity @e[type=!#custom:not_mob,distance=..1.75] run {
                data modify storage minecraft:custom billy.trap.self set string entity @s data.username
                data merge storage minecraft:custom {billy:{trap:{victim:""}}}
                execute as @n[type=!#custom:not_mob,distance=..1.75] if entity @s[type=minecraft:player] run {
                    loot insert 0 -63 0 loot custom:player_head
                    data modify storage minecraft:custom billy.trap.victim set string block 0 -63 0 Items[0].components."minecraft:profile".name
                    item replace block 0 -63 0 container.0 with minecraft:air
                }
                execute store success score @s customBilly.TrapSuccess run data modify storage minecraft:custom billy.trap.victim set from storage minecraft:custom billy.trap.self

                execute if score @s customBilly.TrapSuccess matches 1 run block { with storage minecraft:custom billy.trap
                    $execute as @n[type=!#custom:not_mob,distance=..1.75,name=!$(self)] run {
                        attribute @s minecraft:movement_speed modifier add custom:billy.snare -0.25 add_multiplied_total
                    }
                    function animated_java:billy/summon {args:{animation: 'snare_trigger', start_animation: true}}
                    execute as @n[type=minecraft:item_display,tag=aj.billy.root,tag=!temp] run block {
                        data modify entity @s data.username set string storage minecraft:custom billy.trap.self
                        tag @s add temp
                    }
                    kill @s
                }
            }

            execute unless score @s customBilly.TrapDuration matches 1.. run kill @s[type=minecraft:item_display]
        }
    }

    execute as @a run function custom:ui/player/tick
    execute as @e[type=chest_minecart,tag=ui] run function custom:ui/minecart/tick
}

function connect {
    REPEAT (1,6) as i {
        scoreboard players enable @s customUniversal.Move<%i%>Trigger
        scoreboard players enable @s customUniversal.ToggleTrigger
    }
}

dir abilities {
    dir gojo {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/gojo/active

                execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.Delay4=0,customUniversal.AwakeningDuration=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                    REPEAT (1,6) as i {
                        execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                    }
                    
                    execute if score @s customUniversal.Delay4 matches 1.. run {
                        scoreboard players remove @s customUniversal.Delay4 1
                        execute if score @s customUniversal.Delay4 matches 0 run {
                            tag @s remove customGojo.InfinityAmplification
                        }
                    }

                    execute if score @s customUniversal.AwakeningDuration matches 1.. run scoreboard players remove @s customUniversal.AwakeningDuration 1
                    execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                    execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
                }
            }
        }

        function active {
            execute if score @s customUniversal.Move1Trigger matches 1.. run {
                execute unless entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move1
                execute if entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move4
            }
            execute if score @s customUniversal.Move2Trigger matches 1.. run {
                execute unless entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move2
                execute if entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move5
            }
            execute if score @s customUniversal.Move3Trigger matches 1.. run {
                execute unless entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move3
                execute if entity @s[tag=customGojo.Awakening] run function custom:abilities/gojo/key_bindings/move6
            }

            function custom:abilities/gojo/hotbar/main
        }

        dir admin {
            function force_awakening {
                function custom:abilities/gojo/awakening/achieve
            }
        }

        dir key_bindings {
            REPEAT (1,6) as i {
                function move<%i%> {
                    function custom:abilities/gojo/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                }
            }
        }

        dir awakening {
            function achieve {
                gamemode spectator @s
                function custom:abilities/gojo/moves/setup {animation:'honored',objective:"customUniversal.RigID"}
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.gojo.camera.camera",objective:"customUniversal.RigID"}
            }

            function setup {
                gamemode survival @s
                $tp @s @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.RigID=$(id)}]
                $execute as @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.RigID=$(id)}] at @s rotated ~ 0 run function custom:abilities/gojo/awakening/jump_vfx
                scoreboard players set @s customUniversal.AwakeningDuration 4800
                tag @s add customGojo.Awakening
            }

            function duration {
                $scoreboard players set .GojoCooldown customUniversal.AwakeningDuration $(duration)
                scoreboard players operation .GojoCooldown customUniversal.AwakeningDuration *= x20 customUniversal.AwakeningDuration
                scoreboard players operation .GojoCooldownDivided customUniversal.AwakeningDuration = .GojoCooldown customUniversal.AwakeningDuration
                scoreboard players operation .GojoCooldownThresholds customUniversal.AwakeningDuration = .GojoCooldown customUniversal.AwakeningDuration
                scoreboard players operation .GojoCooldownDivided customUniversal.AwakeningDuration = .GojoCooldown customUniversal.AwakeningDuration
                scoreboard players operation .GojoCooldownDivided customUniversal.AwakeningDuration /= div16 customUniversal.AwakeningDuration

                execute store result storage minecraft:custom gojo.awakening.16 int 1 run scoreboard players get .GojoCooldownThresholds customUniversal.AwakeningDuration

                REPEAT (15,1) as i {
                    scoreboard players operation .GojoCooldownThresholds customUniversal.AwakeningDuration -= .GojoCooldownDivided customUniversal.AwakeningDuration
                    execute store result storage minecraft:custom gojo.awakening.<%i%>a int 1 run scoreboard players get .GojoCooldownThresholds customUniversal.AwakeningDuration
                    scoreboard players remove .GojoCooldownThresholds customUniversal.AwakeningDuration 1
                    execute store result storage minecraft:custom gojo.awakening.<%i%>b int 1 run scoreboard players get .GojoCooldownThresholds customUniversal.AwakeningDuration
                }

                scoreboard players operation .GojoCooldownThresholds customUniversal.AwakeningDuration -= .GojoCooldownDivided customUniversal.AwakeningDuration
                execute store result storage minecraft:custom gojo.awakening.1 int 1 run scoreboard players get .GojoCooldownThresholds customUniversal.AwakeningDuration
            }

            function jump_vfx {
                data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"gojo",animation:'honored_jump'}
            }
        }
        
        dir hotbar {
            function main {
                execute unless entity @s[tag=customGojo.Awakening] run {
                    REPEAT (1,3) as i {
                        function custom:abilities/gojo/hotbar/base_progress with storage minecraft:custom gojo.cooldowns.move<%i%>
                    }
                } else run {
                    REPEAT (4,6) as i {
                        function custom:abilities/gojo/hotbar/base_progress with storage minecraft:custom gojo.cooldowns.move<%i%>
                    }
                }
                
                function custom:abilities/gojo/hotbar/meter with storage minecraft:custom gojo.awakening
                
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"gojo",selected:<%i%>}
                    }
                }

                execute unless entity @s[tag=customGojo.Awakening] run {
                    execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A0"},{"text":"\uF820\$(move1)\uF801\u01B5"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)\uF801\u01B5"},{"text":"\uF800\$(move3)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)\uF801\u01B5"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }
                } else run {
                    execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)\uF801\u01B5"},{"text":"\uF800\$(move5)"},{"text":"\uF800\$(move6)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)"},{"text":"\uF800\$(move5)\uF801\u01B5"},{"text":"\uF800\$(move6)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom gojo.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)"},{"text":"\uF800\$(move5)"},{"text":"\uF800\$(move6)\uF801\u01B5"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }
                }
            }

            function base_progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01B1"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01B2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom gojo.hotbar.move$(selection) set value "u01B3"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }

            function meter {
                $execute if score @s customUniversal.AwakeningDuration matches $(15a)..$(16) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01D1"
                $execute if score @s customUniversal.AwakeningDuration matches $(14a)..$(15b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01D0"
                $execute if score @s customUniversal.AwakeningDuration matches $(13a)..$(14b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C9"
                $execute if score @s customUniversal.AwakeningDuration matches $(12a)..$(13b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C8"
                $execute if score @s customUniversal.AwakeningDuration matches $(11a)..$(12b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C7"
                $execute if score @s customUniversal.AwakeningDuration matches $(10a)..$(11b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C6"
                $execute if score @s customUniversal.AwakeningDuration matches $(9a)..$(10b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C5"
                $execute if score @s customUniversal.AwakeningDuration matches $(8a)..$(9b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C4"
                $execute if score @s customUniversal.AwakeningDuration matches $(7a)..$(8b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C3"
                $execute if score @s customUniversal.AwakeningDuration matches $(6a)..$(7b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C2"
                $execute if score @s customUniversal.AwakeningDuration matches $(5a)..$(6b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C1"
                $execute if score @s customUniversal.AwakeningDuration matches $(4a)..$(5b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01C0"
                $execute if score @s customUniversal.AwakeningDuration matches $(3a)..$(4b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01B9"
                $execute if score @s customUniversal.AwakeningDuration matches $(2a)..$(3b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01B8"
                $execute if score @s customUniversal.AwakeningDuration matches $(1)..$(2b) run data modify storage minecraft:custom gojo.hotbar.awakening set value "u01B7"
                execute unless score @s customUniversal.AwakeningDuration matches 1.. run {
                    data modify storage minecraft:custom gojo.hotbar.awakening set value "u01B6"
                    tag @s remove customGojo.Awakening
                }
            }
        }

        dir toggle {
            function on {
                playsound minecraft:gojo.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:gojo.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }

        dir moves {
            function setup {

                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                effect give @s minecraft:invisibility infinite 0 true
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                function custom:universal/armor/hide
                $execute rotated ~ 0 run function animated_java:gojo/summon {args:{animation:'$(animation)', start_animation: true}}
                $function custom:universal/setup/rig {objective:"$(objective)",item:"gojo"}
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.gojo.camera",objective:"$(objective)"}

                scoreboard players add .global customUniversal.GlobalCounter 1
                scoreboard players operation @s customUniversal.GlobalCounter = .global customUniversal.GlobalCounter
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.gojo.root",objective:"customUniversal.GlobalCounter"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/gojo/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Reverse Cursed Technique"}
                }

                function pass {
                    function custom:abilities/gojo/moves/setup {animation:'reverse_cursed_technique',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .GojoCooldown customUniversal.Move1Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }
            }

            dir 2 {
                function core {
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 2
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/gojo/moves/2/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A0",move:"Lapis Blue"}
                }

                function pass {
                    function custom:abilities/gojo/moves/setup {animation:'lapis_blue',objective:"customGojo.LapisBlueID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 2
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move2Cooldown = .GojoCooldown customUniversal.Move2Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                function spawn {
                    execute rotated ~ ~ positioned ^ ^0.6 ^0.85 run function animated_java:gojo_projectiles/summon {args:{}}
                    $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing] run scoreboard players set @s $(objective) $(id)
                    block { with storage minecraft:custom universal.control
                        $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing,scores={$(objective)=$(id)}] run function animated_java:gojo_projectiles/animations/lapis_blue/play
                        REPEAT (1,8) as i {
                           $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.gojo_projectiles.locator.anc<%i%>",objective:"$(objective)"} 
                        }
                    }
                }

                function movement {
                    execute unless block ~ ~ ~ #custom:raycast_pass run tp @s ^ ^1 ^
                    execute positioned ^ ^ ^1.25 if block ~ ~ ~ #custom:raycast_pass run tp @s ^ ^ ^-0.5

                    execute positioned ^ ^ ^1.25 unless block ~ ~0.5 ~ #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/y
                    execute positioned ^ ^ ^1.25 unless block ~ ~-0.5 ~ #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/y

                    execute positioned ^ ^ ^1.25 unless block ~0.5 ~ ~ #custom:raycast_pass unless block ~0.5 ~1 ~ #custom:raycast_pass unless block ~0.5 ~ ~ #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/x
                    execute positioned ^ ^ ^1.25 unless block ~-0.5 ~ ~ #custom:raycast_pass unless block ~-0.5 ~1 ~ #custom:raycast_pass unless block ~-0.5 ~ ~ #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/x

                    execute positioned ^ ^ ^1.25 unless block ~ ~ ~0.5 #custom:raycast_pass unless block ~ ~1 ~0.5 #custom:raycast_pass unless block ~ ~ ~0.5 #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/z
                    execute positioned ^ ^ ^1.25 unless block ~ ~ ~-0.5 #custom:raycast_pass unless block ~ ~1 ~-0.5 #custom:raycast_pass unless block ~ ~ ~-0.5 #custom:raycast_pass run function custom:abilities/gojo/moves/2/bounce/z

                    execute if predicate custom:gojo/blue_sfx run playsound minecraft:gojo.blue.ambient player @a ~ ~ ~ 1

                    $execute as @e[type=!#custom:not_mob,tag=!customGojo.LapisBlueVictim,distance=..3] unless entity @s[scores={customGojo.LapisBlueID=$(id)}] unless entity @s[tag=customSettings_Immunity] unless entity @s[gamemode=spectator] run block { {id:$(id)}
                        tag @s add customGojo.LapisBlueVictim
                        $scoreboard players set @s customGojo.LapisBlueID $(id)
                        execute store result score @s customGojo.LapisBlueOrbit run random value 1..8
                        playsound minecraft:entity.wind_charge.wind_burst player @a ~ ~ ~ 0.5
                    }

                    $execute as @e[type=!#custom:not_mob,tag=customGojo.LapisBlueVictim,scores={customGojo.LapisBlueID=$(id)}] unless entity @s[nbt={RootVehicle:1b}] run block {
                        execute store result storage minecraft:custom gojo.moves.id int 1 run scoreboard players get @s customGojo.LapisBlueID
                        execute store result storage minecraft:custom gojo.moves.orbit int 1 run scoreboard players get @s customGojo.LapisBlueOrbit
                        block { with storage minecraft:custom gojo.moves
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.gojo_projectiles.locator.blue,tag=aj.gojo_projectiles.locator.anc$(orbit),scores={customGojo.LapisBlueID=$(id)}]
                        }
                    }
                }

                dir bounce {
                    function x {
                        execute at @s run playsound minecraft:gojo.blue.bounce player @a ~ ~ ~ 1
                        execute store result entity @s Rotation[0] float -1 run data get entity @s Rotation[0]
                    }

                    function y {
                        execute at @s run playsound minecraft:gojo.blue.bounce player @a ~ ~ ~ 1
                        execute store result entity @s Rotation[1] float -1 run data get entity @s Rotation[1]
                    }

                    function z {
                        execute at @s run playsound minecraft:gojo.blue.bounce player @a ~ ~ ~ 1
                        scoreboard players set .scale customGojo.LapisBlueRotation 18000
                        execute store result score .scaledDown customGojo.LapisBlueRotation run data get entity @s Rotation[0] 100.0
                        execute store result entity @s Rotation[0] float 0.01 run scoreboard players operation .scale customGojo.LapisBlueRotation -= .scaledDown customGojo.LapisBlueRotation
                    }
                }

                function ambient_particles {
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    function custom:universal/vfx/spawn {mode:3,speed:0,count:1,duration:0,branch:"gojo",animation:'lapis_blue'}
                }

                function launch {
                    execute store result storage minecraft:custom gojo.moves.id int 1 run scoreboard players get @s customGojo.LapisBlueID
                    block { with storage minecraft:custom gojo.moves
                        $execute as @e[type=!#custom:not_mob,tag=customGojo.LapisBlueVictim,scores={customGojo.LapisBlueID=$(id)}] at @s run block { with storage minecraft:custom gojo.moves
                            ride @s dismount
                            tag @s remove customGojo.LapisBlueVictim
                            $function custom:universal/damage/victim {id:"$(id)",damage:"4",type:"minecraft:generic",attacker:"tag=customAbility.Gojo",objective:"customGojo.LapisBlueID",first:"was atomically restructured by",second:"using Lapis Blue"}
                            execute store result storage minecraft:custom gojo.moves.launchXl int 1 run random value -2..2
                            execute store result storage minecraft:custom gojo.moves.launchXs int 1 run random value 3..9
                            execute store result storage minecraft:custom gojo.moves.launchYl int 1 run random value 0..2
                            execute store result storage minecraft:custom gojo.moves.launchYs int 1 run random value 3..9
                            execute store result storage minecraft:custom gojo.moves.launchZl int 1 run random value -2..2
                            execute store result storage minecraft:custom gojo.moves.launchZs int 1 run random value 3..9
                            block { with storage minecraft:custom gojo.moves
                                $launch @s setMotion $(launchXl).$(launchXs) $(launchYl).$(launchYs) $(launchZl).$(launchZs)
                            }
                        }
                    }
                }
            }

            dir 3 {
                function core {
                    execute unless score @s customUniversal.Move3Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 3
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/gojo/moves/3/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:3,unicode:"u50A0",move:"Reversal Red"}
                }

                function pass {
                    function custom:abilities/gojo/moves/setup {animation:'reversal_red',objective:"customGojo.ReversalRedID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 3
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move3Cooldown = .GojoCooldown customUniversal.Move3Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                function spawn {
                    execute rotated ~ ~ positioned ^-0.4 ^.6 ^0.85 run function animated_java:gojo_projectiles/summon {args:{}}
                    $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing] run scoreboard players set @s $(objective) $(id)
                    block { with storage minecraft:custom universal.control
                        $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing,scores={$(objective)=$(id)}] run function animated_java:gojo_projectiles/animations/reversal_red/play
                    }
                }

                function movement {
                    tp @s ^ ^ ^1
                    execute if predicate custom:gojo/blue_sfx run playsound minecraft:gojo.blue.ambient player @a ~ ~ ~ 1
                    $execute as @e[type=!#custom:not_mob,distance=..3] unless entity @s[scores={customGojo.ReversalRedID=$(id)}] unless entity @s[tag=customSettings_Immunity] run function custom:universal/damage/victim {id:"$(id)",damage:"15",type:"minecraft:generic",attacker:"tag=customAbility.Gojo",objective:"customGojo.ReversalRedID",first:"was torn apart by",second:"using Reversal Red"}
                }

                function ambient_particles {
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    function custom:universal/vfx/spawn {mode:3,speed:0,count:1,duration:0,branch:"gojo",animation:'reversal_red'}
                }
            }

            dir 4 {
                function core {
                    execute unless score @s customUniversal.Move4Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/gojo/moves/4/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Infinity Amplification"}
                }

                function pass {
                    function custom:abilities/gojo/moves/setup {animation:'infinity_amplification',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move4Cooldown = .GojoCooldown customUniversal.Move4Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                function buff {
                    tag @s add customGojo.InfinityAmplification
                    scoreboard players set @s customUniversal.Delay4 300
                }
            }

            dir 5 {
                dir quickfire {
                    function pass {
                        function custom:abilities/gojo/moves/setup {animation:'hollow_purple_quickfire',objective:"customGojo.HollowPurpleID"}
                        tag @s add customUniversal.Cancellable
                        scoreboard players set @s customUniversal.MoveLastUsed 2
                        execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move5Cooldown = .GojoCooldown customUniversal.Move5Cooldown
                        scoreboard players set @s customUniversal.MoveDelay 10

                        attribute @s minecraft:movement_speed base set 0.025
                        attribute @s minecraft:jump_strength base set 0
                    }

                    function spawn {
                        execute rotated ~ ~ positioned ^-0.4 ^.6 ^0.85 run function animated_java:gojo_projectiles/summon {args:{}}
                        $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing] run scoreboard players set @s $(objective) $(id)
                        block { with storage minecraft:custom universal.control
                            $execute as @n[type=minecraft:item_display,tag=aj.gojo_projectiles.root,tag=!playing,scores={$(objective)=$(id)}] run function animated_java:gojo_projectiles/animations/hollow_purple_quickfire/play
                        }
                    }

                    function movement {
                        tp @s ^ ^ ^1.25
                        execute if predicate custom:gojo/blue_sfx run playsound minecraft:gojo.blue.ambient player @a ~ ~ ~ 1
                        $execute as @e[type=!#custom:not_mob,distance=..3] unless entity @s[scores={customGojo.HollowPurpleID=$(id)}] unless entity @s[tag=customSettings_Immunity] run function custom:universal/damage/victim {id:"$(id)",damage:"15",type:"minecraft:generic",attacker:"tag=customAbility.Gojo",objective:"customGojo.HollowPurpleID",first:"was obliterated by ",second:"using Hollow Purple: Quickfire"}
                    }
                }

                function core {
                    execute unless score @s customMove5Cooldown matches 0 run function custom:universal/error_messages/find {error:"1"}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:"2"}
                    function custom:universal/error_messages/universal

                    execute unless score @s customFailReturn matches 1 if entity @s[tag=customGojo.InfiniteVoiding] run function custom:abilities/gojo/moves/5/cutscene/raycast/start
                    execute unless score @s customFailReturn matches 1 unless entity @s[tag=customGojo.InfiniteVoiding] run function custom:abilities/gojo/moves/5/quickfire/pass
                    execute if score @s customFailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A0",move:"Hollow Purple"}
                }

                function ambient_particles {
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    function custom:universal/vfx/spawn {mode:3,speed:0,count:1,duration:0,branch:"gojo",animation:'hollow_purple'}
                }
            }

            dir 6 {
                function core {
                    execute unless score @s customUniversal.Move6Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 3
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/gojo/moves/6/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:3,unicode:"u50A0",move:"Domain Expansion: Infinite Void"}
                }

                function pass {
                    function custom:abilities/gojo/moves/setup {animation:'domain_expansion_windup_1',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 3
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move6Cooldown = .GojoCooldown customUniversal.Move6Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                dir box {
                    function connect {
                        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                        execute positioned ~ -15 ~ rotated ~180 ~ run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"gojo",animation:'domain_galaxy'}
                        execute store result storage minecraft:custom gojo.moves.id int 1 run scoreboard players get @s customUniversal.RigID
                        
                        execute positioned ~ -20 ~ rotated ~ ~ run {
                            function animated_java:gojo/summon {args:{animation:'domain_expansion_core_1', start_animation: true}}
                            scoreboard players operation @n[type=minecraft:item_display,tag=aj.gojo.root] customUniversal.RigID = @s customUniversal.RigID
                        }
                        
                        function animated_java:gojo/remove/this

                        block { with storage minecraft:custom gojo.moves
                            $execute as @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.RigID=$(id)}] run {
                                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.gojo.camera",objective:"customUniversal.RigID"}
                            }

                            $execute as @p[tag=customAbility.Gojo,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom gojo.moves
                                $spectate @n[type=minecraft:item_display,tag=aj.gojo.camera,scores={customUniversal.RigID=$(id)}]
                            }
                        }

                        # function custom:universal/as/player {objective:"customUniversal.RigID",what:"tag=customAbility.Gojo",output:"function custom:abilities/gojo/moves/6/box/player_sync with storage minecraft:custom universal"}
                        # block player_sync {
                        #    spectate
                        #     $tp @s @n[type=minecraft:item_display,tag=aj.gojo.camera.camera,scores={customUniversal.RigID=$(id)}]
                        # } 
                    }

                    function light_beam {
                        execute store result storage minecraft:custom gojo.domain.lightbeam_axis1L int 1 run random value 2..9
                        execute store result storage minecraft:custom gojo.domain.lightbeam_axis1S int 1 run random value 1..99
                        execute store result storage minecraft:custom gojo.domain.lightbeam_axis2L int 1 run random value 2..9
                        execute store result storage minecraft:custom gojo.domain.lightbeam_axis2S int 1 run random value 1..99
                        execute store result storage minecraft:custom gojo.domain.lightbeam_axis3L int 1 run random value 5..8
                        execute if predicate custom:gojo/light_beam1 run {
                            data merge storage minecraft:custom {gojo:{domain:{lightbeam_axis1D:"-"}}}
                        } else run {
                            data merge storage minecraft:custom {gojo:{domain:{lightbeam_axis1D:""}}}
                        }
                        execute if predicate custom:gojo/light_beam2 run {
                            data merge storage minecraft:custom {gojo:{domain:{lightbeam_axis2D:"-"}}}
                        } else run {
                            data merge storage minecraft:custom {gojo:{domain:{lightbeam_axis2D:""}}}
                        }
                        block { with storage minecraft:custom gojo.domain
                            data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                            data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                            $execute positioned ^$(lightbeam_axis1D)$(lightbeam_axis1L).$(lightbeam_axis1S) ^$(lightbeam_axis2D)$(lightbeam_axis2L).$(lightbeam_axis2S) ^-$(lightbeam_axis3L) run function custom:universal/vfx/spawn {mode:2,speed:0,count:1,duration:0,branch:"gojo",animation:'light_beam'}
                        }
                    }

                    function blind {
                        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                        execute positioned ^ ^ ^5 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"gojo",animation:'blind'}
                    }
                }

                function setup {
                    gamemode survival @s
                    $tp @s @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.RigID=$(id)}]
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Gojo,scores={$(objective)=$(id)}] at @s run function custom:abilities/gojo/moves/reset/player
                        $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }

        dir passive {
            function main {
                scoreboard players add @s customGojo.InfinityPassive 1

                execute unless entity @s[tag=customGojo.Awakening] run {
                    execute if score @s customGojo.InfinityPassive matches 6 run function custom:abilities/gojo/passive/enable
                    execute if score @s customGojo.InfinityPassive matches 7.. run function custom:abilities/gojo/passive/alert
                } else run {
                    execute if entity @s[tag=customGojo.InfinityAmplification] run {
                        execute if score @s customGojo.InfinityPassive matches 3 run function custom:abilities/gojo/passive/enable
                        execute if score @s customGojo.InfinityPassive matches 4.. run function custom:abilities/gojo/passive/alert
                    } else run {
                        execute if score @s customGojo.InfinityPassive matches 5 run function custom:abilities/gojo/passive/enable
                        execute if score @s customGojo.InfinityPassive matches 6.. run function custom:abilities/gojo/passive/alert
                    }
                }
            }

            function enable {
                effect give @s minecraft:resistance infinite 255 true
            }

            function alert {
                playsound minecraft:gojo.passive.activate player @a ~ ~ ~ 1
                effect give @s minecraft:glowing 1 255 true
                effect clear @s minecraft:resistance
                scoreboard players set @s customGojo.InfinityPassive 1
            }
            
            #  if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 2 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 3.. run function custom:items/gojo/passive/damaged/reset

            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 4 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 5.. run function custom:items/gojo/passive/damaged/reset

            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 5 run function custom:items/gojo/passive/damaged/infinity
            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 6.. run function custom:items/gojo/passive/damaged/reset
        }
    }

    dir dice {
        # Fatebound Dice #
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/dice/active

                execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customDice.RollDelay=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                    REPEAT (1,3) as i {
                        execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                    }   
                    
                    execute if score @s customDice.RollDelay matches 1.. run {
                        scoreboard players remove @s customDice.RollDelay 1
                        execute if score @s customDice.RollDelay matches 0 run function custom:abilities/dice/moves/1/roll
                    }
                    execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                    execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
                }
            }
        }

        function active {
            execute if score @s customUniversal.Move1Trigger matches 1.. run {
                function custom:abilities/dice/key_bindings/move1
            }
            execute if score @s customUniversal.Move2Trigger matches 1.. run {
                function custom:abilities/dice/key_bindings/move2
            }
            execute if score @s customUniversal.Move3Trigger matches 1.. run {
                function custom:abilities/dice/key_bindings/move3
            }

            function custom:abilities/dice/hotbar/main

            execute if score @s customDice.ActivePassive matches 1.. run function custom:abilities/dice/passive/main
        }

        dir passive {
            function main {
                # Passive: Repetitive Motion
                execute if score @s customDice.ActivePassive matches 1 run {
                    # scoreboard players add @s customDice.PassiveRepetitiveTimer 1
                    # execute if predicate custom:dice/repetitive/forward run scoreboard players reset @s customDice.PassiveRepetitiveTimer
                    # execute if predicate custom:dice/repetitive/backward run scoreboard players reset @s customDice.PassiveRepetitiveTimer
                    # execute if predicate custom:dice/repetitive/left run scoreboard players reset @s customDice.PassiveRepetitiveTimer
                    # execute if predicate custom:dice/repetitive/right run scoreboard players reset @s customDice.PassiveRepetitiveTimer
                    # execute if predicate custom:dice/repetitive/jump run scoreboard players reset @s customDice.PassiveRepetitiveTimer

                    # execute if score @s customDice.PassiveRepetitiveTimer matches 100.. run {
                    #     kill @s
                    #     scoreboard players reset @s customDice.PassiveRepetitiveTimer
                    # }
                    say a
                }
            }
        }

        dir key_bindings {
            REPEAT (1,3) as i {
                function move<%i%> {
                    function custom:abilities/dice/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move<%i%>Trigger
                    scoreboard players enable @s customUniversal.Move<%i%>Trigger
                }
            }
        }

        dir moves {
            dir 1 {
                function core {
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/dice/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Tempt Fate"}
                }

                function pass {
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .DiceCooldown customUniversal.Move1Cooldown
                    
                    playsound minecraft:dice.roll player @s ~ ~ ~ 10
                    scoreboard players set @s customDice.RollDelay 20
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    scoreboard players set @s customUniversal.MoveDelay 10
                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                    tag @s add customUniversal.Animation
                }

                function roll {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    tag @s remove customUniversal.Animation
                    execute store result score @s customDice.RollValue run random value 1..20
                    execute if score @s customDice.RollValue matches 1..20 run function custom:abilities/dice/roll/12_15/select
                }
            }

            dir 2 {
                function core {
                    scoreboard players set @s customUniversal.ActiveHotbar 2
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    execute unless score @s customDice.PreviousRoll matches 1.. run function custom:universal/error_messages/find {error:10}
                    function custom:universal/error_messages/universal

                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/dice/moves/2/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Store Roll"}
                }

                function pass {
                    say b
                }
            }
        }

        dir roll {
            dir 1 {
                function select {
                    execute store result score @s customDice.SecondaryRollValue run random value 1..5
                    execute if score @s customDice.SecondaryRollValue matches 1 run function custom:abilities/dice/roll/1/firework/main
                    execute if score @s customDice.SecondaryRollValue matches 2 run function custom:abilities/dice/roll/1/translocation_100k/main
                    execute if score @s customDice.SecondaryRollValue matches 3 run function custom:abilities/dice/roll/1/grindstone/main
                    execute if score @s customDice.SecondaryRollValue matches 4 run function custom:abilities/dice/roll/1/death/main
                    execute if score @s customDice.SecondaryRollValue matches 5 run function custom:abilities/dice/roll/1/repetitive_passive/main
                }

                function announce {
                    $tellraw @s [{"text":"Fatebound Dice\n","color":"gold"},{"color":"red","italic":false,"text":"Uh oh! "},{"color":"gray","italic":false,"text":"You rolled a "},{"color":"red","italic":false,"text":"d"},{"color":"red","italic":false,"score":{"name":"@s","objective":"customDice.RollValue"}},{"color":"gray","italic":false,"text":" cursing you with "},{"color":"gold","hover_event":{"action":"show_text","value":[$(description)]},"italic":false,"text":"$(name)!"}]
                }

                dir firework {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 1
                        function custom:abilities/dice/roll/1/firework/description
                        function custom:abilities/dice/roll/1/announce with storage minecraft:custom dice.roll

                        launch @s setMotion 0 10 0
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Firework"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Firework\n","color":"gold"},{"text":"The user is ","color":"gray"},{"text":"launched ","color":"aqua"},{"text":"up into the sky, where they then ","color":"gray"},{"text":"explode ","color":"red"},{"text":"into a ","color":"gray"},{"text":"b","color":"red"},{"text":"e","color":"gold"},{"text":"a","color":"yellow"},{"text":"u","color":"green"},{"text":"t","color":"blue"},{"text":"i","color":"light_purple"},{"text":"f","color":"dark_purple"},{"text":"u","color":"red"},{"text":"l","color":"gold"},{"text":" firework launching their items ","color":"gray"},{"text":"everywhere!","color":"yellow"}]}}}
                    }
                }

                dir translocation_100k {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 2
                        function custom:abilities/dice/roll/1/translocation_100k/description
                        function custom:abilities/dice/roll/1/announce with storage minecraft:custom dice.roll

                        execute store result score @s customDice.TranslocationX run data get entity @s Pos[0] 1
                        execute store result score @s customDice.TranslocationZ run data get entity @s Pos[2] 1
                        execute store result score .RandomizedValue customDice.TranslocationX run random value -100000..100000
                        execute store result score .RandomizedValue customDice.TranslocationZ run random value -100000..100000
                        scoreboard players operation @s customDice.TranslocationX += .RandomizedValue customDice.TranslocationX
                        scoreboard players operation @s customDice.TranslocationZ += .RandomizedValue customDice.TranslocationZ

                        execute store result storage minecraft:custom dice.roll.translocation_100k.x int 1 run scoreboard players get @s customDice.TranslocationX
                        execute store result storage minecraft:custom dice.roll.translocation_100k.z int 1 run scoreboard players get @s customDice.TranslocationZ
                        block { with storage minecraft:custom dice.roll.translocation_100k
                            $execute positioned over world_surface run tp @s $(x) ~ $(z)
                        }
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Player Translocation (100k)"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Player Translocation (100k)","color":"gold"},{"text":"\n"},{"text":"The user will be ","color":"gray"},{"text":"teleported ","color":"light_purple"},{"text":"to a ","color":"gray"},{"text":"random location","color":"aqua"},{"text":" within a ","color":"gray"},{"text":"100k block radius.","color":"green"}]}}}
                    }
                }

                dir grindstone {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 3
                        function custom:abilities/dice/roll/1/grindstone/description
                        function custom:abilities/dice/roll/1/announce with storage minecraft:custom dice.roll

                        execute store result score @s customDice.TertiaryRollValue run random value 1..4
                        execute if score @s customDice.TertiaryRollValue matches 1 run function custom:abilities/dice/roll/1/grindstone/remove {slot:"head",piece:"Helmet"}
                        execute if score @s customDice.TertiaryRollValue matches 2 run function custom:abilities/dice/roll/1/grindstone/remove {slot:"chest",piece:"Chestplate"}
                        execute if score @s customDice.TertiaryRollValue matches 3 run function custom:abilities/dice/roll/1/grindstone/remove {slot:"legs",piece:"Leggings"}
                        execute if score @s customDice.TertiaryRollValue matches 4 run function custom:abilities/dice/roll/1/grindstone/remove {slot:"feet",piece:"Boots"}
                    }

                    function remove {
                        execute at @s run playsound minecraft:block.grindstone.use player @s ~ ~ ~ 1
                        $item modify entity @s armor.$(slot) custom:dice/grindstone
                        $tellraw @s ["",{"text":"Your ","color":"gray"},{"text":"$(piece) ","color":"green"},{"text":"has been ","color":"gray"},{"text":"wiped clean","color":"aqua"},{"text":" of ","color":"gray"},{"text":"enchantments...","color":"light_purple"}]
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Grindstone"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Grindstone","color":"gold"},{"text":"\n"},{"text":"Completely ","color":"gray"},{"text":"remove all enchantments","color":"red"},{"text":" from a ","color":"gray"},{"text":"random ","color":"light_purple"},{"text":"armor piece.","color":"gray"}]}}}
                    }
                }

                dir death {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 4
                        function custom:abilities/dice/roll/1/death/description
                        function custom:abilities/dice/roll/1/announce with storage minecraft:custom dice.roll

                        kill @s
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Death"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Death","color":"gold"},{"text":"\n"},{"text":"Instantaneously ","color":"gray"},{"text":"die ","color":"red"},{"text":"upon rolling.","color":"gray"}]}}}
                    }
                }

                dir repetitive_passive {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 5
                        function custom:abilities/dice/roll/1/repetitive_passive/description
                        function custom:abilities/dice/roll/1/announce with storage minecraft:custom dice.roll

                        scoreboard players set @s customDice.ActivePassive 1
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Passive: Repetitive Motion"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Passive: Repetitive Motion","color":"gold"},{"text":"\n"},{"text":"Active until rolling ","color":"gray"},{"text":"another ","color":"white"},{"text":"passive. ","color":"gray"},{"text":"Standing still","color":"light_purple"},{"text":" for longer than ","color":"gray"},{"text":"5s","color":"gold"},{"text":" will immediately ","color":"gray"},{"text":"kill","color":"red"},{"text":" the user.","color":"gray"}]}}}
                    }
                }
            }

            dir 12_15 {
                function select {
                    execute store result score @s customDice.SecondaryRollValue run random value 1..2
                    execute if score @s customDice.SecondaryRollValue matches 1..2 run function custom:abilities/dice/roll/12_15/propulsion/main
                    # execute if score @s customDice.SecondaryRollValue matches 2 run function custom:abilities/dice/roll/20/microphone/main
                }

                function announce {
                    $tellraw @s [{"text":"Fatebound Dice\n","color":"gold"},{"color":"green","italic":false,"text":"Congrats! "},{"color":"gray","italic":false,"text":"You rolled a "},{"color":"red","italic":false,"text":"d"},{"color":"red","italic":false,"score":{"name":"@s","objective":"customDice.RollValue"}},{"color":"gray","italic":false,"text":" cursing you with "},{"color":"gold","hover_event":{"action":"show_text","value":[$(description)]},"italic":false,"text":"$(name)!"}]
                }

                dir propulsion {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 300

                        scoreboard players set @s interactablesUniversal.GiveItemID 3
                        function interactables:recieve_item/create_scenario {animation:'common',perspective:"none",item:"minecraft:interactables/propulsion"}

                        # give @p bowl[max_stack_size=1,max_damage=30,item_name={"color":"yellow","italic":false,"text":"Tommy Gun"},lore=[{"color":"gray","italic":false,"text":"Welcome to the land of the free"}," ",[{"color":"gray","italic":false,"text":"Click to "},{"color":"red","italic":false,"text":"fire "},{"color":"gray","italic":false,"text":"a bullet"}],[{"color":"gold","italic":false,"text":"30"},{"color":"gray","italic":false,"text":"/"},{"color":"gold","italic":false,"text":"30 "},{"color":"gray","italic":false,"text":"Bullets"}]],damage=0,food={nutrition:0,saturation:0,can_always_eat:true},consumable={consume_seconds:8888888},item_model="minecraft:interactables/tommy_gun"] 1
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Expiremental Propulsion Device"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Expiremental Propulsion Device","color":"gold"},{"text":"\n"},{"text":"Skyrockets the wielder ","color":"gray"},{"text":"forward in the direction they're looking","color":"green"},{"text":" at ","color":"gray"},{"text":"incredible ","color":"aqua"},{"text":"speeds. Become completely ","color":"gray"},{"text":"immune to fall damage","color":"light_purple"},{"text":" until ","color":"gray"},{"text":"landing","color":"white"},{"text":" again.","color":"gray"}]}}}
                    }

                    function inform {
                        function custom:abilities/dice/roll/12_15/propulsion/description
                        function custom:abilities/dice/roll/12_15/announce with storage minecraft:custom dice.roll

                        give @s bowl[max_stack_size=1,item_name={"color":"yellow","italic":false,"text":"Expiremental Propulsion Device"},lore=[{"color":"gray","italic":false,"text":"Consumer fully liable."}," ",[{"color":"gray","italic":false,"text":"Click to "},{"color":"red","italic":false,"text":"launch "},{"color":"gray","italic":false,"text":"forward incredibly"}],{"color":"gray","italic":false,"text":"far in the direction you're looking"}],food={nutrition:0,saturation:0,can_always_eat:true},consumable={consume_seconds:8888888},item_model="minecraft:interactables/propulsion"] 1
                    }
                }
            }

            dir 20 {
                function select {
                    execute store result score @s customDice.SecondaryRollValue run random value 1..2
                    execute if score @s customDice.SecondaryRollValue matches 1 run function custom:abilities/dice/roll/20/tommy_gun/main
                    execute if score @s customDice.SecondaryRollValue matches 2 run function custom:abilities/dice/roll/20/microphone/main
                }

                function announce {
                    $tellraw @s [{"text":"Fatebound Dice\n","color":"gold"},{"color":"green","italic":false,"text":"Congrats! "},{"color":"gray","italic":false,"text":"You rolled a "},{"color":"red","italic":false,"text":"d"},{"color":"red","italic":false,"score":{"name":"@s","objective":"customDice.RollValue"}},{"color":"gray","italic":false,"text":" cursing you with "},{"color":"gold","hover_event":{"action":"show_text","value":[$(description)]},"italic":false,"text":"$(name)!"}]
                }

                dir tommy_gun {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 601

                        scoreboard players set @s interactablesUniversal.GiveItemID 1
                        function interactables:recieve_item/create_scenario {animation:'common',perspective:"none",item:"minecraft:interactables/tommy_gun"}

                        # give @p bowl[max_stack_size=1,max_damage=30,item_name={"color":"yellow","italic":false,"text":"Tommy Gun"},lore=[{"color":"gray","italic":false,"text":"Welcome to the land of the free"}," ",[{"color":"gray","italic":false,"text":"Click to "},{"color":"red","italic":false,"text":"fire "},{"color":"gray","italic":false,"text":"a bullet"}],[{"color":"gold","italic":false,"text":"30"},{"color":"gray","italic":false,"text":"/"},{"color":"gold","italic":false,"text":"30 "},{"color":"gray","italic":false,"text":"Bullets"}]],damage=0,food={nutrition:0,saturation:0,can_always_eat:true},consumable={consume_seconds:8888888},item_model="minecraft:interactables/tommy_gun"] 1
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Second Amendment"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Second Amendment","color":"gold"},{"text":"\n"},{"text":"Get given a ","color":"gray"},{"text":"Tommy Gun","color":"yellow"},{"text":" which has ","color":"gray"},{"text":"30 bullets,","color":"green"},{"text":" and will be ","color":"gray"},{"text":"destroyed","color":"red"},{"text":" upon firing all rounds. This item can be stored in chests or passed around to allies.","color":"gray"}]}}}
                    }

                    function inform {
                        function custom:abilities/dice/roll/20/tommy_gun/description
                        function custom:abilities/dice/roll/20/announce with storage minecraft:custom dice.roll

                        give @p bowl[max_stack_size=1,max_damage=50,item_name={"color":"yellow","italic":false,"text":"Tommy Gun"},lore=[{"color":"gray","italic":false,"text":"Welcome to the land of the free"}," ",[{"color":"gray","italic":false,"text":"Click to "},{"color":"red","italic":false,"text":"fire "},{"color":"gray","italic":false,"text":"a bullet"}],[{"color":"gold","italic":false,"text":"50"},{"color":"gray","italic":false,"text":"/"},{"color":"gold","italic":false,"text":"50 "},{"color":"gray","italic":false,"text":"Bullets"}]],damage=0,food={nutrition:0,saturation:0,can_always_eat:true},consumable={consume_seconds:8888888},item_model="minecraft:interactables/tommy_gun",custom_data={bullets:50}] 1
                    }
                }

                dir microphone {
                    function main {
                        scoreboard players set @s customDice.PreviousRoll 602

                        scoreboard players set @s interactablesUniversal.GiveItemID 2
                        function interactables:recieve_item/create_scenario {animation:'common',perspective:"head",item:"minecraft:interactables/microphone"}
                    }

                    function description {
                        data merge storage minecraft:custom {dice:{roll:{name:"Microphone"}}}
                        data merge storage minecraft:custom {dice:{roll:{description:["",{"text":"Microphone","color":"gold"},{"text":"\n"},{"text":"Gives the gambler a ","color":"gray"},{"text":"microphone item.","color":"white"},{"text":" Upon using this item, you'll be put into a cutscene where you launch off a ","color":"gray"},{"text":"Miku Beam","color":"aqua"},{"text":" obliterating literally anything in front of you.","color":"gray"}]}}}
                    }

                    function inform {
                        function custom:abilities/dice/roll/20/microphone/description
                        function custom:abilities/dice/roll/20/announce with storage minecraft:custom dice.roll

                        give @p bowl[max_stack_size=1,max_damage=3,item_name={"color":"aqua","italic":false,"text":"Microphone"},lore=[{"color":"gray","italic":false,"text":"Miku Miku BEAMMMMM!"}," ",[{"color":"gray","italic":false,"text":"Click to "},{"color":"red","italic":false,"text":"fire "},{"color":"gray","italic":false,"text":"a Miku Beam"}],[{"color":"gold","italic":false,"text":"3"},{"color":"gray","italic":false,"text":"/"},{"color":"gold","italic":false,"text":"3 "},{"color":"gray","italic":false,"text":"Beams Left"}]],damage=0,food={nutrition:0,saturation:0,can_always_eat:true},consumable={consume_seconds:8888888},item_model="minecraft:interactables/microphone",custom_data={beams:3}] 1
                    }
                }
            }
        }

        dir hotbar {
            function main {
                REPEAT (1,4) as i {
                    function custom:abilities/dice/hotbar/base_progress with storage minecraft:custom dice.cooldowns.move<%i%>
                }
                
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"dice",selected:<%i%>}
                    }
                }

                block {
                    execute unless score @s customDice.RollValue matches 1.. run scoreboard players set @s customDice.RollValue 1
                    execute store result storage minecraft:custom dice.roll.temp int 1 run scoreboard players get @s customDice.RollValue
                    block { with storage minecraft:custom dice.roll
                        execute store result storage minecraft:custom dice.hotbar.roll_value int 1 run scoreboard players get @s customDice.RollValue
                        $execute if score @s customDice.RollValue matches 1..9 run data merge storage minecraft:custom {dice:{hotbar:{roll_value:"0$(temp)"}}}
                    }

                    execute if score @s customDice.RollValue matches 1 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"dark_red"}}}
                    execute if score @s customDice.RollValue matches 2..7 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"red"}}}
                    execute if score @s customDice.RollValue matches 8..11 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"gold"}}}
                    execute if score @s customDice.RollValue matches 12..15 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"yellow"}}}
                    execute if score @s customDice.RollValue matches 16..19 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"green"}}}
                    execute if score @s customDice.RollValue matches 20 run data merge storage minecraft:custom {dice:{hotbar:{roll_color:"aqua"}}}
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom dice.hotbar
                    $title @s actionbar [{"text":"\uF821\u04A0"},{"text":"\uF822$(roll_value)","color":"$(roll_color)"},{"text":"\uF823"},{"text":"\uF820\$(move1)\uF801\u01B5"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom dice.hotbar
                    $title @s actionbar [{"text":"\uF821\u04A0"},{"text":"\uF822$(roll_value)","color":"$(roll_color)"},{"text":"\uF823"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)\uF801\u01B5"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom dice.hotbar
                    $title @s actionbar [{"text":"\u04A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)\uF801\u01B5"},{"text":"\uF800\$(move4)"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 4 run block { with storage minecraft:custom dice.hotbar
                    $title @s actionbar [{"text":"\u04A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)\uF801\u01B5"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function base_progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A1"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom dice.hotbar.move$(selection) set value "u04B1"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        dir toggle {
            function on {
                playsound minecraft:gojo.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:gojo.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }
    }

    dir the_world {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/the_world/active

                execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }
                    
                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
            }
        }

        function active {
            execute store result storage minecraft:custom the_world.id int 1 run scoreboard players get @s customTheWorld.RigID
            REPEAT (1,4) as i {
                execute if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/the_world/key_bindings/move<%i%>
            }
            block { with storage minecraft:custom the_world
                $tp @n[type=minecraft:item_display,tag=aj.the_world.root,scores={customTheWorld.RigID=$(id)}] ~ ~ ~ ~ 0
            }

            function custom:abilities/the_world/hotbar/main
        }

        dir key_bindings {
            REPEAT (1,4) as i {
                function move<%i%> {
                    function custom:abilities/the_world/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move<%i%>Trigger
                    scoreboard players enable @s customUniversal.Move<%i%>Trigger
                }
            }
        }
        
        dir hotbar {
            function main {
                REPEAT (1,4) as i {
                    function custom:abilities/the_world/hotbar/base_progress with storage minecraft:custom the_world.cooldowns.move<%i%>
                }
                
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"the_world",selected:<%i%>}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom the_world.hotbar
                    $title @s actionbar [{"text":"\uF813\u03A0"},{"text":"\uF800\$(move1)\uF801\u03A2"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u03A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom the_world.hotbar
                    $title @s actionbar [{"text":"\uF813\u03A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)\uF801\u03A2"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u03A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom the_world.hotbar
                    $title @s actionbar [{"text":"\uF813\u03A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)\uF801\u03A2"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u03A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 4 run block { with storage minecraft:custom the_world.hotbar
                    $title @s actionbar [{"text":"\uF813\u03A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)\uF801\u03A2"},{"text":"\uF800\u03A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function base_progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03B1"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03B2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom the_world.hotbar.move$(selection) set value "u03B3"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                $scoreboard players set @s customTheWorld.IdleMode $(idle)

                # function custom:universal/armor/hide
                $function custom:universal/setup/rig {objective:"$(objective)",item:"$(rig)"}
                $execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get .global $(objective)
                $data merge storage minecraft:custom {the_world:{temp:{objective:'$(objective)',animation:'$(animation)'}}}
                block { with storage minecraft:custom the_world.temp
                    $execute as @n[type=minecraft:item_display,tag=aj.the_world.root,scores={$(objective)=$(id)}] run block { with storage minecraft:custom the_world.temp
                        execute if score @p[tag=customAbility.TheWorld] customTheWorld.IdleMode matches 1 run function animated_java:the_world/animations/idle/pause
                        $function animated_java:the_world/animations/$(animation)/play
                    }
                }
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.the_world.camera",objective:"$(objective)"}
            }

            dir 1 {
                function core {
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    function custom:universal/error_messages/universal

                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/the_world/moves/1/raycast/start
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Time Skip"}
                }

                dir raycast {
                    function start {
                        execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .The_WorldCooldown customUniversal.Move1Cooldown
                        scoreboard players set @s customUniversal.MoveLastUsed 1
                        tag @s add temp
                        particle minecraft:dragon_breath ~ ~ ~ 0 0 0 0.125 20 force @a
                        playsound minecraft:the_world.timeskip.sfx player @a ~ ~ ~ 0.5
                        execute anchored eyes positioned ^ ^ ^ run function custom:abilities/the_world/moves/1/raycast/fire
                        tag @s remove temp
                        scoreboard players reset .distance customTheWorld.Timeskip
                    }

                    function fire {
                        execute unless block ^ ^ ^.1 #custom:raycast_pass run function custom:abilities/the_world/moves/1/raycast/hit
                        scoreboard players add .distance customTheWorld.Timeskip 1
                        particle minecraft:portal ^ ^-1 ^ 0 0 0 0.01 1 force @a
                        execute if score .distance customTheWorld.Timeskip matches 125 positioned ~ ~ ~ run function custom:abilities/the_world/moves/1/raycast/hit
                        execute if score .distance customTheWorld.Timeskip matches ..125 positioned ^ ^ ^.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass unless entity @s[tag=temp2] run function custom:abilities/the_world/moves/1/raycast/fire
                        execute if entity @s[tag=temp2] run tag @s remove temp2
                    }

                    function hit {
                        execute align y run tp @s ^ ^ ^-0.3
                        particle minecraft:dragon_breath ~ ~-1 ~ 0 0 0 0.125 20 force @a
                        playsound minecraft:the_world.timeskip.sfx player @a ~ ~ ~ 0.5
                        tag @s add temp2
                    }
                }
            }

            dir 2 {
                function core {
                    execute if score @s customUniversal.Toggle matches 1 run {
                        scoreboard players set @s customUniversal.ActiveHotbar 2
                        execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                        execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                        function custom:universal/error_messages/universal

                        execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/the_world/moves/2/pass
                        execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A0",move:"Barrage"}
                    }
                }

                function pass {
                    function custom:abilities/the_world/moves/setup {rig:"the_world",objective:"customTheWorld.BarrageID",animation:'barrage',idle:1}
                    function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.the_world.locator.hitbox",objective:"customTheWorld.BarrageID"} 
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move2Cooldown = .The_WorldCooldown customUniversal.Move2Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 2
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                }

                function damage_check {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.BarrageID
                    block { with storage minecraft:custom the_world.temp
                        $execute as @e[type=!#custom:not_mob,distance=..2.5] unless entity @s[scores={customTheWorld.BarrageID=$(id)}] unless entity @s[tag=customSettings_Immunity] run block { with storage minecraft:custom the_world.temp
                            attribute @s minecraft:movement_speed base set 0.0125
                            attribute @s minecraft:jump_strength base set 0
                            effect give @s minecraft:weakness infinite 255 true
                            tag @s add customUniversal.ConstantCheck
                            tag @s add customTheWorld.BarrageVictim
                            $function custom:universal/damage/victim {id:"$(id)",damage:"4",type:"minecraft:generic",attacker:"tag=customAbility.TheWorld",objective:"customTheWorld.KnifeThrowID",first:"was pummeled",second:"using Barage"}
                        }
                    }
                }

                function final_hit {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.BarrageID
                    block { with storage minecraft:custom the_world.temp
                        $execute as @e[type=!#custom:not_mob,distance=..2.5] unless entity @s[scores={customTheWorld.BarrageID=$(id)}] unless entity @s[tag=customSettings_Immunity] run block { with storage minecraft:custom the_world.temp
                            $execute rotated as @n[type=minecraft:item_display,tag=aj.the_world.locator.hitbox,scores={customTheWorld.BarrageID=$(id)}] rotated ~ -20 as @s run launch @s looking 1.5
                            $function custom:universal/damage/victim {id:"$(id)",damage:"12",type:"minecraft:generic",attacker:"tag=customAbility.TheWorld",objective:"customTheWorld.KnifeThrowID",first:"was pummeled",second:"using Barage"}
                        }
                    }
                }
            }

            dir 3 {
               function core {
                    execute if score @s customUniversal.Toggle matches 1 run {
                        scoreboard players set @s customUniversal.ActiveHotbar 3
                        execute unless score @s customUniversal.Move3Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                        execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                        function custom:universal/error_messages/universal

                        execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/the_world/moves/3/pass
                        execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:3,unicode:"u50A0",move:"Impale"}
                    }
                }

                function pass {
                    function custom:abilities/the_world/moves/setup {rig:"the_world",objective:"customTheWorld.ImpaleID",animation:'impale',idle:1}
                    function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.the_world.locator.right_hand_world",objective:"customTheWorld.ImpaleID"} 
                    tag @s add customUniversal.Cancellable
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move3Cooldown = .The_WorldCooldown customUniversal.Move3Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 3
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0
                    attribute @s minecraft:jump_strength base set 0
                }

                function check_path {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.ImpaleID
                    block { with storage minecraft:custom the_world.temp
                        $execute as @e[type=!#custom:not_mob,distance=..2] at @s unless entity @s[scores={customTheWorld.ImpaleID=$(id)}] unless entity @s[tag=customSettings_Immunity] run block { with storage minecraft:custom the_world.temp
                            function custom:abilities/the_world/moves/3/trigger_cutscene with storage minecraft:custom the_world.temp
                        }
                    }
                }

                function trigger_cutscene {
                    $execute as @n[type=minecraft:item_display,tag=aj.the_world.root,scores={customTheWorld.ImpaleID=$(id)}] run function animated_java:the_world/remove/this

                    $execute rotated as @p[tag=customAbility.TheWorld,scores={customTheWorld.ImpaleID=$(id)}] rotated ~ 0 run {
                        function animated_java:the_world_cutscenes/summon {args:{animation: 'impale', start_animation: true}}
                    }

                    function custom:abilities/the_world/moves/setup {rig:"the_world_cutscenes",objective:"customTheWorld.ImpaleID",animation:'impale',idle:1}
                    function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.the_world_cutscenes.camera",objective:"customTheWorld.ImpaleID"}

                    # as player
                    $execute as @p[tag=customAbility.TheWorld,scores={customTheWorld.ImpaleID=$(id)}] run {
                        scoreboard players operation @s customTheWorld.ImpaleID = .global customTheWorld.ImpaleID
                        tag @s add customTheWorld.ImpaleCutscene
                        tag @s add customTheWorld.ImpaleUser

                        execute store result score @s customTheWorld.ImpaleX run data get entity @s Pos[0] 1
                        execute store result score @s customTheWorld.ImpaleY run data get entity @s Pos[1] 1
                        execute store result score @s customTheWorld.ImpaleZ run data get entity @s Pos[2] 1
                        execute store result score @s customTheWorld.ImpaleRotationX run data get entity @s Rotation[0] 1

                        gamemode spectator @s
                    }
                    
                    # as victim
                    block {
                        scoreboard players operation @s customTheWorld.ImpaleID = .global customTheWorld.ImpaleID
                        tag @s add customTheWorld.ImpaleCutscene
                        tag @s add customTheWorld.ImpaleVictim

                        execute store result score @s customTheWorld.ImpaleX run data get entity @s Pos[0] 1
                        execute store result score @s customTheWorld.ImpaleY run data get entity @s Pos[1] 1
                        execute store result score @s customTheWorld.ImpaleZ run data get entity @s Pos[2] 1
                        execute store result score @s customTheWorld.ImpaleRotationX run data get entity @s Rotation[0] 1

                        execute if entity @s[type=minecraft:player] run {
                            gamemode spectator @s
                        } else run {
                            data merge entity @s {NoAI:1b}
                            tp @s ~ -70 ~
                        }
                    }
                }

                function end_cutscene {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.ImpaleID
                    kill @n[type=minecraft:item_display,tag=aj.the_world_cutscenes.camera]
                    function animated_java:the_world_cutscenes/remove/this

                    block { with storage minecraft:custom the_world.temp
                        $execute as @p[tag=customAbility.TheWorld,tag=customTheWorld.ImpaleUser,scores={customTheWorld.ImpaleID=$(id)}] run {
                            execute store result storage minecraft:custom the_world.impale.x int 1 run scoreboard players get @s customTheWorld.ImpaleX
                            execute store result storage minecraft:custom the_world.impale.y int 1 run scoreboard players get @s customTheWorld.ImpaleY
                            execute store result storage minecraft:custom the_world.impale.z int 1 run scoreboard players get @s customTheWorld.ImpaleZ
                            execute store result storage minecraft:custom the_world.impale.rotx int 1 run scoreboard players get @s customTheWorld.ImpaleRotationX
                            tag @s remove customTheWorld.ImpaleCutscene
                            tag @s remove customTheWorld.ImpaleUser
                            block { with storage minecraft:custom the_world.impale
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                                data remove storage minecraft:custom the_world.impale
                            }
                            function custom:abilities/the_world/toggle/on
                            tag @s remove customUniversal.Animation
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                            attribute @s minecraft:gravity base reset
                            scoreboard players reset @s customTheWorld.ImpaleID
                        }
                        
                        $execute as @n[type=!#custom:not_mob,tag=customTheWorld.ImpaleVictim,scores={customTheWorld.ImpaleID=$(id)}] run block { with storage minecraft:custom the_world.temp
                            execute store result storage minecraft:custom the_world.impale.x int 1 run scoreboard players get @s customTheWorld.ImpaleX
                            execute store result storage minecraft:custom the_world.impale.y int 1 run scoreboard players get @s customTheWorld.ImpaleY
                            execute store result storage minecraft:custom the_world.impale.z int 1 run scoreboard players get @s customTheWorld.ImpaleZ
                            execute store result storage minecraft:custom the_world.impale.rotx int 1 run scoreboard players get @s customTheWorld.ImpaleRotationX
                            $function custom:universal/damage/victim {id:"$(id)",damage:"17",type:"minecraft:generic",attacker:"tag=customAbility.TheWorld,tag=customTheWorld.ImpaleUser",objective:"customTheWorld.ImpaleID",first:"was impaled",second:"using Impale"}
                            tag @s remove customTheWorld.ImpaleCutscene
                            tag @s remove customTheWorld.ImpaleVictim
                            block { with storage minecraft:custom the_world.impale
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                                data remove storage minecraft:custom the_world.impale
                            }

                            execute if entity @s[type=minecraft:player] run {
                                attribute @s minecraft:movement_speed base reset
                                attribute @s minecraft:jump_strength base reset
                                attribute @s minecraft:gravity base reset
                            } else run {
                                data merge entity @s {NoAI:0b}
                            }
                            scoreboard players reset @s customTheWorld.ImpaleID
                        }
                    }
                }
            }

            dir 4 {
                function core {
                    execute if score @s customUniversal.Toggle matches 1 run {
                        scoreboard players set @s customUniversal.ActiveHotbar 4
                        execute unless score @s customUniversal.Move4Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                        execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                        function custom:universal/error_messages/universal

                        execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/the_world/moves/4/pass
                        execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:4,unicode:"u50A0",move:"Knife Throw"}
                    }
                }

                function pass {
                    function custom:abilities/the_world/moves/setup {rig:"the_world",objective:"customTheWorld.KnifeThrowID",animation:'knife_throw',idle:0}
                    tag @s add customUniversal.Cancellable
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move4Cooldown = .The_WorldCooldown customUniversal.Move4Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 4
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                    effect give @s minecraft:invisibility infinite 0 true
                }

                function spawn {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.KnifeThrowID
                    block { with storage minecraft:custom the_world.temp
                        execute rotated as @p[tag=customAbility.TheWorld] run function animated_java:the_world_projectiles/summon {args:{animation:'knife', start_animation: true}}
                        $execute as @n[type=minecraft:item_display,tag=aj.the_world_projectiles.root,tag=!playing] run scoreboard players set @s customTheWorld.KnifeThrowID $(id)
                    }
                }

                function movement {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.KnifeThrowID

                    execute positioned ^ ^ ^ if entity @s[tag=customTheWorld.KnifeNotStuck] run function custom:abilities/the_world/moves/4/check
                    tag @s remove temp
                    # tellraw @a {"score":{"name":"@s","objective":"customTheWorld.KnifeMovement"}}

                    # execute if block ^ ^ ^0.1 #custom:raycast_pass run {
                    #     data merge storage minecraft:custom {the_world:{temp:{teleport_amount:"0.1"}}}
                    #     tag @s add customTheWorld.KnifeMoving
                    # }
                    # REPEAT (2,9) as i {
                    #     execute if block ^ ^ ^0.<%i%> #custom:raycast_pass run data merge storage minecraft:custom {the_world:{temp:{teleport_amount:"0.<%i%>"}}}
                    # }
                    # REPEAT (0,9) as i {
                    #     execute if block ^ ^ ^1.<%i%> #custom:raycast_pass run data merge storage minecraft:custom {the_world:{temp:{teleport_amount:"1.<%i%>"}}}
                    # }                    
                    # execute if block ^ ^ ^2.0 #custom:raycast_pass run data merge storage minecraft:custom {the_world:{temp:{teleport_amount:"2.0"}}}

                    # $tp @s ^ ^ ^$(teleport_amount)

                    execute if entity @s[tag=customTheWorld.KnifeNotStuck] run block { with storage minecraft:custom the_world.temp
                        particle minecraft:crit ~ ~ ~ 0 0 0 0 1 force @a
                        $execute as @e[type=!#custom:not_mob,distance=..2] unless entity @s[scores={customTheWorld.KnifeThrowID=$(id)}] unless entity @s[tag=customSettings_Immunity] run block { with storage minecraft:custom the_world.temp
                            $function custom:universal/damage/victim {id:"$(id)",damage:"12",type:"minecraft:generic",attacker:"tag=customAbility.TheWorld",objective:"customTheWorld.KnifeThrowID",first:"was impaled",second:"using Knife Throw"}
                            $execute as @n[type=minecraft:item_display,tag=aj.the_world_projectiles.root,scores={customTheWorld.KnifeThrowID=$(id)}] run function animated_java:the_world_projectiles/remove/this
                        }
                    }

                    scoreboard players reset @s customTheWorld.KnifeMovement
                    data remove storage minecraft:custom the_world.temp
                }

                function check {
                    tag @s remove temp
                    execute if block ^ ^ ^0.15 #custom:raycast_pass run {
                        scoreboard players add @s customTheWorld.KnifeMovement 1
                        execute unless score @s customTheWorld.KnifeMovement matches 15 run tag @s add temp
                    }
                    
                    execute if score @s customTheWorld.KnifeMovement matches ..14 unless entity @s[tag=temp] run {
                        tag @s remove customTheWorld.KnifeNotStuck
                        tp @s ~ ~ ~
                    } else if score @s customTheWorld.KnifeMovement matches 15 unless entity @s[tag=temp] if entity @s[tag=customTheWorld.KnifeNotStuck] run {
                        tp @s ~ ~ ~
                    }

                    execute if block ^ ^ ^0.15 #custom:raycast_pass unless score @s customTheWorld.KnifeMovement matches 15.. if entity @s[tag=temp] positioned ^ ^ ^0.15 run function custom:abilities/the_world/moves/4/check
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.TheWorld,scores={$(objective)=$(id)}] at @s run function custom:abilities/the_world/moves/reset/player
                        function animated_java:the_world/animations/idle/resume
                        # $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }

        function skin {
            $execute store result storage minecraft:custom the_world.skin.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {the_world:{skin:{rig:"$(rig)",objective:"$(objective)"}}}
            block { with storage minecraft:custom the_world.skin
                $execute as @p[tag=customAbility.TheWorld,scores={$(objective)=$(id)}] run {
                    execute if entity @s[tag=customTheWorld.SkinDefault] run block { with storage minecraft:custom the_world.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/default/apply
                    }
                    execute if entity @s[tag=customTheWorld.SkinTW2] run block { with storage minecraft:custom the_world.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/the_world_2/apply
                    }
                    execute if entity @s[tag=customTheWorld.SkinVTW] run block { with storage minecraft:custom the_world.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/vampire_the_world/apply
                    }
                    execute if entity @s[tag=customTheWorld.SkinRTW] run block { with storage minecraft:custom the_world.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/retro_the_world/apply
                    }
                    execute if entity @s[tag=customTheWorld.SkinSTW] run block { with storage minecraft:custom the_world.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/shadow_the_world/apply
                    }
                }
            }
        }

        dir toggle {
            function on {
                tag @s add temp
                function animated_java:the_world/summon {args:{animation: 'summon', start_animation: true}}
                execute as @n[type=minecraft:item_display,tag=aj.the_world.root,tag=!customTheWorld.IDAssigned] run {
                    scoreboard players add .global customTheWorld.RigID 1
                    scoreboard players operation @s customTheWorld.RigID = .global customTheWorld.RigID
                    execute as @p[tag=customAbility.TheWorld,tag=temp] run {
                        scoreboard players operation @s customTheWorld.RigID = .global customTheWorld.RigID
                        tag @s remove temp
                    }
                    tag @s add customTheWorld.IDAssigned
                }
                playsound minecraft:the_world.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                playsound minecraft:the_world.toggle.withdraw player @s ~ ~ ~ 0.35
                execute store result storage minecraft:custom the_world.id int 1 run scoreboard players get @s customTheWorld.RigID
                block { with storage minecraft:custom the_world
                    $execute as @n[type=minecraft:item_display,tag=aj.the_world.root,scores={customTheWorld.RigID=$(id)}] run function animated_java:the_world/remove/this
                    scoreboard players reset @s customTheWorld.RigID
                }
            }
        }
    }

    dir billy {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/billy/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0,customBilly.ToggleOnText=0}] run {
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }

                execute if score @s customBilly.ToggleOnText matches 1.. run {
                    execute if score @s customBilly.ToggleOnText matches 35 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"aqua","text":"Demarcus"}}

                    execute if score @s customBilly.ToggleOnText matches 25 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"aqua","text":"Bartholomew"}}

                    execute if score @s customBilly.ToggleOnText matches 15 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"aqua","text":"James"}}

                    execute if score @s customBilly.ToggleOnText matches 8 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"aqua","text":"the"}}
                    
                    execute if score @s customBilly.ToggleOnText matches 1 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"aqua","text":"III"}}

                    scoreboard players remove @s customBilly.ToggleOnText 1
                }

                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        dir toggle {
            function on {
                tag @s add temp
                scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                function animated_java:billy/summon {args:{animation: 'summon', start_animation: true}}
                execute as @n[type=minecraft:item_display,tag=aj.billy.root,tag=!customTheWorld.IDAssigned] run {
                    scoreboard players add .global customBilly.RigID 1
                    scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                    execute as @p[tag=customAbility.Billy,tag=temp] run {
                        scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                        tag @s remove temp
                    }
                    tag @s add customBilly.IDAssigned
                }
                tag @s add customUniversal.HideUI
                tag @s add customBilly.ToggleDelay
                scoreboard players set @s customUniversal.ToggleDelay 40 
            }

            function appear {
                data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"billy",animation:'appear',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.position]"}
            }

            function land {
                execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                block { with storage minecraft:custom universal.fetch_block
                    $particle block{block_state:"$(id)"} ^ ^0.5 ^0.25 0.75 0 0.75 1 50 normal
                    particle minecraft:snowflake ~ ~ ~ 0 0 0 0.25 50 force @a
                }
            }

            function enable {
                scoreboard players set @s customBilly.ToggleOnText 44
                tag @s remove customBilly.ToggleDelay
            }

            function off {
                title @s actionbar ""
                execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                block { with storage minecraft:custom billy
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                        function animated_java:billy/animations/idle/stop
                        function animated_java:billy/animations/withdraw/play
                    }
                }
                scoreboard players reset @s customBilly.ToggleOnText
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }
        }

        function active {
            execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
            execute unless entity @s[tag=customBilly.ToggleDelay] run scoreboard players add @s customBilly.PassiveSnowParticles 1

            # execute if score @s customBilly.PassiveSnowParticles matches 20.. run block { with storage minecraft:custom billy
            #     $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] at @s run function animated_java:billy/as_locator {name:'position',command:'particle minecraft:snowflake ~ ~0.5 ~ 0.5 0.5 0.5 0.1 20 force @a'}
            #     scoreboard players reset @s customBilly.PassiveSnowParticles
            # }

            REPEAT (1,3) as i {
                execute unless entity @s[tag=customBilly.ToggleDelay] if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/billy/key_bindings/move<%i%>
                execute unless entity @s[tag=customBilly.ToggleDelay] if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/billy/key_bindings/move<%i%>
                execute unless entity @s[tag=customBilly.ToggleDelay] if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/billy/key_bindings/move<%i%>
            }

            block { with storage minecraft:custom billy
                $execute unless entity @s[gamemode=spectator] run tp @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] ~ ~ ~ ~ 0
                execute unless entity @s[tag=customUniversal.Animation] unless entity @s[tag=customBilly.ToggleDelay] unless entity @s[tag=customBilly.MaulAnimation] run function custom:abilities/billy/movement/main with storage minecraft:custom billy
            }

            execute unless entity @s[tag=customUniversal.HideUI] run function custom:abilities/billy/hotbar/main
        }

        dir key_bindings {
            REPEAT (1,3) as i {
                function move<%i%> {
                    function custom:abilities/billy/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                }
            }
        }
        
        dir hotbar {
            function main {
                REPEAT (1,3) as i {
                    function custom:abilities/billy/hotbar/progress with storage minecraft:custom billy.cooldowns.move<%i%>
                }
                
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"billy",selected:<%i%>}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
                
                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05B0"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                # function custom:universal/armor/hide
                $function custom:universal/setup/rig {objective:"$(objective)",item:"$(rig)"}
                $execute store result storage minecraft:custom billy.temp.id int 1 run scoreboard players get .global $(objective)
                $data merge storage minecraft:custom {billy:{temp:{objective:'$(objective)',animation:'$(animation)'}}}
                block { with storage minecraft:custom billy.temp
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={$(objective)=$(id)}] run block { with storage minecraft:custom billy.temp
                        function animated_java:billy/animations/idle/stop
                        function animated_java:billy/animations/movement/stop
                        tag @s remove customBilly.Idle
                        tag @s remove customBilly.Moving
                        $function animated_java:billy/animations/$(animation)/play
                    }
                }
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.billy.locator.camera",objective:"$(objective)"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Encourage"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'encourage'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .BillyCooldown customUniversal.Move1Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 2
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                }

                function encourage {
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"billy",animation:'encourage',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.mouth]"}
                }

                function buffs {
                    execute at @s as @a[distance=..3] run {
                        tag @s add customUniversal.ConstantCheck
                        scoreboard players set @s customBilly.EncourageBuffDuration 600
                        attribute @s minecraft:movement_speed modifier add custom:billy.encourage 0.25 add_multiplied_total
                    }
                }
            }

            dir 2 {
                function core {
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 2
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/2/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A0",move:"Phase"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'phase'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move2Cooldown = .BillyCooldown customUniversal.Move2Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 2
                    scoreboard players set @s customUniversal.MoveDelay 10
                    function custom:universal/stable_player_display/mask {branch:"billy"}

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                    gamemode spectator @s

                }

                dir movement {
                    function main {
                        function custom:abilities/billy/moves/2/movement/recursive
                        scoreboard players reset .distance customBilly.PhaseMovement
                    }

                    function recursive {
                        scoreboard players add .distance customBilly.PhaseMovement 1
                        tp @s ^ ^ ^

                        execute if block ^ ^ ^0.1 #custom:raycast_pass if entity @s[tag=customBilly.PhaseBegin] run function custom:abilities/billy/moves/2/movement/end

                        execute if score .distance customBilly.PhaseMovement matches ..15 positioned ^ ^ ^.1 rotated ~ ~ run function custom:abilities/billy/moves/2/movement/recursive
                    }
                    
                    function end {
                        tp @s ^ ^ ^-0.1
                        execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                        function animated_java:billy/animations/phase/stop
                        function custom:abilities/billy/moves/reset/all {user:"customAbility.Billy",objective:"customBilly.RigID",rig:"billy"}
                        tag @s remove customBilly.PhaseBegin
                        
                        block { with storage minecraft:custom billy
                            $execute as @p[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] run block { with storage minecraft:custom billy
                                gamemode survival @s
                                $tp @s @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}]
                                playsound minecraft:entity.bat.takeoff player @s ~ ~ ~ 0.5
                            }
                        }
                    }
                }
            }

            dir 3 {
                function core {
                    execute unless score @s customUniversal.Move3Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 3
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/3/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:3,unicode:"u50A0",move:"Snare"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'snare_set'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move3Cooldown = .BillyCooldown customUniversal.Move3Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 2
                    scoreboard players set @s customUniversal.MoveDelay 10
                    playsound minecraft:entity.polar_bear.hurt player @a ~ ~ ~ 0.5

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                }

                function dig {
                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ~ ~ ~ 0.5 0 0.5 1 10 normal
                    }
                }

                function setup {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom billy
                        $execute as @p[tag=customAbility.Billy,scores={customUniversal.RigID=$(id)}] run {
                            loot insert 0 -63 0 loot custom:player_head
                            data modify storage minecraft:custom billy.username set string block 0 -63 0 Items[0].components."minecraft:profile".name
                            item replace block 0 -63 0 container.0 with minecraft:air
                        }
                        block { with storage minecraft:custom billy
                            $function animated_java:billy/as_locator {name:'position',command:'summon item_display ~ ~1.2 ~ {Tags:["customBilly.Trap","temp","customUniversal.Tick"],data:{username:"$(username)"}}'}
                            execute as @n[type=minecraft:item_display,tag=customBilly.Trap,tag=temp] run {
                                scoreboard players set @s customBilly.TrapDuration 1500
                                tag @s remove temp
                            }
                        }
                    }
                    
                    function custom:abilities/billy/moves/reset/all {user:"customAbility.Billy",objective:"customUniversal.RigID",rig:"billy"}
                }

                function slam {
                    data modify storage minecraft:custom billy.trap.damage set string entity @s data.username
                    block { with storage minecraft:custom billy.trap
                        $execute as @e[type=!#custom:not_mob,distance=..2.5,name=!$(damage)] run {
                            damage @s 10
                            attribute @s minecraft:movement_speed modifier remove custom:billy.snare
                        }
                    }

                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ~ ~ ~ 1 0 1 1 100 force @a
                    }
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Billy,scores={$(objective)=$(id)}] at @s run function custom:abilities/billy/moves/reset/player
                        # $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }

        dir secret_interactions {
            dir devour {
                function pass {
                    execute unless entity @s[tag=customBilly.SecretInteractionDevour] run {
                        tag @s add customBilly.SecretInteractionDevour
                        function custom:universal/secret_interaction_notify {description:["",{"text":"Devour","color":"gold"},{"text":"\n"},{"text":"Everytime ","color":"gray"},{"text":"Maul ","color":"yellow"},{"text":"is activated, there is a ","color":"gray"},{"text":"0.5% chance","color":"green"},{"text":" that Billy plays a cutscene version of the passive instead.","color":"gray"},{"text":"\n"},{"text":"-> Damage: ","color":"gray"},{"text":"30","color":"red"},{"text":"\n"},{"text":"-> Victim Movement Speed: ","color":"gray"},{"text":"0.75x","color":"red"},{"text":"\n"},{"text":"-> Victim Jump Strength: ","color":"gray"},{"text":"0.5x","color":"red"},{"text":"\n"},{"text":"-> Effect Duration:","color":"gray"},{"text":" 15s","color":"yellow"}]}
                    }

                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    block { with storage minecraft:custom billy
                        $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run function animated_java:billy/remove/this

                        $execute rotated as @p[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] rotated ~ 0 run {
                            function animated_java:billy_cutscenes/summon {args:{animation: 'devour', start_animation: true}}
                        }

                        execute as @n[type=minecraft:item_display,tag=aj.billy_cutscenes.root,tag=!temp] run {
                            scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                            execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.DevourID
                            tag @s add temp
                        }

                        block { with storage minecraft:custom billy
                            $execute as @n[type=!#custom:not_mob,tag=customBilly.DevourVictim,scores={customBilly.DevourID=$(id)}] run function custom:universal/stable_player_display/mask {branch:"billy_cutscenes"}
                        }

                        function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.billy_cutscenes.locator.camera",objective:"customBilly.DevourID"}
                    }
                }

                function end {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.DevourID
                    function animated_java:billy_cutscenes/remove/this

                    block { with storage minecraft:custom billy
                        $execute as @p[tag=customAbility.Billy,tag=customBilly.DevourUser,scores={customBilly.DevourID=$(id)}] run {
                            execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                            execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                            execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                            execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                            tag @s remove customBilly.DevourCutscene
                            tag @s remove customBilly.DevourUser
                            block { with storage minecraft:custom billy
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                            }
                            function custom:abilities/billy/toggle/on
                            tag @s remove customUniversal.Animation
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                            attribute @s minecraft:gravity base reset
                            scoreboard players reset @s customBilly.DevourID
                        }
                        
                        $execute as @n[type=!#custom:not_mob,tag=customBilly.DevourVictim,scores={customBilly.DevourID=$(id)}] run block { with storage minecraft:custom billy
                            execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                            execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                            execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                            execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                            $function custom:universal/damage/victim {id:"$(id)",damage:"17",type:"minecraft:generic",attacker:"tag=customAbility.Billy,tag=customBilly.DevourUser",objective:"customBilly.DevourID",first:"was devoured",second:"using Devour"}
                            tag @s remove customBilly.DevourCutscene
                            tag @s remove customBilly.DevourVictim
                            block { with storage minecraft:custom billy
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                            }

                            execute if entity @s[type=minecraft:player] run {
                                attribute @s minecraft:movement_speed base reset
                                attribute @s minecraft:jump_strength base reset
                                attribute @s minecraft:gravity base reset
                            } else run {
                                data merge entity @s {NoAI:0b}
                            }
                            scoreboard players reset @s customBilly.DevourID
                        }
                    }
                }
            }
        }

        dir passive {
            dir maul {
                function start {
                    scoreboard players add @s customBilly.PassiveMaul 1
                    execute if score @s customBilly.PassiveMaul matches 5.. run {
                        execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                        execute if predicate custom:billy/devour_chance run {
                            scoreboard players add .global customBilly.DevourID 1
                            # as player
                            block {
                                tag @s add customBilly.DevourUser
                                tag @s add customBilly.DevourCutscene
                                scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                                execute store result score @s customBilly.DevourX run data get entity @s Pos[0] 1
                                execute store result score @s customBilly.DevourY run data get entity @s Pos[1] 1
                                execute store result score @s customBilly.DevourZ run data get entity @s Pos[2] 1
                                execute store result score @s customBilly.DevourRotationX run data get entity @s Rotation[0] 1

                                gamemode spectator @s
                            }

                            # as victim
                            execute as @n[type=!#custom:not_mob,nbt={HurtTime:10s}] run {
                                tag @s add customBilly.DevourVictim
                                tag @s add customBilly.DevourCutscene
                                scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                                execute store result score @s customBilly.DevourX run data get entity @s Pos[0] 1
                                execute store result score @s customBilly.DevourY run data get entity @s Pos[1] 1
                                execute store result score @s customBilly.DevourZ run data get entity @s Pos[2] 1
                                execute store result score @s customBilly.DevourRotationX run data get entity @s Rotation[0] 1

                                execute if entity @s[type=minecraft:player] run {
                                    gamemode spectator @s
                                } else run {
                                    data merge entity @s {NoAI:1b}
                                    tp @s ~ -70 ~
                                }
                            }

                            function custom:abilities/billy/secret_interactions/devour/pass
                        } else run {
                            execute as @n[type=!#custom:not_mob,nbt={HurtTime:10s}] run tag @s add customBilly.MaulVictim
                            block { with storage minecraft:custom billy
                                tag @s add customBilly.MaulAnimation
                                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                                    function animated_java:billy/animations/movement/stop
                                    function animated_java:billy/animations/idle/stop
                                    function animated_java:billy/animations/maul/play
                                    tag @s remove customBilly.Moving
                                    tag @s remove customBilly.Idle
                                }
                            }
                        }
                        scoreboard players reset @s customBilly.PassiveMaul
                    }
                }

                function damage {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    execute as @n[type=!#custom:not_mob,tag=customBilly.MaulVictim] at @s run block { with storage minecraft:custom billy
                        particle block{block_state:"minecraft:redstone_block"} ~ ~ ~ 0.5 0.5 0.5 1 30 force @a
                        $function custom:universal/damage/victim {id:"$(id)",damage:"8",type:"interactables:microphone",attacker:"tag=customAbility.Billy",objective:"customBilly.RigID",first:"was mauled to death by",second:"using Billy"}
                        tag @s remove customBilly.MaulVictim
                    }
                }
            }

            function enable {
                effect give @s minecraft:resistance infinite 255 true
            }

            function alert {
                playsound minecraft:gojo.passive.activate player @a ~ ~ ~ 1
                effect give @s minecraft:glowing 1 255 true
                effect clear @s minecraft:resistance
                scoreboard players set @s customGojo.InfinityPassive 1
            }
            
            #  if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 2 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 3.. run function custom:items/gojo/passive/damaged/reset

            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 4 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 5.. run function custom:items/gojo/passive/damaged/reset

            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 5 run function custom:items/gojo/passive/damaged/infinity
            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 6.. run function custom:items/gojo/passive/damaged/reset
        }

        dir movement {
            function main {
                execute if predicate custom:universal/forward run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/backward run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/left run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/right run function custom:abilities/billy/movement/moving with storage minecraft:custom billy

                execute unless predicate custom:universal/forward unless predicate custom:universal/backward unless predicate custom:universal/left unless predicate custom:universal/right run function custom:abilities/billy/movement/idle with storage minecraft:custom billy
            }

            function moving {
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                    execute unless entity @s[tag=customBilly.Moving] run {
                        function animated_java:billy/animations/idle/stop
                        function animated_java:billy/animations/maul/stop
                        function animated_java:billy/animations/movement/play
                    }
                    tag @s remove customBilly.Idle
                    tag @s add customBilly.Moving
                }
            }

            function idle {
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                    execute unless entity @s[tag=customBilly.Idle] run {
                        function animated_java:billy/animations/movement/stop
                        function animated_java:billy/animations/maul/stop
                        function animated_java:billy/animations/idle/play
                    }
                    tag @s remove customBilly.Moving
                    tag @s add customBilly.Idle
                }
            }
        }
    }

    dir toji {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/toji/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.Delay4=0,customUniversal.AwakeningDuration=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }
                
                execute if score @s customUniversal.Delay4 matches 1.. run {
                    scoreboard players remove @s customUniversal.Delay4 1
                    execute if score @s customUniversal.Delay4 matches 0 run {
                        tag @s remove customGojo.InfinityAmplification
                    }
                }

                execute if score @s customUniversal.AwakeningDuration matches 1.. run scoreboard players remove @s customUniversal.AwakeningDuration 1
                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        function active {
            execute if score @s customUniversal.Move1Trigger matches 1.. run {
                function custom:abilities/toji/key_bindings/move1
            }
            execute if score @s customUniversal.Move2Trigger matches 1.. run {
                function custom:abilities/toji/key_bindings/move2
            }
            execute if score @s customUniversal.Move3Trigger matches 1.. run {
                function custom:abilities/toji/key_bindings/move3
            }
            execute if score @s customUniversal.Move4Trigger matches 1.. run {
                function custom:abilities/toji/key_bindings/move4
            }

            function custom:abilities/toji/hotbar/main
        }

        dir key_bindings {
            REPEAT (1,4) as i {
                function move<%i%> {
                    function custom:abilities/toji/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                    scoreboard players reset @s customUniversal.Move4Trigger
                    scoreboard players enable @s customUniversal.Move4Trigger
                }
            }
        }

        dir obtainment {
            dir npc {
                function spawn {
                    execute rotated ~ 0 run function animated_java:toji/summon {args:{animation:'npc_idle', start_animation: true}}
                    function custom:universal/text {type:"toji_npc",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.text_location]",what:{"color":"red","text":"Toji Fushiguro"}}
                    function custom:universal/stable_player_display/state/model {branch:"toji"}

                    scoreboard players add .global customUniversal.QuestID 1
                    scoreboard players operation @n[type=minecraft:item_display,tag=aj.toji.root] customUniversal.QuestID = .global customUniversal.QuestID
                }

                function idle {
                    execute if entity @a[distance=..6] run {
                        function animated_java:toji/animations/npc_close/tween {to_frame: 1, duration: 4}
                    }

                    execute if entity @s[tag=customToji.NPC.CloseRotation] run {
                        execute store result storage minecraft:custom toji.obtainment.npc.id int 1 run scoreboard players get @s customUniversal.QuestID
                        block { with storage minecraft:custom toji.obtainment.npc
                            $kill @n[type=minecraft:marker,tag=customToji.NPC.RotationMarker,scores={customUniversal.QuestID=$(id)}]
                            $kill @n[type=minecraft:interaction,tag=customToji.NPC.Interaction,scores={customUniversal.QuestID=$(id)}]
                            tag @s remove customToji.NPC.CloseRotation
                        }
                    }
                }

                function close {
                    execute if entity @a[distance=6..] run {
                        function animated_java:toji/animations/npc_idle/tween {to_frame: 1, duration: 4}
                    }

                    execute store result storage minecraft:custom toji.obtainment.npc.id int 1 run scoreboard players get @s customUniversal.QuestID
                    block { with storage minecraft:custom toji.obtainment.npc
                        execute unless entity @s[tag=customToji.NPC.CloseRotation] run block { with storage minecraft:custom toji.obtainment.npc
                            summon marker ~ ~ ~ {NoGravity:1b,Tags:["customToji.NPC.RotationMarker"]}
                            summon interaction ~ ~ ~ {NoGravity:1b,width:1.25f,height:2.25f,Tags:["customToji.NPC.Interaction"]}
                            $execute as @n[type=minecraft:marker,tag=customToji.NPC.RotationMarker] run scoreboard players set @s customUniversal.QuestID $(id)
                            $execute as @n[type=minecraft:interaction,tag=customToji.NPC.Interaction] run scoreboard players set @s customUniversal.QuestID $(id)
                            tag @s add customToji.NPC.CloseRotation
                        }

                        $execute as @n[type=minecraft:marker,tag=customToji.NPC.RotationMarker,scores={customUniversal.QuestID=$(id)}] run {
                            tp @s ~ ~ ~ facing entity @p
                            execute store result storage minecraft:custom toji.obtainment.npc.rotation_x float 1 run data get entity @s Rotation[0]
                        }

                        $execute as @n[type=minecraft:interaction,tag=customToji.NPC.Interaction,scores={customUniversal.QuestID=$(id)}] run {
                            execute if data entity @s interaction run block { with storage minecraft:custom toji.obtainment.npc
                                execute on target run block { with storage minecraft:custom toji.obtainment.npc
                                    $scoreboard players set @s customUniversal.QuestID $(id)
                                    attribute @s minecraft:movement_speed base set 0
                                    attribute @s minecraft:jump_strength base set 0
                                }
                                $execute as @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.QuestID=$(id)}] run {
                                    function animated_java:toji/animations/npc_talking/tween {to_frame: 1, duration: 4}
                                }
                                data remove entity @s interaction
                            }
                        }

                        block { with storage minecraft:custom toji.obtainment.npc
                            $tp @s ~ ~ ~ $(rotation_x) ~
                        }
                    }
                }
                
                function talking {
                    execute store result storage minecraft:custom toji.obtainment.npc.id int 1 run scoreboard players get @s customUniversal.QuestID
                    block { with storage minecraft:custom toji.obtainment.npc
                        # Setup
                        execute if entity @s[tag=customToji.NPC.CloseRotation] run block { with storage minecraft:custom toji.obtainment.npc
                            $kill @n[type=minecraft:marker,tag=customToji.NPC.RotationMarker,scores={customUniversal.QuestID=$(id)}]
                            $kill @n[type=minecraft:interaction,tag=customToji.NPC.Interaction,scores={customUniversal.QuestID=$(id)}]
                            tag @s remove customToji.NPC.CloseRotation
                        }

                        # Player
                        $execute as @p[scores={customUniversal.QuestID=$(id)}] run {
                            scoreboard players add @s customUniversal.QuestDialogue 1
                            execute unless score @s customToji.QuestProgress matches 1.. run scoreboard players add @s customToji.QuestProgress 1
                            execute if score @s customToji.QuestProgress matches 2 if score @s customToji.ObtainmentMonsterKills matches 250.. run scoreboard players add @s customToji.QuestProgress 1
                            execute if score @s customToji.QuestProgress matches 1 run function custom:abilities/toji/obtainment/npc/dialogue/stage1
                            execute if score @s customToji.QuestProgress matches 2 run function custom:abilities/toji/obtainment/npc/dialogue/stage2
                            execute if score @s customToji.QuestProgress matches 3 run function custom:abilities/toji/obtainment/npc/dialogue/stage3
                        }
                    }
                }

                dir dialogue {
                    function stage1 {
                        execute if score @s customUniversal.QuestDialogue matches 1 run {
                            tellraw @s ["",{"text":"Toji Fushiguro","color":"gold"},{"text":"\n"},{"text":"So, you've come to ","color":"gray"},{"text":"learn ","color":"green"},{"text":"the way of the ","color":"gray"},{"text":"assassin?","color":"red"}]
                        }
                        execute if score @s customUniversal.QuestDialogue matches 3 run {
                            tellraw @s ["",{"text":"And you thought I'd just teach you for ","color":"gray"},{"text":"free...?","color":"yellow"}]
                        }
                        execute if score @s customUniversal.QuestDialogue matches 6 run {
                            tellraw @s ["",{"text":"HAH!","color":"red"},{"text":" Don't make me laugh. You're going to need to do some ","color":"gray"},{"text":"tasks ","color":"light_purple"},{"text":"for me first.","color":"gray"}]
                        }
                        execute if score @s customUniversal.QuestDialogue matches 10 run {
                            scoreboard players add @s customToji.QuestProgress 1
                            scoreboard players reset @s customUniversal.QuestDialogue
                        }
                    }

                    function stage2 {
                        execute if score @s customUniversal.QuestDialogue matches 1 run {
                            tellraw @s ["",{"text":"Toji Fushiguro","color":"gold"},{"text":"\n"},{"text":"Firstly, you're going to need to slay ","color":"gray"},{"text":"250 Monsters!","color":"red"}]
                        }
                        execute if score @s customUniversal.QuestDialogue matches 3 run {
                            tellraw @s ["",{"text":"Return ","color":"gray"},{"text":"after ","color":"light_purple"},{"text":"you've accomplished this.","color":"gray"}]
                        }

                        execute if score @s customUniversal.QuestDialogue matches 5 run block { with storage minecraft:custom toji.obtainment.npc
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                            scoreboard players reset @s customUniversal.QuestDialogue
                            scoreboard players reset @s customUniversal.QuestID
                            $execute as @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.QuestID=$(id)}] run function animated_java:toji/animations/npc_close/tween {to_frame: 1, duration: 4}
                        }
                    }

                    function stage3 {
                        execute if score @s customUniversal.QuestDialogue matches 1 run {
                            tellraw @s ["",{"text":"Toji Fushiguro","color":"gold"},{"text":"\n"},{"text":"Firstly, you're going to need taaaaaaaaaaaaaao slay ","color":"gray"},{"text":"250aaa Monsters!","color":"red"}]
                        }

                        execute if score @s customUniversal.QuestDialogue matches 5 run block { with storage minecraft:custom toji.obtainment.npc
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                            scoreboard players reset @s customUniversal.QuestDialogue
                            scoreboard players reset @s customUniversal.QuestID
                            $execute as @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.QuestID=$(id)}] run function animated_java:toji/animations/npc_close/tween {to_frame: 1, duration: 4}
                        }
                    }
                }
            }
        }
        
        dir hotbar {
            function main {
                REPEAT (1,4) as i {
                    function custom:abilities/toji/hotbar/progress with storage minecraft:custom toji.cooldowns.move<%i%>
                }
                
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"toji",selected:<%i%>}
                    }
                }

                block {
                    execute store result storage minecraft:custom toji.hotbar.bloodlust_string int 1 run scoreboard players get @s customToji.PassiveBloodlust
                    block { with storage minecraft:custom toji.hotbar
                        $execute if score @s customToji.PassiveBloodlust matches 10..99 run data merge storage minecraft:custom {toji:{hotbar:{bloodlust:"$(bloodlust_string)"}}}
                        $execute if score @s customToji.PassiveBloodlust matches 0..9 run data merge storage minecraft:custom {toji:{hotbar:{bloodlust:"0$(bloodlust_string)"}}}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 4 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        dir toggle {
            function on {
                playsound minecraft:gojo.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:gojo.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                effect give @s minecraft:invisibility infinite 0 true
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                function custom:universal/armor/hide
                $execute rotated ~ 0 run function animated_java:toji/summon {args:{animation:'$(animation)', start_animation: true}}
                $function custom:universal/setup/rig {objective:"$(objective)",item:"toji"}

                execute unless entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/model {branch:"toji"}
                execute if entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/skin {branch:"toji"}
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.camera",objective:"$(objective)"}

                scoreboard players add .global customUniversal.GlobalCounter 1
                scoreboard players operation @s customUniversal.GlobalCounter = .global customUniversal.GlobalCounter
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.root",objective:"customUniversal.GlobalCounter"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    execute if entity @s[tag=customToji.AcrobaticsRecastable] run {
                        tag @s remove customUniversal.Error1
                        tag @s remove customUniversal.Error2
                        scoreboard players set @s customUniversal.FailReturn 0
                    }
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/1/raycast/start

                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Acrobatics"}
                }

                dir raycast {
                    function start {
                        tag @s add customToji.AcrobaticsRaycast
                        function custom:universal/error_messages/find {error:"11"}
                        execute anchored eyes positioned ^ ^ ^ run function custom:abilities/toji/moves/1/raycast/fire
                        scoreboard players reset .distance beam
                        tag @s remove customToji.AcrobaticsRaycast
                    }

                    function fire {
                        execute unless block ^ ^ ^.1 #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/found
                        scoreboard players add .distance beam 1
                        execute if score .distance beam matches ..300 positioned ^ ^ ^.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/fire
                    }

                    function found {
                        block {
                            execute unless block ~ ~0.1 ~ #custom:raycast_pass run scoreboard players set @s customToji.AcrobaticsAnimation 1
                            execute positioned ~ ~ ~0.1 unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~0.1 ~ ~ unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~ ~ ~-0.1 unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~-0.1 ~ ~ unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute unless block ~ ~-0.1 ~ #custom:raycast_pass run scoreboard players set @s customToji.AcrobaticsAnimation 3
                        }
                        summon marker ~ ~ ~ {NoGravity:1b,Tags:["customToji.AcrobaticsMarker"]}
                        execute store result score @s customToji.AcrobaticsRotationX run data get entity @s Rotation[0]
                        execute store result score @s customToji.AcrobaticsX run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[0]
                        execute store result score @s customToji.AcrobaticsY run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[1]
                        execute store result score @s customToji.AcrobaticsZ run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[2]
                        kill @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker]

                        scoreboard players set @s customUniversal.FailReturn 0
                        scoreboard players set .distance beam 300
                        tag @s remove customUniversal.Error11
                        tag @s remove customToji.AcrobaticsAnchor
                    }

                    function wall_or_mantle {
                        execute unless block ~ ~ ~ #custom:raycast_pass unless block ~ ~1 ~ #custom:raycast_pass run {
                            scoreboard players set @s customToji.AcrobaticsAnimation 2
                        } else run {
                            scoreboard players set @s customToji.AcrobaticsAnimation 4
                        }
                    }
                }

                function pass {
                    execute unless entity @s[tag=customToji.AcrobaticsRecastable] run {
                        function custom:abilities/toji/moves/setup {animation:'acrobatics_start',objective:"customUniversal.RigID"}
                        execute as @n[tag=aj.toji.locator.acrobatics_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                        scoreboard players set @s customUniversal.MoveLastUsed 1
                        execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .TojiCooldown customUniversal.Move1Cooldown
                        scoreboard players set @s customUniversal.MoveDelay 10

                        playsound minecraft:toji.acrobatics.voiceline player @a ~ ~ ~ 0.5
                        attribute @s minecraft:movement_speed base set 0
                        attribute @s minecraft:jump_strength base set 0
                    } else run {
                        scoreboard players remove @s customToji.PassiveBloodlust 2

                        execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                        block { with storage minecraft:custom toji.acrobatics
                            $execute as @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] run {
                                function custom:abilities/toji/moves/1/reposition
                            }
                        }

                        tag @s remove customToji.AcrobaticsRecastable
                    }
                }

                function reposition {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run {
                            execute store result storage minecraft:custom toji.acrobatics.animation int 1 run scoreboard players get @s customToji.AcrobaticsAnimation
                            execute store result storage minecraft:custom toji.acrobatics.x int 1 run scoreboard players get @s customToji.AcrobaticsX
                            execute store result storage minecraft:custom toji.acrobatics.y int 1 run scoreboard players get @s customToji.AcrobaticsY
                            execute store result storage minecraft:custom toji.acrobatics.z int 1 run scoreboard players get @s customToji.AcrobaticsZ
                            execute store result storage minecraft:custom toji.acrobatics.rot_x int 1 run scoreboard players get @s customToji.AcrobaticsRotationX
                        }

                        block { with storage minecraft:custom toji.acrobatics
                            $scoreboard players set @s customToji.AcrobaticsAnimation $(animation)
                            function animated_java:toji/animations/acrobatics_start/stop
                            function animated_java:toji/animations/acrobatics_wall/stop
                            function animated_java:toji/animations/acrobatics_ceiling/stop 
                            function animated_java:toji/animations/acrobatics_ground/stop
                            function animated_java:toji/animations/acrobatics_mantle/stop
                            $execute as @a unless score @s customUniversal.RigID matches $(id) run playsound minecraft:toji.acrobatics.relocate player @s ~ ~ ~ 0.25
                            $tp @s $(x) $(y) $(z) $(rot_x) 0

                            execute if score @s customToji.AcrobaticsAnimation matches 1 run function animated_java:toji/animations/acrobatics_ceiling/play
                            execute if score @s customToji.AcrobaticsAnimation matches 2 run function animated_java:toji/animations/acrobatics_wall/play
                            execute if score @s customToji.AcrobaticsAnimation matches 3 run function animated_java:toji/animations/acrobatics_ground/play
                            execute if score @s customToji.AcrobaticsAnimation matches 4 run function animated_java:toji/animations/acrobatics_mantle/play
                        }
                    }
                }

                function mount {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.acrobatics
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.acrobatics_mount,scores={customUniversal.RigID=$(id)}]
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                        }
                    }
                }

                function wall {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @n[type=minecraft:item_display,tag=aj.toji.locator.acrobatics_mount,scores={customUniversal.RigID=$(id)}] rotated as @s run rotate @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] ~-15 0
                    }
                }

                function determine {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] if score @s customToji.PassiveBloodlust matches 2.. run {
                            tag @s add customToji.AcrobaticsRecastable
                        }
                    }
                }
            }

            dir 4 {
                function core {
                    execute unless score @s customUniversal.Move4Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 4
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/4/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:4,unicode:"u50A0",move:"Spring"}
                }

                function pass {
                    function custom:abilities/toji/moves/setup {animation:'spring_windup',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 4
                    execute as @n[tag=aj.toji.locator.coil_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID

                    function custom:abilities/toji/moves/4/danger_zone
                    execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,tag=!found] run {
                        scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                        tag @s add found
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move4Cooldown = .TojiCooldown customUniversal.Move4Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                function danger_zone {
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"toji",animation:'danger_zone',extra:"random value 1..2"}
                }

                dir raycast {
                    function start {
                        tag @s add customToji.SpringRaycast
                        execute anchored eyes positioned ^ ^ ^ run function custom:abilities/toji/moves/4/raycast/fire
                        scoreboard players reset .distance beam
                        tag @s remove customToji.SpringRaycast
                    }

                    function fire {
                        execute unless block ^ ^ ^.1 #custom:raycast_pass unless block ~ ~-1 ~ #custom:raycast_pass run function custom:abilities/toji/moves/4/raycast/found
                        scoreboard players add .distance beam 1
                        execute if score .distance beam matches ..300 positioned ^ ^ ^.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/4/raycast/fire
                    }

                    function found {
                        execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                        block { with storage minecraft:custom toji.spring
                            execute store result score @s customToji.SpringRotationX run data get entity @s Rotation[0] 10
                            execute store result storage minecraft:custom toji.spring.rotation float 0.1 run scoreboard players get @s customToji.SpringRotationX
                            $execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] align xz positioned ~0.5 ~ ~0.5 run block { with storage minecraft:custom toji.spring
                                $tp @s ~ ~ ~ $(rotation) 0
                            }
                            $execute store result score @s customToji.SpringX run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[0] 1000
                            $execute store result score @s customToji.SpringY run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[1] 1000
                            $execute store result score @s customToji.SpringZ run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[2] 1000
                        }

                        scoreboard players set .distance beam 300
                        tag @s remove customToji.SpringAnchor
                    }
                }

                function coil_start {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.spring
                        # Locate Endpoint
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.spring
                            scoreboard players operation dx customToji.SpringMath = @s customToji.SpringX
                            $execute store result score t customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[0] 1000
                            scoreboard players operation dx customToji.SpringMath -= t customToji.SpringMath
                            scoreboard players operation dz customToji.SpringMath = @s customToji.SpringZ
                            $execute store result score t customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[2] 1000
                            scoreboard players operation dz customToji.SpringMath -= t customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath = dx customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath *= dx customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath = dz customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath *= dz customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath += t customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = dx customToji.SpringMath
                            $execute store result score ax customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[0] 0
                            execute if score g customToji.SpringMath matches ..-1 run scoreboard players operation g customToji.SpringMath *= -1 customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath = dz customToji.SpringMath
                            execute if score t customToji.SpringMath matches ..-1 run scoreboard players operation t customToji.SpringMath *= -1 customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath += t customToji.SpringMath
                            scoreboard players set two customToji.SpringMath 2
                            execute if score g customToji.SpringMath matches 0 run scoreboard players set g customToji.SpringMath 1
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation dist1000 customToji.SpringMath = g customToji.SpringMath
                            scoreboard players operation @s customToji.Spring2DIncrements = dist1000 customToji.SpringMath
                            scoreboard players operation @s customToji.Spring2DIncrements /= div15 customToji.SpringMath

                            $execute store result score posY1000 customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[1] 1000
                            scoreboard players operation tgtY1000 customToji.SpringMath = @s customToji.SpringY
                            scoreboard players operation dy1000 customToji.SpringMath = tgtY1000 customToji.SpringMath
                            scoreboard players operation dy1000 customToji.SpringMath -= posY1000 customToji.SpringMath

                            scoreboard players operation @s customToji.SpringYIncrements = dy1000 customToji.SpringMath
                            scoreboard players operation @s customToji.SpringYIncrements /= div15 customToji.SpringMath

                            execute store result storage minecraft:custom toji.spring.total_distance double 0.001 run scoreboard players get dist1000 customToji.SpringMath
                            execute store result storage minecraft:custom toji.spring.rotation float 0.1 run scoreboard players get @s customToji.SpringRotationX
                            execute store result storage minecraft:custom toji.spring.2Dincrements double 0.001 run scoreboard players get @s customToji.Spring2DIncrements
                            execute store result storage minecraft:custom toji.spring.Yincrements double 0.001 run scoreboard players get @s customToji.SpringYIncrements
                            block { with storage minecraft:custom toji.spring
                                $tellraw @a[tag=customSettings.DebugLog] "spring debug log\ndistance: $(total_distance)m\nrotation: $(rotation)f\n2Dincrements: $(2Dincrements)m\nYincrements: $(Yincrements)m"
                            }
                        }

                        block { with storage minecraft:custom toji.spring
                            $rotate @s $(rotation) 0
                        }
                    }

                    function animated_java:toji/animations/spring_windup/stop
                    function animated_java:toji/animations/spring_coil/play
                }

                function coil_movement {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.spring
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run {
                            execute store result storage minecraft:custom toji.spring.2Dincrements double 0.001 run scoreboard players get @s customToji.Spring2DIncrements
                            execute store result storage minecraft:custom toji.spring.Yincrements double 0.001 run scoreboard players get @s customToji.SpringYIncrements
                        }
                        block { with storage minecraft:custom toji.spring
                            $tp @s ^ ^$(Yincrements) ^$(2Dincrements)
                        }

                        execute if predicate custom:universal/0.35 run playsound minecraft:toji.spring.rapid_spin player @a ~ ~ ~ 0.5
                    }
                    function animated_java:toji/as_locator {name:'coil_mount',command:'particle minecraft:cloud ~ ~ ~ 0.1 0.1 0.1 0.1 2 force @a'}
                }

                function mount {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    $data merge storage minecraft:custom {toji:{spring:{movement:$(movement)}}}

                    block { with storage minecraft:custom toji.spring
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.spring
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.coil_mount,scores={customUniversal.RigID=$(id)}]
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                        }
                        $execute positioned ^ ^ ^$(movement) if block ^ ^ ^ #custom:raycast_pass run tp @s ^ ^ ^ $(rotation) 0
                        # $tp @s ^ ^ ^$(movement) $(rotation) 0
                    }
                }

                function land {
                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ^ ^0.5 ^ 1.5 0 1.5 1 100 normal
                    }
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Toji,scores={$(objective)=$(id)}] at @s run function custom:abilities/toji/moves/reset/player
                        $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customToji.AcrobaticsRecastable
                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }

        dir passive {
            function main {
                scoreboard players add @s customGojo.InfinityPassive 1

                execute unless entity @s[tag=customGojo.Awakening] run {
                    execute if score @s customGojo.InfinityPassive matches 6 run function custom:abilities/gojo/passive/enable
                    execute if score @s customGojo.InfinityPassive matches 7.. run function custom:abilities/gojo/passive/alert
                } else run {
                    execute if entity @s[tag=customGojo.InfinityAmplification] run {
                        execute if score @s customGojo.InfinityPassive matches 3 run function custom:abilities/gojo/passive/enable
                        execute if score @s customGojo.InfinityPassive matches 4.. run function custom:abilities/gojo/passive/alert
                    } else run {
                        execute if score @s customGojo.InfinityPassive matches 5 run function custom:abilities/gojo/passive/enable
                        execute if score @s customGojo.InfinityPassive matches 6.. run function custom:abilities/gojo/passive/alert
                    }
                }
            }

            function enable {
                effect give @s minecraft:resistance infinite 255 true
            }

            function alert {
                playsound minecraft:gojo.passive.activate player @a ~ ~ ~ 1
                effect give @s minecraft:glowing 1 255 true
                effect clear @s minecraft:resistance
                scoreboard players set @s customGojo.InfinityPassive 1
            }
            
            #  if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 2 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] if entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 3.. run function custom:items/gojo/passive/damaged/reset

            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 4 run function custom:items/gojo/passive/damaged/infinity
            # execute if entity @s[tag=Honored] unless entity @s[tag=customGojo_AmplifiedInfinity] if score @s customGojo.InfinityPassive matches 5.. run function custom:items/gojo/passive/damaged/reset

            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 5 run function custom:items/gojo/passive/damaged/infinity
            # execute unless entity @s[tag=Honored] if score @s customGojo.InfinityPassive matches 6.. run function custom:items/gojo/passive/damaged/reset
        }
    }

    dir yuji {
      function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/yuji/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.Delay4=0,customUniversal.AwakeningDuration=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                REPEAT (1,6) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }

                execute if score @s customUniversal.AwakeningDuration matches 1.. run scoreboard players remove @s customUniversal.AwakeningDuration 1
                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        function active {
            execute if score @s customUniversal.Move1Trigger matches 1.. run {
                execute unless entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move1
                execute if entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move4
            }
            execute if score @s customUniversal.Move2Trigger matches 1.. run {
                execute unless entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move2
                execute if entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move5
            }
            execute if score @s customUniversal.Move3Trigger matches 1.. run {
                execute unless entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move3
                execute if entity @s[tag=customYuji.Awakening] run function custom:abilities/yuji/key_bindings/move6
            }

            function custom:abilities/yuji/hotbar/main
        }

        dir admin {
            function force_awakening {
                function custom:abilities/yuji/awakening/achieve
            }
        }

        dir key_bindings {
            REPEAT (1,6) as i {
                function move<%i%> {
                    function custom:abilities/yuji/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                }
            }
        }

        dir awakening {
            function achieve {
                gamemode spectator @s
                function custom:abilities/yuji/moves/setup {animation:'king_of_curses',objective:"customUniversal.RigID"}
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.yuji.camera.camera",objective:"customUniversal.RigID"}
            }

            function setup {
                gamemode survival @s
                $tp @s @n[type=minecraft:item_display,tag=aj.yuji.root,scores={customUniversal.RigID=$(id)}]
                $execute as @n[type=minecraft:item_display,tag=aj.yuji.root,scores={customUniversal.RigID=$(id)}] at @s rotated ~ 0 run function custom:abilities/yuji/awakening/jump_vfx
                scoreboard players set @s customUniversal.AwakeningDuration 4800
                tag @s add customYuji.Awakening
            }

            function duration {
                $scoreboard players set .YujiCooldown customUniversal.AwakeningDuration $(duration)
                scoreboard players operation .YujiCooldown customUniversal.AwakeningDuration *= x20 customUniversal.AwakeningDuration
                scoreboard players operation .YujiCooldownDivided customUniversal.AwakeningDuration = .YujiCooldown customUniversal.AwakeningDuration
                scoreboard players operation .YujiCooldownThresholds customUniversal.AwakeningDuration = .YujiCooldown customUniversal.AwakeningDuration
                scoreboard players operation .YujiCooldownDivided customUniversal.AwakeningDuration = .YujiCooldown customUniversal.AwakeningDuration
                scoreboard players operation .YujiCooldownDivided customUniversal.AwakeningDuration /= div16 customUniversal.AwakeningDuration

                execute store result storage minecraft:custom yuji.awakening.16 int 1 run scoreboard players get .YujiCooldownThresholds customUniversal.AwakeningDuration

                REPEAT (15,1) as i {
                    scoreboard players operation .YujiCooldownThresholds customUniversal.AwakeningDuration -= .YujiCooldownDivided customUniversal.AwakeningDuration
                    execute store result storage minecraft:custom yuji.awakening.<%i%>a int 1 run scoreboard players get .YujiCooldownThresholds customUniversal.AwakeningDuration
                    scoreboard players remove .YujiCooldownThresholds customUniversal.AwakeningDuration 1
                    execute store result storage minecraft:custom yuji.awakening.<%i%>b int 1 run scoreboard players get .YujiCooldownThresholds customUniversal.AwakeningDuration
                }

                scoreboard players operation .YujiCooldownThresholds customUniversal.AwakeningDuration -= .YujiCooldownDivided customUniversal.AwakeningDuration
                execute store result storage minecraft:custom yuji.awakening.1 int 1 run scoreboard players get .YujiCooldownThresholds customUniversal.AwakeningDuration
            }
        }
        
        dir hotbar {
            function main {
                execute unless entity @s[tag=customYuji.Awakening] run {
                    block { with storage minecraft:custom yuji.cooldowns.move1
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D1"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D2"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D3"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D4"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D5"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D6"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D7"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D8"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02D9"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E0"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E1"

                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                    }
                    block { with storage minecraft:custom yuji.cooldowns.move2
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E2"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E3"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E4"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E5"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E6"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E7"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E8"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02E9"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F0"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F1"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F2"

                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                    }
                    block { with storage minecraft:custom yuji.cooldowns.move3
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F3"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F4"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F5"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F6"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F7"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F8"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u02F9"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u0200"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u0201"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u0202"
                        $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom yuji.hotbar.move$(selection) set value "u0203"

                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                    }
                } else run {
                    REPEAT (4,6) as i {
                        function custom:abilities/yuji/hotbar/base_progress with storage minecraft:custom yuji.cooldowns.move<%i%>
                    }
                }
                
                function custom:abilities/yuji/hotbar/meter with storage minecraft:custom yuji.awakening
                
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"yuji",selected:<%i%>}
                    }
                }

                execute unless entity @s[tag=customYuji.Awakening] run {
                    execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF802\uF807\u02A0","color":"#4e5c24"},{"text":"\uF817\u02A2\uF818\uF816","color":"#4e5c24"},{"text":"\uF800\$(move1)","color":"#4e5c24"},{"text":"\uF800\$(move2)","color":"#4e5c24"},{"text":"\uF800\$(move3)","color":"#4e5c24"},{"text":"\uF827\$(awakening)","color":"#4e5c24"},{"text":"\uF806\u02A1","color":"#4e5c24"},{"text":"\uF806\u02A3"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)\uF801\u01B5"},{"text":"\uF800\$(move3)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A0"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)\uF801\u01B5"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }
                } else run {
                    execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)\uF801\u01B5"},{"text":"\uF800\$(move5)"},{"text":"\uF800\$(move6)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)"},{"text":"\uF800\$(move5)\uF801\u01B5"},{"text":"\uF800\$(move6)"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }

                    execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom yuji.hotbar
                        $title @s actionbar [{"text":"\uF813\u01A2"},{"text":"\uF820\$(move4)"},{"text":"\uF800\$(move5)"},{"text":"\uF800\$(move6)\uF801\u01B5"},{"text":"\uF805\$(awakening)"},{"text":"\uF818\u01A2"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                    }
                }
            }

            function meter {
                $execute if score @s customUniversal.AwakeningDuration matches $(15a)..$(16) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B9"
                $execute if score @s customUniversal.AwakeningDuration matches $(14a)..$(15b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B8"
                $execute if score @s customUniversal.AwakeningDuration matches $(13a)..$(14b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B7"
                $execute if score @s customUniversal.AwakeningDuration matches $(12a)..$(13b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B6"
                $execute if score @s customUniversal.AwakeningDuration matches $(11a)..$(12b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B5"
                $execute if score @s customUniversal.AwakeningDuration matches $(10a)..$(11b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B4"
                $execute if score @s customUniversal.AwakeningDuration matches $(9a)..$(10b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B3"
                $execute if score @s customUniversal.AwakeningDuration matches $(8a)..$(9b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B2"
                $execute if score @s customUniversal.AwakeningDuration matches $(7a)..$(8b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B1"
                $execute if score @s customUniversal.AwakeningDuration matches $(6a)..$(7b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02B0"
                $execute if score @s customUniversal.AwakeningDuration matches $(5a)..$(6b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A9"
                $execute if score @s customUniversal.AwakeningDuration matches $(4a)..$(5b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A8"
                $execute if score @s customUniversal.AwakeningDuration matches $(3a)..$(4b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A7"
                $execute if score @s customUniversal.AwakeningDuration matches $(2a)..$(3b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A6"
                $execute if score @s customUniversal.AwakeningDuration matches $(1)..$(2b) run data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A5"
                execute unless score @s customUniversal.AwakeningDuration matches 1.. run {
                    data modify storage minecraft:custom yuji.hotbar.awakening set value "u02A4"
                    tag @s remove customGojo.Awakening
                }
            }
        }

        dir toggle {
            function on {
                playsound minecraft:yuji.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:yuji.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                effect give @s minecraft:invisibility infinite 0 true
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                function custom:universal/armor/hide
                $execute rotated ~ 0 run function animated_java:yuji/summon {args:{animation:'$(animation)', start_animation: true}}
                $function custom:universal/setup/rig {objective:"$(objective)",item:"yuji"}
                # item modify entity @s hotbar.8 custom:hide

                execute unless entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/model {branch:"yuji"}
                execute if entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/skin {branch:"yuji"}

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.yuji.camera",objective:"$(objective)"}

                scoreboard players add .global customUniversal.GlobalCounter 1
                scoreboard players operation @s customUniversal.GlobalCounter = .global customUniversal.GlobalCounter
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.yuji.root",objective:"customUniversal.GlobalCounter"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/yuji/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Natural Talent"}
                }

                function pass {
                    function custom:abilities/yuji/moves/setup {animation:'natural_talent',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .YujiCooldown customUniversal.Move1Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }
            }

            dir 6 {
                function core {
                    execute unless score @s customUniversal.Move6Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/yuji/moves/6/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:6,unicode:"u50A0",move:"Domain Expansion: Malevolent Shrine"}
                }

                function pass {
                    function custom:abilities/yuji/moves/setup {animation:'domain_expansion',objective:"customYuji.DomainID"}
                    tag @s add customYuji.DomainWielder
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move6Cooldown = .YujiCooldown customUniversal.Move6Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                dir domain {
                    function appear {
                        execute store result storage minecraft:custom yuji.id int 1 run scoreboard players get @s customYuji.DomainID
                        execute rotated 0 0 align xyz positioned ~0.5 ~0.5 ~0.5 run function animated_java:yuji_domain/summon {args:{animation:'domain_outside', start_animation: true}}
                        execute as @n[type=minecraft:item_display,tag=aj.yuji_domain.root,tag=!spawned] run block { with storage minecraft:custom yuji
                            $scoreboard players set @s customYuji.DomainID $(id)
                            tag @s add spawned
                        }
                        function custom:abilities/yuji/moves/reset/all {user:"customAbility.Yuji",objective:"customYuji.DomainID",rig:"yuji"}
                    }

                    function entrap {
                        execute store result storage minecraft:custom yuji.domain.id int 1 run scoreboard players get @s customYuji.DomainID

                        execute if dimension minecraft:overworld run {
                            scoreboard players set @s customYuji.DomainDimension 1
                            data merge storage minecraft:custom {yuji:{domain:{scalar:1}}}
                        }
                        execute if dimension minecraft:the_end run {
                            scoreboard players set @s customYuji.DomainDimension 2
                            data merge storage minecraft:custom {yuji:{domain:{scalar:1}}}
                        }
                        execute if dimension minecraft:the_nether run {
                            scoreboard players set @s customYuji.DomainDimension 3
                            data merge storage minecraft:custom {yuji:{domain:{scalar:8}}}
                        }

                        # top of circle is y=183
                        # clone size is (36x36x36)
                        forceload add ~-1 ~-1 ~1 ~1
                        execute in server:god run forceload add ~-2 ~-2 ~2 ~2
                        tag @s add customYuji.DomainSphere
                        function custom:abilities/yuji/moves/6/domain/origin_calculation with storage minecraft:custom yuji.domain
                        block { with storage minecraft:custom yuji.domain
                            $clone ~-16 ~-16 ~-16 ~16 ~16 ~16 to server:god $(targetX_minimum) 150 $(targetZ_minimum)
                            $execute in server:god positioned $(targetX_origin) 166 $(targetZ_origin) run {
                                place template custom:domain_carveout ~-16 ~-16 ~-16
                                fill ~-34 199 ~-34 ~34 233 ~34 minecraft:black_concrete hollow
                                fill ~-33 200 ~-33 ~33 232 ~33 minecraft:barrier hollow
                            }

                            execute as @e[type=!#custom:not_mob,distance=..16] at @s run block { with storage minecraft:custom yuji.domain
                                $execute store result score @s customYuji.DomainX run data get entity @s Pos[0] $(scalar)00
                                execute store result score @s customYuji.DomainY run data get entity @s Pos[1] 100
                                $execute store result score @s customYuji.DomainZ run data get entity @s Pos[2] $(scalar)00
                                execute store result storage minecraft:custom yuji.domain.entityX double 0.01 run scoreboard players get @s customYuji.DomainX
                                execute store result storage minecraft:custom yuji.domain.entityZ double 0.01 run scoreboard players get @s customYuji.DomainZ
                                block { with storage minecraft:custom yuji.domain
                                    # $execute in server:god run tp @s $(entityX) 201 $(entityZ)
                                    $scoreboard players set @s customYuji.DomainID $(id)
                                    gamemode spectator @s
                                    tag @s add customYuji.Domain
                                    tag @s add customYuji.DomainVictim
                                }
                            }

                            function animated_java:yuji_domain/summon {args:{animation:'shrine_spawn', start_animation: true}}
                            execute as @n[type=minecraft:item_display,tag=aj.yuji_domain.camera,tag=!customYuji.ShrineCameraID] run block { with storage minecraft:custom yuji.domain
                                $scoreboard players set @s customYuji.DomainID $(id)
                                tag @s add customYuji.ShrineCameraID
                            }
                            execute as @n[type=minecraft:item_display,tag=aj.yuji_domain.root,tag=!customYuji.DomainSphere,tag=!customYuji.ShrineIDAssigned] run block { with storage minecraft:custom yuji.domain
                                $scoreboard players set @s customYuji.DomainID $(id)
                                tag @s add customYuji.ShrineIDAssigned

                                $execute in server:god run tp @s $(targetX_origin) 200 $(targetZ_origin)
                            }
                        }

                        place template custom:domain_barrier ~-16 ~-16 ~-16
                        kill @e[type=minecraft:item,distance=..16,nbt={Age:0s,Item:{}}]
                    }

                    function end {
                        execute if score @s customYuji.DomainDimension matches 1 run data merge storage minecraft:custom {yuji:{domain:{dimension:"minecraft:overworld"}}}
                        execute if score @s customYuji.DomainDimension matches 2 run data merge storage minecraft:custom {yuji:{domain:{dimension:"minecraft:the_end"}}}
                        execute if score @s customYuji.DomainDimension matches 3 run data merge storage minecraft:custom {yuji:{domain:{dimension:"minecraft:the_nether"}}}

                        fill ~-16 ~-16 ~-16 ~16 ~16 ~16 minecraft:air replace minecraft:barrier
                        execute if score @s customYuji.DomainDimension matches 1..2 run function custom:abilities/yuji/moves/6/domain/origin_calculation {scale:1}
                        execute if score @s customYuji.DomainDimension matches 3 run function custom:abilities/yuji/moves/6/domain/origin_calculation {scale:8}
                        execute in server:god run {
                            block { with storage minecraft:custom yuji.domain
                                $clone $(targetX_minimum) 150 $(targetZ_minimum) $(targetX_maximum) 183 $(targetZ_maximum) to $(dimension) $(x) $(y) $(z) masked
                                $fill $(targetX_minimum) 150 $(targetZ_minimum) $(targetX_maximum) 183 $(targetZ_maximum) minecraft:air
                            }
                            forceload remove ~-2 ~-2 ~2 ~2
                        }
                        function animated_java:yuji_domain/remove/this
                        forceload remove ~-1 ~-1 ~1 ~1
                    }

                    function origin_calculation {
                        execute store result score .locationX customYuji.DomainDimension run data get entity @s Pos[0]
                        scoreboard players remove .locationX customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.x int 1 run scoreboard players get .locationX customYuji.DomainDimension

                        execute store result score .locationY customYuji.DomainDimension run data get entity @s Pos[1]
                        scoreboard players remove .locationY customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.y int 1 run scoreboard players get .locationY customYuji.DomainDimension

                        execute store result score .locationZ customYuji.DomainDimension run data get entity @s Pos[2]
                        scoreboard players remove .locationZ customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.z int 1 run scoreboard players get .locationZ customYuji.DomainDimension

                        $execute store result score .originX customYuji.DomainDimension run data get entity @s Pos[0] $(scalar)
                        execute store result storage minecraft:custom yuji.domain.targetX_origin int 1 run scoreboard players get .originX customYuji.DomainDimension

                        $execute store result score .originZ customYuji.DomainDimension run data get entity @s Pos[2] $(scalar)
                        execute store result storage minecraft:custom yuji.domain.targetZ_origin int 1 run scoreboard players get .originZ customYuji.DomainDimension

                        scoreboard players operation .minimumX customYuji.DomainDimension = .originX customYuji.DomainDimension
                        scoreboard players remove .minimumX customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.targetX_minimum int 1 run scoreboard players get .minimumX customYuji.DomainDimension

                        scoreboard players operation .maximumX customYuji.DomainDimension = .originX customYuji.DomainDimension
                        scoreboard players add .maximumX customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.targetX_maximum int 1 run scoreboard players get .maximumX customYuji.DomainDimension

                        scoreboard players operation .minimumZ customYuji.DomainDimension = .originZ customYuji.DomainDimension
                        scoreboard players remove .minimumZ customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.targetZ_minimum int 1 run scoreboard players get .minimumZ customYuji.DomainDimension

                        scoreboard players operation .maximumZ customYuji.DomainDimension = .originZ customYuji.DomainDimension
                        scoreboard players add .maximumZ customYuji.DomainDimension 16
                        execute store result storage minecraft:custom yuji.domain.targetZ_maximum int 1 run scoreboard players get .maximumZ customYuji.DomainDimension
                    }
                }

                dir shrine {
                    function end {
                        execute store result storage minecraft:custom yuji.domain.id int 1 run scoreboard players get @s customYuji.DomainID
                        block { with storage minecraft:custom yuji.domain
                            fill ~-34 199 ~-34 ~34 233 ~34 minecraft:air
                            $execute as @n[type=minecraft:item_display,tag=aj.yuji_domain.root,tag=customYuji.DomainSphere,scores={customYuji.DomainID=$(id)}] at @s run {
                                function custom:abilities/yuji/moves/6/domain/end
                            }

                            $execute as @e[type=!#custom:not_mob,tag=customYuji.DomainVictim,scores={customYuji.DomainID=$(id)}] run {
                                execute store result storage minecraft:custom yuji.domain.entityX double 0.01 run scoreboard players get @s customYuji.DomainX
                                execute store result storage minecraft:custom yuji.domain.entityY double 0.01 run scoreboard players get @s customYuji.DomainY
                                execute store result storage minecraft:custom yuji.domain.entityZ double 0.01 run scoreboard players get @s customYuji.DomainZ
                                block { with storage minecraft:custom yuji.domain
                                    $execute in $(dimension) run tp @s $(entityX) $(entityY) $(entityZ)
                                    scoreboard players reset @s customYuji.DomainID
                                    tag @s remove customYuji.DomainVictim
                                }
                            }
                            function animated_java:yuji_domain/remove/this
                        }
                    }

                    function slash_vfx {
                        data merge storage minecraft:custom {universal:{vfx:{offsetXL:40,offsetXR:40,offsetYL:20,offsetYR:20,offsetZL:40,offsetZR:40}}}
                        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                        execute positioned ~ ~20 ~ run function custom:universal/vfx/spawn {mode:4,speed:0,count:5,duration:0,branch:"yuji",animation:'malevolent_slash',extra:"random value 1..2"}
                    }

                    # function proximity_launch {
                    #     execute as @e[type=!#custom:not_mob,tag=customYuji.DomainVictim,distance=..4] at @s rotated ~180 -30 run {
                    #         launch @s looking 1
                    #     }
                    # }
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Yuji,scores={$(objective)=$(id)}] at @s run function custom:abilities/yuji/moves/reset/player
                        $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }
    }

    dir avatar {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/avatar/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.Delay4=0,customUniversal.AwakeningDuration=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }
                
                execute at @s if score @s customUniversal.Delay1 matches 1.. run {
                    particle minecraft:cloud ~ ~ ~ 0.5 0.5 0.5 0 2 force @a
                    scoreboard players remove @s customUniversal.Delay1 1
                }

                execute if score @s customUniversal.AwakeningDuration matches 1.. run scoreboard players remove @s customUniversal.AwakeningDuration 1
                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        function active {
            execute if score @s customUniversal.Move1Trigger matches 1.. run {
                function custom:abilities/avatar/key_bindings/move1
            }
            execute if score @s customUniversal.Move2Trigger matches 1.. run {
                function custom:abilities/avatar/key_bindings/move2
            }
            execute if score @s customUniversal.Move3Trigger matches 1.. run {
                function custom:abilities/avatar/key_bindings/move3
            }
            execute if score @s customUniversal.Move4Trigger matches 1.. run {
                function custom:abilities/avatar/key_bindings/move4
            }

            function custom:abilities/avatar/hotbar/main

            function custom:abilities/avatar/passive/main
        }

        dir passive {
            function main {
                execute unless score @s customUniversal.PreviousHotbar = @s customUniversal.ActiveHotbar run function custom:abilities/avatar/passive/changed

                execute if score @s customUniversal.ActiveHotbar matches 1 run function custom:abilities/avatar/passive/air/core

                scoreboard players operation @s customUniversal.PreviousHotbar = @s customUniversal.ActiveHotbar
            }
            
            function changed {
                tag @s remove customAvatar.PassiveAir
                attribute @s minecraft:safe_fall_distance base reset
                effect clear @s minecraft:slow_falling

                tag @s remove customAvatar.PassiveWater
                tag @s remove customAvatar.PassiveEarth
                tag @s remove customAvatar.PassiveFire
            }

            dir air {
                function init {
                    attribute @s minecraft:safe_fall_distance base set 100000000
                    tag @s add customAvatar.PassiveAir
                }
                function core {
                    execute unless entity @s[tag=customAvatar.PassiveAir] run function custom:abilities/avatar/passive/air/init

                    execute if predicate custom:universal/sneak run {
                        tag @s add customAvatar.PassiveAirSneaking
                        effect clear @s minecraft:slow_falling
                    } else run {
                        tag @s remove customAvatar.PassiveAirSneaking

                        execute store result score @s customAvatar.PassiveAirMotion run data get entity @s Motion[1] 100000
                        execute if score @s customAvatar.PassiveAirMotion matches ..-15000 run {
                            particle minecraft:cloud ~ ~-0.5 ~ 0.35 0 0.35 0 2 force @a
                        }
                        effect give @s minecraft:slow_falling infinite 10 true
                    }
                }
            }
        }


        dir key_bindings {
            REPEAT (1,4) as i {
                function move<%i%> {
                    function custom:abilities/avatar/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move1Trigger
                    scoreboard players enable @s customUniversal.Move1Trigger
                    scoreboard players reset @s customUniversal.Move2Trigger
                    scoreboard players enable @s customUniversal.Move2Trigger
                    scoreboard players reset @s customUniversal.Move3Trigger
                    scoreboard players enable @s customUniversal.Move3Trigger
                    scoreboard players reset @s customUniversal.Move4Trigger
                    scoreboard players enable @s customUniversal.Move4Trigger
                }
            }
        }

        dir hotbar {
            function main {
                block { with storage minecraft:custom avatar.cooldowns.move1
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A3"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A4"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A5"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A6"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A7"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A8"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07A9"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B0"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B1"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B2"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B3"

                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                }
                block { with storage minecraft:custom avatar.cooldowns.move2
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B4"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B5"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B6"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B7"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B8"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07B9"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C0"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C1"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C2"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C3"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C4"

                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                }
                block { with storage minecraft:custom avatar.cooldowns.move3
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C5"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C6"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C7"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C8"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07C9"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D0"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D1"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D2"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D3"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D4"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D5"

                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                }
                block { with storage minecraft:custom avatar.cooldowns.move4
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D6"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D7"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D8"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07D9"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E0"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E1"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E2"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E3"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E4"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E5"
                    $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u07E6"

                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                    $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
                }
                
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"avatar",selected:<%i%>}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom avatar.hotbar
                    $title @s actionbar [{"text":"\uF830\u07A0\uF817"},{"text":"\uF820\$(move1)\uF801\u07A2"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u07A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom avatar.hotbar
                    $title @s actionbar [{"text":"\uF830\u07A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)\uF801\u07A2"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u07A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom avatar.hotbar
                    $title @s actionbar [{"text":"\uF830\u07A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)\uF801\u07A2"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u07A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 4 run block { with storage minecraft:custom avatar.hotbar
                    $title @s actionbar [{"text":"\uF830\u07A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)\uF801\u07A2"},{"text":"\uF800\u07A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom avatar.hotbar.move$(selection) set value "u06B0"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        dir toggle {
            function on {
                playsound minecraft:gojo.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:gojo.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                effect give @s minecraft:invisibility infinite 0 true
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                function custom:universal/armor/hide
                $execute rotated ~ 0 run function animated_java:toji/summon {args:{animation:'$(animation)', start_animation: true}}
                $function custom:universal/setup/rig {objective:"$(objective)",item:"toji"}

                execute unless entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/model {branch:"toji"}
                execute if entity @s[tag=customSettings.PlayerSkin] run function custom:universal/stable_player_display/state/skin {branch:"toji"}
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.camera",objective:"$(objective)"}

                scoreboard players add .global customUniversal.GlobalCounter 1
                scoreboard players operation @s customUniversal.GlobalCounter = .global customUniversal.GlobalCounter
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.root",objective:"customUniversal.GlobalCounter"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    execute if score @s customUniversal.ActiveHotbar matches 1 run {
                        execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/avatar/moves/1/pass
                        execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Gust"}
                    }
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                }

                function pass {
                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .AvatarCooldown customUniversal.Move1Cooldown
                    scoreboard players set @s customUniversal.MoveLastUsed 1
                    scoreboard players set @s customUniversal.MoveDelay 10
                    
                    tag @s add temp
                    particle minecraft:cloud ~ ~ ~ 0.35 0 0.35 0 50 force @a
                    playsound minecraft:entity.breeze.shoot player @a ~ ~ ~ 1
                    launch @s looking 2.5

                    scoreboard players set @s customUniversal.Delay1 20
                    execute as @e[type=!#custom:not_mob,distance=..3,tag=!temp] run {
                        launch @s setMotionY 2.5
                    }
                    tag @s remove temp
                }
            }

            dir 2 {
                function core {
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 2
                }
            }

            dir 3 {
                function core {
                    execute unless score @s customUniversal.Move3Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 3
                }
            }

            dir 4 {
                function core {
                    execute unless score @s customUniversal.Move4Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 4
                    # execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/4/pass
                    # execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:4,unicode:"u50A0",move:"Spring"}
                }

                function pass {
                    # function custom:abilities/toji/moves/setup {animation:'spring_windup',objective:"customUniversal.RigID"}
                    # tag @s add customUniversal.Cancellable
                    # scoreboard players set @s customUniversal.MoveLastUsed 4
                    # execute as @n[tag=aj.toji.locator.coil_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID

                    # function custom:abilities/toji/moves/4/danger_zone
                    # execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,tag=!found] run {
                    #     scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                    #     tag @s add found
                    # }

                    # execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move4Cooldown = .TojiCooldown customUniversal.Move4Cooldown
                    # scoreboard players set @s customUniversal.MoveDelay 10

                    # attribute @s minecraft:movement_speed base set 0.025
                    # attribute @s minecraft:jump_strength base set 0
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Toji,scores={$(objective)=$(id)}] at @s run function custom:abilities/toji/moves/reset/player
                        $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customToji.AcrobaticsRecastable
                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }
    }
}

dir traits {
    dir shrink {
        function a {
            say a
        }
    }
}

dir universal {
    dir advancements {
        function killed_monster {
            execute if score @s customToji.QuestProgress matches 2 run {
                scoreboard players add @s customToji.ObtainmentMonsterKills 1
            }
            advancement revoke @s only custom:killed_monster
        }
    }

    function secret_interaction_notify {
        # function custom:universal/secret_interaction_notify {description:["",{"text":"Devour","color":"gold"},{"text":"\n"},{"text":"Everytime ","color":"gray"},{"text":"Maul ","color":"yellow"},{"text":"is activated, there is a ","color":"gray"},{"text":"0.5% chance","color":"green"},{"text":" that Billy plays a cutscene version of the passive instead.","color":"gray"},{"text":"\n"},{"text":"-> Damage: ","color":"gray"},{"text":"30","color":"red"},{"text":"\n"},{"text":"-> Victim Movement Speed: ","color":"gray"},{"text":"0.75x","color":"red"},{"text":"\n"},{"text":"-> Victim Jump Strength: ","color":"gray"},{"text":"0.5x","color":"red"},{"text":"\n"},{"text":"-> Effect Duration:","color":"gray"},{"text":" 15s","color":"yellow"}]}
        $tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"C","color":"red"},{"text":"o","color":"gold"},{"text":"n","color":"yellow"},{"text":"g","color":"green"},{"text":"r","color":"blue"},{"text":"a","color":"light_purple"},{"text":"t","color":"dark_purple"},{"text":"u","color":"red"},{"text":"l","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"i","color":"blue"},{"text":"o","color":"light_purple"},{"text":"n","color":"dark_purple"},{"text":"s","color":"red"},{"text":"!","color":"gold"},{"text":" You've discovered a new ","color":"gray"},{"text":"[Secret Interaction]","color":"light_purple","hover_event":{"action":"show_text","value":[$(description)]}}]
        playsound minecraft:entity.villager.yes player @s ~ ~ ~ 0.5
        scoreboard players add @s customUniversal.SecretInteractionCount 1
    }

    function text {
        # function custom:universal/text {type:"up",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"yellow","text":"Billy"}}
        $execute at @s positioned ~ ~$(y_offset) ~ run function animated_java:text_display/summon {args:{animation: '$(type)', start_animation: true}}
        $data merge storage minecraft:custom {universal:{text:{what:$(what),extra:"$(extra)"}}}
        execute as @n[type=minecraft:text_display,tag=aj.text_display.text_display.display,tag=!customUniversal.WrittenText] run block { with storage minecraft:custom universal.text
            $data merge entity @s {text:$(what)}
            tag @s add customUniversal.WrittenText
        }
        execute as @n[type=minecraft:item_display,tag=aj.text_display.root,tag=!customUniversal.TextPost] run block { with storage minecraft:custom universal.text
            $$(extra)
            tag @s add customUniversal.TextPost
        }
    }

    function admin_setup {
        tag @s add customUI.AdminAccess
        tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"You now have complete ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"a","color":"gold"},{"text":"t","color":"yellow"},{"text":"o","color":"green"},{"text":"r","color":"blue"},{"text":" access to everything relating to ","color":"gray"},{"text":"Custom Abilities!","color":"aqua"}]
    }

    dir vfx {
        function enable {
            scoreboard players add .global customUniversal.VFXID 1
            scoreboard players operation @s customUniversal.VFXID = .global customUniversal.VFXID
        }

        function spawn {
            #  --   Required Args  --   #
            # Mode: 1 - 3 | 
            
            # Mode 1 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:1,offsetXR:50,offsetYL:1,offsetYR:50,offsetZL:1,offsetZR:50}}}
                # data merge storage minecraft:custom {universal:{vfx:{duration:30,speedXL:1,speedXR:50,speedYL:1,speedYR:50,speedZL:1,speedZR:50}}}
                # function custom:universal/vfx/spawn {mode:1,speed:1,duration:300,count:10,branch:"gojo",animation:'lapis_blue',extra:"random value 1..2"}

            # Mode 3 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                # function custom:universal/vfx/spawn {mode:3,speed:0,count:1,duration:0,branch:"gojo",animation:'light_beam'}

            # Mode 3 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{mode:3,speed:0,animation:'lapis_blue'}}}

            # Mode 1 - Spawning with a specific offset.
            # Mode 2 - Spawning with a random offset, provided by args.
            
            $scoreboard players set @s customUniversal.VFXCount $(count)
            $scoreboard players set .Mode customUniversal.VFXConditions $(mode)
            $data merge storage minecraft:custom {universal:{vfx:{speed:$(speed),animation:'$(animation)',duration:$(duration),branch:"$(branch)",extra:"$(extra)"}}}

            # Particle with speed, duration, and random rotation config
            execute if score .Mode customUniversal.VFXConditions matches 1 run function custom:universal/vfx/mode_1

            # Mounting spawner with NO rotation
            execute if score .Mode customUniversal.VFXConditions matches 2 run function custom:universal/vfx/mode_2

            # Mounting spawner with RANDOM rotation
            execute if score .Mode customUniversal.VFXConditions matches 3 run function custom:universal/vfx/mode_3

            # Particle with speed, duration, and inherited random rotation config
            execute if score .Mode customUniversal.VFXConditions matches 4 run function custom:universal/vfx/mode_4
            
            # scoreboard players set .Mode customUniversal.VFXConditions 0
            # scoreboard players set .Speed customUniversal.VFXConditions 0
            # data remove storage minecraft:custom universal.vfx
        }

        function mode_1 {
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.offsetXLfinal int 1 run random value -$(offsetXL)..$(offsetXL)
                $execute store result storage minecraft:custom universal.vfx.offsetXRfinal int 1 run random value 0..$(offsetXR)
                $execute store result storage minecraft:custom universal.vfx.offsetYLfinal int 1 run random value -$(offsetYL)..$(offsetYL)
                $execute store result storage minecraft:custom universal.vfx.offsetYRfinal int 1 run random value 0..$(offsetYR)
                $execute store result storage minecraft:custom universal.vfx.offsetZLfinal int 1 run random value -$(offsetZL)..$(offsetZL)
                $execute store result storage minecraft:custom universal.vfx.offsetZRfinal int 1 run random value 0..$(offsetZR)

                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get .global customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $execute positioned ~$(offsetXLfinal).$(offsetXRfinal) ~$(offsetYLfinal).$(offsetYRfinal) ~$(offsetZLfinal).$(offsetZRfinal) run function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $execute as @e[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless entity @s[tag=customUniversal.VFXSpawned] run block { with storage minecraft:custom universal.vfx
                        $data merge entity @s {teleport_duration:$(duration)}
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $scoreboard players set @s customUniversal.VFXSpeed $(speed)
                        tag @s add customUniversal.VFXSpawned
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_1
        }

        function mode_2 {
            block {
                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get @s customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $function animated_java:vfx_billboard/summon {args:{animation:'$(animation)', start_animation: true}}
                    execute as @e[type=minecraft:item_display,tag=aj.vfx_billboard.root,tag=customUniversal.VFXBillboard] run block { with storage minecraft:custom universal.vfx
                        # scoreboard players set @s customUniversal.VFXRotation 1
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=!temp] run {
                            tag @s add temp
                        }

                        $execute as @n[type=minecraft:item_display,tag=aj.$(branch)_vfx.root,tag=customUniversal.VFXSpawn] run {
                            ride @s mount @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp]
                            tag @s remove customUniversal.VFXSpawn
                        }

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp] run {
                            tag @s remove customUniversal.VFXBillboardMount
                            tag @s remove temp
                        }

                        tag @s remove customUniversal.VFXBillboard
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_2
        }

        function mode_3 {
            block {
                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get @s customUniversal.VFXID
                execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
                execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90

                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $function animated_java:vfx_billboard/summon {args:{animation:'$(animation)', start_animation: true}}
                    execute as @e[type=minecraft:item_display,tag=aj.vfx_billboard.root,tag=customUniversal.VFXBillboard] run block { with storage minecraft:custom universal.vfx
                        # scoreboard players set @s customUniversal.VFXRotation 1
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $rotate @s $(rotationX) $(rotationY)

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=!temp] run {
                            tag @s add temp
                        }

                        $execute as @n[type=minecraft:item_display,tag=aj.$(branch)_vfx.root,tag=customUniversal.VFXSpawn] run {
                            ride @s mount @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp]
                            tag @s remove customUniversal.VFXSpawn
                        }

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp] run {
                            tag @s remove customUniversal.VFXBillboardMount
                            tag @s remove temp
                        }

                        tag @s remove customUniversal.VFXBillboard
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_3
        }

        function mode_4 {
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.offsetXLfinal int 1 run random value -$(offsetXL)..$(offsetXL)
                $execute store result storage minecraft:custom universal.vfx.offsetXRfinal int 1 run random value 0..$(offsetXR)
                $execute store result storage minecraft:custom universal.vfx.offsetYLfinal int 1 run random value -$(offsetYL)..$(offsetYL)
                $execute store result storage minecraft:custom universal.vfx.offsetYRfinal int 1 run random value 0..$(offsetYR)
                $execute store result storage minecraft:custom universal.vfx.offsetZLfinal int 1 run random value -$(offsetZL)..$(offsetZL)
                $execute store result storage minecraft:custom universal.vfx.offsetZRfinal int 1 run random value 0..$(offsetZR)
                execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
                execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90

                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get .global customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $execute positioned ~$(offsetXLfinal).$(offsetXRfinal) ~$(offsetYLfinal).$(offsetYRfinal) ~$(offsetZLfinal).$(offsetZRfinal) rotated $(rotationX) $(rotationY) run function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $execute as @e[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless entity @s[tag=customUniversal.VFXSpawned] run block { with storage minecraft:custom universal.vfx
                        $data merge entity @s {teleport_duration:$(duration)}
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $scoreboard players set @s customUniversal.VFXSpeed $(speed)
                        tag @s add customUniversal.VFXSpawned
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_4
        }

        function speed {
            block { with storage minecraft:custom universal.vfx
                $scoreboard players set @s customUniversal.VFXDuration $(duration)
                $execute store result score @s customUniversal.VFXSpeedXL run random value -$(speedXL)..$(speedXL)
                $execute store result score @s customUniversal.VFXSpeedXR run random value 0..$(speedXR)
                $execute store result score @s customUniversal.VFXSpeedYL run random value -$(speedYL)..$(speedYL)
                $execute store result score @s customUniversal.VFXSpeedYR run random value 0..$(speedYR)
                $execute store result score @s customUniversal.VFXSpeedZL run random value -$(speedZL)..$(speedZL)
                $execute store result score @s customUniversal.VFXSpeedZR run random value 0..$(speedZR)
                tag @s remove customUniversal.VFXSpeed

                block {
                    execute store result storage minecraft:custom universal.vfx.speedXLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedXL
                    execute store result storage minecraft:custom universal.vfx.speedXRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedXR
                    execute store result storage minecraft:custom universal.vfx.speedYLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedYL
                    execute store result storage minecraft:custom universal.vfx.speedYRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedYR
                    execute store result storage minecraft:custom universal.vfx.speedZLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedZL
                    execute store result storage minecraft:custom universal.vfx.speedZRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedZR
                    block { with storage minecraft:custom universal.vfx
                        $tp @s ~$(speedXLfinal).$(speedXRfinal) ~$(speedYLfinal).$(speedYRfinal) ~$(speedZLfinal).$(speedZRfinal)
                    }
                }
            }
        }

        function random_rotation {
            execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
            execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90
            block { with storage minecraft:custom universal.vfx
                $rotate @s $(rotationX) $(rotationY)
            }
        }

        function random_variant {
            # EX: function custom:universal/vfx/random {variant_pool:"blue_static",range:"6"}
            $data merge storage minecraft:custom {universal:{vfx:{variant_pool:"$(variant_pool)",range:$(range),particle_set:"$(particle_set)"}}}
            
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.random int 1 run random value 1..$(range)
                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(particle_set)_vfx/variants/$(variant_pool)_$(random)/apply
                }
            }
        }
    }

    dir as {
        function player {
            # function custom:universal/as/player {objective:"customTheWorld.RigID",what:"tag=customAbility.TheWorld",output:"say a"}
            $execute store result storage minecraft:custom universal.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {universal:{what:"$(what)",objective:"$(objective)",output:"$(output)"}}
            block { with storage minecraft:custom universal
                $execute as @p[$(what),scores={$(objective)=$(id)}] at @s run $(output)
            }
        }
    }

    dir hotbar {
        function time {
            $execute store result storage minecraft:custom universal.hotbar.time int 1 run scoreboard players get @s customUniversal.Move$(selected)CooldownConverted
            $data merge storage minecraft:custom {universal:{hotbar:{ability:"$(ability)",move:$(selected)}}}
            block { with storage minecraft:custom universal.hotbar
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 100.. store result storage minecraft:custom $(ability).hotbar.time int 1 run scoreboard players get @s customUniversal.Move$(move)CooldownConverted
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 10..99 run data merge storage minecraft:custom {$(ability):{hotbar:{time:"0$(time)"}}}
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 0..9 run data merge storage minecraft:custom {$(ability):{hotbar:{time:"00$(time)"}}}
            }
        }
    }

    function cooldowns {
        $scoreboard players set .$(ability)Cooldown customUniversal.Move$(move)Cooldown $(cooldown)
        $scoreboard players operation .$(ability)Cooldown customUniversal.Move$(move)Cooldown *= x20 customUniversal.MoveCooldowns
        $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
        $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
        $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
        $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown /= div11 customUniversal.MoveCooldowns

        $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).11 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

        REPEAT (10,1) as i {
            $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>a int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
            $scoreboard players remove .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown 1
            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>b int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
        }

        $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
        $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).1 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

        $data merge storage minecraft:custom {$(storage):{cooldowns:{move$(path):{selection:$(move)}}}}
    }

    dir control {
        function spectate_camera {
            # ex:
            # function custom:universal/control/spectate_camera {storage:"the_world",objective:"customTheWorld.ImpaleID",spectator:"customTheWorld.ImpaleCutscene",camera:"aj.the_world_cutscenes.camera"}
            $execute store result storage minecraft:custom $(storage).camera.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {$(storage):{camera:{spectator:"$(spectator)",camera:"$(camera)",objective:"$(objective)"}}}
            $block { with storage minecraft:custom $(storage).camera
                $execute as @a[tag=$(spectator),scores={$(objective)=$(id)}] run spectate @n[type=minecraft:item_display,tag=$(camera),scores={$(objective)=$(id)}]
            }
        }

        function movement {
            $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:custom universal.control
                $execute as @a[tag=$(user),scores={$(objective)=$(id)}] at @s run tp @n[type=item_display,tag=$(rig),scores={$(objective)=$(id)}] ~ ~ ~ ~ 0
            }
        }
    }

    dir damage {
        function self {
            execute if entity @s[tag=customUniversal.Cancellable] run {
                execute if entity @s[tag=customAbility.Gojo] run {
                    execute store result storage minecraft:custom gojo.temp.id int 1 run scoreboard players get @s customUniversal.GlobalCounter
                    execute store result storage minecraft:custom gojo.temp.last int 1 run scoreboard players get @s customUniversal.MoveLastUsed
                    block { with storage minecraft:custom gojo.temp
                        $execute as @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.GlobalCounter=$(id)}] run {
                            function animated_java:gojo/remove/this
                            execute as @a[distance=..16] run {
                                stopsound @s player minecraft:the_world.barrage.shinei
                                stopsound @s player minecraft:the_world.barrage.voiceline
                                stopsound @s player minecraft:the_world.impale.laugh
                                stopsound @s player minecraft:the_world.impale.punch
                                stopsound @s player minecraft:the_world.impale.rustle
                                stopsound @s player minecraft:the_world.impale.shinei
                                stopsound @s player minecraft:the_world.impale.voiceline1
                                stopsound @s player minecraft:the_world.impale.voiceline2
                                stopsound @s player minecraft:the_world.knife_throw.voiceline
                                stopsound @s player minecraft:the_world.timeskip.sfx
                            }
                        }
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run block { with storage minecraft:custom gojo.temp
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown = .GojoCooldown customUniversal.Move$(last)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown *= mult50 customUniversal.CooldownMath
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown /= div100 customUniversal.CooldownMath
                    }
                    function custom:abilities/gojo/moves/reset/player
                }

                execute if entity @s[tag=customAbility.TheWorld] run {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.RigID
                    execute store result storage minecraft:custom the_world.temp.last int 1 run scoreboard players get @s customUniversal.MoveLastUsed
                    block { with storage minecraft:custom the_world.temp
                        $execute as @n[type=minecraft:item_display,tag=aj.the_world.root,scores={customTheWorld.RigID=$(id)}] run {
                            function animated_java:the_world/animations/barrage/stop
                            function animated_java:the_world/animations/impale/stop
                            function animated_java:the_world/animations/knife_throw/stop
                            function animated_java:the_world/animations/hide_dio/play
                            execute as @a[distance=..16] run {
                                stopsound @s player minecraft:the_world.barrage.shinei
                                stopsound @s player minecraft:the_world.barrage.voiceline
                                stopsound @s player minecraft:the_world.impale.laugh
                                stopsound @s player minecraft:the_world.impale.punch
                                stopsound @s player minecraft:the_world.impale.rustle
                                stopsound @s player minecraft:the_world.impale.shinei
                                stopsound @s player minecraft:the_world.impale.voiceline1
                                stopsound @s player minecraft:the_world.impale.voiceline2
                                stopsound @s player minecraft:the_world.knife_throw.voiceline
                                stopsound @s player minecraft:the_world.timeskip.sfx
                            }
                        }
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run block { with storage minecraft:custom the_world.temp
                        say a
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown = .The_WorldCooldown customUniversal.Move$(last)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown *= mult50 customUniversal.CooldownMath
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown /= div100 customUniversal.CooldownMath
                    }

                    function custom:abilities/the_world/moves/reset/player
                }
                tag @s remove customUniversal.Cancellable
            }

            execute if entity @s[tag=customAbility.Gojo] run {
                function custom:abilities/gojo/passive/main
            }

            advancement revoke @s only custom:taken_damage
        }

        function entity {
            execute if score @s customUniversal.Toggle matches 1 if entity @s[tag=customAbility.Billy] run function custom:abilities/billy/passive/maul/start
            # execute as @n[nbt={HurtTime:10s}] run say ow
            advancement revoke @s only custom:dealt_damage
        }

        function victim {
            gamerule showDeathMessages false
            scoreboard players operation @s customUniversal_DeathCountPre = @s customUniversal_DeathCount
            $damage @s $(damage) $(type)
            $execute unless score @s customUniversal_DeathCountPre = @s customUniversal_DeathCount run tellraw @a ["",{"selector":"@s"},{"text":" $(first) "},{"selector":"@p[$(attacker),scores={$(objective)=$(id)}]"},{"text":" $(second)"}]
            gamerule showDeathMessages true
        }
    }

    dir setup {
        function rig {
            $scoreboard players add .global $(objective) 1
            $scoreboard players operation @s $(objective) = .global $(objective)
            $execute store result score @n[type=minecraft:item_display,tag=aj.$(item).root] $(objective) run scoreboard players get @s $(objective)
        }
        function pair {
            $execute store result score @n[type=$(type),tag=$(what)] $(objective) run scoreboard players get @s $(objective)
        }
    }

    dir error_messages {
        function universal {
            execute if entity @s[tag=customGojo.RidingBlue] run function custom:universal/error_messages/find {error:100}
            execute if entity @s[tag=customGojo.InfiniteVoided] run function custom:universal/error_messages/find {error:101}
        }
        function find {
            $tag @s add customUniversal.Error$(error)
            scoreboard players set @s customUniversal.FailReturn 1

        }
        function fail {
            $scoreboard players operation @s customUniversal.CooldownMath = @s customUniversal.Move$(number)Cooldown
            scoreboard players operation @s customUniversal.CooldownMath /= div20 customUniversal.CooldownMath
            $tellraw @s ["",{"text":"\n\$(unicode) ","color":"white"},{"text":" $(move)","color":"gold"}]
            execute if entity @s[tag=customUniversal.Error1] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" On cooldown for","color":"gray"},{"text":" ","color":"blue"},{"score":{"name":"@s","objective":"customUniversal.CooldownMath"},"color":"red"},{"text":"s","color":"red"}]
            execute if entity @s[tag=customUniversal.Error2] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" Another move is ","color":"gray"},{"text":"currently casting!","color":"blue"}]
            execute if entity @s[tag=customUniversal.Error3] run tellraw @s ["",{"text":"- This move is ","color":"gray"},{"text":"BANNED ","color":"red"},{"text":"in the ","color":"gray"},{"text":"Pocket Dimension","color":"red"}]
            execute if entity @s[tag=customUniversal.Error4] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"be looking at an entity to use ","color":"gray"},{"text":"this ","color":"aqua"},{"text":"move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error5] run tellraw @s ["",{"text":"- You can't use ","color":"gray"},{"text":"Domain Expansion","color":"dark_purple"},{"text":" - ","color":"gray"},{"text":"Infinite Void","color":"light_purple"},{"text":" whilst nearby someone ","color":"gray"},{"text":"currently using","color":"gold"},{"text":" or ","color":"red"},{"text":"performing ","color":"gold"},{"text":"this move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error6] run tellraw @s ["",{"text":"- You must be on ","color":"gray"},{"text":"solid ground ","color":"green"},{"text":"to cast this ","color":"gray"},{"text":"move!","color":"gold"}]
            execute if entity @s[tag=customUniversal.Error7] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use this attack whilst it's ","color":"gray"},{"text":"currently casting!","color":"aqua"}]
            execute if entity @s[tag=customUniversal.Error8] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CAN'T","color":"red"},{"text":" use this move whilst being targeted by ","color":"gray"},{"text":"Pact!","color":"aqua"}]

            execute if entity @s[tag=customUniversal.Error9] run scoreboard players operation @s customUniversal.CooldownMath = @s customEren.ShiftCooldown
            execute if entity @s[tag=customUniversal.Error9] run scoreboard players operation @s customUniversal.CooldownMath /= #divide customUniversal.CooldownMath
            execute if entity @s[tag=customUniversal.Error9] run tellraw @s ["",{"text":"- You can't attempt to ","color":"gray"},{"text":"shift","color":"gold"},{"text":" into the ","color":"gray"},{"text":"Attack Titan","color":"aqua"},{"text":" for another ","color":"gray"},{"score":{"name":"@s","objective":"customUniversal.CooldownMath"},"color":"red"},{"text":"s!","color":"red"}]

            execute if entity @s[tag=customUniversal.Error10] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"roll the dice before ","color":"gray"},{"text":"storing ","color":"aqua"},{"text":"a move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error11] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"must ","color":"red"},{"text":"be looking at a ","color":"gray"},{"text":"block in range","color":"aqua"},{"text":" in order to use ","color":"gray"},{"text":"Acrobatics","color":"light_purple"}]

            execute if entity @s[tag=customUniversal.Error100] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use moves when ","color":"gray"},{"text":"picked up","color":"gold"},{"text":" by ","color":"gray"},{"text":"Lapis Blue","color":"aqua"}]
            execute if entity @s[tag=customUniversal.Error101] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CAN'T ","color":"red"},{"text":"use moves when in ","color":"gray"},{"text":"Domain Expansion ","color":"dark_purple"},{"text":"-","color":"gray"},{"text":" Infinite Void!","color":"light_purple"}]
            
            REPEAT (1,101) as i {
                tag @s remove customUniversal.Error<%i%>
            }

            playsound minecraft:entity.villager.no player @s ~ ~ ~ 0.5
            scoreboard players set @s customUniversal.MoveDelay 10
            scoreboard players set @s customUniversal.FailReturn 0
            tellraw @s ""
        }
    }

    dir toggle {
        function main {
            execute if entity @s[tag=CustomAbility.User] unless entity @s[tag=customUniversal.Animation] unless score @s customUniversal.ToggleDelay matches 1.. run {
                execute unless entity @s[tag=CustomAbility.Active] run {
                    # Toggle ON #
                    tag @s add CustomAbility.Active
                    tag @s add temp
                    scoreboard players set @s customUniversal.Toggle 1
                    execute if entity @s[tag=customAbility.Gojo] run {
                        function custom:abilities/gojo/toggle/on
                    }
                    execute if entity @s[tag=customAbility.TheWorld] run {
                        function custom:abilities/the_world/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Dice] run {
                        function custom:abilities/dice/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Billy] run {
                        function custom:abilities/billy/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Toji] run {
                        function custom:abilities/toji/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Yuji] run {
                        function custom:abilities/yuji/toggle/on
                    }
                } else execute unless entity @s[tag=temp] run {
                    # Toggle OFF #
                    tag @s remove CustomAbility.Active
                    scoreboard players set @s customUniversal.Toggle 2
                    execute if entity @s[tag=customAbility.Gojo] run {
                        function custom:abilities/gojo/toggle/off
                    }
                    execute if entity @s[tag=customAbility.TheWorld] run {
                        function custom:abilities/the_world/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Dice] run {
                        function custom:abilities/dice/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Billy] run {
                        function custom:abilities/billy/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Toji] run {
                        function custom:abilities/toji/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Yuji] run {
                        function custom:abilities/yuji/toggle/off
                    }
                }
                tag @s remove temp
            } 
        }
    }

    function fetch_block {
        loot insert 0 -63 0 mine ~ ~ ~ minecraft:stick[tool={can_destroy_blocks_in_creative:true,default_mining_speed:90,damage_per_block:90,rules:[]},enchantments={"minecraft:silk_touch":1}]
        data modify storage minecraft:custom universal.fetch_block.id set string block 0 -63 0 Items[0].id
        item replace block 0 -63 0 container.0 with minecraft:air
    }

    dir stable_player_display {
        function test {
            $function animated_java:$(branch)/remove/all 
            $execute rotated ~ 0 run function animated_java:$(branch)/summon {args:{}}
            $function custom:universal/stable_player_display/mask {branch:$(branch)}
            $execute as @n[tag=aj.$(branch).root] run function animated_java:$(branch)/animations/$(animation)/play
        }

        dir state {
            function model {
                $execute as @n[tag=aj.$(branch).root] run block { {branch:"$(branch)"}
                    $function animated_java:$(branch)/variants/default/apply
                    $execute as @n[tag=aj.$(branch).item_display.helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                }
            }

            function skin {
                $execute as @n[tag=aj.$(branch).root] run block { {branch:$(branch)}
                    $function animated_java:$(branch)/variants/player_model/apply
                }
                $function custom:universal/stable_player_display/mask {branch:$(branch)}
            }
        }

        function mask {
            $loot replace entity @n[tag=aj.$(branch).bone.head] hotbar.0 loot minecraft:player/head
            $loot replace entity @n[tag=aj.$(branch).bone.right_arm] hotbar.0 loot minecraft:player/right_arm
            $loot replace entity @n[tag=aj.$(branch).bone.right_forearm] hotbar.0 loot minecraft:player/right_forearm
            $loot replace entity @n[tag=aj.$(branch).bone.left_arm] hotbar.0 loot minecraft:player/left_arm
            $loot replace entity @n[tag=aj.$(branch).bone.left_forearm] hotbar.0 loot minecraft:player/left_forearm
            $loot replace entity @n[tag=aj.$(branch).bone.waist] hotbar.0 loot minecraft:player/waist
            $loot replace entity @n[tag=aj.$(branch).bone.right_leg] hotbar.0 loot minecraft:player/right_leg
            $loot replace entity @n[tag=aj.$(branch).bone.lower_right_leg] hotbar.0 loot minecraft:player/lower_right_leg
            $loot replace entity @n[tag=aj.$(branch).bone.left_leg] hotbar.0 loot minecraft:player/left_leg
            $loot replace entity @n[tag=aj.$(branch).bone.lower_left_leg] hotbar.0 loot minecraft:player/lower_left_leg

            $data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:empty",chestplate_body:"minecraft:empty",chestplate_arms:"minecraft:empty",leggings_pants:"minecraft:empty",leggings_upper:"minecraft:empty",leggings_lower:"minecraft:empty",boots:"minecraft:empty",branch:$(branch)}}}
            execute if items entity @s armor.head #minecraft:head_armor run {
                execute if items entity @s armor.head minecraft:netherite_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/netherite/helmet"}}}
                execute if items entity @s armor.head minecraft:diamond_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/diamond/helmet"}}}
                execute if items entity @s armor.head minecraft:iron_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/iron/helmet"}}}
                execute if items entity @s armor.head minecraft:chainmail_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/chainmail/helmet"}}}
                execute if items entity @s armor.head minecraft:golden_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/gold/helmet"}}}
            }
            execute if items entity @s armor.chest #minecraft:chest_armor run {
                execute if items entity @s armor.chest minecraft:netherite_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/netherite/chestplate/arms",chestplate_body:"minecraft:armor/netherite/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:diamond_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/diamond/chestplate/arms",chestplate_body:"minecraft:armor/diamond/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:iron_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/iron/chestplate/arms",chestplate_body:"minecraft:armor/iron/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:chainmail_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/chainmail/chestplate/arms",chestplate_body:"minecraft:armor/chainmail/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:golden_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/gold/chestplate/arms",chestplate_body:"minecraft:armor/gold/chestplate/body"}}}
            }

            execute if items entity @s armor.legs #minecraft:leg_armor run {
                execute if items entity @s armor.legs minecraft:netherite_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/netherite/leggings/pants",leggings_upper:"minecraft:armor/netherite/leggings/upper",leggings_lower:"minecraft:armor/netherite/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:diamond_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/diamond/leggings/pants",leggings_upper:"minecraft:armor/diamond/leggings/upper",leggings_lower:"minecraft:armor/diamond/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:iron_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/iron/leggings/pants",leggings_upper:"minecraft:armor/iron/leggings/upper",leggings_lower:"minecraft:armor/iron/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:chainmail_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/chainmail/leggings/pants",leggings_upper:"minecraft:armor/chainmail/leggings/upper",leggings_lower:"minecraft:armor/chainmail/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:golden_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/gold/leggings/pants",leggings_upper:"minecraft:armor/gold/leggings/upper",leggings_lower:"minecraft:armor/gold/leggings/lower"}}}
            }

            execute if items entity @s armor.feet #minecraft:foot_armor run {
                execute if items entity @s armor.feet minecraft:netherite_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/netherite/boots"}}}
                execute if items entity @s armor.feet minecraft:diamond_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/diamond/boots"}}}
                execute if items entity @s armor.feet minecraft:iron_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/iron/boots"}}}
                execute if items entity @s armor.feet minecraft:chainmail_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/chainmail/boots"}}}
                execute if items entity @s armor.feet minecraft:golden_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/gold/boots"}}}
            }

            block { with storage minecraft:custom universal.stable_player_display
                $execute as @n[tag=aj.$(branch).item_display.helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"$(helmet)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_body)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_pants)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower)"}}}
                $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots)"}}}
                $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots)"}}}
            }
        }
    }

    dir armor {
        function hide {
            item modify entity @s armor.head custom:universal/hide_armor/helmet
            item modify entity @s armor.chest custom:universal/hide_armor/chest
            item modify entity @s armor.legs custom:universal/hide_armor/legs
            item modify entity @s armor.feet custom:universal/hide_armor/feet

            effect give @s minecraft:invisibility infinite 1 true
            tag @s add customUniversal.LockArmor
        }

        function reveal {
            execute if items entity @s armor.feet minecraft:leather_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/leather
            execute if items entity @s armor.feet minecraft:chainmail_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/chainmail
            execute if items entity @s armor.feet minecraft:iron_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/iron
            execute if items entity @s armor.feet minecraft:golden_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/golden
            execute if items entity @s armor.feet minecraft:diamond_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/diamond
            execute if items entity @s armor.feet minecraft:netherite_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/netherite

            execute if items entity @s armor.chest minecraft:leather_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/leather
            execute if items entity @s armor.chest minecraft:chainmail_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/chainmail
            execute if items entity @s armor.chest minecraft:iron_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/iron
            execute if items entity @s armor.chest minecraft:golden_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/golden
            execute if items entity @s armor.chest minecraft:diamond_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/diamond
            execute if items entity @s armor.chest minecraft:netherite_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/netherite

            execute if items entity @s armor.legs minecraft:leather_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/leather
            execute if items entity @s armor.legs minecraft:chainmail_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/chainmail
            execute if items entity @s armor.legs minecraft:iron_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/iron
            execute if items entity @s armor.legs minecraft:golden_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/golden
            execute if items entity @s armor.legs minecraft:diamond_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/diamond
            execute if items entity @s armor.legs minecraft:netherite_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/netherite

            execute if items entity @s armor.head minecraft:leather_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/leather
            execute if items entity @s armor.head minecraft:chainmail_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/chainmail
            execute if items entity @s armor.head minecraft:iron_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/iron
            execute if items entity @s armor.head minecraft:golden_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/golden
            execute if items entity @s armor.head minecraft:diamond_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/diamond
            execute if items entity @s armor.head minecraft:netherite_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/netherite
            execute if items entity @s armor.head minecraft:turtle_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/turtle
        }
    }
}

dir ui {
    dir player {
        function tick {
            execute if items entity @s weapon.* *[minecraft:custom_data={ui:1b}] run function custom:ui/player/teleport
            execute unless items entity @s weapon.* *[minecraft:custom_data={ui:1b}] if score @s ui.id matches 0.. run function custom:ui/player/close
        }

        function close {
            scoreboard players operation #search ui.id = @s ui.id
            execute as @e[type=chest_minecart,tag=ui] if score @s ui.id = #search ui.id run data remove entity @s Items
            execute as @e[tag=ui] if score @s ui.id = #search ui.id run kill @s
            scoreboard players reset @s ui.id
        }

        function teleport {
            execute unless score @s ui.id matches 0.. run function custom:ui/player/open

            scoreboard players operation #search ui.id = @s ui.id
            execute at @s as @e[type=item_display,tag=ui] if score @s ui.id = #search ui.id run tp @s ~ ~1 ~
        }

        function open {
            summon item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}

            scoreboard players add .global ui.id 1
            scoreboard players operation @s ui.id = .global ui.id
            scoreboard players operation @e[tag=new] ui.id = .global ui.id

            scoreboard players set .type ui 1
            execute as @e[type=chest_minecart,tag=new] run function custom:ui/menu/pages/menu/open
            execute as @e[type=chest_minecart,tag=new] run function custom:ui/minecart/load_page

            tag @e remove new
        }

        function return {
            data remove block 0 -64 0 Items
            data modify block 0 -64 0 Items set from storage ui in
            loot give @s mine 0 -64 0 stick[minecraft:custom_data={drop_contents:1b}]
        }
    }

    dir menu {
        dir pages {
            dir menu {
                function mask {
                    # setblock ~ ~ ~ chest{Items:[{Slot:10b,id:"minecraft:arrow","components":{"minecraft:custom_model_data":1,"minecraft:item_name":'{"color":"gold","text":"Settings Config"}',"minecraft:lore":['{"color":"gray","italic":false,"text":"Modify the way Custom Items are used"}'],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:12b,id:"minecraft:arrow","components":{"minecraft:custom_model_data":1,"minecraft:item_name":'{"color":"green","text":"Overview"}',"minecraft:lore":['{"color":"gray","italic":false,"text":"Navigates to the currently equipped Custom Item"}','[{"color":"gray","italic":false,"text":"Currently Equipped Item: "},{"color":"$(equipped_item_color)","text":"$(equipped_item)"}]'],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/overview"}}}},{Slot:13b,id:"minecraft:arrow","components":{"minecraft:custom_model_data":1,"minecraft:item_name":'{"color":"aqua","text":"Selection Menu"}',"minecraft:lore":['{"color":"gray","italic":false,"text":"Change what Custom Item you are using!"}','{"color":"gray","italic":false,"text":"Check what requirements other Custom Items have!"}'],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/open"}}}},{Slot:14b,id:"minecraft:arrow","components":{"minecraft:custom_model_data":1,"minecraft:item_name":'{"color":"red","text":"Disable"}',"minecraft:lore":['{"color":"gray","italic":false,"text":"Removes currently active Custom Item"}'],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/demo/games/open"}}}},{Slot:16b,id:"minecraft:paper","components":{"minecraft:custom_model_data":1,"minecraft:item_name":'{"color":"light_purple","text":"Statistics"}',"minecraft:lore":['{"color":"gray","italic":false,"text":"guh???"}'],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/demo/games/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:custom_model_data":100,"minecraft:custom_data":{ui_item:{empty:1b}}}}]}

                    # setblock ~ ~ ~ chest{Items:[{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Settings Config"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the way Custom Items are used"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}}]} replace

                    $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(ability_item_model)","minecraft:item_name":{"color":"gold","italic":false,"text":"$(ability_name)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"$(ability_description)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_selection_page)"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Settings Config"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the way Custom Abilities are used"}," ",[{"color":"blue","italic":false,"text":"Click"},{"color":"gray","italic":false,"text":" for "},{"color":"green","italic":false,"text":"Generic "},{"color":"gray","italic":false,"text":"access."}],[{"color":"blue","italic":false,"text":"Shift-Click "},{"color":"gray","italic":false,"text":"with "},{"color":"gold","italic":false,"text":"OP "},{"color":"gray","italic":false,"text":"for "},{"color":"red","italic":false,"text":"A"},{"color":"gold","italic":false,"text":"d"},{"color":"yellow","italic":false,"text":"m"},{"color":"green","italic":false,"text":"i"},{"color":"blue","italic":false,"text":"n"},{"color":"light_purple","italic":false,"text":"i"},{"color":"dark_purple","italic":false,"text":"s"},{"color":"red","italic":false,"text":"t"},{"color":"gold","italic":false,"text":"r"},{"color":"yellow","italic":false,"text":"a"},{"color":"green","italic":false,"text":"t"},{"color":"blue","italic":false,"text":"o"},{"color":"light_purple","italic":false,"text":"r "},{"color":"gray","italic":false,"text":"access"}]],"minecraft:custom_data":{ui_item:{settings_button:1b,empty:1b}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for $(ability_name)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_moveset_page)"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","italic":false,"text":"Statistics"},"minecraft:lore":[{"color":"gray","italic":false,"text":"View statistics for the following catergories..."},{"text":""},{"color":"gray","italic":false,"text":"$(ability_name) Stats"},{"color":"gray","italic":false,"text":"General Stats"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/same"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of $(ability_name)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_skin_page)"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"light_purple","italic":false,"text":"Ability Selection"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Overview of all Custom Abilities"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{empty:1b}}}}]
                }

                function open {
                    execute at @s as @p run function custom:ui/menu/pages/menu/player
                    function custom:ui/menu/pages/menu/mask with storage minecraft:ui custom.menu
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/menu/mask"
                }

                function same {
                    execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/menu/open
                }

                function flip {
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/menu/open
                }

                function player {
                    block {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"No Ability"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"Select one for more features!"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:empty"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/menu/same"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/menu/same"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/menu/same"}}}
                    }

                    execute if entity @s[tag=customAbility.TheWorld] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"The World"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"I Reject My Humanity, Jojo!"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/the_world/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/the_world/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/the_world/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/selection/the_world/skins/flip"}}}
                    }

                    execute if entity @s[tag=customAbility.Gojo] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"Satoru Gojo"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"The Honored One"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/gojo/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/gojo/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/gojo/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/selection/gojo/skins/flip"}}}
                    }
                }
            }

            dir settings {
                dir administrator {
                    function open {
                        execute at @s as @p run {
                            execute unless score @s customUI.SelectedOdds matches 1.. run scoreboard players set @s customUI.SelectedOdds 1
                            data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"Yes"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"gray"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"gray"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"gray"}}}}

                            execute if entity @s[tag=customSettings.NoCooldowns] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"green"}}}}
                            }

                            execute if entity @s[tag=customSettings.Immunity] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"green"}}}}
                            }

                            execute if entity @s[tag=customSettings.NormalOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"red"}}}}
                            execute if entity @s[tag=customSettings.RiggedOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"red"}}}}
                            execute if entity @s[tag=customSettings.DisabledOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"red"}}}}
                        }

                        function custom:ui/menu/pages/settings/administrator/mask with storage minecraft:ui custom.settings.administrator
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/settings/administrator/mask"
                    }

                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Cooldowns"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable cooldowns on moves"}," ",[{"color":"gray","italic":false,"text":"Cooldowns: "},{"color":"$(cooldown_color)","italic":false,"text":"$(cooldown_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/cooldowns"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Immunity"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable immunity to all attacks"},{"color":"gray","italic":false,"text":"caused by Custom Abilities"}," ",[{"color":"gray","italic":false,"text":"Immunity: "},{"color":"$(immunity_color)","italic":false,"text":"$(immunity_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/immunity"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Randomization Mode"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Controls the chances of Secret Interactions,"},{"color":"gray","italic":false,"text":"Awakenings, and Dice Rolling"}," ",{"color":"gray","italic":false,"text":"Click to cycle between 3 different modes..."}," ",{"color":"$(odds_normal)","italic":false,"text":"Normal Odds"},{"color":"$(odds_rigged)","italic":false,"text":"Rigged Odds"},{"color":"$(odds_disabled)","italic":false,"text":"Disabled Odds"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/odds"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/administrator_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{empty:1b}}}}]
                    }

                    function cooldowns {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.NoCooldowns] run {
                                tag @s add customSettings.NoCooldowns
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=temp] run {
                                tag @s remove customSettings.NoCooldowns
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function immunity {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.Immunity] run {
                                tag @s add customSettings.Immunity
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.Immunity] unless entity @s[tag=temp] run {
                                tag @s remove customSettings.Immunity
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function odds {
                        execute at @s as @p run {
                            scoreboard players add @s customUI.SelectedOdds 1
                            execute if score @s customUI.SelectedOdds matches 4.. run scoreboard players set @s customUI.SelectedOdds 1
                            tag @s remove customSettings.NormalOdds
                            tag @s remove customSettings.RiggedOdds
                            tag @s remove customSettings.DisabledOdds

                            execute if score @s customUI.SelectedOdds matches 1 run {
                                tag @s add customSettings.NormalOdds
                            }
                            execute if score @s customUI.SelectedOdds matches 2 run {
                                tag @s add customSettings.RiggedOdds
                            }
                            execute if score @s customUI.SelectedOdds matches 3 run {
                                tag @s add customSettings.DisabledOdds
                            }

                            playsound minecraft:entity.experience_orb.pickup player @a ~ ~ ~ 0.25
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }
                }
            }

            dir selection {
                function mask {
                    data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/default_skin","minecraft:item_name":{"color":"yellow","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/flip"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/yuji/default_skin","minecraft:item_name":{"color":"red","italic":false,"text":"Yuji Itadori"},"minecraft:lore":[{"color":"gray","italic":false,"text":"That is my role in this war."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/toji/default_skin","minecraft:item_name":{"color":"dark_gray","italic":false,"text":"Toji Fushiguro"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Kill all Sorcerers huh?... You're a Sorcerer."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/flip"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I Reject My Humanity, Jojo!"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","italic":false,"text":"Star Platinum"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Yare Yare Daze..."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/selection1","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{empty:1b}}}}]
                }

                function open {
                    execute at @s as @p run scoreboard players reset @s customUI.AbilityConfirm

                    function custom:ui/menu/pages/selection/mask
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/mask"
                }

                function flip {
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/selection/open
                }

                function remove {
                    tag @s remove CustomItemHolder
                    tag @s remove GojoUser
                    tag @s remove YujiUser
                    title @s actionbar ""
                }

                dir purchase {
                    function main {
                        execute at @s as @p run block { with storage minecraft:ui custom.purchase
                            $execute if entity @s[tag=$(tag)] run block { with storage minecraft:ui custom.purchase
                                $execute unless entity @s[tag=$(toggle)] run block { with storage minecraft:ui custom.purchase
                                    $tag @s add $(context)
                                    function custom:ui/menu/pages/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                                    tag @s add CustomAbility.User
                                    $tag @s add $(toggle)

                                    tag @s add temp
                                    playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.25
                                } 
                                $execute if entity @s[tag=$(toggle)] unless entity @s[tag=temp] run block { with storage minecraft:ui custom.purchase
                                    $tag @s add $(context)
                                    function custom:ui/menu/pages/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                                    playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.25
                                }
                                tag @s remove temp
                            }

                            $execute unless entity @s[tag=$(tag)] run block { with storage minecraft:ui custom.purchase
                                tag @s add clickEvent
                                tag @s add customUniversal.PurchaseHandler
                                $$(price)

                                execute unless score @s customUI.SkinPatchID matches 1.. run scoreboard players set @s customUI.SkinPatchID 0 

                                block { with storage minecraft:ui custom.purchase
                                    scoreboard players operation @s customUI.SkinLastPatchID = @s customUI.SkinPatchID
                                    $scoreboard players set @s customUI.SkinPatchID $(clickID)
                                }

                                execute unless score @s customUI.SkinLastPatchID = @s customUI.SkinPatchID run {
                                    scoreboard players reset @s customUI.PurchaseConfirm
                                    # tellraw @a ["",{"text":"current "},{"score":{"name":"@s","objective":"customUI.SkinPatchID"}},{"text":"\nprevious "},{"score":{"name":"@s","objective":"customUI.SkinLastPatchID"}}]
                                }

                                execute if entity @s[tag=customUniversal.PurchaseHandler] if score @s customUI.PurchaseConfirm matches 1.. run block { with storage minecraft:ui custom.purchase
                                    $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Congratulations!","color":"aqua"},{"text":" You've just unlocked ","color":"gray"},{"text":"$(name)!","color":"yellow"}]
                                    playsound minecraft:entity.villager.yes player @s ~ ~ ~ 0.35
                                    playsound minecraft:entity.firework_rocket.blast_far player @s ~ ~ ~ 0.35
                                    scoreboard players reset @s customUI.PurchaseConfirm
                                    scoreboard players reset @s customUI.SkinLastPatchID
                                    scoreboard players reset @s customUI.SkinPatchID
                                    tag @s add temp

                                    REPEAT (1,5) as i {
                                        execute if entity @s[tag=customUniversal.RequiredItem<%i%>] run block { with storage minecraft:ui custom.purchase
                                            $clear @s $(type<%i%>) $(count<%i%>)
                                            $data remove storage minecraft:ui custom.purchase.$(type<%i%>)
                                            $data remove storage minecraft:ui custom.purchase.$(count<%i%>)
                                        }
                                    }

                                    $tag @s add $(tag)
                                }

                                execute if entity @s[tag=customUniversal.PurchaseHandler] unless score @s customUI.PurchaseConfirm matches 1.. unless entity @s[tag=temp] run block { with storage minecraft:ui custom.purchase
                                    $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're ","color":"gray"},{"text":"about ","color":"green"},{"text":"to purchase ","color":"gray"},{"text":"$(name)...","color":"yellow"},{"text":" are you ","color":"gray"},{"text":"sure..?","color":"light_purple"}]
                                    playsound minecraft:entity.villager.ambient player @s ~ ~ ~ 0.35
                                    scoreboard players add @s customUI.PurchaseConfirm 1
                                }

                                tag @s remove temp
                                tag @s remove clickEvent
                                tag @s remove customUniversal.PurchaseHandler
                            }
                        }
                    }

                    function remove_tags {
                        scoreboard players reset @s customUI.SkinLastPatchID
                        scoreboard players reset @s customUI.SkinPatchID

                        execute if entity @s[tag=customUniversal.AbilityContext] run {
                            tag @s remove CustomAbility.User
                            tag @s remove customAbility.Gojo
                            tag @s remove customAbility.TheWorld
                        }

                        execute if entity @s[tag=customGojo.SkinContext] run {
                            tag @s remove customGojo.SkinDefault
                            tag @s remove customGojo.SkinWushu
                            tag @s remove customGojo.SkinBeach
                        }

                        execute if entity @s[tag=customTheWorld.SkinContext] run {
                            tag @s remove customTheWorld.SkinDefault
                            tag @s remove customTheWorld.SkinTW2
                            tag @s remove customTheWorld.SkinVTW
                            tag @s remove customTheWorld.SkinRTW
                            tag @s remove customTheWorld.SkinSTW
                        }
                        $tag @s remove $(context)
                    }
                }

                dir inventory {
                    function check {
                        $execute store result score .Item$(number)_Temp1 customUI.PurchaseItemCount run execute if items entity @s hotbar.* $(type)
                        $execute store result score .Item$(number)_Temp2 customUI.PurchaseItemCount run execute if items entity @s inventory.* $(type)

                        $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount = .Item$(number)_Temp1 customUI.PurchaseItemCount
                        $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount += .Item$(number)_Temp2 customUI.PurchaseItemCount
                        $scoreboard players reset .Item$(number)_Temp1 customUI.PurchaseItemCount
                        $scoreboard players reset .Item$(number)_Temp2 customUI.PurchaseItemCount

                        $execute store result storage minecraft:ui custom.selection.$(storage).$(product)_item$(number)count int 1 run scoreboard players get .Item$(number)_Count customUI.PurchaseItemCount

                        $tag @s add customUniversal.RequiredItem$(number)

                        $execute if entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{purchase:{type$(number):"$(type)",count$(number):$(required)}}}
                        $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"red",number:$(number),name:"$(name)",product:"$(product)"}}}}

                        $execute if score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. unless entity @s[tag=clickEvent] run block { {storage:"$(storage)",number:$(number),product:"$(product)"}
                            $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"green"}}}}
                        }

                        $execute unless score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. if entity @s[tag=clickEvent] run block { with storage minecraft:ui custom.selection.$(storage)
                            $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Insufficient","color":"red"},{"text":" resources to purchase ","color":"gray"},{"text":"$(name)","color":"yellow"}]
                            scoreboard players reset @s customUI.PurchaseConfirm
                            tag @s remove customUniversal.PurchaseHandler
                        }
                    }
                }

                dir advancements {
                    function check {
                        $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_advancement_color:"red",name:"$(name)"}}}}
                        $execute if entity @s[advancements={$(advancement)=false}] run block { {storage:"$(storage)"}
                            tag @s remove customUniversal.AdvancementCheck

                            $execute if entity @s[tag=customUniversal.PurchaseHandler] run block { with storage minecraft:ui custom.selection.$(storage)
                                $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Insufficient","color":"red"},{"text":" resources to purchase ","color":"gray"},{"text":"$(name)","color":"yellow"}]
                                scoreboard players reset @s customUI.PurchaseConfirm
                                tag @s remove customUniversal.PurchaseHandler
                            }
                        }
                    }
                }

                dir gojo {
                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Unique secrets that you can find specific to this Ability."},{"color":"gray","italic":false,"text":"They can range anywhere from a simple change, to an"},{"color":"gray","italic":false,"text":"entirely different move. Hints are provided below."}," ",{"color":"gold","italic":false,"text":"Interaction (1)"},[{"color":"gray","italic":false,"text":"You need to be "},{"color":"blue","italic":true,"text":"Stronger"}],[{"color":"gray","italic":false,"text":"Discovered: "},{"color":"red","italic":false,"text":"No"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","text":"Passive"},"minecraft:lore":[[{"color":"light_purple","italic":false,"text":"Infinity "},{"color":"gray","italic":false,"text":"activates after taking damage "},{"color":"gold","italic":false,"text":"5 "}],[{"color":"gold","italic":false,"text":"times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming damage."}]," ",[{"color":"yellow","italic":false,"text":"Speed II "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":"Night Vision V"}]," ",{"color":"aqua","italic":false,"text":"Awakening"},[{"color":"gray","italic":false,"text":"Upon using "},{"color":"light_purple","italic":false,"text":"Reverse Cursed Technique, "},{"color":"gray","italic":false,"text":"you've"}],[{"color":"gray","italic":false,"text":"got a "},{"color":"gold","italic":false,"text":"10% chance "},{"color":"gray","italic":false,"text":"to achieve the "},{"color":"yellow","italic":false,"text":"Honored"}],[{"color":"gray","italic":false,"text":"status with a different set of moves for "},{"color":"dark_aqua","text":"3m 48s."}]," ",[{"color":"light_purple","italic":false,"text":"Infinity --> Infinity+ "},{"color":"gray","italic":false,"text":"activates after taking"}],[{"color":"gray","italic":false,"text":"damage "},{"color":"gold","italic":false,"text":"4 times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming"}],{"color":"gray","italic":false,"text":"damage."}," ",[{"color":"yellow","italic":false,"text":"Speed III "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":" Night Vision V"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"}," ",{"color":"gold","italic":false,"text":"Ability Cost"},[{"color":"$(ability_item1color)","italic":false,"text":"$(ability_item1count)/1 Blindfolds(s) "},{"color":"gray","italic":false,"text":"can be rarely found in "}],{"color":"gray","italic":false,"text":"Ancient Cities"},[{"color":"$(ability_item2color)","italic":false,"text":"$(ability_item2count)/6 Honored Eyes(s) "},{"color":"gray","italic":false,"text":"rare drop from killing Spiders"}],[{"color":"$(ability_advancement_color)","italic":false,"text":"Advancements: "},{"color":"light_purple","italic":false,"text":"Minecraft: Trial(s) Edition"}]," ",[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(ownership_color)","italic":false,"text":"$(ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(equip_color)","italic":false,"text":"$(equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/gojo/ability_price",name:"Satoru Gojo",tag:"customGojo.Ownership",toggle:"customAbility.Gojo",context:"customUniversal.AbilityContext",cmd:"function custom:ui/menu/pages/selection/gojo/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/gojo/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}}]
                    }

                    function open {
                        execute at @s as @p run function custom:ui/menu/pages/selection/gojo/player

                        function custom:ui/menu/pages/selection/gojo/mask with storage minecraft:ui custom.selection.gojo
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/gojo/mask"
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/gojo/open
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/gojo/open
                    }

                    function player {
                        block {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"No"}}}}
                        }

                        execute if entity @s[tag=customAbility.Gojo] run {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"Yes"}}}}
                        }

                        execute if entity @s[tag=customGojo.Ownership] run {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"Yes"}}}}
                        }

                        function custom:ui/menu/pages/selection/gojo/ability_price
                    }

                    function ability_price {
                        data merge storage minecraft:ui {custom:{purchase:{clickID:9174910}}}
                        function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:arrow",required:1,number:1,product:"ability",storage:"gojo",name:"Satoru Gojo"}
                        function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:6,number:2,product:"ability",storage:"gojo",name:"Satoru Gojo"}

                        tag @s add customUniversal.AdvancementCheck
                        function custom:ui/menu/pages/selection/advancements/check {advancement:"minecraft:adventure/minecraft_trials_edition",product:"ability",storage:"gojo",name:"Satoru Gojo"}
                        execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{gojo:{ability_advancement_color:"green"}}}}
                        tag @s remove customUniversal.AdvancementCheck
                    }

                    dir moveset {
                        function open {
                            function custom:ui/menu/pages/selection/gojo/moveset/data

                            function custom:ui/menu/pages/selection/gojo/moveset/mask with storage minecraft:ui custom.gojo
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/gojo/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Gojo Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/reverse_cursed_technique","minecraft:item_name":{"color":"aqua","text":"#1 Reverse Cursed Technique"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"Grants the following "},{"color":"light_purple","italic":false,"text":"buffs "},{"color":"gray","italic":false,"text":"to the user"}],[{"color":"yellow","italic":false,"text":"Speed III "},{"color":"gray","italic":false,"text":"- "},{"color":"dark_aqua","italic":false,"text":"1m 30s"}],[{"color":"red","italic":false,"text":"Regeneration II "},{"color":"gray","italic":false,"text":"- "},{"color":"dark_aqua","italic":false,"text":"10s"}]," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/lapis_blue","minecraft:item_name":{"color":"aqua","text":"#2 Lapis Blue"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Gojo launches a manipulative orb of energy in the direction"},{"color":"gray","italic":false,"text":"you're currently facing. Entities caught in its path are"},[{"color":"gold","italic":false,"text":"picked up "},{"color":"gray","italic":false,"text":"and "},{"italic":false,"text":"thrown "},{"color":"gray","italic":false,"text":"in a random direction upon projectile"}],{"color":"gray","italic":false,"text":"expiration."}," ",[{"color":"red","italic":false,"text":"12 Magic Damage "},{"color":"gray","italic":false,"text":"+ "},{"italic":false,"text":"Fall Damage"}],[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/reversal_red","minecraft:item_name":{"color":"aqua","text":"#3 Reversal Red"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Gojo launches a destructive ball of energy in the direction"},[{"color":"gray","italic":false,"text":"you're currently facing. This projectile moves "},{"color":"dark_aqua","italic":false,"text":"rapidly "}],{"color":"gray","italic":false,"text":"and annihilates anything in its path!"}," ",{"color":"red","italic":false,"text":"15 Magic Damage"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/infinity_amplification","minecraft:item_name":{"color":"yellow","text":"#1 Infinity Amplification"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"Amplify the "},{"color":"light_purple","text":"Infinity "},{"color":"gray","italic":false,"text":"passive for "},{"color":"dark_aqua","italic":false,"text":"15s, "},{"color":"gray","italic":false,"text":"changing the"}],[{"color":"gray","italic":false,"text":"hit requirement for activation from "},{"color":"gold","italic":false,"text":"4 hits "},{"color":"gray","italic":false,"text":"to"}],{"color":"gold","italic":false,"text":"2 hits."}," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/hollow_purple_$(hollow_purple_icon)","minecraft:item_name":{"color":"yellow","text":"#2 Hollow Purple: $(hollow_purple_mode)"},"minecraft:lore":$(hollow_purple_lore),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/hollow_purple"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/infinite_void","minecraft:item_name":{"color":"yellow","text":"#3 Domain Expansion: Infinite Void"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"After a very short initial windup, "},{"color":"blue","italic":false,"text":"Gojo "},{"color":"gray","italic":false,"text":"unleashes his"}],[{"color":"gray","italic":false,"text":"ultimate attack. The surrounding entities within "},{"color":"gold","italic":false,"text":"25m "}],[{"color":"gray","italic":false,"text":"are "},{"color":"red","italic":false,"text":"stunned "},{"color":"gray","italic":false,"text":"for "},{"color":"dark_aqua","italic":false,"text":"10s. "}]," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE "},{"color":"gray","italic":false,"text":"during its "},{"color":"dark_red","italic":false,"text":"windup!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/gojo/moveset","minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}}]
                        }

                        function data {
                            execute unless score @s customUI.Move5Swap matches 1 run {
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_icon:"quickfire"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_mode:"Quickfire"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_lore:[[{"color":"gray","italic":false,"text":"You MUST be outside of "},{"color":"aqua","italic":false,"text":"Domain Expansion: Infinite Void."}]," ",[{"color":"gray","italic":false,"text":"This move is "},{"color":"light_purple","italic":false,"text":"launched in the direction you're looking!"}],{"color":"gray","italic":false,"text":"After the initial windup, launch a combination of "},[{"color":"blue","italic":false,"text":"Lapis Blue "},{"color":"gray","italic":false,"text":"and "},{"color":"red","italic":false,"text":"Reversal Red "},{"color":"gray","italic":false,"text":"that annihilates anything"}],[{"color":"gray","italic":false,"text":"in its path. This is, "},{"color":"dark_purple","italic":false,"text":"Hollow... Purple."}]," ",{"color":"red","italic":false,"text":"27 Magic Damage"},[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]," ",[{"color":"gray","italic":false,"text":"Click to view the "},{"color":"blue","italic":false,"text":"secondary use "},{"color":"gray","italic":false,"text":"for this move!"}]]}}}
