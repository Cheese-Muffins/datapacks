                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_lore:[[{"color":"gray","italic":false,"text":"You MUST be using "},{"color":"aqua","italic":false,"text":"Domain Expansion: Infinite Void."}]," ",[{"color":"gray","italic":false,"text":"This move is "},{"color":"light_purple","italic":false,"text":"triggered by looking "},{"color":"gray","italic":false,"text":"at a "},{"color":"light_purple","italic":false,"text":"victim "},{"color":"gray","italic":false,"text":"that"}],[{"color":"gray","italic":false,"text":"is stunned by "},{"color":"aqua","italic":false,"text":"Infinite Void. "},{"color":"gray","italic":false,"text":"They are then hit by"}],[{"color":"gray","italic":false,"text":"an "},{"color":"gold","italic":false,"text":"unavoidable cutscene "},{"color":"gray","italic":false,"text":"that obliterates"}],[{"color":"gray","italic":false,"text":"anything caught in its wake. This is, "},{"color":"dark_purple","italic":false,"text":"Hollow... Purple."}]," ",{"color":"red","italic":false,"text":"42 Magic Damage"},[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]," ",[{"color":"gray","italic":false,"text":"Click to view the "},{"color":"blue","italic":false,"text":"primary use "},{"color":"gray","italic":false,"text":"for this move!"}]]}}}
