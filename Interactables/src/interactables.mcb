advancement use {
    "criteria": {
      "requirement": {
        "trigger": "minecraft:using_item",
        "conditions": {
          "item": {
            "components": {
              "minecraft:food": {
                "nutrition": 0,
                "saturation": 0,
                "can_always_eat": true
              },
              "minecraft:consumable": {
                "consume_seconds": 8888888
              }
            }
          }
        }
      }
    },
    "rewards": {
      "function": "interactables:use"
    }
}

function on_load minecraft:load{
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy
    scoreboard objectives add interactablesUniversal.Delay dummy
    scoreboard objectives add interactablesUniversal.RecieveItemID dummy
    scoreboard objectives add interactablesUniversal.GiveItemID dummy

    scoreboard objectives add interactablesTommyGun.Statistics dummy
    scoreboard objectives add interactablesMicrophone.Statistics dummy
    scoreboard players set #const.360 interactablesMicrophone.Statistics 360
}

function tick {
    execute as @a[scores={interactablesUniversal.Delay=1..}] run scoreboard players remove @s interactablesUniversal.Delay 1

}

function use {
    execute unless score @s interactablesUniversal.Delay matches 1.. run {
      execute if entity @s[nbt={SelectedItem:{components:{"minecraft:item_model":"minecraft:interactables/tommy_gun"}}}] run function interactables:tommy_gun/main
      execute if entity @s[nbt={SelectedItem:{components:{"minecraft:item_model":"minecraft:interactables/microphone"}}}] run function interactables:microphone/main
      execute if entity @s[nbt={SelectedItem:{components:{"minecraft:item_model":"minecraft:interactables/propulsion"}}}] run function interactables:propulsion/main
    }
    advancement revoke @s only interactables:use
}

dir rig {
  function spawn {
    # function interactables:rig/spawn {rig:"hatsune_miku",animation:'beam',objective:"interactablesMicrophone.Statistics"}
    $execute at @s rotated ~ 0 run function animated_java:$(rig)/summon {args:{animation:'$(animation)', start_animation: true}}
    $scoreboard players add .global $(objective) 1
    $scoreboard players operation @s $(objective) = .global $(objective)
    $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root] run scoreboard players operation @s $(objective) = .global $(objective)
    $execute as @n[type=minecraft:item_display,tag=aj.$(rig).locator.camera] run scoreboard players operation @s $(objective) = .global $(objective)
  }

  function spectate {
    # function interactables:rig/spectate {objective:"interactablesMicrophone.Statistics",spectator:"interactablesMicrophone.Spectator",camera:"aj.hatsune_miku.locator.camera"}
    $execute store result storage minecraft:interactables camera.id int 1 run scoreboard players get @s $(objective)
    $data merge storage minecraft:interactables {camera:{spectator:"$(spectator)",camera:"$(camera)",objective:"$(objective)"}}
    block { with storage minecraft:interactables camera
      $execute as @a[tag=$(spectator),scores={$(objective)=$(id)}] run spectate @n[type=minecraft:item_display,tag=$(camera),scores={$(objective)=$(id)}]
    }
  }
  
  function movement {
    # function interactables:rig/movement {objective:"interactablesMicrophone.Statistics",user:"interactablesMicrophone.Spectator",rig:"aj.hatsune_miku.root"}
    $execute store result storage minecraft:interactables rig.id int 1 run scoreboard players get @s $(objective)
    $data merge storage minecraft:interactables {rig:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}
    block { with storage minecraft:interactables rig
      $execute as @a[tag=$(user),scores={$(objective)=$(id)}] at @s run tp @n[type=item_display,tag=$(rig),scores={$(objective)=$(id)}] ~ ~ ~ ~ 0
    }
  }

  function run_command {
    # function interactables:rig/run_command {objective:"interactablesMicrophone.Statistics",what:"tag=interactablesMicrophone.Spectator",output:"say a"}
    $execute store result storage minecraft:interactables rig.id int 1 run scoreboard players get @s $(objective)
    $data merge storage minecraft:interactables {rig:{what:"$(what)",objective:"$(objective)",output:"$(output)"}}
    block { with storage minecraft:interactables rig
      $execute as @a[$(what),scores={$(objective)=$(id)}] at @s run $(output)
    }
  }

  function reset {
    # function interactables:rig/reset {who:"interactablesMicrophone.Spectator",objective:"interactablesMicrophone.Statistics",rig:"hatsune_miku",reset_file:"interactables/hatsune_miku/reset with storage minecraft:interactables rig"}
    $execute store result storage minecraft:interactables rig.id int 1 run scoreboard players get @s $(objective)
    $data merge storage minecraft:interactables {rig:{who:"$(who)",objective:"$(objective)",rig:"$(rig)",reset_file:"$(reset_file)"}}
    block { with storage minecraft:interactables rig
      $execute as @a[$(who),scores={$(objective)=$(id)}] at @s run $(reset_file)
      $function animated_java:$(rig)/remove/this
    }
  }
}

dir recieve_item {
    function create_scenario {
        tag @s add interactablesUniversal.RecieveItemSpectator
        $execute at @s rotated ~ 0 run function animated_java:recieve_item/summon {args:{animation:'$(animation)', start_animation: true}}
        $execute as @n[type=minecraft:item_display,tag=aj.recieve_item.item_display.item] run data merge entity @s {item:{components:{"minecraft:item_model":"$(item)"}}}
        $execute as @n[type=minecraft:item_display,tag=aj.recieve_item.item_display.item] run data merge entity @s {item_display:"$(perspective)"}
        scoreboard players add .global interactablesUniversal.RecieveItemID 1
        scoreboard players operation @s interactablesUniversal.RecieveItemID = .global interactablesUniversal.RecieveItemID
        execute as @n[type=minecraft:item_display,tag=aj.recieve_item.root] run scoreboard players operation @s interactablesUniversal.RecieveItemID = .global interactablesUniversal.RecieveItemID
        execute as @n[type=minecraft:item_display,tag=aj.recieve_item.locator.camera] run scoreboard players operation @s interactablesUniversal.RecieveItemID = .global interactablesUniversal.RecieveItemID
        gamemode spectator @s
    }

    function chest_glint_vfx {
      data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
      data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
      execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"recieve_item",animation:'chest_glint'}
    }

    function reset {
      gamemode survival @s
      $tp @s @n[type=minecraft:item_display,tag=aj.recieve_item.root,scores={interactablesUniversal.RecieveItemID=$(id)}]
      tag @s remove interactablesUniversal.RecieveItemSpectator
    }

    function what {
      execute if score @s interactablesUniversal.GiveItemID matches 1 run function custom:abilities/dice/roll/20/tommy_gun/inform
      execute if score @s interactablesUniversal.GiveItemID matches 2 run function custom:abilities/dice/roll/20/microphone/inform
      execute if score @s interactablesUniversal.GiveItemID matches 3 run function custom:abilities/dice/roll/12_15/propulsion/inform
      scoreboard players reset @s interactablesUniversal.GiveItemID
    }
}

dir tommy_gun {
  function main {
    scoreboard players set @s interactablesUniversal.Delay 2

    item replace block 0 -63 0 container.0 from entity @s weapon
    execute store result score .BulletCount interactablesTommyGun.Statistics run data get block 0 -63 0 Items[0].components."minecraft:custom_data".bullets
    execute store result score .DamageValue interactablesTommyGun.Statistics run data get block 0 -63 0 Items[0].components."minecraft:damage"
    scoreboard players remove .BulletCount interactablesTommyGun.Statistics 1
    scoreboard players add .DamageValue interactablesTommyGun.Statistics 1
    execute store result storage minecraft:interactables tommy_gun.bullet_count int 1 run scoreboard players get .BulletCount interactablesTommyGun.Statistics
    execute store result storage minecraft:interactables tommy_gun.damage_value int 1 run scoreboard players get .DamageValue interactablesTommyGun.Statistics
        
    block { with storage minecraft:interactables tommy_gun
      $data modify block 0 -63 0 Items[0].components."minecraft:lore"[3].text set value "$(bullet_count)"
      $data modify block 0 -63 0 Items[0].components."minecraft:custom_data".bullets set value $(bullet_count)
      $data modify block 0 -63 0 Items[0].components."minecraft:damage" set value $(damage_value)
    }

    execute if score .BulletCount interactablesTommyGun.Statistics matches 1.. run {
      item replace entity @s weapon from block 0 -63 0 container.0
    } else run {
      item replace entity @s weapon with air
      playsound minecraft:entity.item.break player @a ~ ~ ~ 0.5
    }
    item replace block 0 -63 0 container.0 with minecraft:air

    function interactables:tommy_gun/logic/start
  }

  dir logic {
    function start {
      scoreboard players reset .distance interactablesTommyGun.Statistics
      tag @s add temp
      playsound minecraft:tommy_gun.fire player @a ~ ~ ~ 5
      execute anchored eyes positioned ^ ^ ^ run function interactables:tommy_gun/logic/fire
      tag @s remove temp
    }

    function fire {
      execute as @a[tag=!temp,distance=..3] run tag @s add interactablesTommyGun.NearBullet
      execute as @e[tag=!temp,type=!#custom:not_mob,dx=0] positioned ~-0.99 ~-0.99 ~-0.99 if entity @s[dx=0] positioned ~0.99 ~0.99 ~0.99 run {
        scoreboard players set .distance interactablesTommyGun.Statistics 500
        damage @s 8 interactables:tommy_gun by @p[tag=temp]
        particle block{block_state:"minecraft:redstone_block"} ~ ~ ~ 0 0 0 1 25 force @a
        tag @s remove interactablesTommyGun.NearBullet
      }
      execute as @a[tag=!temp,tag=interactablesTommyGun.NearBullet,distance=3..] at @s run {
        tag @s remove interactablesTommyGun.NearBullet
        playsound minecraft:tommy_gun.miss player @s ~ ~ ~ 0.5
      }
      execute positioned ^ ^ ^0.2 unless block ^ ^ ^ #custom:raycast_pass run {
        function custom:universal/fetch_block
        block { with storage minecraft:custom universal.fetch_block
          $particle block{block_state:"$(id)"} ^ ^ ^-0.2 0 0 0 1 10 normal
          playsound minecraft:block.pointed_dripstone.hit player @a ~ ~ ~ 0.5
        }
      }
      scoreboard players add .distance interactablesTommyGun.Statistics 1
      particle minecraft:smoke ~ ~ ~ 0 0 0 0 1 force @a[tag=!temp]
      execute if score .distance interactablesTommyGun.Statistics matches ..500 positioned ^ ^ ^.2 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function interactables:tommy_gun/logic/fire
    }
  }
}

dir microphone {
  function main {
    scoreboard players set @s interactablesUniversal.Delay 80

    item replace block 0 -63 0 container.0 from entity @s weapon
    execute store result score .BeamCount interactablesMicrophone.Statistics run data get block 0 -63 0 Items[0].components."minecraft:custom_data".beams
    execute store result score .DamageValue interactablesMicrophone.Statistics run data get block 0 -63 0 Items[0].components."minecraft:damage"
    scoreboard players remove .BeamCount interactablesMicrophone.Statistics 1
    scoreboard players add .DamageValue interactablesMicrophone.Statistics 1
    execute store result storage minecraft:interactables microphone.beam_count int 1 run scoreboard players get .BeamCount interactablesMicrophone.Statistics
    execute store result storage minecraft:interactables microphone.damage_value int 1 run scoreboard players get .DamageValue interactablesMicrophone.Statistics
        
    block { with storage minecraft:interactables microphone
      $data modify block 0 -63 0 Items[0].components."minecraft:lore"[3].text set value "$(beam_count)"
      $data modify block 0 -63 0 Items[0].components."minecraft:custom_data".beams set value $(beam_count)
      $data modify block 0 -63 0 Items[0].components."minecraft:damage" set value $(damage_value)
    }

    execute if score .BeamCount interactablesMicrophone.Statistics matches 1.. run {
      item replace entity @s weapon from block 0 -63 0 container.0
    } else run {
      item replace entity @s weapon with air
      playsound minecraft:entity.item.break player @a ~ ~ ~ 0.5
    }
    item replace block 0 -63 0 container.0 with minecraft:air

    function interactables:microphone/logic/start
  }

  dir logic {
    function start {
      function interactables:rig/spawn {rig:"hatsune_miku",animation:'beam',objective:"interactablesMicrophone.Statistics"}
      tag @s add interactablesMicrophone.Spectator
      gamemode spectator @s
    }

    function aim_mode {
      gamemode survival @s
      $tp @s @n[type=minecraft:item_display,tag=aj.hatsune_miku.root,scores={interactablesMicrophone.Statistics=$(id)}]
      effect give @s minecraft:invisibility infinite 255 true
      effect give @s minecraft:resistance infinite 255 true
      attribute @s minecraft:movement_speed base set 0
      attribute @s minecraft:jump_strength base set 0

      function interactables:microphone/logic/movement
    }

    function finish {
      gamemode spectator @s
    }

    function movement {
      scoreboard players set .AngleDiff interactablesMicrophone.Statistics 0
      execute store result storage minecraft:interactables rig.id int 1 run scoreboard players get @s interactablesMicrophone.Statistics
      execute store result score .MikuRotation interactablesMicrophone.Statistics run data get entity @s Rotation[0]

      block { with storage minecraft:interactables rig
        $execute as @a[tag=interactablesMicrophone.Spectator,scores={interactablesMicrophone.Statistics=$(id)}] at @s run block { {id:$(id)}
          $tp @n[type=item_display,tag=aj.hatsune_miku.root,scores={interactablesMicrophone.Statistics=$(id)}] ~ ~ ~
          execute store result score .PlayerRotation interactablesMicrophone.Statistics run data get entity @s Rotation[0]
        }
      }

      # Normalize rotation difference (Miku - Player + 360) % 360
      scoreboard players operation .AngleDiff interactablesMicrophone.Statistics = .MikuRotation interactablesMicrophone.Statistics
      scoreboard players operation .AngleDiff interactablesMicrophone.Statistics -= .PlayerRotation interactablesMicrophone.Statistics
      scoreboard players add .AngleDiff interactablesMicrophone.Statistics 360
      scoreboard players operation .AngleDiff interactablesMicrophone.Statistics %= #const.360 interactablesMicrophone.Statistics

      # Bring difference into range [-180, 180]
      execute if score .AngleDiff interactablesMicrophone.Statistics matches 181.. run scoreboard players remove .AngleDiff interactablesMicrophone.Statistics 360

      # Now: .AngleDiff < 0 => turn left, > 0 => turn right
      execute if score .AngleDiff interactablesMicrophone.Statistics matches 2.. run {
          execute unless entity @s[tag=interactablesMicrophone.SpeedUp] run scoreboard players remove .MikuRotation interactablesMicrophone.Statistics 1
          execute if entity @s[tag=interactablesMicrophone.SpeedUp] run scoreboard players remove .MikuRotation interactablesMicrophone.Statistics 3
          execute store result entity @s Rotation[0] float 1 run scoreboard players get .MikuRotation interactablesMicrophone.Statistics
      }
      execute if score .AngleDiff interactablesMicrophone.Statistics matches ..-2 run {
          execute unless entity @s[tag=interactablesMicrophone.SpeedUp] run scoreboard players add .MikuRotation interactablesMicrophone.Statistics 1
          execute if entity @s[tag=interactablesMicrophone.SpeedUp] run scoreboard players add .MikuRotation interactablesMicrophone.Statistics 3
          execute store result entity @s Rotation[0] float 1 run scoreboard players get .MikuRotation interactablesMicrophone.Statistics
      }
    }


    function reset {
      gamemode survival @s
      effect clear @s invisibility
      attribute @s minecraft:movement_speed base reset
      attribute @s minecraft:jump_strength base reset
      $tp @s @n[type=minecraft:item_display,tag=aj.hatsune_miku.root,scores={interactablesMicrophone.Statistics=$(id)}]
      tag @s remove interactablesMicrophone.Spectator
    }

    dir hitbox {
      function start {
        execute rotated ~ 0 run function interactables:microphone/logic/hitbox/recursive
        scoreboard players reset .BeamDistance interactablesMicrophone.Statistics
        execute as @e[type=!#custom:not_mob,tag=interactablesMicrophone.BeamHit] run tag @s remove interactablesMicrophone.BeamHit
      }
      function recursive {
        execute as @e[type=!#custom:not_mob,tag=!interactablesMicrophone.BeamHit,tag=!interactablesMicrophone.Spectator,distance=..4] run {
          tag @s add interactablesMicrophone.BeamHit
          damage @s 3 interactables:microphone by @p[tag=interactablesMicrophone.Spectator]
        }
        execute positioned ^ ^ ^3 unless score .BeamDistance interactablesMicrophone.Statistics matches 10.. run {
          particle dust{color:[0.031,1.000,1.000],scale:1} ~ ~ ~ 2 2 2 1 10 force @a
          scoreboard players add .BeamDistance interactablesMicrophone.Statistics 1
          function interactables:microphone/logic/hitbox/recursive
        }
      }
    }

    dir vfx {
      function twinkle {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:3,speed:0,count:10,duration:0,branch:"hatsune_miku",animation:'twinkle',extra:"random value 1..2"}
      }

      function countdown_1 {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:2,speed:0,count:1,duration:0,branch:"hatsune_miku",animation:'countdown1',extra:"random value 1..2"}
      }

      function countdown_2 {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:2,speed:0,count:1,duration:0,branch:"hatsune_miku",animation:'countdown2',extra:"random value 1..2"}
      }

      function countdown_3 {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:2,speed:0,count:1,duration:0,branch:"hatsune_miku",animation:'countdown3',extra:"random value 1..2"}
      }

      function backdrop {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"hatsune_miku",animation:'backdrop',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.hatsune_miku.locator.star]"}
      }

      function beam {
        data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
        data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
        execute rotated ~180 0 positioned ~ ~1.5 ~ run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"hatsune_miku",animation:'beam_fire',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.hatsune_miku.locator.beam]"}
      }
    }
  }
}

dir propulsion {
  function main {
    say a
  }
}