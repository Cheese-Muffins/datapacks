                            function custom:ui/menu/pages/selection/toji/passive {open:"{custom:{selection:{toji:{passive",end:"}}}}"}
                        }

                        execute if entity @s[tag=customAbility.Toji] run {
                            data merge storage minecraft:ui {custom:{selection:{toji:{equip_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{toji:{equip_state:"Yes"}}}}
                        }

                        execute if entity @s[tag=customToji.Ownership] run {
                            data merge storage minecraft:ui {custom:{selection:{toji:{ownership_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{toji:{ownership_state:"Yes"}}}}
