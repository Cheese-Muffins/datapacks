                    }
                }

                function open {
                    execute unless score @s customUI.SelectionPage matches 1.. run scoreboard players set @s customUI.SelectionPage 1
                    execute if score @s customUI.SelectionPage matches 1 run function custom:ui/menu/pages/selection/mask/1
                    execute if score @s customUI.SelectionPage matches 2 run function custom:ui/menu/pages/selection/mask/2
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/mask"
                }

                function flip {
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/selection/open
                }

                function same {
                    execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/selection/open
                }

                dir arrows {
                    function previous {
                        scoreboard players remove @s customUI.SelectionPage 1
                        execute at @s as @p run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/open
                    }

                    function next {
                        scoreboard players add @s customUI.SelectionPage 1
                        execute at @s as @p run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/open
                    }
                }

                dir purchase {
                    function main {
                        execute at @s as @p run block { with storage minecraft:ui custom.purchase
                            # ability owned / bypassed
                            $execute if entity @s[tag=$(tag)] unless entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/selection/purchase/owned/main with storage minecraft:ui custom.purchase 
                            execute if entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/selection/purchase/owned/main with storage minecraft:ui custom.purchase

                            # ask, confirm, and unlock ability
                            $execute unless entity @s[tag=$(tag)] unless entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/selection/purchase/unowned/main with storage minecraft:ui custom.purchase
                        }
                    }

                    dir owned {
                        function main {
                            $execute unless entity @s[tag=$(toggle)] run function custom:ui/menu/pages/selection/purchase/owned/equip with storage minecraft:ui custom.purchase
                            $execute if entity @s[tag=$(toggle)] unless entity @s[tag=temp] run function custom:ui/menu/pages/selection/purchase/owned/disable with storage minecraft:ui custom.purchase
                            tag @s remove temp
                        }

                        function equip {
                            $tag @s add $(context)

                            data merge storage minecraft:ui {custom:{purchase:{state:"add"}}}
                            function custom:ui/menu/pages/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                            execute unless entity @s[tag=customUniversal.SkinContext] run block { with storage minecraft:ui custom.purchase
                                tag @s add customAbility.User
                                $tag @s add $(toggle)
                            }
                            scoreboard players set @s customUniversal.ActiveHotbar 1

                            tag @s add temp
                            playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.25
                        }
                        
                        function disable {
                            $tag @s add $(context)

                            data merge storage minecraft:ui {custom:{purchase:{state:"remove"}}}
                            function custom:ui/menu/pages/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.25
                        }
                    }

                    dir unowned {
                        function main {
                            tag @s add clickEvent
                            tag @s add customUniversal.PurchaseHandler
                            $$(price)

                            execute unless score @s customUI.SkinPatchID matches 1.. run scoreboard players set @s customUI.SkinPatchID 0 
                            block { with storage minecraft:ui custom.purchase
                                scoreboard players operation @s customUI.SkinLastPatchID = @s customUI.SkinPatchID
                                $scoreboard players set @s customUI.SkinPatchID $(clickID)
                            }

                            execute unless score @s customUI.SkinLastPatchID = @s customUI.SkinPatchID run scoreboard players reset @s customUI.PurchaseConfirm

                            # confirm
                            execute if entity @s[tag=customUniversal.PurchaseHandler] if score @s customUI.PurchaseConfirm matches 1.. run function custom:ui/menu/pages/selection/purchase/unowned/confirm with storage minecraft:ui custom.purchase

                            # ask
                            execute if entity @s[tag=customUniversal.PurchaseHandler] unless score @s customUI.PurchaseConfirm matches 1.. unless entity @s[tag=temp] run function custom:ui/menu/pages/selection/purchase/unowned/ask with storage minecraft:ui custom.purchase

                            tag @s remove temp
                            tag @s remove clickEvent
                            tag @s remove customUniversal.PurchaseHandler
                        }

                        function confirm {
                            $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Congratulations!","color":"aqua"},{"text":" You've just unlocked ","color":"gray"},{"text":"$(name)!","color":"yellow"}]
                            playsound minecraft:entity.villager.yes player @s ~ ~ ~ 0.35
                            playsound minecraft:entity.firework_rocket.blast_far player @s ~ ~ ~ 0.35
                            scoreboard players reset @s customUI.PurchaseConfirm
                            scoreboard players reset @s customUI.SkinLastPatchID
                            scoreboard players reset @s customUI.SkinPatchID
                            tag @s add temp

                            REPEAT (1,5) as i {
                                execute if entity @s[tag=customUniversal.RequiredItem<%i%>] run block { with storage minecraft:ui custom.purchase
                                    $clear @s $(type<%i%>) $(count<%i%>)
                                    $data remove storage minecraft:ui custom.purchase.$(type<%i%>)
                                    $data remove storage minecraft:ui custom.purchase.$(count<%i%>)
                                }
                            }
                            $tag @s add $(tag)
                        }

                        function ask {
                            $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're ","color":"gray"},{"text":"about ","color":"green"},{"text":"to purchase ","color":"gray"},{"text":"$(name)...","color":"yellow"},{"text":" are you ","color":"gray"},{"text":"sure..?","color":"light_purple"}]
                            playsound minecraft:entity.villager.ambient player @s ~ ~ ~ 0.35
                            scoreboard players add @s customUI.PurchaseConfirm 1
                            tag @s add customUI.TempClick
                        }
                    }

                    function fail {
                        $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Insufficient","color":"red"},{"text":" resources to purchase ","color":"gray"},{"text":"$(name)","color":"yellow"}]
                        playsound minecraft:block.anvil.land player @s ~ ~ ~ 0.25
                        scoreboard players reset @s customUI.PurchaseConfirm
                        tag @s remove customUniversal.PurchaseHandler
                    }

                    function remove_tags {
                        scoreboard players reset @s customUI.SkinLastPatchID
                        scoreboard players reset @s customUI.SkinPatchID

                        execute if entity @s[tag=customUniversal.AbilityContext] run {
                            execute if score @s customUniversal.Toggle matches 1 run function custom:universal/toggle/main
                            tag @s remove customAbility.User
                            tag @s remove customAbility.Gojo
                            tag @s remove customAbility.Toji
                            tag @s remove customAbility.TheWorld
                            tag @s remove customAbility.Billy
                        }

                        execute if entity @s[tag=customToji.SkinContext] run block { with storage minecraft:ui custom.purchase
                            tag @s remove customToji.SkinDefault
                            tag @s remove customToji.SkinWounded

                            $tag @s $(state) $(toggle)
                            execute if entity @s[tag=!customToji.SkinDefault,tag=!customToji.SkinWounded] run tag @s add customToji.SkinDefault
                        }
                        $tag @s remove $(context)
                    }

                    dir check {
                        function items {
                            $execute store result score .Item$(number)_Temp1 customUI.PurchaseItemCount run execute if items entity @s hotbar.* $(type)
                            $execute store result score .Item$(number)_Temp2 customUI.PurchaseItemCount run execute if items entity @s inventory.* $(type)

                            $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount = .Item$(number)_Temp1 customUI.PurchaseItemCount
                            $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount += .Item$(number)_Temp2 customUI.PurchaseItemCount
                            $scoreboard players reset .Item$(number)_Temp1 customUI.PurchaseItemCount
                            $scoreboard players reset .Item$(number)_Temp2 customUI.PurchaseItemCount

                            $execute store result storage minecraft:ui custom.selection.$(storage).$(product)_item$(number)count int 1 run scoreboard players get .Item$(number)_Count customUI.PurchaseItemCount

                            $tag @s add customUniversal.RequiredItem$(number)

                            $execute if entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{purchase:{type$(number):"$(type)",count$(number):$(required)}}}
                            $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"red",number:$(number),name:"$(name)",product:"$(product)"}}}}

                            $execute if score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. unless entity @s[tag=clickEvent] run block { {storage:"$(storage)",number:$(number),product:"$(product)"}
                                $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"green"}}}}
                            }

                            $execute unless score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. if entity @s[tag=clickEvent,tag=customUniversal.PurchaseHandler] run function custom:ui/menu/pages/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                        }

                        function advancements {
                            $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_advancement_color:"red",name:"$(name)"}}}}
                            $execute if entity @s[advancements={$(advancement)=false}] run block { {storage:"$(storage)"}
                                tag @s remove customUniversal.AdvancementCheck

                                $execute if entity @s[tag=customUniversal.PurchaseHandler] run function custom:ui/menu/pages/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                            }
                        }

                        function username {
                            $data merge storage minecraft:ui {custom:{selection:{$(storage):{ability:"$(ability)",username_required:"$(username)",storage:"$(storage)",ability_usernamecolor:"red"}}}}

                            loot insert 0 -63 0 loot custom:player_head
                            $data modify storage minecraft:ui custom.selection.$(storage).username_current set string block 0 -63 0 Items[0].components."minecraft:profile".name
                            item replace block 0 -63 0 container.0 with minecraft:air
                            $block { with storage minecraft:ui custom.selection.$(storage)
                                $execute if entity @s[tag=customSettings.DebugLog] run block { with storage minecraft:ui custom.selection.$(storage)
                                    $tellraw @s "required username: $(username_required)"
                                    $tellraw @s "provided username: $(username_current)"
                                }
                                
                                $execute store success score @s customUI.PurchaseUsername run data modify storage minecraft:ui custom.selection.$(storage).username_current set from storage minecraft:ui custom.selection.$(storage).username_required
                                $execute if score @s customUI.PurchaseUsername matches 0 run data merge storage minecraft:ui {custom:{selection:{$(storage):{ability_usernamecolor:"green"}}}}
                                $execute if entity @s[tag=customUniversal.PurchaseHandler] if score @s customUI.PurchaseUsername matches 1 run function custom:ui/menu/pages/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                            }
                        }
                    }
                }

                dir gojo {
                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Unique secrets that you can find specific to this Ability."},{"color":"gray","italic":false,"text":"They can range anywhere from a simple change, to an"},{"color":"gray","italic":false,"text":"entirely different move. Hints are provided below."}," ",{"color":"gold","italic":false,"text":"Interaction (1)"},[{"color":"gray","italic":false,"text":"You need to be "},{"color":"blue","italic":true,"text":"Stronger"}],[{"color":"gray","italic":false,"text":"Discovered: "},{"color":"red","italic":false,"text":"No"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","text":"Passive"},"minecraft:lore":[[{"color":"light_purple","italic":false,"text":"Infinity "},{"color":"gray","italic":false,"text":"activates after taking damage "},{"color":"gold","italic":false,"text":"5 "}],[{"color":"gold","italic":false,"text":"times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming damage."}]," ",[{"color":"yellow","italic":false,"text":"Speed II "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":"Night Vision V"}]," ",{"color":"aqua","italic":false,"text":"Awakening"},[{"color":"gray","italic":false,"text":"Upon using "},{"color":"light_purple","italic":false,"text":"Reverse Cursed Technique, "},{"color":"gray","italic":false,"text":"you've"}],[{"color":"gray","italic":false,"text":"got a "},{"color":"gold","italic":false,"text":"10% chance "},{"color":"gray","italic":false,"text":"to achieve the "},{"color":"yellow","italic":false,"text":"Honored"}],[{"color":"gray","italic":false,"text":"status with a different set of moves for "},{"color":"dark_aqua","text":"3m 48s."}]," ",[{"color":"light_purple","italic":false,"text":"Infinity --> Infinity+ "},{"color":"gray","italic":false,"text":"activates after taking"}],[{"color":"gray","italic":false,"text":"damage "},{"color":"gold","italic":false,"text":"4 times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming"}],{"color":"gray","italic":false,"text":"damage."}," ",[{"color":"yellow","italic":false,"text":"Speed III "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":" Night Vision V"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"}," ",{"color":"gold","italic":false,"text":"Ability Cost"},[{"color":"$(ability_item1color)","italic":false,"text":"$(ability_item1count)/1 Blindfolds(s) "},{"color":"gray","italic":false,"text":"can be rarely found in "}],{"color":"gray","italic":false,"text":"Ancient Cities"},[{"color":"$(ability_item2color)","italic":false,"text":"$(ability_item2count)/6 Honored Eyes(s) "},{"color":"gray","italic":false,"text":"rare drop from killing Spiders"}],[{"color":"$(ability_advancement_color)","italic":false,"text":"Advancements: "},{"color":"light_purple","italic":false,"text":"Minecraft: Trial(s) Edition"}]," ",[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(ownership_color)","italic":false,"text":"$(ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(equip_color)","italic":false,"text":"$(equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/gojo/ability_price",name:"Satoru Gojo",tag:"customGojo.Ownership",toggle:"customAbility.Gojo",context:"customUniversal.AbilityContext",cmd:"function custom:ui/menu/pages/selection/gojo/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/gojo/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/same"}}}}]
                    }

                    function open {
                        execute at @s as @p run function custom:ui/menu/pages/selection/gojo/player

                        function custom:ui/menu/pages/selection/gojo/mask with storage minecraft:ui custom.selection.gojo
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/gojo/mask"
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/gojo/open
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/gojo/open
                    }

                    function player {
                        block {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"No"}}}}
                        }

                        execute if entity @s[tag=customAbility.Gojo] run {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"Yes"}}}}
                        }

                        execute if entity @s[tag=customGojo.Ownership] run {
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"Yes"}}}}
                        }

                        function custom:ui/menu/pages/selection/gojo/ability_price
                    }

                    function ability_price {
                        data merge storage minecraft:ui {custom:{purchase:{clickID:9174910}}}
                        function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:arrow",required:1,number:1,product:"ability",storage:"gojo",name:"Satoru Gojo"}
                        function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:6,number:2,product:"ability",storage:"gojo",name:"Satoru Gojo"}

                        tag @s add customUniversal.AdvancementCheck
                        function custom:ui/menu/pages/selection/advancements/check {advancement:"minecraft:adventure/minecraft_trials_edition",product:"ability",storage:"gojo",name:"Satoru Gojo"}
                        execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{gojo:{ability_advancement_color:"green"}}}}
                        tag @s remove customUniversal.AdvancementCheck
                    }

                    dir moveset {
                        function open {
                            function custom:ui/menu/pages/selection/gojo/moveset/data

                            function custom:ui/menu/pages/selection/gojo/moveset/mask with storage minecraft:ui custom.gojo
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/gojo/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Gojo Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/reverse_cursed_technique","minecraft:item_name":{"color":"aqua","text":"#1 Reverse Cursed Technique"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"Grants the following "},{"color":"light_purple","italic":false,"text":"buffs "},{"color":"gray","italic":false,"text":"to the user"}],[{"color":"yellow","italic":false,"text":"Speed III "},{"color":"gray","italic":false,"text":"- "},{"color":"dark_aqua","italic":false,"text":"1m 30s"}],[{"color":"red","italic":false,"text":"Regeneration II "},{"color":"gray","italic":false,"text":"- "},{"color":"dark_aqua","italic":false,"text":"10s"}]," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/lapis_blue","minecraft:item_name":{"color":"aqua","text":"#2 Lapis Blue"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Gojo launches a manipulative orb of energy in the direction"},{"color":"gray","italic":false,"text":"you're currently facing. Entities caught in its path are"},[{"color":"gold","italic":false,"text":"picked up "},{"color":"gray","italic":false,"text":"and "},{"italic":false,"text":"thrown "},{"color":"gray","italic":false,"text":"in a random direction upon projectile"}],{"color":"gray","italic":false,"text":"expiration."}," ",[{"color":"red","italic":false,"text":"12 Magic Damage "},{"color":"gray","italic":false,"text":"+ "},{"italic":false,"text":"Fall Damage"}],[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/reversal_red","minecraft:item_name":{"color":"aqua","text":"#3 Reversal Red"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Gojo launches a destructive ball of energy in the direction"},[{"color":"gray","italic":false,"text":"you're currently facing. This projectile moves "},{"color":"dark_aqua","italic":false,"text":"rapidly "}],{"color":"gray","italic":false,"text":"and annihilates anything in its path!"}," ",{"color":"red","italic":false,"text":"15 Magic Damage"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/infinity_amplification","minecraft:item_name":{"color":"yellow","text":"#1 Infinity Amplification"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"Amplify the "},{"color":"light_purple","text":"Infinity "},{"color":"gray","italic":false,"text":"passive for "},{"color":"dark_aqua","italic":false,"text":"15s, "},{"color":"gray","italic":false,"text":"changing the"}],[{"color":"gray","italic":false,"text":"hit requirement for activation from "},{"color":"gold","italic":false,"text":"4 hits "},{"color":"gray","italic":false,"text":"to"}],{"color":"gold","italic":false,"text":"2 hits."}," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/hollow_purple_$(hollow_purple_icon)","minecraft:item_name":{"color":"yellow","text":"#2 Hollow Purple: $(hollow_purple_mode)"},"minecraft:lore":$(hollow_purple_lore),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/hollow_purple"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/infinite_void","minecraft:item_name":{"color":"yellow","text":"#3 Domain Expansion: Infinite Void"},"minecraft:lore":[[{"color":"gray","italic":false,"text":"After a very short initial windup, "},{"color":"blue","italic":false,"text":"Gojo "},{"color":"gray","italic":false,"text":"unleashes his"}],[{"color":"gray","italic":false,"text":"ultimate attack. The surrounding entities within "},{"color":"gold","italic":false,"text":"25m "}],[{"color":"gray","italic":false,"text":"are "},{"color":"red","italic":false,"text":"stunned "},{"color":"gray","italic":false,"text":"for "},{"color":"dark_aqua","italic":false,"text":"10s. "}]," ",[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE "},{"color":"gray","italic":false,"text":"during its "},{"color":"dark_red","italic":false,"text":"windup!"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/gojo/moveset","minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/moveset/same"}}}}]
                        }

                        function data {
                            execute unless score @s customUI.Move5Swap matches 1 run {
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_icon:"quickfire"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_mode:"Quickfire"}}}
