                    }

                    function open {
                        execute at @s as @p run function custom:ui/menu/pages/abilities/statistics/player
                        function custom:ui/menu/pages/abilities/statistics/mask with storage minecraft:ui custom.statistics
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/statistics/mask"
                    }

                    function flip {
                        tag @s add customUI.StatisticsPage
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/abilities/statistics/open
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/abilities/statistics/open
                    }
                }

                dir settings {
                    dir administrator {
                        function open {
                            execute at @s as @p run {
                                execute unless score @s customUI.SelectedOdds matches 1.. run scoreboard players set @s customUI.SelectedOdds 1
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"gray"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"gray"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"gray"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{debug_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{debug_color:"red"}}}}

                                execute if entity @s[tag=customSettings.NoCooldowns] run {
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"No"}}}}
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"green"}}}}
                                }

                                execute if entity @s[tag=customSettings.Immunity] run {
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"Yes"}}}}
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"green"}}}}
                                }

                                execute if entity @s[tag=customSettings.NormalOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"red"}}}}
                                execute if entity @s[tag=customSettings.RiggedOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"red"}}}}
                                execute if entity @s[tag=customSettings.DisabledOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"red"}}}}

                                execute if entity @s[tag=customSettings.Bypass] run {
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_state:"Yes"}}}}
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_color:"green"}}}}
                                }

                                execute if entity @s[tag=customSettings.DebugLog] run {
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{debug_state:"Yes"}}}}
                                    data merge storage minecraft:ui {custom:{settings:{administrator:{debug_color:"green"}}}}
                                }
                            }

                            function custom:ui/menu/pages/abilities/settings/administrator/mask with storage minecraft:ui custom.settings.administrator
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/settings/administrator/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Cooldowns"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable cooldowns on moves"}," ",[{"color":"gray","italic":false,"text":"Cooldowns: "},{"color":"$(cooldown_color)","italic":false,"text":"$(cooldown_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/cooldowns"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Immunity"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable immunity to all attacks"},{"color":"gray","italic":false,"text":"caused by Custom Abilities"}," ",[{"color":"gray","italic":false,"text":"Immunity: "},{"color":"$(immunity_color)","italic":false,"text":"$(immunity_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/immunity"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Randomization Mode"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Controls the chances of Secret Interactions,"},{"color":"gray","italic":false,"text":"Awakenings, and Dice Rolling"}," ",{"color":"gray","italic":false,"text":"Click to cycle between 3 different modes..."}," ",{"color":"$(odds_normal)","italic":false,"text":"Normal Odds"},{"color":"$(odds_rigged)","italic":false,"text":"Rigged Odds"},{"color":"$(odds_disabled)","italic":false,"text":"Disabled Odds"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/odds"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Bypass Ownership"},"minecraft:lore":[[{"text":"Click to enable/disable bypassing ownership","italic":false,"color":"gray"}],[{"text":"of all custom abilities and skins.","italic":false,"color":"gray"}],"",[{"text":"Bypass Ownership: ","italic":false,"color":"gray"},{"text":"$(bypass_state)","italic":false,"color":"$(bypass_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/bypass"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Debug Log"},"minecraft:lore":[[{"text":"Click to enable/disable the Debug log","italic":false,"color":"gray"}],[{"text":"for abilities","italic":false,"color":"gray"}],"",[{"text":"Debug Log: ","italic":false,"color":"gray"},{"text":"$(debug_state)","italic":false,"color":"$(debug_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/debug"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/administrator_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/administrator/same"}}}}]
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function cooldowns {
                            execute at @s as @p run {
                                execute unless entity @s[tag=customSettings.NoCooldowns] run {
                                    tag @s add customSettings.NoCooldowns
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=temp] run {
                                    tag @s remove customSettings.NoCooldowns
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function immunity {
                            execute at @s as @p run {
                                execute unless entity @s[tag=customSettings.Immunity] run {
                                    tag @s add customSettings.Immunity
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.Immunity] unless entity @s[tag=temp] run {
                                    tag @s remove customSettings.Immunity
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function odds {
                            execute at @s as @p run {
                                scoreboard players add @s customUI.SelectedOdds 1
                                execute if score @s customUI.SelectedOdds matches 4.. run scoreboard players set @s customUI.SelectedOdds 1
                                tag @s remove customSettings.NormalOdds
                                tag @s remove customSettings.RiggedOdds
                                tag @s remove customSettings.DisabledOdds

                                execute if score @s customUI.SelectedOdds matches 1 run {
                                    tag @s add customSettings.NormalOdds
                                }
                                execute if score @s customUI.SelectedOdds matches 2 run {
                                    tag @s add customSettings.RiggedOdds
                                }
                                execute if score @s customUI.SelectedOdds matches 3 run {
                                    tag @s add customSettings.DisabledOdds
                                }

                                playsound minecraft:entity.experience_orb.pickup player @a ~ ~ ~ 0.25
                            }
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function bypass {
                            execute at @s as @p run {
                                execute unless entity @s[tag=customSettings.Bypass] run {
                                    playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                    tag @s add customSettings.Bypass
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.Bypass] unless entity @s[tag=temp] run {
                                    playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                    tag @s remove customSettings.Bypass
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }

                        function debug {
                            execute at @s as @p run {
                                execute unless entity @s[tag=customSettings.DebugLog] run {
                                    playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                    tag @s add customSettings.DebugLog
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.DebugLog] unless entity @s[tag=temp] run {
                                    playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                    tag @s remove customSettings.DebugLog
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/administrator/open
                        }
                    }
                    
                    dir default {
                        function open {
                            execute at @s as @p run {
                                data merge storage minecraft:ui {custom:{settings:{default:{display_state:"Ability"}}}}
                                data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_state:"On"}}}}
                                data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_color:"green"}}}}

                                execute if entity @s[tag=customSettings.DisplayState] run data merge storage minecraft:ui {custom:{settings:{default:{display_state:"Player"}}}}

                                execute if entity @s[tag=customSettings.DisabledAwakeningMusic] run {
                                    data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_state:"Off"}}}}
                                    data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_color:"red"}}}}
                                }
                            }

                            function custom:ui/menu/pages/abilities/settings/default/mask with storage minecraft:ui custom.settings.default
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/settings/default/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Display State"},"minecraft:lore":[[{"text":"Click to toggle the display state of","italic":false,"color":"gray"}],[{"text":"certain abilities between the default","italic":false,"color":"gray"}],[{"text":"model and player skin","italic":false,"color":"gray"}],"",[{"text":"State: ","italic":false,"color":"gray"},{"text":"$(display_state)","italic":false,"color":"light_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/default/display"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Awakening Music"},"minecraft:lore":[[{"text":"Click to disable/enable music playing for","italic":false,"color":"gray"}],[{"text":"the duration of specific abilities.","italic":false,"color":"gray"}],"",[{"text":"Awakening Music: ","italic":false,"color":"gray"},{"text":"$(awakeningmusic_state)","italic":false,"color":"$(awakeningmusic_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/default/awakening_music"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/default_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/settings/default/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/settings/default/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/settings/default/open
                        }

                        function display {
                            execute at @s as @p run {
                                playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                                execute unless entity @s[tag=customSettings.DisplayState] run {
                                    tag @s add customSettings.DisplayState
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.DisplayState] unless entity @s[tag=temp] run {
                                    tag @s remove customSettings.DisplayState
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/default/open
                        }

                        function awakening_music {
                            execute at @s as @p run {
                                execute unless entity @s[tag=customSettings.DisabledAwakeningMusic] run {
                                    playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                    tag @s add customSettings.DisabledAwakeningMusic
                                    tag @s add temp
                                }

                                execute if entity @s[tag=customSettings.DisabledAwakeningMusic] unless entity @s[tag=temp] run {
                                    playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                    tag @s remove customSettings.DisabledAwakeningMusic
                                }

                                tag @s remove temp
                            }
                            function custom:ui/menu/pages/abilities/settings/default/open
                        }
                    }
                }

                dir selection {
                    dir mask {
                        function 1 {
                            data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/president/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"Mr. President"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I'll fulfill my promise."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/flip"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/default_skin","minecraft:item_name":{"color":"yellow","italic":false,"text":"The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I Reject My Humanity, Jojo!"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/flip"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/avatar/default_skin","minecraft:item_name":{"color":"yellow","italic":false,"text":"The Avatar"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The past can be a great teacher."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/flip"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/billy/default_skin","minecraft:item_name":{"color":"aqua","italic":false,"text":"Billy"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Main Character"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/billy/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/eren/default_skin","minecraft:item_name":{"color":"red","italic":false,"text":"Eren Yeager"},"minecraft:lore":[{"color":"gray","italic":false,"text":"We're born to be free."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/eren/flip"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/yuji/default_skin","minecraft:item_name":{"color":"red","italic":false,"text":"Yuji Itadori"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Vessel"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/yuji/flip"}}}},{Slot:17b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Next Page"},"minecraft:lore":[{"color":"gray","italic":false,"text":"(2/3)"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/same"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/selection1","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/same"}}}}]
                        }

                        function 2 {
                            data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/menu/flip"}}}},{Slot:9b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Previous Page"},"minecraft:lore":[{"color":"gray","italic":false,"text":"(1/3)"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/arrows/previous"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/default_skin","minecraft:item_name":{"color":"yellow","italic":false,"text":"The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I Reject My Humanity, Jojo!"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/selection2","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/same"}}}}]
                        }
                    }

                    function open {
                        execute unless score @s customUI.SelectionPage matches 1.. run scoreboard players set @s customUI.SelectionPage 1
                        execute if score @s customUI.SelectionPage matches 1 run function custom:ui/menu/pages/abilities/selection/mask/1
                        execute if score @s customUI.SelectionPage matches 2 run function custom:ui/menu/pages/abilities/selection/mask/2
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/mask"
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/abilities/selection/open
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/abilities/selection/open
                    }

                    dir arrows {
                        function previous {
                            scoreboard players remove @s customUI.SelectionPage 1
                            execute at @s as @p run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/open
                        }

                        function next {
                            scoreboard players add @s customUI.SelectionPage 1
                            execute at @s as @p run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/open
                        }
                    }

                    dir purchase {
                        function main {
                            execute at @s as @p run block { with storage minecraft:ui custom.purchase
                                # ability owned / bypassed
                                $execute if entity @s[tag=$(tag)] unless entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/abilities/selection/purchase/owned/main with storage minecraft:ui custom.purchase 
                                execute if entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/abilities/selection/purchase/owned/main with storage minecraft:ui custom.purchase

                                # ask, confirm, and unlock ability
                                $execute unless entity @s[tag=$(tag)] unless entity @s[tag=customSettings.Bypass] run function custom:ui/menu/pages/abilities/selection/purchase/unowned/main with storage minecraft:ui custom.purchase
                            }
                        }

                        dir owned {
                            function main {
                                $execute unless entity @s[tag=$(toggle)] run function custom:ui/menu/pages/abilities/selection/purchase/owned/equip with storage minecraft:ui custom.purchase
                                $execute if entity @s[tag=$(toggle)] unless entity @s[tag=temp] run function custom:ui/menu/pages/abilities/selection/purchase/owned/disable with storage minecraft:ui custom.purchase
                                tag @s remove temp
                            }

                            function equip {
                                $tag @s add $(context)

                                data merge storage minecraft:ui {custom:{purchase:{state:"add"}}}
                                function custom:ui/menu/pages/abilities/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                                execute unless entity @s[tag=customUniversal.SkinContext] run block { with storage minecraft:ui custom.purchase
                                    tag @s add customAbility.User
                                    $tag @s add $(toggle)
                                }
                                scoreboard players set @s customUniversal.ActiveHotbar 1

                                tag @s add temp
                                playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.25
                            }
                            
                            function disable {
                                $tag @s add $(context)

                                data merge storage minecraft:ui {custom:{purchase:{state:"remove"}}}
                                function custom:ui/menu/pages/abilities/selection/purchase/remove_tags with storage minecraft:ui custom.purchase
                                playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.25
                            }
                        }

                        dir unowned {
                            function main {
                                tag @s add clickEvent
                                tag @s add customUniversal.PurchaseHandler
                                $$(price)

                                execute unless score @s customUI.SkinPatchID matches 1.. run scoreboard players set @s customUI.SkinPatchID 0 
                                block { with storage minecraft:ui custom.purchase
                                    scoreboard players operation @s customUI.SkinLastPatchID = @s customUI.SkinPatchID
                                    $scoreboard players set @s customUI.SkinPatchID $(clickID)
                                }

                                execute unless score @s customUI.SkinLastPatchID = @s customUI.SkinPatchID run scoreboard players reset @s customUI.PurchaseConfirm

                                # confirm
                                execute if entity @s[tag=customUniversal.PurchaseHandler] if score @s customUI.PurchaseConfirm matches 1.. run function custom:ui/menu/pages/abilities/selection/purchase/unowned/confirm with storage minecraft:ui custom.purchase

                                # ask
                                execute if entity @s[tag=customUniversal.PurchaseHandler] unless score @s customUI.PurchaseConfirm matches 1.. unless entity @s[tag=temp] run function custom:ui/menu/pages/abilities/selection/purchase/unowned/ask with storage minecraft:ui custom.purchase

                                tag @s remove temp
                                tag @s remove clickEvent
                                tag @s remove customUniversal.PurchaseHandler
                                tag @s remove customUI.BypassRequirements
                            }

                            function confirm {
                                $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Congratulations!","color":"aqua"},{"text":" You've just unlocked ","color":"gray"},{"text":"$(name)!","color":"yellow"}]
                                playsound minecraft:entity.villager.yes player @s ~ ~ ~ 0.35
                                playsound minecraft:entity.firework_rocket.blast_far player @s ~ ~ ~ 0.35
                                scoreboard players reset @s customUI.PurchaseConfirm
                                scoreboard players reset @s customUI.SkinLastPatchID
                                scoreboard players reset @s customUI.SkinPatchID
                                tag @s add temp

                                $advancement grant @s only server:abilities/$(namespace)

                                $tag @s add $(type)Purchased
                                execute if entity @s[tag=abilityPurchased] run scoreboard players add @s customUI.AbilitiesUnlocked 1
                                execute if entity @s[tag=skinPurchased] run scoreboard players add @s customUI.SkinsUnlocked 1
                                $tag @s remove $(type)Purchased

                                execute unless entity @s[tag=customUI.BypassRequirements] run {
                                    REPEAT (1,5) as i {
                                        execute if entity @s[tag=customUniversal.RequiredItem<%i%>] run block { with storage minecraft:ui custom.purchase
                                            $clear @s $(item<%i%>) $(count<%i%>)
                                        }
                                    }
                                }
                                $tag @s add $(tag)
                            }

                            function ask {
                                $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're ","color":"gray"},{"text":"about ","color":"green"},{"text":"to purchase ","color":"gray"},{"text":"$(name)...","color":"yellow"},{"text":" are you ","color":"gray"},{"text":"sure..?","color":"light_purple"}]
                                playsound minecraft:entity.villager.ambient player @s ~ ~ ~ 0.35
                                scoreboard players add @s customUI.PurchaseConfirm 1
                                tag @s add customUI.TempClick
                            }
                        }

                        function fail {
                            $tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"Insufficient","color":"red"},{"text":" resources to purchase ","color":"gray"},{"text":"$(name)","color":"yellow"}]
                            playsound minecraft:block.anvil.land player @s ~ ~ ~ 0.25
                            scoreboard players reset @s customUI.PurchaseConfirm
                            tag @s remove customUniversal.PurchaseHandler
                        }

                        function remove_tags {
                            scoreboard players reset @s customUI.SkinLastPatchID
                            scoreboard players reset @s customUI.SkinPatchID

                            execute if entity @s[tag=customUniversal.AbilityContext] run {
                                execute if score @s customUniversal.Toggle matches 1 run function custom:universal/toggle/main
                                tag @s remove customAbility.User
                                tag @s remove customAbility.Gojo
                                tag @s remove customAbility.Toji
                                tag @s remove customAbility.Yuji
                                tag @s remove customAbility.TheWorld
                                tag @s remove customAbility.Billy
                                tag @s remove customAbility.President
                                tag @s remove customAbility.Eren
                                tag @s remove customAbility.Avatar
                            }

                            execute if entity @s[tag=customToji.SkinContext] run block { with storage minecraft:ui custom.purchase
                                tag @s remove customToji.SkinDefault
                                tag @s remove customToji.SkinWounded

                                $tag @s $(state) $(toggle)
                                execute if entity @s[tag=!customToji.SkinDefault,tag=!customToji.SkinWounded] run tag @s add customToji.SkinDefault
                            }

                            execute if entity @s[tag=customTheWorld.SkinContext] run block { with storage minecraft:ui custom.purchase
                                tag @s remove customTheWorld.SkinDefault
                                tag @s remove customTheWorld.SkinTW2
                                tag @s remove customTheWorld.SkinVampire
                                tag @s remove customTheWorld.SkinRetro
                                tag @s remove customTheWorld.SkinShadow

                                $tag @s $(state) $(toggle)
                                execute if entity @s[tag=!customTheWorld.SkinDefault,tag=!customTheWorld.SkinTW2,tag=!customTheWorld.SkinVampire,tag=!customTheWorld.SkinRetro,tag=!customTheWorld.SkinShadow] run tag @s add customTheWorld.SkinDefault
                            }

                            execute if entity @s[tag=customPresident.SkinContext] run block { with storage minecraft:ui custom.purchase
                                tag @s remove customPresident.SkinDefault

                                $tag @s $(state) $(toggle)
                                execute if entity @s[tag=!customPresident.SkinDefault] run tag @s add customPresident.SkinDefault
                            }

                            execute if entity @s[tag=customAvatar.SkinContext] run block { with storage minecraft:ui custom.purchase
                                tag @s remove customAvatar.SkinDefault

                                $tag @s $(state) $(toggle)
                                execute if entity @s[tag=!customAvatar.SkinDefault] run tag @s add customAvatar.SkinDefault
                            }

                            $tag @s remove $(context)
                        }

                        dir check {
                            function items {
                                $execute store result score .Item$(number)_Temp1 customUI.PurchaseItemCount run execute if items entity @s hotbar.* $(item)
                                $execute store result score .Item$(number)_Temp2 customUI.PurchaseItemCount run execute if items entity @s inventory.* $(item)

                                $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount = .Item$(number)_Temp1 customUI.PurchaseItemCount
                                $scoreboard players operation .Item$(number)_Count customUI.PurchaseItemCount += .Item$(number)_Temp2 customUI.PurchaseItemCount
                                $scoreboard players reset .Item$(number)_Temp1 customUI.PurchaseItemCount
                                $scoreboard players reset .Item$(number)_Temp2 customUI.PurchaseItemCount

                                $execute store result storage minecraft:ui custom.selection.$(storage).$(product)_item$(number)count int 1 run scoreboard players get .Item$(number)_Count customUI.PurchaseItemCount

                                $tag @s add customUniversal.RequiredItem$(number)

                                # $say $(number) $(item)$(components)
                                $execute if entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{purchase:{item$(number):"$(item)",count$(number):$(required)}}}
                                $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"red",number:$(number),name:"$(name)",product:"$(product)"}}}}

                                $execute if score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. unless entity @s[tag=clickEvent] run block { {storage:"$(storage)",number:$(number),product:"$(product)"}
                                    $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_item$(number)color:"green"}}}}
                                }

                                $execute unless score .Item$(number)_Count customUI.PurchaseItemCount matches $(required).. if entity @s[tag=clickEvent,tag=customUniversal.PurchaseHandler] unless entity @s[tag=customUI.BypassRequirements] run function custom:ui/menu/pages/abilities/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                            }

                            function advancements {
                                $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_advancement_color:"red",name:"$(name)"}}}}
                                $execute if entity @s[advancements={$(advancement)=false}] run block { {storage:"$(storage)"}
                                    tag @s remove customUniversal.AdvancementCheck

                                    $execute if entity @s[tag=customUniversal.PurchaseHandler] unless entity @s[tag=customUI.BypassRequirements] run function custom:ui/menu/pages/abilities/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                                }
                            }

                            function username {
                                $data merge storage minecraft:ui {custom:{selection:{$(storage):{product:"$(product)",username_required:"$(username)",storage:"$(storage)"}}}}

                                loot insert 0 -63 0 loot custom:player_head
                                $data modify storage minecraft:ui custom.selection.$(storage).username_current set string block 0 -63 0 Items[0].components."minecraft:profile".name
                                item replace block 0 -63 0 container.0 with minecraft:air
                                $block { with storage minecraft:ui custom.selection.$(storage)
                                    $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_usernamecolor:"red"}}}}
                                    $tellraw @s ["",{"text":"Debug Log ","color":"gold"},{"text":"-","color":"gray"},{"text":" Username Query","color":"gold"},{"text":"\n"},{"text":"Provided Username: ","color":"gray"},{"text":"$(username_current)","color":"aqua"},{"text":"\n"},{"text":"Required Username: ","color":"gray"},{"text":"$(username_required)","color":"green"}]
                                    
                                    $execute store success score @s customUI.PurchaseUsername run data modify storage minecraft:ui custom.selection.$(storage).username_current set from storage minecraft:ui custom.selection.$(storage).username_required
                                    $execute if score @s customUI.PurchaseUsername matches 0 run block { with storage minecraft:ui custom.selection.$(storage)
                                        $data merge storage minecraft:ui {custom:{selection:{$(storage):{$(product)_usernamecolor:"green"}}}}
                                        execute if entity @s[tag=customUI.BypassCheck] run tag @s add customUI.BypassRequirements
                                    }
                                    $execute if entity @s[tag=customUniversal.PurchaseHandler] unless entity @s[tag=customUI.BypassCheck] if score @s customUI.PurchaseUsername matches 1 run function custom:ui/menu/pages/abilities/selection/purchase/fail with storage minecraft:ui custom.selection.$(storage)
                                }
                                tag @s remove customUI.BypassCheck
                            }
                        }
                    }

                    dir gojo {
                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Unique secrets that you can find specific to this Ability."},{"color":"gray","italic":false,"text":"They can range anywhere from a simple change, to an"},{"color":"gray","italic":false,"text":"entirely different move. Hints are provided below."}," ",{"color":"gold","italic":false,"text":"Interaction (1)"},[{"color":"gray","italic":false,"text":"You need to be "},{"color":"blue","italic":true,"text":"Stronger"}],[{"color":"gray","italic":false,"text":"Discovered: "},{"color":"red","italic":false,"text":"No"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/gojo/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","text":"Passive"},"minecraft:lore":[[{"color":"light_purple","italic":false,"text":"Infinity "},{"color":"gray","italic":false,"text":"activates after taking damage "},{"color":"gold","italic":false,"text":"5 "}],[{"color":"gold","italic":false,"text":"times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming damage."}]," ",[{"color":"yellow","italic":false,"text":"Speed II "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":"Night Vision V"}]," ",{"color":"aqua","italic":false,"text":"Awakening"},[{"color":"gray","italic":false,"text":"Upon using "},{"color":"light_purple","italic":false,"text":"Reverse Cursed Technique, "},{"color":"gray","italic":false,"text":"you've"}],[{"color":"gray","italic":false,"text":"got a "},{"color":"gold","italic":false,"text":"10% chance "},{"color":"gray","italic":false,"text":"to achieve the "},{"color":"yellow","italic":false,"text":"Honored"}],[{"color":"gray","italic":false,"text":"status with a different set of moves for "},{"color":"dark_aqua","text":"3m 48s."}]," ",[{"color":"light_purple","italic":false,"text":"Infinity --> Infinity+ "},{"color":"gray","italic":false,"text":"activates after taking"}],[{"color":"gray","italic":false,"text":"damage "},{"color":"gold","italic":false,"text":"4 times, "},{"color":"gray","italic":false,"text":"completely "},{"color":"red","italic":false,"text":"negating "},{"color":"gray","italic":false,"text":"incoming"}],{"color":"gray","italic":false,"text":"damage."}," ",[{"color":"yellow","italic":false,"text":"Speed III "},{"color":"gray","italic":false,"text":"| "},{"color":"blue","italic":false,"text":" Night Vision V"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/gojo/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/gojo/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of Satoru Gojo"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/gojo/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"}," ",{"color":"gold","italic":false,"text":"Ability Cost"},[{"color":"$(ability_item1color)","italic":false,"text":"$(ability_item1count)/1 Blindfolds(s) "},{"color":"gray","italic":false,"text":"can be rarely found in "}],{"color":"gray","italic":false,"text":"Ancient Cities"},[{"color":"$(ability_item2color)","italic":false,"text":"$(ability_item2count)/6 Honored Eyes(s) "},{"color":"gray","italic":false,"text":"rare drop from killing Spiders"}],[{"color":"$(ability_advancement_color)","italic":false,"text":"Advancements: "},{"color":"light_purple","italic":false,"text":"Minecraft: Trial(s) Edition"}]," ",[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(ownership_color)","italic":false,"text":"$(ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(equip_color)","italic":false,"text":"$(equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/abilities/selection/gojo/ability_price",name:"Satoru Gojo",tag:"customGojo.Ownership",toggle:"customAbility.Gojo",context:"customUniversal.AbilityContext",cmd:"function custom:ui/menu/pages/abilities/selection/gojo/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/gojo/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/gojo/same"}}}}]
                        }

                        function open {
                            execute at @s as @p run function custom:ui/menu/pages/abilities/selection/gojo/player

                            function custom:ui/menu/pages/abilities/selection/gojo/mask with storage minecraft:ui custom.selection.gojo
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/gojo/mask"
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/gojo/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/gojo/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customAbility.Gojo] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/abilities/selection/gojo/ability_price
                        }

                        function ability_price {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:9174910}}}
                            function custom:ui/menu/pages/abilities/selection/inventory/check {item:"minecraft:arrow",required:1,number:1,product:"ability",storage:"gojo",name:"Satoru Gojo"}
                            function custom:ui/menu/pages/abilities/selection/inventory/check {item:"minecraft:dirt",required:6,number:2,product:"ability",storage:"gojo",name:"Satoru Gojo"}

                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/abilities/selection/advancements/check {advancement:"minecraft:adventure/minecraft_trials_edition",product:"ability",storage:"gojo",name:"Satoru Gojo"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{gojo:{ability_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                        }

