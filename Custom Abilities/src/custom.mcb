                    dir president {
                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[[{"text":"Unique secrets that you can find specific to this ability.","italic":false,"color":"gray"}],[{"text":"They can range anywhere from a simple change, to an","italic":false,"color":"gray"}],[{"text":"entirely different move. Hints are provided below.","italic":false,"color":"gray"}],[{"text":" ","color":"dark_purple"}],[{"text":"Interaction (1)","italic":false,"color":"gold"}],[{"text":"Not availiable.","italic":false,"color":"gray"}],[{"text":"Discovered: ","italic":false,"color":"gray"},{"text":"$(secret_interaction1state)","italic":false,"color":"$(secret_interaction1color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Passive(s)"},"minecraft:lore":$(passive),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for Mr. President"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of Mr. President"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Mr. President"},"minecraft:lore":[[{"text":"I'll fulfill my promise.","italic":false,"color":"gray"}],"",[{"text":"Ability Cost","italic":false,"color":"gold"}],[{"text":"$(ability_item1count)/12 Turtle Scute(s)","italic":false,"color":"$(ability_item1color)"}],[{"text":"$(ability_item2count)/1 Mysterious Arrow(s)","italic":false,"color":"$(ability_item2color)"},{"text":" can be discovered in","italic":false,"color":"gray"}],[{"text":"Desert Pyramids or Bastions","italic":false,"color":"gray"}],[{"text":"Advancements:","italic":false,"color":"$(ability_advancement_color)"},{"text":" Sneak 100 and Respecting the","italic":false,"color":"gray"}],[{"text":"Remnants","italic":false,"color":"gray"}],"",[{"text":"Bypass","italic":false,"color":"gold"}],[{"text":"JoeBingleBarf ","italic":false,"color":"$(ability_usernamecolor)"},{"text":"as your Mojang username","italic":false,"color":"gray"}],"",[{"text":"Unlocked: ","italic":false,"color":"gray"},{"text":"$(ownership_state)","italic":false,"color":"$(ownership_color)"}],[{"text":"Equipped: ","italic":false,"color":"gray"},{"text":"$(equip_state)","italic":false,"color":"$(equip_color)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/abilities/selection/president/ability_price",name:"Mr. President",namespace:"president",tag:"customPresident.Ownership",toggle:"customAbility.President",context:"customUniversal.AbilityContext",cmd:"function custom:ui/menu/pages/abilities/selection/president/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/president/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/same"}}}}]
                        }

                        function open {
                            execute at @s as @p run function custom:ui/menu/pages/abilities/selection/president/player

                            function custom:ui/menu/pages/abilities/selection/president/mask with storage minecraft:ui custom.selection.president
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/president/mask"
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/president/open
                        }

                        function passive {
                            $data merge storage minecraft:ui $(open):[[{"text":"Freezer Room","italic":false,"color":"light_purple"},{"text":" activates upon walking against","italic":false,"color":"gray"}],[{"text":"the locked room inside ","italic":false,"color":"gray"},{"text":"your","italic":false,"color":"yellow"},{"text":" personal","italic":false,"color":"gray"},{"text":" Pocket","italic":false,"color":"aqua"}],[{"text":"Dimension.","italic":false,"color":"aqua"},{"text":" Gain access to ","italic":false,"color":"gray"},{"text":"3","italic":false,"color":"gold"},{"text":" personal chests","italic":false,"color":"gray"}],[{"text":"that can be accessed from anywhere.","italic":false,"color":"gray"}],"",[{"text":"Endure","italic":false,"color":"light_purple"},{"text":" gains a stack anytime damage is taken","italic":false,"color":"gray"}],[{"text":"whilst in ","italic":false,"color":"gray"},{"text":"Turtle Form.","italic":false,"color":"aqua"},{"text":" Casting moves with ","italic":false,"color":"gray"},{"text":"Endure","italic":false,"color":"light_purple"}],[{"text":"stacks will remove all stacks and enhance that","italic":false,"color":"gray"}],[{"text":"move. ","italic":false,"color":"gray"}],[{"text":" o Kidnap Range: ","italic":false,"color":"gray"},{"text":"0.2m per stack","italic":false,"color":"green"}],[{"text":" o Shake Damage: ","italic":false,"color":"gray"},{"text":"+1 per stack","italic":false,"color":"green"}],[{"text":" o Refreshments: ","italic":false,"color":"gray"},{"text":"+1 health per stack","italic":false,"color":"green"}],[{"text":" o Max Tokens: ","italic":false,"color":"gray"},{"text":"10","italic":false,"color":"green"}]]$(end)
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/president/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{president:{equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{secret_interaction1state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{secret_interaction1color:"red"}}}}
                                function custom:ui/menu/pages/abilities/selection/president/passive {open:"{custom:{selection:{president:{passive",end:"}}}}"}
                            }

                            execute if entity @s[tag=customAbility.President] run {
                                data merge storage minecraft:ui {custom:{selection:{president:{equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customPresident.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{president:{ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{ownership_state:"Yes"}}}}
                            }
                            
                            execute if entity @s[tag=customPresident.SecretInteractionAscend] run {
                                data merge storage minecraft:ui {custom:{selection:{president:{secret_interaction1state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{secret_interaction1color:"green"}}}}
                            }

                            function custom:ui/menu/pages/abilities/selection/president/ability_price
                        }

                        function ability_price {
                            data merge storage minecraft:ui {custom:{purchase:{type:"ability",clickID:1}}}

                            
                            # bypass #
                            tag @s add customUI.BypassCheck
                            function custom:ui/menu/pages/abilities/selection/purchase/check/username {product:"ability",storage:"president",username:"JoeBingleBarf"}

                            # scute x12 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:turtle_scute",number:1,required:12,product:"ability",storage:"president",name:"Mr. President"}

                            # mysterious arrow x1 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,mysterious_arrow:1b}]",number:2,required:1,product:"ability",storage:"president",name:"Mr. President"}

                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/abilities/selection/purchase/check/advancements {advancement:"minecraft:adventure/avoid_vibration",product:"ability",storage:"president",name:"Mr. President"}
                            function custom:ui/menu/pages/abilities/selection/purchase/check/advancements {advancement:"minecraft:adventure/salvage_sherd",product:"ability",storage:"president",name:"Mr. President"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{president:{ability_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                        }

