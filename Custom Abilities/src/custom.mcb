                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I Reject My Humanity, Jojo!"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"aqua","italic":false,"text":"Default"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(default_equip_color)","italic":false,"text":"$(default_equip_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/skins/default"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/the_world_2","minecraft:item_name":{"color":"aqua","italic":false,"text":"The World 2"},"minecraft:lore":[{"color":"gray","italic":false,"text":"You're next, Jotaro!"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"white","italic":false,"text":"Common"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"text":"Advancement(s):","italic":false,"color":"$(tw2_advancement_color)"},{"text":" ","italic":false},{"text":"Spooky Scary Skeleton","italic":false,"color":"gray"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(tw2_ownership_color)","italic":false,"text":"$(tw2_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(tw2_equip_color)","italic":false,"text":"$(tw2_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/tw2",name:"The World 2",namespace:"nil",tag:"customTheWorld.SkinTW2.Ownership",toggle:"customTheWorld.SkinTW2",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/p