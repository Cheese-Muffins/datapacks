                        execute if entity @s[tag=customToji.SecretInteractionAssasinate] run {
                            data merge storage minecraft:ui {custom:{selection:{toji:{secret_interaction1state:"Yes"}}}}
                            data merge storage minecraft:ui {custom:{selection:{toji:{secret_interaction1color:"green"}}}}
                        }

                        function custom:ui/menu/pages/selection/toji/ability_price
                    }

                    function ability_price {
