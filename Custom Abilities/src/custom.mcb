                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/president/skins/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/president/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{president:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{default_equip_state:"No"}}}}
                            }

                            execute if entity @s[tag=customPresident.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{president:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{president:{default_equip_state:"Yes"}}}}
                            }
