                            function custom:ui/menu/pages/selection/toji/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{toji:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{default_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customToji.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{toji:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{default_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customToji.SkinWounded] run {
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customToji.SkinWounded.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{toji:{wounded_ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/selection/toji/skins/wounded
                        }

                        function default {
                            execute at @s as @p run {
                                tag @s add customUniversal.SkinContext
                                tag @s add customToji.DefaultSkinBypass
                            }

                            data merge storage minecraft:ui {custom:{purchase:{tag:"customToji.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customToji.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customToji.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/toji/skins/open

                            execute at @s as @p run {
                                tag @s remove customUniversal.SkinContext
                                tag @s remove customToji.DefaultSkinBypass
                            }
                        }

                        function wounded {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:1}}}

                            execute at @s as @p run tag @s add customUniversal.SkinContext
                            function custom:ui/menu/pages/selection/purchase/check/items {type:"minecraft:arrow",required:1,number:1,product:"wounded",storage:"toji",name:"Toji Fushiguro"}
                            execute at @s as @p run tag @s remove customUniversal.SkinContext
                        }
                    }
                }

