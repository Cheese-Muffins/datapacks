                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinWushu] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinWushu.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinBeach] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinBeach.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/selection/gojo/skins/wushu
                            function custom:ui/menu/pages/selection/gojo/skins/beach
                        }

                        function default {
                            execute at @s as @p run tag @s add customGojo.DefaultSkinBypass
                            data merge storage minecraft:ui {custom:{purchase:{tag:"customGojo.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customGojo.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customGojo.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/gojo/skins/open
                            execute at @s as @p run tag @s remove customGojo.DefaultSkinBypass
                        }

