                dir avatar {
                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[[{"text":"Unique secrets that you can find specific to this ability.","italic":false,"color":"gray"}],[{"text":"They can range anywhere from a simple change, to an","italic":false,"color":"gray"}],[{"text":"entirely different move. Hints are provided below.","italic":false,"color":"gray"}],[{"text":" ","color":"dark_purple"}],[{"text":"Interaction (1)","italic":false,"color":"gold"}],[{"text":"Not availiable.","italic":false,"color":"gray"}],[{"text":"Discovered: ","italic":false,"color":"gray"},{"text":"$(secret_interaction1state)","italic":false,"color":"$(secret_interaction1color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Passive(s)"},"minecraft:lore":$(passive),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for The Avatar"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of The Avatar"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar"},"minecraft:lore":[[{"text":"The past can be a great teacher.","italic":false,"color":"gray"}],"",[{"text":"Ability Cost","italic":false,"color":"gold"}],[{"text":"$(ability_item1count)/4 Gem Cluster(s)","italic":false,"color":"$(ability_item1color)"},{"text":" Rarely dropped from","italic":false,"color":"gray"}],[{"text":"breaking Stone or Deepslate","italic":false,"color":"gray"}],[{"text":"$(ability_item2count)/4 Phantom Feather(s)","italic":false,"color":"$(ability_item2color)"},{"text":" Uncommonly dropped","italic":false,"color":"gray"}],[{"text":"from killing Phantoms","italic":false,"color":"gray"}],[{"text":"$(ability_item3count)/2 Blaze Core(s)","italic":false,"color":"$(ability_item3color)"},{"text":" Rarely dropped from killing","italic":false,"color":"gray"}],[{"text":"blazes","italic":false,"color":"gray"}],[{"text":"$(ability_item4count)/1 Drowned Heart(s)","italic":false,"color":"$(ability_item4color)"},{"text":" ","italic":false,"color":"gray"},{"text":"Rarely dropped ","italic":false,"color":"gray"},{"text":"from","italic":false,"color":"gray"}],[{"text":"killing Drowned","italic":false,"color":"gray"}],[{"text":"Advancements:","italic":false,"color":"$(ability_advancement_color)"},{"text":" With Our Powers Combined!","italic":false,"color":"gray"}],"",[{"text":"Bypass","italic":false,"color":"gold"}],[{"text":"35Shadowgames ","italic":false,"color":"$(ability_usernamecolor)"},{"text":"as your Mojang username","italic":false,"color":"gray"}],"",[{"text":"Unlocked: ","italic":false,"color":"gray"},{"text":"$(ownership_state)","italic":false,"color":"$(ownership_color)"}],[{"text":"Equipped: ","italic":false,"color":"gray"},{"text":"$(equip_state)","italic":false,"color":"$(equip_color)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/avatar/ability_price",name:"The Avatar",tag:"customAvatar.Ownership",toggle:"customAbility.Avatar",context:"customUniversal.AbilityContext",namespace:"avatar",cmd:"function custom:ui/menu/pages/selection/avatar/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/avatar/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/same"}}}}]
                    }

                    function open {
                        execute at @s as @p run function custom:ui/menu/pages/selection/avatar/player

                        function custom:ui/menu/pages/selection/avatar/mask with storage minecraft:ui custom.selection.avatar
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/avatar/mask"
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/avatar/open
                    }

                    function passive {
                        $data merge storage minecraft:ui $(open):[[{"text":"Draft","italic":false,"color":"light_purple"},{"text":" is active whenever air mode is being hovered","italic":false,"color":"gray"}],[{"text":"and falling downwards. The user gains ","italic":false,"color":"gray"},{"text":"Slow Falling","italic":false,"color":"white"}],[{"text":"which can be canceled out by sneaking. Whilst ","italic":false,"color":"gray"},{"text":"sneaking,","italic":false,"color":"yellow"}],[{"text":"gain complete ","italic":false,"color":"gray"},{"text":"immunity ","italic":false,"color":"aqua"},{"text":"to fall damage. ","italic":false,"color":"gray"}],"",[{"text":"Dive ","italic":false,"color":"light_purple"},{"text":"is active whenever water mode is being hovered","italic":false,"color":"gray"}],[{"text":"and submerged in ","italic":false,"color":"gray"},{"text":"water.","italic":false,"color":"blue"},{"text":" The user gains the following","italic":false,"color":"gray"}],[{"text":"changes.","italic":false,"color":"gray"}],[{"text":"o Damage Multiplier: ","italic":false,"color":"gray"},{"text":"1.25x","italic":false,"color":"green"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Dolphins Grace I","italic":false,"color":"dark_aqua"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Conduit Power III","italic":false,"color":"aqua"}],"",[{"text":"Masonry ","italic":false,"color":"light_purple"},{"text":"activates whenever earth mode is being","italic":false,"color":"gray"}],[{"text":"hovered. The user gains the following changes","italic":false,"color":"gray"}],[{"text":"o Efficiency Multiplier: ","italic":false,"color":"gray"},{"text":"1.5x","italic":false,"color":"green"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Haste II","italic":false,"color":"yellow"}],"",[{"text":"Boil ","italic":false,"color":"light_purple"},{"text":"is active whenever fire mode is being hovered.","italic":false,"color":"gray"}],[{"text":"The user gains the following ","italic":false,"color":"gray"},{"text":"changes.","italic":false,"color":"gray"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Fire Resistance I","italic":false,"color":"red"}]]$(end)
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/selection/avatar/open
                    }

                    function player {
                        block {
                            data merge storage minecraft:ui {custom:{selection:{avatar:{equip_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{equip_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1state:"No"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1color:"red"}}}}
                            function custom:ui/menu/pages/selection/avatar/passive {open:"{custom:{selection:{avatar:{passive",end:"}}}}"}
                        }

                        execute if entity @s[tag=customAbility.Avatar] run {
                            data merge storage minecraft:ui {custom:{selection:{avatar:{equip_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{equip_state:"Yes"}}}}
                        }

                        execute if entity @s[tag=customAvatar.Ownership] run {
                            data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_color:"green"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_state:"Yes"}}}}
                        }
                        
                        execute if entity @s[tag=customAvatar.SecretInteractionAscend] run {
                            data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1state:"Yes"}}}}
                            data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1color:"green"}}}}
                        }

                        function custom:ui/menu/pages/selection/avatar/ability_price
                    }

                    function ability_price {
                        data merge storage minecraft:ui {custom:{purchase:{type:"ability",clickID:1}}}

                        
                        # bypass #
                        tag @s add customUI.BypassCheck
                        function custom:ui/menu/pages/selection/purchase/check/username {product:"ability",storage:"avatar",username:"35ShadowGames"}

                        # gem cluster x4 #
                        function custom:ui/menu/pages/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,gem_cluster:1b}]",number:1,required:4,product:"ability",storage:"avatar",name:"The Avatar"}

                        # phantom feather x4 #
                        function custom:ui/menu/pages/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,phantom_feather:1b}]",number:2,required:4,product:"ability",storage:"avatar",name:"The Avatar"}

                        # blaze core x2 #
                        function custom:ui/menu/pages/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,blaze_core:1b}]",number:3,required:2,product:"ability",storage:"avatar",name:"The Avatar"}

                        # drowned heart x1 #
                        function custom:ui/menu/pages/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,drowned_heart:1b}]",number:4,required:1,product:"ability",storage:"avatar",name:"The Avatar"}

                        tag @s add customUniversal.AdvancementCheck
                        function custom:ui/menu/pages/selection/purchase/check/advancements {advancement:"minecraft:husbandry/froglights",product:"ability",storage:"avatar",name:"The Avatar"}
                        execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{avatar:{ability_advancement_color:"green"}}}}
                        tag @s remove customUniversal.AdvancementCheck
                    }

                    dir moveset {
                        function open {
                            function custom:ui/menu/pages/selection/avatar/moveset/mask
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/avatar/moveset/mask"
                        }

                        function mask {
                            data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Toji's overview"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:wind_charge","minecraft:item_name":{"color":"aqua","text":"Gust"},"minecraft:lore":[[{"text":"Launch the user in the direction they're currently","italic":false,"color":"gray"}],[{"text":"facing. ","italic":false,"color":"gray"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"11s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/same"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:water_bucket","minecraft:item_name":{"color":"aqua","text":"Water Arrow"},"minecraft:lore":[[{"text":"Following a short initial windup, launch a deadly","italic":false,"color":"gray"}],[{"text":"arrow of water ahead of where you're looking.","italic":false,"color":"gray"}],[{"text":"Using this move whilst touching ","italic":false,"color":"gray"},{"text":"water","italic":false,"color":"blue"},{"text":" increases","italic":false,"color":"gray"}],[{"text":"the arrow speed by ","italic":false,"color":"gray"},{"text":"1.5x.","italic":false,"color":"gold"}],[{"text":"o Windup: ","italic":false,"color":"gray"},{"text":"1.45s","italic":false,"color":"red"}],[{"text":"o Arrow Speed: ","italic":false,"color":"gray"},{"text":"4m/s","italic":false,"color":"green"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"12","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"19s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:diamond_pickaxe","minecraft:item_name":{"color":"aqua","text":"Excavate"},"minecraft:lore":[[{"text":"Must be holding a pickaxe to use, draining a ","italic":false,"color":"gray"}],[{"text":"maximum of ","italic":false,"color":"gray"},{"text":"343 durability. ","italic":false,"color":"gold"},{"text":"Destroy the ","italic":false,"color":"gray"}],[{"text":"surrounding ","italic":false,"color":"gray"},{"text":"7x7x7","italic":false,"color":"green"},{"text":" area of blocks the wielded","italic":false,"color":"gray"}],[{"text":"pickaxe is capable of destroying. Blocks are","italic":false,"color":"gray"}],[{"text":"dropped on the ground when destroyed.","italic":false,"color":"gray"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"26s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:fire_charge","minecraft:item_name":{"color":"aqua","text":"Meteor"},"minecraft:lore":[[{"text":"Launch a molten meteor of lava ahead of where","italic":false,"color":"gray"}],[{"text":"you're looking. ","italic":false,"color":"gray"},{"text":"Collision","italic":false,"color":"gold"},{"text":" with terrain, ","italic":false,"color":"gray"},{"text":"players ","italic":false,"color":"gold"},{"text":"or","italic":false,"color":"gray"}],[{"text":"travelling for ","italic":false,"color":"gray"},{"text":"too long","italic":false,"color":"gold"},{"text":" will cause the cube to","italic":false,"color":"gray"}],[{"text":"explode ","italic":false,"color":"red"},{"text":"dealing large ","italic":false,"color":"gray"},{"text":"AOE","italic":false,"color":"red"},{"text":" damage in the area.","italic":false,"color":"gray"}],[{"text":"o AOE Range:","italic":false,"color":"gray"},{"text":" 4m","italic":false,"color":"green"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"9","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"21s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to The Avatar's Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/flip"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/avatar/moveset","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/moveset/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/avatar/moveset/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/avatar/moveset/open
                        }
                    }

                    dir skins {
                        function open {
                            execute at @s as @p run function custom:ui/menu/pages/selection/avatar/skins/player

                            function custom:ui/menu/pages/selection/avatar/skins/mask with storage minecraft:ui custom.selection.avatar
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/avatar/skins/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/avatar/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The past can be a great teacher."},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"aqua","italic":false,"text":"Default"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(default_equip_color)","italic":false,"text":"$(default_equip_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/skins/default"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/avatar/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/avatar/skins/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/avatar/skins/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/avatar/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_state:"No"}}}}
                            }

                            execute if entity @s[tag=customAvatar.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_state:"Yes"}}}}
                            }
                        }

                        function default {
                            execute at @s as @p run {
                                tag @s add customUniversal.SkinContext
                                tag @s add customAvatar.DefaultSkinBypass
                            }

                            data merge storage minecraft:ui {custom:{purchase:{tag:"customAvatar.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customAvatar.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customAvatar.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/avatar/skins/open

                            execute at @s as @p run {
                                tag @s remove customUniversal.SkinContext
                                tag @s remove customAvatar.DefaultSkinBypass
                            }
                        }
                    }
                }
            }
        }

        function get_mask {
            $$(mask)
        }

        function on_click {
            function custom:ui/run_cmd with storage ui in[0].components."minecraft:custom_data".ui_item

            execute if score .type ui matches 1 run function custom:ui/minecart/load_page
        }

        function on_input {
            execute as @p run function custom:ui/player/return

            function custom:ui/menu/refresh
        }

        function refresh {
            data modify storage ui mask set from storage ui current
            execute on passengers run function custom:ui/menu/get_mask with entity @s data.page
            data modify storage ui current set from storage ui mask

            execute if score .type ui matches 1 run function custom:ui/minecart/load_page
        }
    }

    dir minecart {
        dir click {
            function check {
                # $scoreboard players set @s customUI.SkinClick $(skin_id)
                # execute unless score @s customUI.SkinClickPrevious = @s customUI.SkinClick run scoreboard players reset @s customUI.SkinConfirm
                # scoreboard players operation @s customUI.SkinClickPrevious = @s customUI.SkinClick
                # $execute if score @s customUI.SkinClick matches 1 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
                # $execute if score @s customUI.SkinClick matches 2 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
                # $execute if score @s customUI.SkinClick matches 3 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
            }

            function shop {
                execute at @s as @p run item replace block 0 -64 0 container.0 from entity @s player.cursor
                data modify storage minecraft:ui custom.purchase.price set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.price
                data modify storage minecraft:ui custom.purchase.context set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.context
                data modify storage minecraft:ui custom.purchase.name set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.name
                data modify storage minecraft:ui custom.purchase.tag set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.tag
                data modify storage minecraft:ui custom.purchase.toggle set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.toggle
                data modify storage minecraft:ui custom.purchase.namespace set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.namespace

                # data modify storage minecraft:ui custom.skin_name set from block 0 -63 0 Items[0].components."minecraft:custom_data".ui_item.skin_name
                # data modify storage minecraft:ui custom.ability set from block 0 -63 0 Items[0].components."minecraft:custom_data".ui_item.ability

                execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
            }

            dir settings {
                function admin {
                    execute if entity @p[tag=customUI.AdminAccess] run {
                        function custom:ui/menu/pages/settings/administrator/flip
                    } else run {
                        execute at @s as @p run {
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're not an ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"r","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"o","color":"blue"},{"text":"r","color":"light_purple"},{"text":",","color":"dark_purple"},{"text":" and ","color":"gray"},{"text":"cannot","color":"red"},{"text":" access this page.","color":"gray"}]
                        }
                        function custom:ui/player/close
                    }
                }
            }
        }

        function cleanup {
            data remove storage minecraft:ui current
            data remove storage minecraft:ui previous
            data remove storage minecraft:ui temp
            data remove storage minecraft:ui in
            data remove storage minecraft:ui mask
            data remove storage minecraft:ui custom
        }

        function load_page {
            data modify entity @s Items set from storage ui current

            data modify storage ui current set from entity @s Items
            execute on passengers run data modify entity @s data.previous set from storage ui current
        }

        function on_change {
            execute at @s as @p run {
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{purchaseable_item:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/shop
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/menu/pages/settings/default/flip
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/settings/admin
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/settings/admin
                scoreboard players reset @s[tag=!customUI.TempClick] customUI.PurchaseConfirm
                tag @s remove customUI.TempClick
            }
            clear @a *[minecraft:custom_data~{ui_item:{}}]
            kill @e[type=item,nbt={Item:{components:{"minecraft:custom_data":{ui_item:{}}}}}]
            data remove storage minecraft:ui custom

            scoreboard players set .type ui 1

            data modify storage ui in set from storage ui current
            data remove storage ui in[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0] run return run function custom:ui/menu/on_input

            data modify storage ui temp set from storage ui previous
            data modify storage ui temp[].components."minecraft:custom_data" merge value {prev:1b}
            data modify entity @s Items insert 0 from storage ui temp[]
            data remove storage ui temp
            data modify storage ui temp append from entity @s Items[{components:{"minecraft:custom_data":{prev:1b}}}]
            data remove storage ui in
            data modify storage ui in append from storage ui temp[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0].components."minecraft:custom_data".ui_item.empty run data remove storage ui in[0]
            execute if data storage ui in[0] unless data storage ui in[1] run return run function custom:ui/menu/on_click

            function custom:ui/menu/refresh
        }

        function tick {
            data modify storage ui current set from entity @s Items
            execute on passengers run data modify storage ui previous set from entity @s data.previous
            
            execute on passengers store result score #bool ui run data modify entity @s data.previous set from storage ui current

            execute if score #bool ui matches 1 run function custom:ui/minecart/on_change
            # why r u down here bro
        }
        # im gonna blow up
    }
