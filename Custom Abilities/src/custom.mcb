                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{yuji:{equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{yuji:{equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{yuji:{ownership_color:"red"}}}}
