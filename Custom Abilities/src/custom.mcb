"italic":false,"color":"gray"},{"text":"20","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"30s","italic":false,"color":"gold"}],[{"text":"Cancellable: ","italic":false,"color":"gray"},{"text":"Yes, ","italic":false,"color":"dark_red"},{"text":"during the","italic":false,"color":"red"},{"text":" Initial Windup","italic":false,"color":"dark_red"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/moveset/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/toji/moveset/snare","minecraft:item_name":{"color":"aqua","text":"Sneak Attack"},"minecraft:lore":[[{"text":"Must be casted whilst looking at an entity.","italic":false,"color":"gray"}],[{"text":"Vanish ","italic":false,"color":"yellow"},{"text":"from the naked eye in that same moment,","italic":false,"color":"gray"}],[{"text":"giving the victim a small ","italic":false,"color":"gray"},{"text":"sound que","italic":false,"color":"white"},{"text":" warning them to ","italic":false,"color":"gray"}],[{"text":"turn around.","italic":false,"color":"red"}],"",[{"text":"Failing to turn around","italic":false,"color":"light_purple"}],[{"text":"Deal heavy damage to the victim and teleport","italic":false,"color":"gray"}],[{"text":"back to the original spot the move was casted.","italic":false,"color":"gray"}],[{"text":" o Reaction Time: ","italic":false,"color":"gray"},{"text":"1.1s","italic":false,"color":"red"}],[{"text":" o Damage: ","italic":false,"color":"gray"},{"text":"20","italic":false,"color":"green"}],"",[{"text":"Successfully turned around","italic":false,"color":"light_purple"}],[{"text":"Sneak Attack is instantly cancelled, dealing ","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"gold"}],[{"text":"damage and teleporting the user in front of the","italic":false,"color":"gray"}],[{"text":"victim.","italic":false,"color":"gray"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"30s","italic":false,"color":"gold"}],[{"text":"Cancellable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/moveset/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Toji's overview"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/flip"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/toji/moveset","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/moveset/same"}}}}]
