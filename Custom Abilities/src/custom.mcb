/the_world/skins/open"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/vampire_the_world","minecraft:item_name":{"color":"red","italic":false,"text":"Vampire The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Kono Dio Da!"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"#91F26D","italic":false,"text":"Uncommon"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"color":"$(vtw_item1color)","italic":false,"text":"$(vtw_item1count)/7 Time Fragment(s) "},{"color":"gray","italic":false,"text":"Rare drop from killing Enderman"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(vtw_ownership_color)","italic":false,"text":"$(vtw_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(vtw_equip_color)","italic":false,"text":"$(vtw_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/vampire_the_world",name:"Vampire The World",tag:"customTheWorld.SkinVTW.Ownership",toggle:"customTheWorld.SkinVTW",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/pages/selection/the_world/skins/open"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/retro_the_world","minecraft:item_name":{"color":"green","italic":false,"text":"Retro The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Oh? You're approaching me?"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"light_purple","italic":false,"text":"Epic"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"color":"$(rtw_item1color)","italic":false,"text":"$(rtw_item1count)/1 Mysterious Arrow(s) "},{"color":"gray","italic":false,"text":"can be rarely found in"}],{"color":"gray","italic":false,"text":"Mineshafts and Strongholds"},[{"color":"$(rtw_item2color)","italic":false,"text":"$(rtw_item2count)/10 Time Fragment(s) "},{"color":"gray","italic":false,"text":"Rare drop from killing Enderman"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(rtw_ownership_color)","italic":false,"text":"$(rtw_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(rtw_equip_color)","italic":false,"text":"$(rtw_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/retro_the_world",name:"Retro The World",tag:"customTheWorld.SkinRTW.Ownership",toggle:"customTheWorld.SkinRTW",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/pages/selection/the_world/skins/open"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/shadow_the_world","minecraft:item_name":{"color":"white","italic":false,"text":"Shadow The World"},"minecraft:lore":[{"color":"gray","italic":false,"text":"What is it that you desire?"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"yellow","italic":false,"text":"Legendary"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"color":"$(stw_item1color)","italic":false,"text":"$(stw_item1count)/1 Mysterious Arrow(s) "},{"color":"gray","italic":false,"text":"can be rarely found in"}],{"color":"gray","italic":false,"text":"Mineshafts and Strongholds"},[{"color":"$(stw_item2color)","italic":false,"text":"$(stw_item2count)/22 Time Fragment(s) "},{"color":"gray","italic":false,"text":"Rare drop from killing Enderman"}],[{"color":"$(stw_advancement_color)","italic":false,"text":"Advancements: "},{"color":"light_purple","italic":false,"text":"Free the End "},{"color":"gray","italic":false,"text":"and "},{"color":"light_purple","italic":false,"text":"Postmortal"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(stw_ownership_color)","italic":false,"text":"$(stw_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(stw_equip_color)","italic":false,"text":"$(stw_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/shadow_the_world",name:"Shadow The World",tag:"customTheWorld.SkinSTW.Ownership",toggle:"customTheWorld.SkinSTW",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/pages/selection/the_world/skins/open"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The World Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/the_world/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/skins/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/the_world/skins/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/the_world/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinTW2] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinTW2.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinVTW] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinVTW.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vtw_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinRTW] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinRTW.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{rtw_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinSTW] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinSTW.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{stw_ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/selection/the_world/skins/the_world_2
                            function custom:ui/menu/pages/selection/the_world/skins/vampire_the_world
                            function custom:ui/menu/pages/selection/the_world/skins/retro_the_world
                            function custom:ui/menu/pages/selection/the_world/skins/shadow_the_world
                        }

                        function default {
                            execute at @s as @p run tag @s add customTheWorld.DefaultSkinBypass
                            data merge storage minecraft:ui {custom:{purchase:{tag:"customTheWorld.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customTheWorld.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customTheWorld.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/the_world/skins/open
                            execute at @s as @p run tag @s remove customTheWorld.DefaultSkinBypass
                        }

                        function the_world_2 {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:103913}}}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:3,number:1,product:"tw2",storage:"the_world",name:"The World"}
                        }

                        function vampire_the_world {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:4849201}}}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:7,number:1,product:"vtw",storage:"the_world",name:"The World"}
                        }

                        function retro_the_world {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:3021931}}}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:arrow",required:1,number:1,product:"rtw",storage:"the_world",name:"The World"}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:10,number:2,product:"rtw",storage:"the_world",name:"The World"}
                        }

                        function shadow_the_world {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:4891391}}}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:arrow",required:1,number:1,product:"stw",storage:"the_world",name:"The World"}
                            function custom:ui/menu/pages/selection/inventory/check {type:"minecraft:dirt",required:22,number:2,product:"stw",storage:"the_world",name:"The World"}

                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/selection/advancements/check {advancement:"minecraft:end/kill_dragon",product:"stw",storage:"the_world",name:"The World"}
                            function custom:ui/menu/pages/selection/advancements/check {advancement:"minecraft:adventure/totem_of_undying",product:"stw",storage:"the_world",name:"The World"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{the_world:{stw_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                        }
                    }
                }
            }
        }

        function get_mask {
            $$(mask)
        }

        function on_click {
            function custom:ui/run_cmd with storage ui in[0].components."minecraft:custom_data".ui_item

            execute if score .type ui matches 1 run function custom:ui/minecart/load_page
        }

        function on_input {
            execute as @p run function custom:ui/player/return

            function custom:ui/menu/refresh
        }

        function refresh {
            data modify storage ui mask set from storage ui current
            execute on passengers run function custom:ui/menu/get_mask with entity @s data.page
            data modify storage ui current set from storage ui mask

            execute if score .type ui matches 1 run function custom:ui/minecart/load_page
        }
    }

    dir minecart {
        dir click {
            function check {
                # $scoreboard players set @s customUI.SkinClick $(skin_id)
                # execute unless score @s customUI.SkinClickPrevious = @s customUI.SkinClick run scoreboard players reset @s customUI.SkinConfirm
                # scoreboard players operation @s customUI.SkinClickPrevious = @s customUI.SkinClick
                # $execute if score @s customUI.SkinClick matches 1 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
                # $execute if score @s customUI.SkinClick matches 2 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
                # $execute if score @s customUI.SkinClick matches 3 run function custom:ui/menu/pages/selection/$(ability)/skins/equip/$(skin_name)/main
            }

            function shop {
                execute at @s as @p run item replace block 0 -64 0 container.0 from entity @s player.cursor
                data modify storage minecraft:ui custom.purchase.price set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.price
                data modify storage minecraft:ui custom.purchase.context set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.context
                data modify storage minecraft:ui custom.purchase.name set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.name
                data modify storage minecraft:ui custom.purchase.tag set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.tag
                data modify storage minecraft:ui custom.purchase.toggle set from block 0 -64 0 Items[0].components."minecraft:custom_data".ui_item.toggle

                # data modify storage minecraft:ui custom.skin_name set from block 0 -63 0 Items[0].components."minecraft:custom_data".ui_item.skin_name
                # data modify storage minecraft:ui custom.ability set from block 0 -63 0 Items[0].components."minecraft:custom_data".ui_item.ability

                execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                item replace block 0 -64 0 container.0 with air
            }

            dir settings {
                function admin {
                    execute if entity @p[tag=customUI.AdminAccess] run {
                        function custom:ui/menu/pages/settings/administrator/flip
                    } else run {
                        execute at @s as @p run {
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            tellraw @s ["",{"text":"Custom Ability Tome","color":"gold"},{"text":"\n"},{"text":"You're not an ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"r","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"o","color":"blue"},{"text":"r","color":"light_purple"},{"text":",","color":"dark_purple"},{"text":" and ","color":"gray"},{"text":"cannot","color":"red"},{"text":" access this page.","color":"gray"}]
                        }
                        function custom:ui/player/close
                    }
                }
            }
        }

        function cleanup {
            data remove storage minecraft:ui current
            data remove storage minecraft:ui previous
            data remove storage minecraft:ui temp
            data remove storage minecraft:ui in
            data remove storage minecraft:ui mask
            data remove storage minecraft:ui custom
        }

        function load_page {
            data modify entity @s Items set from storage ui current

            data modify storage ui current set from entity @s Items
            execute on passengers run data modify entity @s data.previous set from storage ui current
        }

        function on_change {
            execute at @s as @p run {
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{purchaseable_item:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/shop
                execute if items entity @s player.cursor minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/menu/pages/settings/default/flip
                execute if items entity @s inventory.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/settings/admin
                execute if items entity @s hotbar.* minecraft:arrow[minecraft:custom_data~{ui_item:{settings_button:1b}}] as @n[type=minecraft:chest_minecart,tag=ui] run function custom:ui/minecart/click/settings/admin
                scoreboard players reset @s[tag=!customUI.TempClick] customUI.PurchaseConfirm
                tag @s remove customUI.TempClick
            }
            clear @a *[minecraft:custom_data~{ui_item:{}}]
            data remove storage minecraft:ui custom

            scoreboard players set .type ui 1

            data modify storage ui in set from storage ui current
            data remove storage ui in[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0] run return run function custom:ui/menu/on_input

            data modify storage ui temp set from storage ui previous
            data modify storage ui temp[].components."minecraft:custom_data" merge value {prev:1b}
            data modify entity @s Items insert 0 from storage ui temp[]
            data remove storage ui temp
            data modify storage ui temp append from entity @s Items[{components:{"minecraft:custom_data":{prev:1b}}}]
            data remove storage ui in
            data modify storage ui in append from storage ui temp[{components:{"minecraft:custom_data":{ui_item:{}}}}]
            execute if data storage ui in[0].components."minecraft:custom_data".ui_item.empty run data remove storage ui in[0]
            execute if data storage ui in[0] unless data storage ui in[1] run return run function custom:ui/menu/on_click

            function custom:ui/menu/refresh
        }

        function tick {
            data modify storage ui current set from entity @s Items
            execute on passengers run data modify storage ui previous set from entity @s data.previous
            execute on passengers store result score #bool ui run data modify entity @s data.previous set from storage ui current

            execute if score #bool ui matches 1 run function custom:ui/minecart/on_change
            # why r u down here bro
        }
    }

    function run_cmd {
        $$(cmd)
    }
}