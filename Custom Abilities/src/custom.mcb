function on_load {
    # you can use MC-Build without its internal scoreboard but this will limit the available features
    scoreboard objectives add mcb.internal dummy

    # Universal #
        scoreboard objectives add ui dummy
        scoreboard objectives add ui.id dummy
        scoreboard objectives add customUI.PurchaseConfirm dummy
        scoreboard objectives add customUI.PurchaseItemCount dummy
        scoreboard objectives add customUI.SkinLastPatchID dummy
        scoreboard objectives add customUI.SkinPatchID dummy
        scoreboard objectives add customUI.PlayerOP dummy
        scoreboard objectives add customUI.SelectedOdds dummy
        scoreboard objectives add customUI.PurchaseUsername dummy
        scoreboard objectives add customUI.SelectionPage dummy
        setblock 0 -64 0 minecraft:yellow_shulker_box[facing=west]
        setblock 0 -63 0 shulker_box

        scoreboard objectives add customUniversal.GlobalCounter dummy
        scoreboard objectives add customUniversal.RigID dummy
        scoreboard objectives add customUniversal.AwakeningDuration dummy
        scoreboard players set div16 customUniversal.AwakeningDuration 16
        scoreboard players set x20 customUniversal.AwakeningDuration 20
        scoreboard objectives add customUniversal.Toggle dummy
        scoreboard objectives add customUniversal.ToggleDelay dummy
        scoreboard objectives add customUniversal.CooldownMath dummy
        scoreboard objectives add customUniversal.LastUsedMove dummy
        scoreboard players set div20 customUniversal.CooldownMath 20
        scoreboard players set mult50 customUniversal.CooldownMath 50
        scoreboard players set div100 customUniversal.CooldownMath 100
        scoreboard objectives add customUniversal.FailReturn dummy
        scoreboard objectives add customUniversal.ActiveHotbar dummy
        scoreboard objectives add customUniversal.LastMoveState dummy
        REPEAT (1,9) as i {
            scoreboard objectives add customUniversal.Move<%i%>Cooldown dummy
            scoreboard objectives add customUniversal.Move<%i%>CooldownConverted dummy
            scoreboard objectives add customUniversal.Delay<%i%> dummy
        }
        REPEAT (1,6) as i {
            scoreboard objectives add customUniversal.Move<%i%>Trigger trigger
        }
        scoreboard objectives add customUniversal.ToggleTrigger trigger
        scoreboard objectives add customUniversal.MoveDelay dummy
        scoreboard objectives add customUniversal.MoveCooldowns dummy
        scoreboard players set x20 customUniversal.MoveCooldowns 20
        scoreboard players set div11 customUniversal.MoveCooldowns 11
        scoreboard players set div9 customUniversal.MoveCooldowns 9
        scoreboard objectives add customUniversal.VFXID dummy
        scoreboard objectives add customUniversal.VFXConditions dummy
        scoreboard objectives add customUniversal.VFXCount dummy
        scoreboard objectives add customUniversal.VFXSpeed dummy
        scoreboard objectives add customUniversal.SecretInteractionCount dummy
        scoreboard objectives add customUniversal.QuestID dummy
        scoreboard objectives add customUniversal.QuestDialogue dummy
        scoreboard objectives add customUniversal.PlayerCount dummy
        scoreboard objectives add customUniversal.Disconnected minecraft.custom:minecraft.leave_game

    # Statistics #
        scoreboard objectives add customUniversal.StatisticsPlayerKills dummy
        scoreboard objectives add customUniversal.StatisticsEntityKills dummy

    # Billy #
        scoreboard objectives add customBilly.RigID dummy
        scoreboard objectives add customBilly.ToggleOnText dummy
        scoreboard objectives add customBilly.PassiveSnowParticles dummy
        scoreboard objectives add customBilly.PassiveMaul dummy
        scoreboard objectives add customBilly.EncourageBuffDuration dummy
        scoreboard objectives add customBilly.PhaseMovement dummy
        scoreboard objectives add customBilly.PhaseX dummy
        scoreboard objectives add customBilly.PhaseY dummy
        scoreboard objectives add customBilly.PhaseZ dummy
        scoreboard objectives add customBilly.TrapLimit dummy
        scoreboard objectives add customBilly.TrapDuration dummy
        scoreboard objectives add customBilly.TrapLinger dummy
        scoreboard objectives add customBilly.TrapSuccess dummy
        scoreboard objectives add customBilly.DevourID dummy
        scoreboard objectives add customBilly.DevourX dummy
        scoreboard objectives add customBilly.DevourY dummy
        scoreboard objectives add customBilly.DevourZ dummy
        scoreboard objectives add customBilly.DevourRotationX dummy
        
        # Move Cooldowns #
            function custom:universal/cooldowns/8x {ability:"Billy",storage:"billy",path:"1a",move:1,cooldown:30}
            function custom:universal/cooldowns/8x {ability:"Billy_Homeland",storage:"billy",path:"1b",move:1,cooldown:24}
            function custom:universal/cooldowns/8x {ability:"Billy",storage:"billy",path:"2a",move:2,cooldown:30}
            function custom:universal/cooldowns/8x {ability:"Billy_Homeland",storage:"billy",path:"2b",move:2,cooldown:24}
            function custom:universal/cooldowns/8x {ability:"Billy",storage:"billy",path:"3a",move:3,cooldown:30}
            function custom:universal/cooldowns/8x {ability:"Billy_Homeland",storage:"billy",path:"3b",move:3,cooldown:24}

        # Statistics #
            scoreboard objectives add customBilly.Statistics.PlaytimeT dummy
            scoreboard objectives add customBilly.Statistics.PlaytimeS dummy
            scoreboard objectives add customBilly.Statistics.PlaytimeM dummy
            scoreboard objectives add customBilly.Statistics.PlaytimeH dummy

            scoreboard objectives add customBilly.Statistics.Maul.Activations dummy
            scoreboard objectives add customBilly.Statistics.Maul.Damage dummy

            scoreboard objectives add customBilly.Statistics.HomelandT dummy
            scoreboard objectives add customBilly.Statistics.HomelandS dummy
            scoreboard objectives add customBilly.Statistics.HomelandM dummy
            scoreboard objectives add customBilly.Statistics.HomelandH dummy

            scoreboard objectives add customBilly.Statistics.Encourage.Uses dummy
            scoreboard objectives add customBilly.Statistics.Encourage.BuffedCount dummy

            scoreboard objectives add customBilly.Statistics.Phase.Uses dummy
            scoreboard objectives add customBilly.Statistics.Phase.Distance dummy

            scoreboard objectives add customBilly.Statistics.Snare.Uses dummy
            scoreboard objectives add customBilly.Statistics.Snare.Triggered dummy
            scoreboard objectives add customBilly.Statistics.Snare.Damage dummy

    # Toji #
        scoreboard objectives add customToji.QuestProgress dummy
        scoreboard objectives add customToji.ObtainmentMonsterKills dummy
        scoreboard objectives add customToji.PassiveBloodlust dummy
        scoreboard objectives add customToji.AcrobaticsX dummy
        scoreboard objectives add customToji.AcrobaticsY dummy
        scoreboard objectives add customToji.AcrobaticsZ dummy
        scoreboard objectives add customToji.AcrobaticsRotationX dummy
        scoreboard objectives add customToji.AcrobaticsAnimation dummy
        scoreboard objectives add customToji.BlitzTravel dummy
        scoreboard objectives add customToji.BlitzGravity dummy
        scoreboard objectives add customToji.BlitzDamage dummy
        scoreboard objectives add customToji.SpringX dummy
        scoreboard objectives add customToji.SpringY dummy
        scoreboard objectives add customToji.SpringZ dummy
        scoreboard objectives add customToji.SpringRotationX dummy
        scoreboard objectives add customToji.SpringMath dummy
        scoreboard players set div15 customToji.SpringMath 15
        scoreboard players set div15 customToji.SpringMath 15
        scoreboard objectives add customToji.Spring2DIncrements dummy
        scoreboard objectives add customToji.SpringYIncrements dummy

        # Move Cooldowns #
            function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:1,move:1,cooldown:30}
            function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:2,move:2,cooldown:30}
            function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:3,move:3,cooldown:30}
            function custom:universal/cooldowns {ability:"Toji",storage:"toji",path:4,move:4,cooldown:30}
}

function tick {
    execute as @a run {
        execute as @s[tag=customAbility.User] run {
            execute if entity @s[tag=customAbility.Gojo] run function custom:abilities/gojo/tick
            execute if entity @s[tag=customAbility.TheWorld] run function custom:abilities/the_world/tick
            execute if entity @s[tag=customAbility.Dice] run function custom:abilities/dice/tick
            execute if entity @s[tag=customAbility.Billy] run function custom:abilities/billy/tick
            execute if entity @s[tag=customAbility.Toji] run function custom:abilities/toji/tick
            execute if entity @s[tag=customAbility.Yuji] run function custom:abilities/yuji/tick
            execute if entity @s[tag=customAbility.Avatar] run function custom:abilities/avatar/tick

            execute if score @s customUniversal.ToggleTrigger matches 1.. at @s run function custom:universal/toggle/main
        }

        execute at @s run {
            function custom:ui/player/tick
            execute if score @s customUniversal.Disconnected matches 1.. run function custom:universal/disconnect/self/main
        }
    }

    execute as @e[type=!#custom:misc_mob] at @s run {
        execute if entity @s[tag=customUniversal.ConstantCheck] run function custom:universal/constant_tick/main
        execute as @s[type=chest_minecart,tag=ui] run function custom:ui/minecart/tick
    }
}

dir abilities {
    dir billy {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/billy/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0,customBilly.ToggleOnText=0}] run {
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }

                execute if score @s customBilly.ToggleOnText matches 1.. run {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    function custom:abilities/billy/toggle/text with storage minecraft:custom billy

                    scoreboard players remove @s customBilly.ToggleOnText 1
                }

                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        dir toggle {
            function on {
                function animated_java:billy/summon {args:{animation: 'summon', start_animation: true}}
                execute as @n[type=minecraft:item_display,tag=aj.billy.root,tag=!customBilly.IDAssigned] run {
                    scoreboard players add .global customBilly.RigID 1
                    scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                    tag @s add customBilly.IDAssigned

                    function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.billy.locator.text_location",objective:"customBilly.RigID"}
                }
                scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                tag @s add customUniversal.HideUI
                tag @s add customBilly.ToggleDelay
                scoreboard players set @s customUniversal.ToggleDelay 40 
            }

            function skip_animation {
                tag @s add temp
                function animated_java:billy/summon {args:{animation: 'idle', start_animation: true}}
                execute as @n[type=minecraft:item_display,tag=aj.billy.root,tag=!customBilly.IDAssigned] run {
                    scoreboard players add .global customBilly.RigID 1
                    scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                    execute as @p[tag=customAbility.Billy,tag=temp] run {
                        scoreboard players operation @s customBilly.RigID = .global customBilly.RigID
                        tag @s remove temp
                    }
                    tag @s add customBilly.IDAssigned
                }
            }

            function text {
                $execute if score @s customBilly.ToggleOnText matches 54 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"red","italic":false,"text":"Billy"}}

                $execute if score @s customBilly.ToggleOnText matches 44 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"gold","italic":false,"text":"Demetrius"}}

                execute if score @s customBilly.ToggleOnText matches 35 run block { with storage minecraft:custom billy
                    $function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"yellow","italic":false,"text":"Demarcus"}}
                    tag @s remove customBilly.ToggleDelay
                }

                $execute if score @s customBilly.ToggleOnText matches 25 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"green","italic":false,"text":"Bartholomew"}}

                $execute if score @s customBilly.ToggleOnText matches 15 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"blue","italic":false,"text":"James"}}

                $execute if score @s customBilly.ToggleOnText matches 8 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"light_purple","italic":false,"text":"the"}}
                
                $execute if score @s customBilly.ToggleOnText matches 1 run function custom:universal/text {type:"billy",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location,scores={customBilly.RigID=$(id)}]",what:{"color":"dark_purple","italic":false,"text":"III"}}
            }

            function appear {
                data merge storage minecraft:custom {universal:{vfx:{notation:"~"}}}
                data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"billy",animation:'appear',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.position]"}
            }

            function land {
                execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                block { with storage minecraft:custom universal.fetch_block
                    $particle block{block_state:"$(id)"} ^ ^0.5 ^0.25 0.75 0 0.75 1 50 normal
                    particle minecraft:snowflake ~ ~ ~ 0 0 0 0.25 50 force @a
                }
            }

            function enable {
                scoreboard players set @s customBilly.ToggleOnText 54
            }

            function off {
                title @s actionbar ""
                execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                block { with storage minecraft:custom billy
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] at @s run {
                        playsound minecraft:entity.polar_bear.death player @a ~ ~ ~ 0.5
                        function animated_java:billy/animations/idle/stop
                        function animated_java:billy/animations/withdraw/play
                    }
                }
                scoreboard players reset @s customBilly.ToggleOnText
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }
        }

        dir key_bindings {
            REPEAT (1,3) as i {
                function move<%i%> {
                    execute unless entity @s[gamemode=spectator] run function custom:abilities/billy/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move<%i%>Trigger
                }
            }
        }

        dir hotbar {
            function main {
                REPEAT (1,3) as i {
                    execute unless entity @s[tag=customBilly.PassiveHomeland] run function custom:abilities/billy/hotbar/progress with storage minecraft:custom billy.cooldowns.move<%i%>a
                    execute if entity @s[tag=customBilly.PassiveHomeland] run function custom:abilities/billy/hotbar/progress with storage minecraft:custom billy.cooldowns.move<%i%>b
                }
                
                REPEAT (1,3) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"billy",selected:<%i%>}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
                
                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom billy.hotbar
                    $title @s actionbar [{"text":"\uF807\u05A0\uF817"},{"text":"\uF820\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF811\u05A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom billy.hotbar.move$(selection) set value "u05B0"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        function active {
            execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
            execute unless entity @s[tag=customBilly.ToggleDelay] run {
                scoreboard players add @s customBilly.PassiveSnowParticles 1
                function custom:universal/statistics/time {ability:"Billy",stat:"Playtime"}
            }

            execute if score @s customBilly.PassiveSnowParticles matches 20.. run block { with storage minecraft:custom billy
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] at @s run function animated_java:billy/as_locator {name:'position',command:'particle minecraft:snowflake ~ ~0.5 ~ 0.5 0.5 0.5 0.1 20 force @a'}
                scoreboard players reset @s customBilly.PassiveSnowParticles
            }

            REPEAT (1,3) as i {
                execute unless entity @s[tag=customBilly.ToggleDelay] if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/billy/key_bindings/move<%i%>
            }

            block { with storage minecraft:custom billy
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] unless entity @s[tag=customBilly.Phasing] run tp @s ~ ~ ~ ~ 0
                execute unless entity @s[tag=customUniversal.Animation] unless entity @s[tag=customBilly.ToggleDelay] unless entity @s[tag=customBilly.MaulAnimation] run function custom:abilities/billy/movement/main with storage minecraft:custom billy
            }

            execute unless entity @s[tag=customUniversal.HideUI] run function custom:abilities/billy/hotbar/main
            function custom:abilities/billy/passives/homeland/main

            execute if entity @s[tag=customBilly.PassiveHomeland] run {
                function custom:universal/statistics/time {ability:"Billy",stat:"Homeland"}
                execute if score @s customBilly.PassiveMaul matches 4.. run function custom:abilities/billy/passives/maul/decide/main
            }
            execute unless entity @s[tag=customBilly.PassiveHomeland] if score @s customBilly.PassiveMaul matches 5.. run function custom:abilities/billy/passives/maul/decide/main
        }

        dir passives {
            dir homeland {
                function main {
                    execute if predicate custom:billy/homeland unless entity @s[tag=customBilly.PassiveHomeland] run function custom:abilities/billy/passives/homeland/enter/start
                    execute unless predicate custom:billy/homeland if entity @s[tag=customBilly.PassiveHomeland] run function custom:abilities/billy/passives/homeland/exit/start
                }

                dir enter {
                    function start {
                        function custom:universal/text {type:"homeland",y_offset:0,extra:"function custom:abilities/billy/passives/homeland/enter/text",what:{"color":"aqua","text":"happy",italic:true}}
                        playsound minecraft:entity.panda.bite player @a ~ ~ ~ 0.5
                        tag @s add customBilly.PassiveHomeland
                    }

                    function text {
                        ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]
                        data merge entity @s {background:16711680}
                    }
                }

                dir exit {
                    function start {
                        function custom:universal/text {type:"homeland",y_offset:0,extra:"function custom:abilities/billy/passives/homeland/exit/text",what:{"color":"red","text":"sad",italic:true}}
                        playsound minecraft:entity.panda.hurt player @a ~ ~ ~ 0.5
                        tag @s remove customBilly.PassiveHomeland
                    }

                    function text {
                        ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]
                        data merge entity @s {background:16711680}
                    }
                }
            }

            dir maul {
                function start {
                    scoreboard players add @s customBilly.PassiveMaul 1
                }

                dir decide {
                    function main {
                        execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID

                        execute unless entity @s[tag=customSettings.RiggedOdds] if predicate custom:billy/devour_chance run function custom:abilities/billy/passives/maul/decide/devour
                        execute if entity @s[tag=customSettings.RiggedOdds] run function custom:abilities/billy/passives/maul/decide/devour
                        execute unless entity @s[tag=temp] run function custom:abilities/billy/passives/maul/decide/maul/start

                        tag @s remove temp
                        scoreboard players reset @s customBilly.PassiveMaul
                        scoreboard players add @s customBilly.Statistics.Maul.Activations 1
                    }
                    
                    function devour {
                        tag @s add temp
                        scoreboard players add .global customBilly.DevourID 1

                        # as player
                        block {
                            tag @s add customUniversal.DisconnectCheck
                            tag @s add customBilly.DevourUser
                            tag @s add customBilly.DevourCutscene
                            scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                            execute store result score @s customBilly.DevourX run data get entity @s Pos[0] 1
                            execute store result score @s customBilly.DevourY run data get entity @s Pos[1] 1
                            execute store result score @s customBilly.DevourZ run data get entity @s Pos[2] 1
                            execute store result score @s customBilly.DevourRotationX run data get entity @s Rotation[0] 1

                            gamemode spectator @s
                        }

                        # as victim
                        execute as @n[type=!#custom:not_mob,nbt={HurtTime:10s}] run {
                            tag @s add customUniversal.DisconnectCheck
                            tag @s add customBilly.DevourVictim
                            tag @s add customBilly.DevourCutscene
                            scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                            execute store result score @s customBilly.DevourX run data get entity @s Pos[0] 1
                            execute store result score @s customBilly.DevourY run data get entity @s Pos[1] 1
                            execute store result score @s customBilly.DevourZ run data get entity @s Pos[2] 1
                            execute store result score @s customBilly.DevourRotationX run data get entity @s Rotation[0] 1

                            execute if entity @s[type=minecraft:player] run {
                                gamemode spectator @s
                                execute if score @s customUniversal.Toggle matches 1 run function custom:universal/toggle/main
                            } else run {
                                data merge entity @s {NoAI:1b}
                                tp @s ~ -70 ~
                            }
                        }

                        function custom:abilities/billy/secret_interactions/devour/pass
                    }

                    dir maul {
                        function start {
                            execute as @n[type=!#custom:not_mob,nbt={HurtTime:10s}] run tag @s add customBilly.MaulVictim
                            block { with storage minecraft:custom billy
                                tag @s add customUniversal.DisconnectCheck
                                tag @s add customBilly.MaulAnimation
                                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                                    function animated_java:billy/animations/maul/play
                                    tag @s remove customBilly.Moving
                                    tag @s remove customBilly.Idle
                                }
                            }
                        }

                        function end {
                            tag @s remove customUniversal.DisconnectCheck
                            tag @s remove customBilly.MaulAnimation
                        }
                    }
                }


                function damage {
                    execute store result storage minecraft:custom billy.maul.id int 1 run scoreboard players get @s customBilly.RigID
                    block { with storage minecraft:custom billy.maul
                        $execute as @a[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] run {
                            execute if entity @s[tag=customBilly.PassiveHomeland] run data merge storage minecraft:custom {billy:{maul:{amount:10}}}
                            execute unless entity @s[tag=customBilly.PassiveHomeland] run data merge storage minecraft:custom {billy:{maul:{amount:8}}}
                            block { with storage minecraft:custom billy.maul
                                $execute if entity @s[tag=customSettings.DebugLog] run tellraw @s "trap damage: $(amount)"
                                $scoreboard players add @s customBilly.Statistics.Maul.Damage $(amount)
                            }
                        }
                    }
                    execute as @n[type=!#custom:not_mob,tag=customBilly.MaulVictim] at @s run block { with storage minecraft:custom billy.maul
                        particle block{block_state:"minecraft:redstone_block"} ~ ~ ~ 0.5 0.5 0.5 1 30 force @a
                        $function custom:universal/damage/victim {id:"$(id)",damage:"$(amount)",type:"interactables:microphone",attacker:"tag=customAbility.Billy",objective:"customBilly.RigID",first:"was mauled to death by",second:"using Billy"}
                        tag @s remove customBilly.MaulVictim
                    }
                }
            }
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                # function custom:universal/armor/hide
                $function custom:universal/setup/rig {objective:"$(objective)",item:"$(rig)"}
                $execute store result storage minecraft:custom billy.temp.id int 1 run scoreboard players get .global $(objective)
                $data merge storage minecraft:custom {billy:{temp:{objective:'$(objective)',animation:'$(animation)'}}}
                block { with storage minecraft:custom billy.temp
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={$(objective)=$(id)}] run block { with storage minecraft:custom billy.temp
                        function animated_java:billy/animations/idle/stop
                        function animated_java:billy/animations/movement/stop
                        tag @s remove customBilly.Idle
                        tag @s remove customBilly.Moving
                        $function animated_java:billy/animations/$(animation)/play
                    }
                }
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.billy.locator.camera",objective:"$(objective)"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A1",move:"Encourage"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'encourage'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 0
                        scoreboard players operation @s customUniversal.Move1Cooldown = .BillyCooldown customUniversal.Move1Cooldown
                    }
                    execute unless entity @s[tag=customSettings.NoCooldowns] if entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 1
                        scoreboard players operation @s customUniversal.Move1Cooldown = .Billy_HomelandCooldown customUniversal.Move1Cooldown
                    }
                    scoreboard players set @s customUniversal.LastUsedMove 1
                    scoreboard players set @s customUniversal.MoveDelay 10
                    tag @s add customUniversal.Cancellable

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0

                    scoreboard players add @s customBilly.Statistics.Encourage.Uses 1
                }

                function encourage {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"~"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"billy",animation:'encourage',extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.mouth]"}
                }

                function range {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"~"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"billy",animation:'range',extra:"random value 1..2"}
                }

                function buffs {
                    execute at @s as @a[distance=..4] run {
                        tag @s add customUniversal.ConstantCheck
                        scoreboard players set @s customBilly.EncourageBuffDuration 1200
                        attribute @s minecraft:movement_speed modifier add custom:billy.encourage 0.25 add_multiplied_total
                        attribute @s minecraft:jump_strength modifier add custom:billy.encourage 0.5 add_multiplied_total
                        effect give @s minecraft:haste 60 1 true

                        scoreboard players add .temp customBilly.Statistics.Encourage.BuffedCount 1
                    }
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    block { with storage minecraft:custom billy
                        $execute as @p[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] run scoreboard players operation @s customBilly.Statistics.Encourage.BuffedCount += .temp customBilly.Statistics.Encourage.BuffedCount
                        scoreboard players reset .temp customBilly.Statistics.Encourage.BuffedCount
                    }
                }
            }

            dir 2 {
                function core {
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 2
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/2/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A1",move:"Phase"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'phase'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 0
                        scoreboard players operation @s customUniversal.Move2Cooldown = .BillyCooldown customUniversal.Move2Cooldown
                    }
                    execute unless entity @s[tag=customSettings.NoCooldowns] if entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 1
                        scoreboard players operation @s customUniversal.Move2Cooldown = .Billy_HomelandCooldown customUniversal.Move2Cooldown
                    }
                    scoreboard players set @s customUniversal.LastUsedMove 2
                    scoreboard players set @s customUniversal.MoveDelay 10
                    function custom:universal/stable_player_display/mask {branch:"billy"}
                    tag @s add customUniversal.DisconnectCheck
                    tag @s add customBilly.DisconnectPhase
                    tag @s add customUniversal.HideUI
                    title @s actionbar ""
                    execute store result score @s customBilly.PhaseX run data get entity @s Pos[0] 1
                    execute store result score @s customBilly.PhaseY run data get entity @s Pos[1] 1
                    execute store result score @s customBilly.PhaseZ run data get entity @s Pos[2] 1

                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    block { with storage minecraft:custom billy
                        $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run tag @s add customBilly.Phasing
                    }

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0
                    gamemode spectator @s

                    scoreboard players add @s customBilly.Statistics.Phase.Uses 1
                }

                dir movement {
                    function main {
                        execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                        function custom:abilities/billy/moves/2/movement/recursive with storage minecraft:custom billy
                        scoreboard players reset .distance customBilly.PhaseMovement
                    }

                    function recursive {
                        scoreboard players add .distance customBilly.PhaseMovement 1
                        $execute as @p[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] run scoreboard players add @s customBilly.Statistics.Phase.Distance 1
                        execute if score @s customBilly.PhaseMovement matches 3.. run {
                            tp @s ^ ^0.1 ^
                        } else run {
                            tp @s ^ ^ ^   
                        }

                        execute if block ^ ^ ^0.1 #custom:raycast_pass if entity @s[tag=customBilly.PhaseBegin] run function custom:abilities/billy/moves/2/movement/end with storage minecraft:custom billy

                        execute unless entity @s[tag=customBilly.PhaseEnded] if score .distance customBilly.PhaseMovement matches ..15 positioned ^ ^ ^.1 rotated ~ ~ run function custom:abilities/billy/moves/2/movement/recursive with storage minecraft:custom billy
                    }
                    
                    function end {
                        execute rotated ~ 0 run block { with storage minecraft:custom billy
                            $execute as @p[tag=customAbility.Billy,scores={customBilly.RigID=$(id)}] run {
                                gamemode survival @s
                                tag @s remove customUniversal.DisconnectCheck
                                tag @s remove customBilly.DisconnectPhase
                                tag @s remove customUniversal.HideUI
                                function custom:abilities/billy/moves/2/movement/offset
                                playsound minecraft:entity.bat.takeoff player @s ~ ~ ~ 0.5
                                stopsound @s player minecraft:billy.phase.music
                            }
                            tag @s remove customBilly.PhaseBegin
                            tag @s add customBilly.PhaseEnded
                            tag @s remove customBilly.Phasing
                            function custom:abilities/billy/moves/reset/all {user:"customAbility.Billy",objective:"customBilly.RigID",rig:"billy"}
                            scoreboard players reset @s customBilly.PhaseMovement
                        }
                    }

                    function offset {
                        execute unless block ^ ^ ^ #custom:raycast_pass run {
                            execute positioned ^ ^ ^0.5 run function custom:abilities/billy/moves/2/movement/offset
                            tag @s add temp
                        }
                        execute unless entity @s[tag=temp] run tp @s ~ ~ ~
                        tag @s remove temp
                    }
                }
            }

            dir 3 {
                function core {
                    execute unless score @s customUniversal.Move3Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    execute if score @s customBilly.TrapLimit matches 4.. run function custom:universal/error_messages/find {error:12}
                    block {
                        loot insert 0 -63 0 loot custom:player_head
                        data modify storage minecraft:custom billy.username set string block 0 -63 0 Items[0].components."minecraft:profile".name
                        item replace block 0 -63 0 container.0 with minecraft:air
                        block { with storage minecraft:custom billy
                            $execute if entity @e[type=minecraft:item_display,tag=customBilly.Trap,distance=..4,nbt={data:{username:"$(username)"}}] run function custom:universal/error_messages/find {error:13}
                        }
                    }
                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 3
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/billy/moves/3/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:3,unicode:"u50A1",move:"Snare"}
                }

                function pass {
                    function custom:abilities/billy/moves/setup {rig:"billy",objective:"customUniversal.RigID",animation:'snare_set'}
                    execute unless entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 0
                        scoreboard players operation @s customUniversal.Move3Cooldown = .BillyCooldown customUniversal.Move3Cooldown
                    }
                    execute unless entity @s[tag=customSettings.NoCooldowns] if entity @s[tag=customBilly.PassiveHomeland] run {
                        scoreboard players set @s customUniversal.LastMoveState 1
                        scoreboard players operation @s customUniversal.Move3Cooldown = .Billy_HomelandCooldown customUniversal.Move3Cooldown
                    }
                    scoreboard players set @s customUniversal.LastUsedMove 3
                    scoreboard players set @s customUniversal.MoveDelay 10
                    playsound minecraft:entity.polar_bear.hurt player @a ~ ~ ~ 0.5

                    attribute @s minecraft:movement_speed base set 0.05
                    attribute @s minecraft:jump_strength base set 0

                    scoreboard players add @s customBilly.Statistics.Snare.Uses 1
                }

                function dig {
                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ~ ~ ~ 0.5 0 0.5 1 10 normal
                    }
                }

                function setup {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom billy
                        $execute as @p[tag=customAbility.Billy,scores={customUniversal.RigID=$(id)}] run {
                            scoreboard players add @s customBilly.TrapLimit 1
                            loot insert 0 -63 0 loot custom:player_head
                            data modify storage minecraft:custom billy.username set string block 0 -63 0 Items[0].components."minecraft:profile".name
                            item replace block 0 -63 0 container.0 with minecraft:air
                        }
                        block { with storage minecraft:custom billy
                            $function animated_java:billy/as_locator {name:'position',command:'summon item_display ~ ~1.2 ~ {Tags:["customBilly.Trap","temp","customUniversal.ConstantCheck"],data:{username:"$(username)"}}'}
                            execute as @n[type=minecraft:item_display,tag=customBilly.Trap,tag=temp] run {
                                scoreboard players set @s customBilly.TrapDuration 1500
                                tag @s remove temp
                            }
                        }
                    }
                    
                    function custom:abilities/billy/moves/reset/all {user:"customAbility.Billy",objective:"customUniversal.RigID",rig:"billy"}
                }

                function lurk {
                    scoreboard players remove @s customBilly.TrapDuration 1
                    scoreboard players add @s customBilly.TrapLinger 1

                    execute if score @s customBilly.TrapLinger matches 20.. run {
                        execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                        block { with storage minecraft:custom universal.fetch_block
                            $particle block{block_state:"$(id)"} ~ ~ ~ 0.75 0 0.75 1 15 normal
                        }
                        scoreboard players reset @s customBilly.TrapLinger
                    }

                    execute if entity @e[type=!#custom:not_mob,distance=..1.75] run {
                        data modify storage minecraft:custom billy.trap.self set string entity @s data.username
                        data merge storage minecraft:custom {billy:{trap:{victim:""}}}
                        execute as @n[type=!#custom:not_mob,distance=..1.75] if entity @s[type=minecraft:player] run {
                            loot insert 0 -63 0 loot custom:player_head
                            data modify storage minecraft:custom billy.trap.victim set string block 0 -63 0 Items[0].components."minecraft:profile".name
                            item replace block 0 -63 0 container.0 with minecraft:air
                        }
                        execute store success score @s customBilly.TrapSuccess run data modify storage minecraft:custom billy.trap.victim set from storage minecraft:custom billy.trap.self

                        execute if score @s customBilly.TrapSuccess matches 1 run block { with storage minecraft:custom billy.trap
                            $execute as @n[type=!#custom:not_mob,distance=..1.75,name=!$(self)] run {
                                attribute @s minecraft:movement_speed modifier add custom:billy.snare -0.25 add_multiplied_total
                            }
                            function animated_java:billy/summon {args:{animation: 'snare_trigger', start_animation: true}}
                            execute as @n[type=minecraft:item_display,tag=aj.billy.root,tag=!temp] run block {
                                data modify entity @s data.username set string storage minecraft:custom billy.trap.self
                                tag @s add temp
                            }
                            kill @s
                        }
                    }

                    execute unless score @s customBilly.TrapDuration matches 1.. run {
                        data modify storage minecraft:custom billy.trap.username set string entity @s data.username
                        block { with storage minecraft:custom billy.trap
                            $execute as @a[name=$(username)] run scoreboard players remove @s customBilly.TrapLimit 1
                        }
                        kill @s[type=minecraft:item_display]
                    }
                }

                function slam {
                    data modify storage minecraft:custom billy.trap.damage set string entity @s data.username
                    block { with storage minecraft:custom billy.trap
                        $execute as $(damage) run {
                            scoreboard players add @s customBilly.Statistics.Snare.Triggered 1
                            execute if entity @s[tag=customBilly.PassiveHomeland] run data merge storage minecraft:custom {billy:{trap:{amount:13}}}
                            execute unless entity @s[tag=customBilly.PassiveHomeland] run data merge storage minecraft:custom {billy:{trap:{amount:10}}}
                            block { with storage minecraft:custom billy.trap
                                $execute if entity @s[tag=customSettings.DebugLog] run tellraw @s "trap damage: $(amount)"
                                $scoreboard players add @s customBilly.Statistics.Snare.Damage $(amount)
                            }
                        }
                        $execute as @e[type=!#custom:not_mob,distance=..2.5,name=!$(damage)] run block { with storage minecraft:custom billy.trap
                            $damage @s $(amount)
                            attribute @s minecraft:movement_speed modifier remove custom:billy.snare
                        }
                    }

                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ~ ~ ~ 1 0 1 1 100 force @a
                    }
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Billy,scores={$(objective)=$(id)}] at @s run function custom:abilities/billy/moves/reset/player
                        # $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }

        dir secret_interactions {
            dir devour {
                function pass {
                    execute unless entity @s[tag=customBilly.SecretInteractionDevour] run {
                        tag @s add customBilly.SecretInteractionDevour
                        function custom:universal/secret_interaction_notify {description:["",{"text":"Devour","color":"gold"},{"text":"\n"},{"text":"Everytime ","color":"gray"},{"text":"Maul ","color":"yellow"},{"text":"is activated, there is a ","color":"gray"},{"text":"0.5% chance","color":"green"},{"text":" that Billy plays a cutscene version of the passive instead.","color":"gray"},{"text":"\n"},{"text":"-> Damage: ","color":"gray"},{"text":"30","color":"red"},{"text":"\n"},{"text":"-> Victim Movement Speed: ","color":"gray"},{"text":"0.75x","color":"red"},{"text":"\n"},{"text":"-> Victim Jump Strength: ","color":"gray"},{"text":"0.5x","color":"red"},{"text":"\n"},{"text":"-> Effect Duration:","color":"gray"},{"text":" 15s","color":"yellow"}]}
                    }

                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                    block { with storage minecraft:custom billy
                        $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run function animated_java:billy/remove/this
                        execute rotated ~ 0 run function animated_java:billy_cutscenes/summon {args:{animation: 'devour', start_animation: true}}
                        execute as @n[type=minecraft:item_display,tag=aj.billy_cutscenes.root,tag=!temp] run {
                            scoreboard players operation @s customBilly.DevourID = .global customBilly.DevourID
                            execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.DevourID
                            tag @s add temp
                        }

                        # victim
                        block { with storage minecraft:custom billy
                            $execute as @n[type=!#custom:not_mob,tag=customBilly.DevourVictim,scores={customBilly.DevourID=$(id)}] run function custom:universal/stable_player_display/mask {branch:"billy_cutscenes"}
                        }

                        function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.billy_cutscenes.camera",objective:"customBilly.DevourID"}
                    }
                }

                function end {
                    execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.DevourID
                    function animated_java:billy_cutscenes/remove/this

                    block { with storage minecraft:custom billy
                        $execute as @p[tag=customAbility.Billy,tag=customBilly.DevourUser,scores={customBilly.DevourID=$(id)}] run {
                            execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                            execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                            execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                            execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                            tag @s remove customUniversal.DisconnectCheck
                            tag @s remove customBilly.DevourCutscene
                            tag @s remove customBilly.DevourUser
                            block { with storage minecraft:custom billy
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                            }
                            function custom:abilities/billy/toggle/skip_animation
                            tag @s remove customUniversal.Animation
                            scoreboard players reset @s customBilly.DevourID
                        }
                        
                        $execute as @n[type=!#custom:not_mob,tag=customBilly.DevourVictim,scores={customBilly.DevourID=$(id)}] run block { with storage minecraft:custom billy
                            execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                            execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                            execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                            execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                            $function custom:universal/damage/victim {id:"$(id)",damage:"17",type:"minecraft:generic",attacker:"tag=customAbility.Billy,tag=customBilly.DevourUser",objective:"customBilly.DevourID",first:"was devoured",second:"using Devour"}
                            tag @s remove customUniversal.DisconnectCheck
                            tag @s remove customBilly.DevourCutscene
                            tag @s remove customBilly.DevourVictim
                            block { with storage minecraft:custom billy
                                gamemode survival @s
                                $tp @s $(x) $(y) $(z) $(rotx) 0
                            }

                            execute if entity @s[type=minecraft:player] run {
                                attribute @s minecraft:movement_speed base reset
                                attribute @s minecraft:jump_strength base reset
                                attribute @s minecraft:gravity base reset
                            } else run {
                                data merge entity @s {NoAI:0b}
                            }
                            scoreboard players reset @s customBilly.DevourID
                        }
                    }
                }

                function poof {
                    particle minecraft:poof ~ ~ ~ 0.35 0.35 0.35 0.1 30 force @a
                    playsound minecraft:billy.devour.poof player @a ~ ~ ~ 1
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.05, 0.15, -0.1],Item:{id:"minecraft:dirt",count:2}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.1, 0.15, 0.05],Item:{id:"minecraft:dirt",count:5}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.2, 0.15, 0.0],Item:{id:"minecraft:dirt",count:1}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.15, 0.15, 0.1],Item:{id:"minecraft:dirt",count:6}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.1, 0.15, -0.05],Item:{id:"minecraft:diorite",count:7}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.2, 0.15, 0.0],Item:{id:"minecraft:diorite",count:11}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.0, 0.15, 0.1],Item:{id:"minecraft:diorite",count:1}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.25, 0.15, -0.05],Item:{id:"minecraft:cobblestone",count:1}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.05, 0.15, 0.0],Item:{id:"minecraft:cobblestone",count:12}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.05, 0.15, 0.2],Item:{id:"minecraft:cobblestone",count:1}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.1, 0.15, -0.1],Item:{id:"minecraft:dead_bush",count:19}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.3, 0.15, 0.05],Item:{id:"minecraft:dead_bush",count:1}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.0, 0.15, -0.2],Item:{id:"minecraft:stick",count:10}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[-0.05, 0.15, 0.3],Item:{id:"minecraft:stick",count:2}}
                    summon item ~ ~ ~ {Age:5900,PickupDelay:32767,Motion:[0.2, 0.15, -0.1],Item:{id:"minecraft:stick",count:1}}
                }
            }
        }

        dir movement {
            function main {
                execute if predicate custom:universal/forward run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/backward run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/left run function custom:abilities/billy/movement/moving with storage minecraft:custom billy
                execute if predicate custom:universal/right run function custom:abilities/billy/movement/moving with storage minecraft:custom billy

                execute unless predicate custom:universal/forward unless predicate custom:universal/backward unless predicate custom:universal/left unless predicate custom:universal/right run function custom:abilities/billy/movement/idle with storage minecraft:custom billy
            }

            function moving {
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                    execute unless entity @s[tag=customBilly.Moving] run {
                        function animated_java:billy/animations/movement/play
                    }
                    tag @s remove customBilly.PhaseEnded
                    tag @s remove customBilly.Idle
                    tag @s add customBilly.Moving
                }
            }

            function idle {
                $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                    execute unless entity @s[tag=customBilly.Idle] run {
                        function animated_java:billy/animations/idle/play
                    }
                    tag @s remove customBilly.PhaseEnded
                    tag @s remove customBilly.Moving
                    tag @s add customBilly.Idle
                }
            }
        }

        function disconnect {
            # disconnected with billy active
            execute if entity @s[tag=customAbility.Billy] if score @s customUniversal.Toggle matches 1 run {
                execute store result storage minecraft:custom billy.id int 1 run scoreboard players get @s customBilly.RigID
                block { with storage minecraft:custom billy
                    # cleaning up any potential leftovers
                    $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run function animated_java:billy/remove/this
                }
                function custom:abilities/billy/toggle/skip_animation
            }

            # clear any active snares
            scoreboard players set @s customBilly.TrapLimit 0
            loot insert 0 -63 0 loot custom:player_head
            data modify storage minecraft:custom billy.username set string block 0 -63 0 Items[0].components."minecraft:profile".name
            item replace block 0 -63 0 container.0 with minecraft:air
            block { with storage minecraft:custom billy
                $execute as @e[type=minecraft:item_display,tag=customBilly.Trap,nbt={data:{username:"$(username)"}}] run kill @s[type=minecraft:item_display]
            }

            say a

            # disconnected during a move / cutscene
            execute if entity @s[tag=customUniversal.DisconnectCheck] run {
                # disconnected during phase
                execute if entity @s[tag=customBilly.DisconnectPhase] run {
                    execute store result storage minecraft:custom billy.phase.x int 1 run scoreboard players get @s customBilly.PhaseX
                    execute store result storage minecraft:custom billy.phase.y int 1 run scoreboard players get @s customBilly.PhaseY
                    execute store result storage minecraft:custom billy.phase.z int 1 run scoreboard players get @s customBilly.PhaseZ
                    block { with storage minecraft:custom billy.phase
                        $tp @s $(x) $(y) $(z)
                    }
                    gamemode survival @s
                    
                    tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"You've ","color":"gray"},{"text":"disconnected ","color":"red"},{"text":"during ","color":"gray"},{"text":"Phase,","color":"aqua"},{"text":" rewinding your position back to ","color":"gray"},{"text":"where it was casted.","color":"light_purple"}]
                    playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                    tag @s remove customUniversal.Animation
                    tag @s remove customBilly.DisconnectPhase
                    tag @s remove customUniversal.HideUI
                }

                # disconnected while using devour secret interaction
                execute if entity @s[tag=customBilly.DevourUser] run {
                    execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                    execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                    execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                    execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customBilly.DevourCutscene
                    tag @s remove customBilly.DevourUser
                    tag @s remove customUniversal.Animation
                    block { with storage minecraft:custom billy
                        gamemode survival @s
                        $tp @s $(x) $(y) $(z) $(rotx) 0
                    }
                    function custom:abilities/billy/toggle/skip_animation
                    scoreboard players reset @s customBilly.DevourID
                }

                execute if entity @s[tag=customBilly.DevourVictim] run {
                    execute store result storage minecraft:custom billy.x int 1 run scoreboard players get @s customBilly.DevourX
                    execute store result storage minecraft:custom billy.y int 1 run scoreboard players get @s customBilly.DevourY
                    execute store result storage minecraft:custom billy.z int 1 run scoreboard players get @s customBilly.DevourZ
                    execute store result storage minecraft:custom billy.rotx int 1 run scoreboard players get @s customBilly.DevourRotationX
                    damage @s 25 interactables:tommy_gun
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customBilly.DevourCutscene
                    tag @s remove customBilly.DevourVictim
                    block { with storage minecraft:custom billy
                        gamemode survival @s
                        $tp @s $(x) $(y) $(z) $(rotx) 0
                    }

                    execute if entity @s[type=!minecraft:player] run data merge entity @s {NoAI:0b}
                    scoreboard players reset @s customBilly.DevourID
                    tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"You've ","color":"gray"},{"text":"disconnected ","color":"red"},{"text":"from the game whilst being hit with ","color":"gray"},{"text":"Devour, ","color":"aqua"},{"text":"recieving additional ","color":"gray"},{"text":"damage.","color":"dark_red"}]
                    playsound minecraft:entity.villager.no player @s ~ ~ ~ 0.5
                }

                execute if entity @s[tag=customBilly.MaulAnimation] run tag @s remove customBilly.MaulAnimation
            }
        }
    }

    dir toji {
        function tick {
            execute if score @s customUniversal.Toggle matches 1 run {
                execute at @s run function custom:abilities/toji/active
            }

            execute unless entity @s[scores={customUniversal.Move1Cooldown=0,customUniversal.Move2Cooldown=0,customUniversal.Move3Cooldown=0,customUniversal.Move4Cooldown=0,customUniversal.Delay4=0,customUniversal.AwakeningDuration=0,customUniversal.MoveDelay=0,customUniversal.ToggleDelay=0}] run {
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.Move<%i%>Cooldown matches 1.. run scoreboard players remove @s customUniversal.Move<%i%>Cooldown 1
                }
                
                execute if score @s customUniversal.Delay4 matches 1.. run {
                    scoreboard players remove @s customUniversal.Delay4 1
                    execute if score @s customUniversal.Delay4 matches 0 run {
                        tag @s remove customGojo.InfinityAmplification
                    }
                }

                execute if score @s customUniversal.AwakeningDuration matches 1.. run scoreboard players remove @s customUniversal.AwakeningDuration 1
                execute if score @s customUniversal.ToggleDelay matches 1.. run scoreboard players remove @s customUniversal.ToggleDelay 1
                execute if score @s customUniversal.MoveDelay matches 1.. run scoreboard players remove @s customUniversal.MoveDelay 1
            }
        }

        dir toggle {
            function on {
                playsound minecraft:gojo.toggle.spawn player @s ~ ~ ~ 0.35
                scoreboard players set @s customUniversal.ToggleDelay 20 
            }

            function off {
                title @s actionbar ""
                playsound minecraft:gojo.toggle.remove player @s ~ ~ ~ 0.5
                scoreboard players set @s customUniversal.ToggleDelay 10
            }
        }

        function skin {
            $execute store result storage minecraft:custom toji.skin.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {toji:{skin:{rig:"$(rig)",objective:"$(objective)"}}}
            block { with storage minecraft:custom toji.skin
                $execute as @p[tag=customAbility.Toji,scores={$(objective)=$(id)}] run {
                    execute if entity @s[tag=customToji.SkinDefault] run block { with storage minecraft:custom toji.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/default/apply
                    }
                    execute if entity @s[tag=customToji.SkinWounded] run block { with storage minecraft:custom toji.skin
                        $execute as @n[type=minecraft:item_display,tag=aj.$(rig).root,scores={$(objective)=$(id)}] run function animated_java:$(rig)/variants/wounded/apply
                    }
                }
            }
        }

        dir key_bindings {
            REPEAT (1,4) as i {
                function move<%i%> {
                    function custom:abilities/toji/moves/<%i%>/core
                    scoreboard players reset @s customUniversal.Move<%i%>Trigger
                }
            }
        }

        dir hotbar {
            function main {
                REPEAT (1,4) as i {
                    function custom:abilities/toji/hotbar/progress with storage minecraft:custom toji.cooldowns.move<%i%>
                }
                
                REPEAT (1,4) as i {
                    execute if score @s customUniversal.ActiveHotbar matches <%i%> run {
                        function custom:universal/hotbar/time {ability:"toji",selected:<%i%>}
                    }
                }

                block {
                    execute store result storage minecraft:custom toji.hotbar.bloodlust_string int 1 run scoreboard players get @s customToji.PassiveBloodlust
                    block { with storage minecraft:custom toji.hotbar
                        $execute if score @s customToji.PassiveBloodlust matches 10..99 run data merge storage minecraft:custom {toji:{hotbar:{bloodlust:"$(bloodlust_string)"}}}
                        $execute if score @s customToji.PassiveBloodlust matches 0..9 run data merge storage minecraft:custom {toji:{hotbar:{bloodlust:"0$(bloodlust_string)"}}}
                    }
                }

                execute if score @s customUniversal.ActiveHotbar matches 1 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 2 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 3 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\$(move4)"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }

                execute if score @s customUniversal.ActiveHotbar matches 4 run block { with storage minecraft:custom toji.hotbar
                    $title @s actionbar [{"text":"\uF817\u06B2"},{"text":"\uF826$(bloodlust)","color":"#FFF56B"},{"text":"\uF819\u06A0"},{"text":"\uF800\$(move1)"},{"text":"\uF800\$(move2)"},{"text":"\uF800\$(move3)"},{"text":"\uF800\$(move4)"},{"text":"\uF824\u06B1","color":"#4e5c24"},{"text":"\uF800\u06A1"},{"text":"\uF806\u03B4"},{"text":"\uF808$(time)","color":"yellow"}]
                }
            }

            function progress {
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(10a)..$(11) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A2"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(9a)..$(10b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A3"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(8a)..$(9b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A4"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(7a)..$(8b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A5"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(6a)..$(7b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A6"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(5a)..$(6b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A7"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(4a)..$(5b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A8"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(3a)..$(4b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06A9"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(2a)..$(3b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches $(1)..$(2b) run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"
                $execute if score @s customUniversal.Move$(selection)Cooldown matches 0 run data modify storage minecraft:custom toji.hotbar.move$(selection) set value "u06B0"

                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted = @s customUniversal.Move$(selection)Cooldown
                $scoreboard players operation @s customUniversal.Move$(selection)CooldownConverted /= div20 customUniversal.CooldownMath
            }
        }

        function active {
            REPEAT (1,4) as i {
                execute if score @s customUniversal.Move<%i%>Trigger matches 1.. run function custom:abilities/toji/key_bindings/move<%i%>
            }

            function custom:abilities/toji/hotbar/main
        }

        dir moves {
            function setup {
                tag @s add customUniversal.Animation
                tag @s add customUniversal.DisconnectCheck
                effect give @s minecraft:invisibility infinite 0 true
                particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                function custom:universal/armor/hide
                $execute rotated ~ 0 run function animated_java:toji/summon {args:{animation:'$(animation)', start_animation: true}}
                $function custom:universal/setup/rig {objective:"$(objective)",item:"toji"}

                execute unless entity @s[tag=customSettings.DisplayState] run function custom:universal/stable_player_display/state/model {branch:"toji"}
                execute if entity @s[tag=customSettings.DisplayState] run function custom:universal/stable_player_display/state/skin {branch:"toji"}
                # item modify entity @s hotbar.8 custom:hide

                $function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.camera",objective:"$(objective)"}

                scoreboard players add .global customUniversal.GlobalCounter 1
                scoreboard players operation @s customUniversal.GlobalCounter = .global customUniversal.GlobalCounter
                function custom:universal/setup/pair {type:"minecraft:item_display",what:"aj.toji.root",objective:"customUniversal.GlobalCounter"}
            }

            dir 1 {
                function core {
                    execute unless score @s customUniversal.Move1Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    execute if entity @s[tag=customToji.AcrobaticsRecastable] run {
                        tag @s remove customUniversal.Error1
                        tag @s remove customUniversal.Error2
                        scoreboard players set @s customUniversal.FailReturn 0
                    }
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/1/raycast/start

                    function custom:universal/error_messages/universal
                    
                    scoreboard players set @s customUniversal.ActiveHotbar 1
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/1/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:1,unicode:"u50A0",move:"Acrobatics"}
                }

                dir raycast {
                    function start {
                        tag @s add customToji.AcrobaticsRaycast
                        function custom:universal/error_messages/find {error:"11"}
                        execute anchored eyes positioned ^ ^ ^ run function custom:abilities/toji/moves/1/raycast/fire
                        scoreboard players reset .distance beam
                        tag @s remove customToji.AcrobaticsRaycast
                    }

                    function fire {
                        execute unless block ^ ^ ^.1 #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/found
                        scoreboard players add .distance beam 1
                        execute if score .distance beam matches ..300 positioned ^ ^ ^.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/fire
                    }

                    function found {
                        block {
                            execute unless block ~ ~0.1 ~ #custom:raycast_pass run scoreboard players set @s customToji.AcrobaticsAnimation 1
                            execute positioned ~ ~ ~0.1 unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~0.1 ~ ~ unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~ ~ ~-0.1 unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute positioned ~-0.1 ~ ~ unless block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/1/raycast/wall_or_mantle
                            execute unless block ~ ~-0.1 ~ #custom:raycast_pass run scoreboard players set @s customToji.AcrobaticsAnimation 3
                        }
                        summon marker ~ ~ ~ {NoGravity:1b,Tags:["customToji.AcrobaticsMarker"]}
                        execute store result score @s customToji.AcrobaticsRotationX run data get entity @s Rotation[0]
                        execute store result score @s customToji.AcrobaticsX run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[0]
                        execute store result score @s customToji.AcrobaticsY run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[1]
                        execute store result score @s customToji.AcrobaticsZ run data get entity @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker] Pos[2]
                        kill @n[type=minecraft:marker,tag=customToji.AcrobaticsMarker]

                        scoreboard players set @s customUniversal.FailReturn 0
                        scoreboard players set .distance beam 300
                        tag @s remove customUniversal.Error11
                        tag @s remove customToji.AcrobaticsAnchor
                    }

                    function wall_or_mantle {
                        execute unless block ~ ~ ~ #custom:raycast_pass unless block ~ ~1 ~ #custom:raycast_pass run {
                            scoreboard players set @s customToji.AcrobaticsAnimation 2
                        } else run {
                            scoreboard players set @s customToji.AcrobaticsAnimation 4
                        }
                    }
                }

                function pass {
                    execute unless entity @s[tag=customToji.AcrobaticsRecastable] run {
                        function custom:abilities/toji/moves/setup {animation:'acrobatics_start',objective:"customUniversal.RigID"}
                        execute as @n[tag=aj.toji.locator.acrobatics_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                        scoreboard players set @s customUniversal.MoveLastUsed 1
                        execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move1Cooldown = .TojiCooldown customUniversal.Move1Cooldown
                        scoreboard players set @s customUniversal.MoveDelay 10

                        playsound minecraft:toji.acrobatics.voiceline player @a ~ ~ ~ 0.5
                        attribute @s minecraft:movement_speed base set 0
                        attribute @s minecraft:jump_strength base set 0
                    } else run {
                        scoreboard players remove @s customToji.PassiveBloodlust 2

                        execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                        block { with storage minecraft:custom toji.acrobatics
                            $execute as @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] run {
                                function custom:abilities/toji/moves/1/reposition
                            }
                        }

                        tag @s remove customToji.AcrobaticsRecastable
                    }
                }

                function reposition {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run {
                            execute store result storage minecraft:custom toji.acrobatics.animation int 1 run scoreboard players get @s customToji.AcrobaticsAnimation
                            execute store result storage minecraft:custom toji.acrobatics.x int 1 run scoreboard players get @s customToji.AcrobaticsX
                            execute store result storage minecraft:custom toji.acrobatics.y int 1 run scoreboard players get @s customToji.AcrobaticsY
                            execute store result storage minecraft:custom toji.acrobatics.z int 1 run scoreboard players get @s customToji.AcrobaticsZ
                            execute store result storage minecraft:custom toji.acrobatics.rot_x int 1 run scoreboard players get @s customToji.AcrobaticsRotationX
                        }

                        block { with storage minecraft:custom toji.acrobatics
                            $scoreboard players set @s customToji.AcrobaticsAnimation $(animation)
                            function animated_java:toji/animations/acrobatics_start/stop
                            function animated_java:toji/animations/acrobatics_wall/stop
                            function animated_java:toji/animations/acrobatics_ceiling/stop 
                            function animated_java:toji/animations/acrobatics_ground/stop
                            function animated_java:toji/animations/acrobatics_mantle/stop
                            $execute as @a unless score @s customUniversal.RigID matches $(id) run playsound minecraft:toji.acrobatics.relocate player @s ~ ~ ~ 0.25
                            $tp @s $(x) $(y) $(z) $(rot_x) 0

                            execute if score @s customToji.AcrobaticsAnimation matches 1 run function animated_java:toji/animations/acrobatics_ceiling/play
                            execute if score @s customToji.AcrobaticsAnimation matches 2 run function animated_java:toji/animations/acrobatics_wall/play
                            execute if score @s customToji.AcrobaticsAnimation matches 3 run function animated_java:toji/animations/acrobatics_ground/play
                            execute if score @s customToji.AcrobaticsAnimation matches 4 run function animated_java:toji/animations/acrobatics_mantle/play
                        }
                    }
                }

                function mount {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.acrobatics
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.acrobatics_mount,scores={customUniversal.RigID=$(id)}]
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                        }
                    }
                }

                function wall {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @n[type=minecraft:item_display,tag=aj.toji.locator.acrobatics_mount,scores={customUniversal.RigID=$(id)}] rotated as @s run rotate @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] ~-15 0
                    }
                }

                function determine {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] if score @s customToji.PassiveBloodlust matches 2.. run {
                            tag @s add customToji.AcrobaticsRecastable
                        }
                    }
                }
            }

            dir 2 {
                function core {
                    execute unless score @s customUniversal.Move2Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 2
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/2/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:2,unicode:"u50A0",move:"Blitz"}
                }

                function pass {
                    function custom:abilities/toji/moves/setup {animation:'blitz_start',objective:"customUniversal.RigID"}
                    execute as @n[tag=aj.toji.locator.acrobatics_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 2

                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move2Cooldown = .TojiCooldown customUniversal.Move2Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    function custom:abilities/toji/moves/2/danger_zone
                    execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,tag=!found] run {
                        scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                        tag @s add found
                    }

                    attribute @s minecraft:movement_speed base set 0
                    attribute @s minecraft:jump_strength base set 0
                }

                function aiming {
                    function custom:universal/control/movement {user:"customAbility.Toji",rig:"aj.toji.root",objective:"customUniversal.RigID"}
                    
                    execute store result storage minecraft:custom toji.blitz.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.blitz
                        $execute at @s as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] run tp @s ~ ~ ~ ~ 0
                    }
                }

                function danger_zone {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"~"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"toji",animation:'danger_rectangle',extra:"random value 1..2"}
                }

                function impact_stars_white {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"^"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:2,offsetXR:0,offsetYL:3,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:15,duration:0,branch:"toji",animation:'impact_white',extra:"random value 1..2"}
                }

                function impact_stars_black {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"^"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:2,offsetXR:0,offsetYL:3,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:15,duration:0,branch:"toji",animation:'impact_black',extra:"random value 1..2"}
                }

                function mount {
                    execute store result storage minecraft:custom toji.acrobatics.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.acrobatics
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.acrobatics
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.acrobatics_mount,scores={customUniversal.RigID=$(id)}]
                        }
                    }
                }

                dir damage {
                    function main {
                        execute store result storage minecraft:custom toji.blitz.id int 1 run scoreboard players get @s customUniversal.RigID
                        block { with storage minecraft:custom toji.blitz
                            $execute as @e[type=!#custom:not_mob,tag=!customToji.BlitzDamaged,distance=..2.5] unless entity @s[scores={customUniversal.RigID=$(id)}] run {
                                damage @s 1
                                execute at @s run particle minecraft:sweep_attack ~ ~1 ~ 0 0 0 0 1 force @a
                                tag @s add customToji.BlitzDamaged
                            }
                        }

                        # execute rotated 90 0 run function custom:abilities/toji/moves/2/damage/beam with storage minecraft:custom toji.blitz
                        # scoreboard players reset .distance customToji.BlitzDamage

                        # execute rotated -90 0 run function custom:abilities/toji/moves/2/damage/beam with storage minecraft:custom toji.blitz
                        # scoreboard players reset .distance customToji.BlitzDamage
                    }

                    function beam {
                        # scoreboard players add .distance customToji.BlitzDamage 1

                        # # found entity
                        # $execute as @e[type=!#custom:not_mob,tag=!customToji.BlitzDamaged,dx=0] unless entity @s[scores={customUniversal.RigID=$(id)}] positioned ~-0.99 ~-0.99 ~-0.99 if entity @s[dx=0] positioned ~0.99 ~0.99 ~0.99 run {
                        #     damage @s 1
                        #     execute at @s run particle minecraft:sweep_attack ~ ~1 ~ 0 0 0 0 1 force @a
                        #     tag @s add customToji.BlitzDamaged
                        # }

                        # execute if score .distance customToji.BlitzDamage matches ..25 positioned ^ ^ ^0.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/2/damage/beam with storage minecraft:custom toji.blitz
                    }
                }

                dir decide {
                    function main {
                        execute if block ~ ~-0.1 ~ #custom:raycast_pass run {
                            function animated_java:toji/animations/blitz_fall/play
                            tag @s add customToji.BlitzFalling
                        }
                        execute unless block ~ ~-0.1 ~ #custom:raycast_pass run function animated_java:toji/animations/blitz_land/play
                    }
                }

                dir movement {
                    function main {
                        particle minecraft:instant_effect ~ ~1 ~ 1 1 1 0 10 force @a
                        function custom:abilities/toji/moves/2/movement/recursive
                        execute if entity @s[tag=customToji.BlitzFalling] run {
                            execute if entity @s[tag=customToji.BlitzGravityCorrected] run {
                                function animated_java:toji/animations/blitz_slam/play
                                tag @s remove customToji.BlitzFalling
                            }
                            execute unless block ~ ~-0.1 ~ #custom:raycast_pass run {
                                function animated_java:toji/animations/blitz_slam/play
                                tag @s remove customToji.BlitzFalling
                            }
                        }
                        scoreboard players reset .distance customToji.BlitzTravel
                        tag @s remove customToji.BlitzGravityCorrected
                    }

                    function recursive {
                        scoreboard players add .distance customToji.BlitzTravel 1

                        # if = not solid (air / pass-through)
                        # unless = solid block

                        execute if block ^ ^-0.1 ^ #custom:raycast_pass run {
                            # not solid ground
                            scoreboard players add @s customToji.BlitzGravity 1

                            # max grav
                            execute if score @s customToji.BlitzGravity matches 250.. run {
                                scoreboard players set @s customToji.BlitzGravity 250
                            }

                            scoreboard players operation .Math customToji.BlitzGravity = @s customToji.BlitzGravity
                            scoreboard players operation .Math customToji.BlitzGravity *= @s customToji.BlitzGravity

                            execute store result storage minecraft:custom toji.blitz.fall double 0.000025 run scoreboard players get .Math customToji.BlitzGravity
                            block { with storage minecraft:custom toji.blitz
                                $execute positioned ^ ^-$(fall) ^ run {
                                    execute if block ~ ~ ~ #custom:raycast_pass run tp @s ^ ^ ^
                                    execute unless block ~ ~ ~ #custom:raycast_pass unless entity @s[tag=customToji.BlitzGravityCorrected] run function custom:abilities/toji/moves/2/movement/gravity_correct
                                }
                            }
                            data remove storage minecraft:custom toji.blitz.fall
                        } else run {
                            # solid ground
                            execute if block ^ ^ ^0.5 #custom:raycast_pass if block ^ ^1 ^0.5 #custom:raycast_pass run {
                                tp @s ^ ^ ^
                            } else execute unless block ^ ^ ^0.5 #custom:raycast_pass if block ^ ^1 ^0.5 #custom:raycast_pass run {
                                tp @s ^ ^1 ^
                            } else execute unless block ^ ^ ^0.5 #custom:raycast_pass unless block ^ ^1 ^0.5 #custom:raycast_pass run {
                                function custom:abilities/toji/moves/2/movement/end
                            }

                            # reset gravity when ground is hit
                            scoreboard players reset @s customToji.BlitzGravity
                        }
                        execute if score .distance customToji.BlitzTravel matches ..26 positioned ^ ^ ^0.05 rotated ~ ~ unless entity @s[tag=customToji.BlitzWall] run function custom:abilities/toji/moves/2/movement/recursive
                    }

                    function gravity_correct {
                        execute if block ~ ~ ~ #custom:raycast_pass run {
                            tp @s ~ ~ ~
                            tag @s add customToji.BlitzGravityCorrected
                        }
                        execute unless block ~ ~ ~ #custom:raycast_pass positioned ~ ~0.01 ~ run function custom:abilities/toji/moves/2/movement/gravity_correct
                    }

                    function end {
                        tag @s add customToji.BlitzWall
                    }
                }

                function land {
                    playsound minecraft:toji.blitz.land player @a ~ ~ ~ 1
                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ^ ^0.5 ^ 1.5 0 1.5 1 100 normal
                    }
                }
            }

            dir 4 {
                function core {
                    execute unless score @s customUniversal.Move4Cooldown matches 0 run function custom:universal/error_messages/find {error:1}
                    execute if entity @s[tag=customUniversal.Animation] run function custom:universal/error_messages/find {error:2}
                    function custom:universal/error_messages/universal

                    scoreboard players set @s customUniversal.ActiveHotbar 4
                    execute unless score @s customUniversal.FailReturn matches 1 run function custom:abilities/toji/moves/4/pass
                    execute if score @s customUniversal.FailReturn matches 1 run function custom:universal/error_messages/fail {number:4,unicode:"u50A0",move:"Spring"}
                }

                function pass {
                    function custom:abilities/toji/moves/setup {animation:'spring_windup',objective:"customUniversal.RigID"}
                    tag @s add customUniversal.Cancellable
                    scoreboard players set @s customUniversal.MoveLastUsed 4
                    execute as @n[tag=aj.toji.locator.coil_mount] run scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID

                    function custom:abilities/toji/moves/4/danger_zone
                    execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,tag=!found] run {
                        scoreboard players operation @s customUniversal.RigID = .global customUniversal.RigID
                        tag @s add found
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run scoreboard players operation @s customUniversal.Move4Cooldown = .TojiCooldown customUniversal.Move4Cooldown
                    scoreboard players set @s customUniversal.MoveDelay 10

                    attribute @s minecraft:movement_speed base set 0.025
                    attribute @s minecraft:jump_strength base set 0
                }

                function danger_zone {
                    data merge storage minecraft:custom {universal:{vfx:{notation:"~"}}}
                    data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                    data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                    execute rotated ~ 0 run function custom:universal/vfx/spawn {mode:1,speed:0,count:1,duration:0,branch:"toji",animation:'danger_zone',extra:"random value 1..2"}
                }

                dir raycast {
                    function start {
                        tag @s add customToji.SpringRaycast
                        execute anchored eyes positioned ^ ^ ^ run function custom:abilities/toji/moves/4/raycast/fire
                        scoreboard players reset .distance beam
                        tag @s remove customToji.SpringRaycast
                    }

                    function fire {
                        execute unless block ^ ^ ^.1 #custom:raycast_pass unless block ~ ~-1 ~ #custom:raycast_pass run function custom:abilities/toji/moves/4/raycast/found
                        scoreboard players add .distance beam 1
                        execute if score .distance beam matches ..300 positioned ^ ^ ^.1 rotated ~ ~ if block ~ ~ ~ #custom:raycast_pass run function custom:abilities/toji/moves/4/raycast/fire
                    }

                    function found {
                        execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                        block { with storage minecraft:custom toji.spring
                            execute store result score @s customToji.SpringRotationX run data get entity @s Rotation[0] 10
                            execute store result storage minecraft:custom toji.spring.rotation float 0.1 run scoreboard players get @s customToji.SpringRotationX
                            $execute as @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] align xz positioned ~0.5 ~ ~0.5 run block { with storage minecraft:custom toji.spring
                                $tp @s ~ ~ ~ $(rotation) 0
                            }
                            $execute store result score @s customToji.SpringX run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[0] 1000
                            $execute store result score @s customToji.SpringY run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[1] 1000
                            $execute store result score @s customToji.SpringZ run data get entity @n[type=minecraft:item_display,tag=aj.toji_vfx.root,scores={customUniversal.RigID=$(id)}] Pos[2] 1000
                        }

                        scoreboard players set .distance beam 300
                        tag @s remove customToji.SpringAnchor
                    }
                }

                function coil_start {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.spring
                        # Locate Endpoint
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.spring
                            scoreboard players operation dx customToji.SpringMath = @s customToji.SpringX
                            $execute store result score t customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[0] 1000
                            scoreboard players operation dx customToji.SpringMath -= t customToji.SpringMath
                            scoreboard players operation dz customToji.SpringMath = @s customToji.SpringZ
                            $execute store result score t customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[2] 1000
                            scoreboard players operation dz customToji.SpringMath -= t customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath = dx customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath *= dx customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath = dz customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath *= dz customToji.SpringMath
                            scoreboard players operation r2 customToji.SpringMath += t customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = dx customToji.SpringMath
                            $execute store result score ax customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[0] 0
                            execute if score g customToji.SpringMath matches ..-1 run scoreboard players operation g customToji.SpringMath *= -1 customToji.SpringMath
                            scoreboard players operation t customToji.SpringMath = dz customToji.SpringMath
                            execute if score t customToji.SpringMath matches ..-1 run scoreboard players operation t customToji.SpringMath *= -1 customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath += t customToji.SpringMath
                            scoreboard players set two customToji.SpringMath 2
                            execute if score g customToji.SpringMath matches 0 run scoreboard players set g customToji.SpringMath 1
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath = r2 customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath += g customToji.SpringMath
                            scoreboard players operation q customToji.SpringMath /= two customToji.SpringMath
                            scoreboard players operation g customToji.SpringMath = q customToji.SpringMath
                            scoreboard players operation dist1000 customToji.SpringMath = g customToji.SpringMath
                            scoreboard players operation @s customToji.Spring2DIncrements = dist1000 customToji.SpringMath
                            scoreboard players operation @s customToji.Spring2DIncrements /= div15 customToji.SpringMath

                            $execute store result score posY1000 customToji.SpringMath run data get entity @n[type=minecraft:item_display,tag=aj.toji.root,scores={customUniversal.RigID=$(id)}] Pos[1] 1000
                            scoreboard players operation tgtY1000 customToji.SpringMath = @s customToji.SpringY
                            scoreboard players operation dy1000 customToji.SpringMath = tgtY1000 customToji.SpringMath
                            scoreboard players operation dy1000 customToji.SpringMath -= posY1000 customToji.SpringMath

                            scoreboard players operation @s customToji.SpringYIncrements = dy1000 customToji.SpringMath
                            scoreboard players operation @s customToji.SpringYIncrements /= div15 customToji.SpringMath

                            execute store result storage minecraft:custom toji.spring.total_distance double 0.001 run scoreboard players get dist1000 customToji.SpringMath
                            execute store result storage minecraft:custom toji.spring.rotation float 0.1 run scoreboard players get @s customToji.SpringRotationX
                            execute store result storage minecraft:custom toji.spring.2Dincrements double 0.001 run scoreboard players get @s customToji.Spring2DIncrements
                            execute store result storage minecraft:custom toji.spring.Yincrements double 0.001 run scoreboard players get @s customToji.SpringYIncrements
                            block { with storage minecraft:custom toji.spring
                                $tellraw @a[tag=customSettings.DebugLog] "spring debug log\ndistance: $(total_distance)m\nrotation: $(rotation)f\n2Dincrements: $(2Dincrements)m\nYincrements: $(Yincrements)m"
                            }
                        }

                        block { with storage minecraft:custom toji.spring
                            $rotate @s $(rotation) 0
                        }
                    }

                    function animated_java:toji/animations/spring_windup/stop
                    function animated_java:toji/animations/spring_coil/play
                }

                function coil_movement {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    block { with storage minecraft:custom toji.spring
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run {
                            execute store result storage minecraft:custom toji.spring.2Dincrements double 0.001 run scoreboard players get @s customToji.Spring2DIncrements
                            execute store result storage minecraft:custom toji.spring.Yincrements double 0.001 run scoreboard players get @s customToji.SpringYIncrements
                        }

                        block { with storage minecraft:custom toji.spring
                            $tp @s ^ ^$(Yincrements) ^$(2Dincrements)
                        }

                        execute if predicate custom:universal/0.35 run playsound minecraft:toji.spring.rapid_spin player @a ~ ~ ~ 0.5
                    }
                    function animated_java:toji/as_locator {name:'coil_mount',command:'particle minecraft:cloud ~ ~ ~ 0.1 0.1 0.1 0.1 2 force @a'}
                }

                function mount {
                    execute store result storage minecraft:custom toji.spring.id int 1 run scoreboard players get @s customUniversal.RigID
                    $data merge storage minecraft:custom {toji:{spring:{movement:$(movement)}}}

                    block { with storage minecraft:custom toji.spring
                        $execute as @p[tag=customAbility.Toji,scores={customUniversal.RigID=$(id)}] run block { with storage minecraft:custom toji.spring
                            $ride @s mount @n[type=minecraft:item_display,tag=aj.toji.locator.coil_mount,scores={customUniversal.RigID=$(id)}]
                            attribute @s minecraft:movement_speed base reset
                            attribute @s minecraft:jump_strength base reset
                        }
                        $execute positioned ^ ^ ^$(movement) if block ^ ^ ^ #custom:raycast_pass run tp @s ^ ^ ^ $(rotation) 0
                        # $tp @s ^ ^ ^$(movement) $(rotation) 0
                    }
                }

                function land {
                    execute positioned ~ ~-1 ~ run function custom:universal/fetch_block
                    block { with storage minecraft:custom universal.fetch_block
                        $particle block{block_state:"$(id)"} ^ ^0.5 ^ 1.5 0 1.5 1 100 normal
                    }
                }
            }

            dir reset {
                function all {
                    $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
                    $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
                    block { with storage minecraft:custom universal.control
                        $execute as @a[tag=customAbility.Toji,scores={$(objective)=$(id)}] at @s run function custom:abilities/toji/moves/reset/player
                        $function animated_java:$(rig)/remove/this
                    }
                }
                function player {
                    attribute @s minecraft:movement_speed base reset
                    attribute @s minecraft:jump_strength base reset
                    attribute @s minecraft:gravity base reset
                    particle minecraft:snowflake ~ ~1 ~ 0 0 0 0.35 20

                    effect clear @s minecraft:invisibility
                    ride @s dismount

                    # item modify entity @s hotbar.8 custom:gojo/base
                    function custom:universal/armor/reveal

                    tag @s remove customToji.AcrobaticsRecastable
                    tag @s remove customUniversal.Cancellable
                    tag @s remove customUniversal.DisconnectCheck
                    tag @s remove customUniversal.Animation
                }
            }
        }
    }
}

dir universal {
    dir statistics {
        function time {
            $scoreboard players add @s custom$(ability).Statistics.$(stat)T 1
            $execute if score @s custom$(ability).Statistics.$(stat)T matches 20.. run block { {ability:"$(ability)",stat:"$(stat)"}
                execute if items entity @s weapon.* *[minecraft:custom_data={ui:1b}] as @n[type=minecraft:chest_minecart,tag=ui,tag=customUI.StatisticsPage] run item replace entity @s container.0 with air
                $scoreboard players reset @s custom$(ability).Statistics.$(stat)T
                $scoreboard players add @s custom$(ability).Statistics.$(stat)S 1
                $execute if score @s custom$(ability).Statistics.$(stat)S matches 60.. run block { {ability:"$(ability)",stat:"$(stat)"}
                    $scoreboard players reset @s custom$(ability).Statistics.$(stat)S
                    $scoreboard players add @s custom$(ability).Statistics.$(stat)M 1
                    $execute if score @s custom$(ability).Statistics.$(stat)M matches 60.. run block { {ability:"$(ability)",stat:"$(stat)"}
                        $scoreboard players reset @s custom$(ability).Statistics.$(stat)M
                        $scoreboard players add @s custom$(ability).Statistics.$(stat)H 1
                    }
                }
            }
        }

        dir fetch {
            function billy {
                execute store result storage minecraft:custom billy.statistics.playtime_s int 1 run scoreboard players get @s customBilly.Statistics.PlaytimeS
                execute store result storage minecraft:custom billy.statistics.playtime_m int 1 run scoreboard players get @s customBilly.Statistics.PlaytimeM
                execute store result storage minecraft:custom billy.statistics.playtime_h int 1 run scoreboard players get @s customBilly.Statistics.PlaytimeH
                execute store result storage minecraft:custom billy.statistics.maul_activations int 1 run scoreboard players get @s customBilly.Statistics.Maul.Activations
                execute store result storage minecraft:custom billy.statistics.maul_damage int 1 run scoreboard players get @s customBilly.Statistics.Maul.Damage
                execute store result storage minecraft:custom billy.statistics.homelandtime_s int 1 run scoreboard players get @s customBilly.Statistics.HomelandS
                execute store result storage minecraft:custom billy.statistics.homelandtime_m int 1 run scoreboard players get @s customBilly.Statistics.HomelandM
                execute store result storage minecraft:custom billy.statistics.homelandtime_h int 1 run scoreboard players get @s customBilly.Statistics.HomelandH
                execute store result storage minecraft:custom billy.statistics.encourage_uses int 1 run scoreboard players get @s customBilly.Statistics.Encourage.Uses
                execute store result storage minecraft:custom billy.statistics.encourage_buffedcount int 1 run scoreboard players get @s customBilly.Statistics.Encourage.BuffedCount
                execute store result storage minecraft:custom billy.statistics.phase_uses int 1 run scoreboard players get @s customBilly.Statistics.Phase.Uses
                execute store result storage minecraft:custom billy.statistics.phase_distance int 0.1 run scoreboard players get @s customBilly.Statistics.Phase.Distance
                execute store result storage minecraft:custom billy.statistics.snare_uses int 1 run scoreboard players get @s customBilly.Statistics.Snare.Uses
                execute store result storage minecraft:custom billy.statistics.snare_triggered int 1 run scoreboard players get @s customBilly.Statistics.Snare.Triggered
                execute store result storage minecraft:custom billy.statistics.snare_damage int 1 run scoreboard players get @s customBilly.Statistics.Snare.Damage
            }
        }
    }

    dir disconnect {
        function online {

        }

        dir self {
            function main {
                function custom:abilities/billy/disconnect

                scoreboard players reset @s customUniversal.Disconnected
            }
        }
    }

    dir constant_tick {
        function main {
            # the world barrage
            execute if entity @s[tag=customTheWorld.BarrageVictim] unless entity @e[type=minecraft:item_display,tag=aj.the_world.locator.hitbox,tag=customTheWorld.BarrageAnchor,distance=..2.5] run function custom:universal/constant_tick/world_barrage

            # shrine delay
            execute if entity @s[type=minecraft:item_display,tag=aj.yuji_vfx.root,tag=customYuji.ShrineIDAssigned] if score @s customYuji.ShrineDelay matches 1.. run function custom:universal/constant_tick/shrine_delay

            # billy encourage
            execute if score @s customBilly.EncourageBuffDuration matches 1.. run function custom:universal/constant_tick/encourage

            # billy snare lurk
            execute if entity @s[type=minecraft:item_display,tag=customBilly.Trap] run function custom:abilities/billy/moves/3/lurk

            # if all constant ticks are neutral
            execute if entity @s[tag=!customTheWorld.BarrageVictim,tag=!customBilly.Trap] unless entity @s[scores={customBilly.EncourageBuffDuration=1..}] run tag @s remove customUniversal.ConstantCheck
        }

        function world_barrage {
            attribute @s minecraft:movement_speed base reset
            attribute @s minecraft:jump_strength base reset
            effect clear @s minecraft:weakness
            tag @s remove customTheWorld.BarrageVictim
        }

        function shrine_delay {
            scoreboard players remove @s customYuji.ShrineDelay 1
            execute if score @s customYuji.ShrineDelay matches 0 run {
                function animated_java:yuji_vfx/animations/shrine_spawn/play
                tag @s add customYuji.ShrinePlaying
            }
        }

        function encourage {
            scoreboard players remove @s customBilly.EncourageBuffDuration 1

            execute unless score @s customBilly.EncourageBuffDuration matches 1.. run {
                attribute @s minecraft:movement_speed modifier remove custom:billy.encourage
                attribute @s minecraft:jump_strength modifier remove custom:billy.encourage
            }
        }
    }

    dir advancements {
        function killed_monster {
            execute if score @s customToji.QuestProgress matches 2 run {
                scoreboard players add @s customToji.ObtainmentMonsterKills 1
            }
            advancement revoke @s only custom:killed_monster
        }
    }

    function secret_interaction_notify {
        # function custom:universal/secret_interaction_notify {description:["",{"text":"Devour","color":"gold"},{"text":"\n"},{"text":"Everytime ","color":"gray"},{"text":"Maul ","color":"yellow"},{"text":"is activated, there is a ","color":"gray"},{"text":"0.5% chance","color":"green"},{"text":" that Billy plays a cutscene version of the passive instead.","color":"gray"},{"text":"\n"},{"text":"-> Damage: ","color":"gray"},{"text":"30","color":"red"},{"text":"\n"},{"text":"-> Victim Movement Speed: ","color":"gray"},{"text":"0.75x","color":"red"},{"text":"\n"},{"text":"-> Victim Jump Strength: ","color":"gray"},{"text":"0.5x","color":"red"},{"text":"\n"},{"text":"-> Effect Duration:","color":"gray"},{"text":" 15s","color":"yellow"}]}
        $tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"C","color":"red"},{"text":"o","color":"gold"},{"text":"n","color":"yellow"},{"text":"g","color":"green"},{"text":"r","color":"blue"},{"text":"a","color":"light_purple"},{"text":"t","color":"dark_purple"},{"text":"u","color":"red"},{"text":"l","color":"gold"},{"text":"a","color":"yellow"},{"text":"t","color":"green"},{"text":"i","color":"blue"},{"text":"o","color":"light_purple"},{"text":"n","color":"dark_purple"},{"text":"s","color":"red"},{"text":"!","color":"gold"},{"text":" You've discovered a new ","color":"gray"},{"text":"[Secret Interaction]","color":"light_purple","hover_event":{"action":"show_text","value":[$(description)]}}]
        playsound minecraft:entity.villager.yes player @s ~ ~ ~ 0.5
        scoreboard players add @s customUniversal.SecretInteractionCount 1
    }

    function text {
        # function custom:universal/text {type:"up",y_offset:0,extra:"ride @s mount @n[type=minecraft:item_display,tag=aj.billy.locator.text_location]",what:{"color":"yellow","text":"Billy"}}
        $execute at @s positioned ~ ~$(y_offset) ~ run function animated_java:text_display/summon {args:{animation: '$(type)', start_animation: true}}
        $data merge storage minecraft:custom {universal:{text:{what:$(what),extra:"$(extra)"}}}
        execute as @n[type=minecraft:text_display,tag=aj.text_display.text_display.display,tag=!customUniversal.WrittenText] run block { with storage minecraft:custom universal.text
            $data merge entity @s {text:$(what)}
            tag @s add customUniversal.WrittenText
        }
        execute as @n[type=minecraft:item_display,tag=aj.text_display.root,tag=!customUniversal.TextPost] run block { with storage minecraft:custom universal.text
            $$(extra)
            tag @s add customUniversal.TextPost
        }
    }

    function admin_setup {
        tag @s add customUI.AdminAccess
        tellraw @s ["",{"text":"Custom Abilities","color":"gold"},{"text":"\n"},{"text":"You now have complete ","color":"gray"},{"text":"A","color":"red"},{"text":"d","color":"gold"},{"text":"m","color":"yellow"},{"text":"i","color":"green"},{"text":"n","color":"blue"},{"text":"i","color":"light_purple"},{"text":"s","color":"dark_purple"},{"text":"t","color":"red"},{"text":"a","color":"gold"},{"text":"t","color":"yellow"},{"text":"o","color":"green"},{"text":"r","color":"blue"},{"text":" access to everything relating to ","color":"gray"},{"text":"Custom Abilities!","color":"aqua"}]
    }

    dir vfx {
        function enable {
            scoreboard players add .global customUniversal.VFXID 1
            scoreboard players operation @s customUniversal.VFXID = .global customUniversal.VFXID
        }

        function spawn {
            #  --   Required Args  --   #
            # Mode: 1 - 3 | 
            
            # Mode 1 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:1,offsetXR:50,offsetYL:1,offsetYR:50,offsetZL:1,offsetZR:50}}}
                # data merge storage minecraft:custom {universal:{vfx:{duration:30,speedXL:1,speedXR:50,speedYL:1,speedYR:50,speedZL:1,speedZR:50}}}
                # function custom:universal/vfx/spawn {mode:1,speed:1,duration:300,count:10,branch:"gojo",animation:'lapis_blue',extra:"random value 1..2"}

            # Mode 3 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                # function custom:universal/vfx/spawn {mode:3,speed:0,count:1,duration:0,branch:"gojo",animation:'light_beam'}

            # Mode 3 EX
                # data merge storage minecraft:custom {universal:{vfx:{offsetXL:0,offsetXR:0,offsetYL:0,offsetYR:0,offsetZL:0,offsetZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{speedXL:0,speedXR:0,speedYL:0,speedYR:0,speedZL:0,speedZR:0}}}
                # data merge storage minecraft:custom {universal:{vfx:{mode:3,speed:0,animation:'lapis_blue'}}}

            # Mode 1 - Spawning with a specific offset.
            # Mode 2 - Spawning with a random offset, provided by args.
            
            $scoreboard players set @s customUniversal.VFXCount $(count)
            $scoreboard players set .Mode customUniversal.VFXConditions $(mode)
            $data merge storage minecraft:custom {universal:{vfx:{speed:$(speed),animation:'$(animation)',duration:$(duration),branch:"$(branch)",extra:"$(extra)"}}}

            # Particle with speed, duration, and random rotation config
            execute if score .Mode customUniversal.VFXConditions matches 1 run function custom:universal/vfx/mode_1

            # Mounting spawner with NO rotation
            execute if score .Mode customUniversal.VFXConditions matches 2 run function custom:universal/vfx/mode_2

            # Mounting spawner with RANDOM rotation
            execute if score .Mode customUniversal.VFXConditions matches 3 run function custom:universal/vfx/mode_3

            # Particle with speed, duration, and inherited random rotation config
            execute if score .Mode customUniversal.VFXConditions matches 4 run function custom:universal/vfx/mode_4
            
            # scoreboard players set .Mode customUniversal.VFXConditions 0
            # scoreboard players set .Speed customUniversal.VFXConditions 0
            # data remove storage minecraft:custom universal.vfx
        }

        function mode_1 {
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.offsetXLfinal int 1 run random value -$(offsetXL)..$(offsetXL)
                $execute store result storage minecraft:custom universal.vfx.offsetXRfinal int 1 run random value 0..$(offsetXR)
                $execute store result storage minecraft:custom universal.vfx.offsetYLfinal int 1 run random value -$(offsetYL)..$(offsetYL)
                $execute store result storage minecraft:custom universal.vfx.offsetYRfinal int 1 run random value 0..$(offsetYR)
                $execute store result storage minecraft:custom universal.vfx.offsetZLfinal int 1 run random value -$(offsetZL)..$(offsetZL)
                $execute store result storage minecraft:custom universal.vfx.offsetZRfinal int 1 run random value 0..$(offsetZR)

                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get .global customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $execute positioned $(notation)$(offsetXLfinal).$(offsetXRfinal) $(notation)$(offsetYLfinal).$(offsetYRfinal) $(notation)$(offsetZLfinal).$(offsetZRfinal) run function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $execute as @e[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless entity @s[tag=customUniversal.VFXSpawned] run block { with storage minecraft:custom universal.vfx
                        $data merge entity @s {teleport_duration:$(duration)}
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $scoreboard players set @s customUniversal.VFXSpeed $(speed)
                        tag @s add customUniversal.VFXSpawned
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_1
        }

        function mode_2 {
            block {
                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get @s customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $function animated_java:vfx_billboard/summon {args:{animation:'$(animation)', start_animation: true}}
                    execute as @e[type=minecraft:item_display,tag=aj.vfx_billboard.root,tag=customUniversal.VFXBillboard] run block { with storage minecraft:custom universal.vfx
                        # scoreboard players set @s customUniversal.VFXRotation 1
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=!temp] run {
                            tag @s add temp
                        }

                        $execute as @n[type=minecraft:item_display,tag=aj.$(branch)_vfx.root,tag=customUniversal.VFXSpawn] run {
                            ride @s mount @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp]
                            tag @s remove customUniversal.VFXSpawn
                        }

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp] run {
                            tag @s remove customUniversal.VFXBillboardMount
                            tag @s remove temp
                        }

                        tag @s remove customUniversal.VFXBillboard
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_2
        }

        function mode_3 {
            block {
                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get @s customUniversal.VFXID
                execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
                execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90

                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $function animated_java:vfx_billboard/summon {args:{animation:'$(animation)', start_animation: true}}
                    execute as @e[type=minecraft:item_display,tag=aj.vfx_billboard.root,tag=customUniversal.VFXBillboard] run block { with storage minecraft:custom universal.vfx
                        # scoreboard players set @s customUniversal.VFXRotation 1
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $rotate @s $(rotationX) $(rotationY)

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=!temp] run {
                            tag @s add temp
                        }

                        $execute as @n[type=minecraft:item_display,tag=aj.$(branch)_vfx.root,tag=customUniversal.VFXSpawn] run {
                            ride @s mount @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp]
                            tag @s remove customUniversal.VFXSpawn
                        }

                        execute as @n[type=minecraft:item_display,tag=customUniversal.VFXBillboardMount,tag=notMounted,tag=temp] run {
                            tag @s remove customUniversal.VFXBillboardMount
                            tag @s remove temp
                        }

                        tag @s remove customUniversal.VFXBillboard
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_3
        }

        function mode_4 {
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.offsetXLfinal int 1 run random value -$(offsetXL)..$(offsetXL)
                $execute store result storage minecraft:custom universal.vfx.offsetXRfinal int 1 run random value 0..$(offsetXR)
                $execute store result storage minecraft:custom universal.vfx.offsetYLfinal int 1 run random value -$(offsetYL)..$(offsetYL)
                $execute store result storage minecraft:custom universal.vfx.offsetYRfinal int 1 run random value 0..$(offsetYR)
                $execute store result storage minecraft:custom universal.vfx.offsetZLfinal int 1 run random value -$(offsetZL)..$(offsetZL)
                $execute store result storage minecraft:custom universal.vfx.offsetZRfinal int 1 run random value 0..$(offsetZR)
                execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
                execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90

                execute store result storage minecraft:custom universal.vfx.id int 1 run scoreboard players get .global customUniversal.VFXID

                block { with storage minecraft:custom universal.vfx
                    $execute positioned ~$(offsetXLfinal).$(offsetXRfinal) ~$(offsetYLfinal).$(offsetYRfinal) ~$(offsetZLfinal).$(offsetZRfinal) rotated $(rotationX) $(rotationY) run function animated_java:$(branch)_vfx/summon {args:{animation:'$(animation)', start_animation: true}}
                    $execute as @e[type=minecraft:item_display,tag=aj.$(branch)_vfx.root] unless entity @s[tag=customUniversal.VFXSpawned] run block { with storage minecraft:custom universal.vfx
                        $data merge entity @s {teleport_duration:$(duration)}
                        $scoreboard players set @s customUniversal.VFXID $(id)
                        $$(extra)
                        $scoreboard players set @s customUniversal.VFXSpeed $(speed)
                        tag @s add customUniversal.VFXSpawned
                    }
                    # $say $(offsetXL).$(offsetXR), $(offsetYL).$(offsetYR), $(offsetZL).$(offsetZR)
                }
            }
            execute unless score @s customUniversal.VFXCount matches 0 run scoreboard players remove @s customUniversal.VFXCount 1
            execute unless score @s customUniversal.VFXCount matches 0 run function custom:universal/vfx/mode_4
        }

        function speed {
            block { with storage minecraft:custom universal.vfx
                $scoreboard players set @s customUniversal.VFXDuration $(duration)
                $execute store result score @s customUniversal.VFXSpeedXL run random value -$(speedXL)..$(speedXL)
                $execute store result score @s customUniversal.VFXSpeedXR run random value 0..$(speedXR)
                $execute store result score @s customUniversal.VFXSpeedYL run random value -$(speedYL)..$(speedYL)
                $execute store result score @s customUniversal.VFXSpeedYR run random value 0..$(speedYR)
                $execute store result score @s customUniversal.VFXSpeedZL run random value -$(speedZL)..$(speedZL)
                $execute store result score @s customUniversal.VFXSpeedZR run random value 0..$(speedZR)
                tag @s remove customUniversal.VFXSpeed

                block {
                    execute store result storage minecraft:custom universal.vfx.speedXLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedXL
                    execute store result storage minecraft:custom universal.vfx.speedXRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedXR
                    execute store result storage minecraft:custom universal.vfx.speedYLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedYL
                    execute store result storage minecraft:custom universal.vfx.speedYRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedYR
                    execute store result storage minecraft:custom universal.vfx.speedZLfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedZL
                    execute store result storage minecraft:custom universal.vfx.speedZRfinal int 1 run scoreboard players get @s customUniversal.VFXSpeedZR
                    block { with storage minecraft:custom universal.vfx
                        $tp @s ~$(speedXLfinal).$(speedXRfinal) ~$(speedYLfinal).$(speedYRfinal) ~$(speedZLfinal).$(speedZRfinal)
                    }
                }
            }
        }

        function random_rotation {
            execute store result storage minecraft:custom universal.vfx.rotationX int 1 run random value -180..180
            execute store result storage minecraft:custom universal.vfx.rotationY int 1 run random value -90..90
            block { with storage minecraft:custom universal.vfx
                $rotate @s $(rotationX) $(rotationY)
            }
        }

        function random_variant {
            # EX: function custom:universal/vfx/random_variant {particle_set:"toji",variant_pool:"impact",range:5}
            $data merge storage minecraft:custom {universal:{vfx:{variant_pool:"$(variant_pool)",range:$(range),particle_set:"$(particle_set)"}}}
            
            block { with storage minecraft:custom universal.vfx
                $execute store result storage minecraft:custom universal.vfx.random int 1 run random value 1..$(range)
                block { with storage minecraft:custom universal.vfx
                    $function animated_java:$(particle_set)_vfx/variants/$(variant_pool)_$(random)/apply
                }
            }
        }
    }

    dir as {
        function player {
            # function custom:universal/as/player {objective:"customTheWorld.RigID",what:"tag=customAbility.TheWorld",output:"say a"}
            $execute store result storage minecraft:custom universal.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {universal:{what:"$(what)",objective:"$(objective)",output:"$(output)"}}
            block { with storage minecraft:custom universal
                $execute as @p[$(what),scores={$(objective)=$(id)}] at @s run $(output)
            }
        }
    }

    dir hotbar {
        function time {
            $execute store result storage minecraft:custom universal.hotbar.time int 1 run scoreboard players get @s customUniversal.Move$(selected)CooldownConverted
            $data merge storage minecraft:custom {universal:{hotbar:{ability:"$(ability)",move:$(selected)}}}
            block { with storage minecraft:custom universal.hotbar
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 100.. store result storage minecraft:custom $(ability).hotbar.time int 1 run scoreboard players get @s customUniversal.Move$(move)CooldownConverted
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 10..99 run data merge storage minecraft:custom {$(ability):{hotbar:{time:"0$(time)"}}}
                $execute if score @s customUniversal.Move$(move)CooldownConverted matches 0..9 run data merge storage minecraft:custom {$(ability):{hotbar:{time:"00$(time)"}}}
            }
        }
    }

    dir cooldowns {
        function 10x {
            $scoreboard players set .$(ability)Cooldown customUniversal.Move$(move)Cooldown $(cooldown)
            $scoreboard players operation .$(ability)Cooldown customUniversal.Move$(move)Cooldown *= x20 customUniversal.MoveCooldowns
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown /= div11 customUniversal.MoveCooldowns

            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).11 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

            REPEAT (10,1) as i {
                $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
                $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>a int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
                $scoreboard players remove .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown 1
                $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>b int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
            }

            $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).1 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

            $data merge storage minecraft:custom {$(storage):{cooldowns:{move$(path):{selection:$(move)}}}}
        }

        function 8x {
            $scoreboard players set .$(ability)Cooldown customUniversal.Move$(move)Cooldown $(cooldown)
            $scoreboard players operation .$(ability)Cooldown customUniversal.Move$(move)Cooldown *= x20 customUniversal.MoveCooldowns
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown = .$(ability)Cooldown customUniversal.Move$(move)Cooldown
            $scoreboard players operation .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown /= div9 customUniversal.MoveCooldowns

            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).9 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

            REPEAT (8,1) as i {
                $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
                $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>a int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
                $scoreboard players remove .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown 1
                $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).<%i%>b int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown
            }

            $scoreboard players operation .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown -= .$(ability)CooldownDivided customUniversal.Move$(move)Cooldown
            $execute store result storage minecraft:custom $(storage).cooldowns.move$(path).1 int 1 run scoreboard players get .$(ability)CooldownThresholds customUniversal.Move$(move)Cooldown

            $data merge storage minecraft:custom {$(storage):{cooldowns:{move$(path):{selection:$(move)}}}}
        }
    }

    dir control {
        function spectate_camera {
            # ex:
            # function custom:universal/control/spectate_camera {storage:"the_world",objective:"customTheWorld.ImpaleID",spectator:"customTheWorld.ImpaleCutscene",camera:"aj.the_world_cutscenes.camera"}
            $execute store result storage minecraft:custom $(storage).camera.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {$(storage):{camera:{spectator:"$(spectator)",camera:"$(camera)",objective:"$(objective)"}}}
            $block { with storage minecraft:custom $(storage).camera
                $execute as @a[tag=$(spectator),scores={$(objective)=$(id)}] run spectate @n[type=minecraft:item_display,tag=$(camera),scores={$(objective)=$(id)}]
            }
        }

        function movement {
            # ex: function custom:universal/control/spectate_camera {user:customAbility.Toji,rig=aj.toji.root,customUniversal.RigID}
            $execute store result storage minecraft:custom universal.control.id int 1 run scoreboard players get @s $(objective)
            $data merge storage minecraft:custom {universal:{control:{user:"$(user)",objective:"$(objective)",rig:"$(rig)"}}}
            block { with storage minecraft:custom universal.control
                $execute as @a[tag=$(user),scores={$(objective)=$(id)}] at @s run tp @n[type=item_display,tag=$(rig),scores={$(objective)=$(id)}] ~ ~ ~ ~ 0
            }
        }
    }

    dir damage {
        function self {
            execute if entity @s[tag=customUniversal.Cancellable] run {
                execute if entity @s[tag=customAbility.Billy] run {
                    execute store result storage minecraft:custom billy.cancelled.id int 1 run scoreboard players get @s customBilly.RigID
                    execute store result storage minecraft:custom billy.cancelled.number int 1 run scoreboard players get @s customUniversal.LastUsedMove
                    block { with storage minecraft:custom billy.cancelled
                        $execute as @n[type=minecraft:item_display,tag=aj.billy.root,scores={customBilly.RigID=$(id)}] run {
                            function animated_java:billy/animations/idle/play
                            execute as @a[distance=..16] run {
                                # sfx
                                say c
                            }
                        }
                    }

                    execute unless score @s customUniversal.LastMoveState matches 1 run data merge storage minecraft:custom {billy:{cancelled:{state:"BillyCooldown"}}}
                    execute if score @s customUniversal.LastMoveState matches 1 run data merge storage minecraft:custom {billy:{cancelled:{state:"Billy_HomelandCooldown"}}}
                    execute unless entity @s[tag=customSettings.NoCooldowns] run block { with storage minecraft:custom billy.cancelled
                        $scoreboard players operation @s customUniversal.Move$(number)Cooldown = .$(state) customUniversal.Move$(number)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(number)Cooldown *= mult50 customUniversal.CooldownMath
                        $scoreboard players operation @s customUniversal.Move$(number)Cooldown /= div100 customUniversal.CooldownMath
                    }
                    function custom:abilities/billy/moves/reset/player
                }

                execute if entity @s[tag=customAbility.Gojo] run {
                    execute store result storage minecraft:custom gojo.temp.id int 1 run scoreboard players get @s customUniversal.GlobalCounter
                    execute store result storage minecraft:custom gojo.temp.last int 1 run scoreboard players get @s customUniversal.LastUsedMove
                    block { with storage minecraft:custom gojo.temp
                        $execute as @n[type=minecraft:item_display,tag=aj.gojo.root,scores={customUniversal.GlobalCounter=$(id)}] run {
                            function animated_java:gojo/remove/this
                            execute as @a[distance=..16] run {
                                stopsound @s player minecraft:the_world.barrage.shinei
                                stopsound @s player minecraft:the_world.barrage.voiceline
                                stopsound @s player minecraft:the_world.impale.laugh
                                stopsound @s player minecraft:the_world.impale.punch
                                stopsound @s player minecraft:the_world.impale.rustle
                                stopsound @s player minecraft:the_world.impale.shinei
                                stopsound @s player minecraft:the_world.impale.voiceline1
                                stopsound @s player minecraft:the_world.impale.voiceline2
                                stopsound @s player minecraft:the_world.knife_throw.voiceline
                                stopsound @s player minecraft:the_world.timeskip.sfx
                            }
                        }
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run block { with storage minecraft:custom gojo.temp
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown = .GojoCooldown customUniversal.Move$(last)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown *= mult50 customUniversal.CooldownMath
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown /= div100 customUniversal.CooldownMath
                    }
                    function custom:abilities/gojo/moves/reset/player
                }

                execute if entity @s[tag=customAbility.TheWorld] run {
                    execute store result storage minecraft:custom the_world.temp.id int 1 run scoreboard players get @s customTheWorld.RigID
                    execute store result storage minecraft:custom the_world.temp.last int 1 run scoreboard players get @s customUniversal.LastUsedMove
                    block { with storage minecraft:custom the_world.temp
                        $execute as @n[type=minecraft:item_display,tag=aj.the_world.root,scores={customTheWorld.RigID=$(id)}] run {
                            function animated_java:the_world/animations/barrage/stop
                            function animated_java:the_world/animations/impale/stop
                            function animated_java:the_world/animations/knife_throw/stop
                            function animated_java:the_world/animations/hide_dio/play
                            execute as @a[distance=..16] run {
                                stopsound @s player minecraft:the_world.barrage.shinei
                                stopsound @s player minecraft:the_world.barrage.voiceline
                                stopsound @s player minecraft:the_world.impale.laugh
                                stopsound @s player minecraft:the_world.impale.punch
                                stopsound @s player minecraft:the_world.impale.rustle
                                stopsound @s player minecraft:the_world.impale.shinei
                                stopsound @s player minecraft:the_world.impale.voiceline1
                                stopsound @s player minecraft:the_world.impale.voiceline2
                                stopsound @s player minecraft:the_world.knife_throw.voiceline
                                stopsound @s player minecraft:the_world.timeskip.sfx
                            }
                        }
                    }

                    execute unless entity @s[tag=customSettings.NoCooldowns] run block { with storage minecraft:custom the_world.temp
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown = .The_WorldCooldown customUniversal.Move$(last)Cooldown
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown *= mult50 customUniversal.CooldownMath
                        $scoreboard players operation @s customUniversal.Move$(last)Cooldown /= div100 customUniversal.CooldownMath
                    }

                    function custom:abilities/the_world/moves/reset/player
                }
                tag @s remove customUniversal.Cancellable
            }

            execute if entity @s[tag=customAbility.Gojo] run {
                function custom:abilities/gojo/passive/main
            }

            advancement revoke @s only custom:taken_damage
        }

        function entity {
            execute if score @s customUniversal.Toggle matches 1 if entity @s[tag=customAbility.Billy] run function custom:abilities/billy/passives/maul/start

            advancement revoke @s only custom:dealt_damage
        }

        function victim {
            gamerule showDeathMessages false
            scoreboard players operation @s customUniversal_DeathCountPre = @s customUniversal_DeathCount
            $damage @s $(damage) $(type)
            $execute unless score @s customUniversal_DeathCountPre = @s customUniversal_DeathCount run tellraw @a ["",{"selector":"@s"},{"text":" $(first) "},{"selector":"@p[$(attacker),scores={$(objective)=$(id)}]"},{"text":" $(second)"}]
            gamerule showDeathMessages true
        }
    }

    dir setup {
        function rig {
            $scoreboard players add .global $(objective) 1
            $scoreboard players operation @s $(objective) = .global $(objective)
            $execute store result score @n[type=minecraft:item_display,tag=aj.$(item).root] $(objective) run scoreboard players get @s $(objective)
        }
        function pair {
            $execute store result score @n[type=$(type),tag=$(what)] $(objective) run scoreboard players get @s $(objective)
        }
    }

    dir error_messages {
        function universal {
            execute if entity @s[tag=customGojo.RidingBlue] run function custom:universal/error_messages/find {error:100}
            execute if entity @s[tag=customGojo.InfiniteVoided] run function custom:universal/error_messages/find {error:101}
        }
        function find {
            $tag @s add customUniversal.Error$(error)
            scoreboard players set @s customUniversal.FailReturn 1

        }
        function fail {
            $scoreboard players operation @s customUniversal.CooldownMath = @s customUniversal.Move$(number)Cooldown
            scoreboard players operation @s customUniversal.CooldownMath /= div20 customUniversal.CooldownMath
            $tellraw @s ["",{"text":"\n\$(unicode) ","color":"white"},{"text":" $(move)","color":"gold"}]
            execute if entity @s[tag=customUniversal.Error1] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" On cooldown for","color":"gray"},{"text":" ","color":"blue"},{"score":{"name":"@s","objective":"customUniversal.CooldownMath"},"color":"red"},{"text":"s","color":"red"}]
            execute if entity @s[tag=customUniversal.Error2] run tellraw @s ["",{"text":"\uF806\u25cf\uF819","color":"gray"},{"text":" Another move is ","color":"gray"},{"text":"currently casting!","color":"blue"}]
            execute if entity @s[tag=customUniversal.Error3] run tellraw @s ["",{"text":"- This move is ","color":"gray"},{"text":"BANNED ","color":"red"},{"text":"in the ","color":"gray"},{"text":"Pocket Dimension","color":"red"}]
            execute if entity @s[tag=customUniversal.Error4] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"be looking at an entity to use ","color":"gray"},{"text":"this ","color":"aqua"},{"text":"move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error5] run tellraw @s ["",{"text":"- You can't use ","color":"gray"},{"text":"Domain Expansion","color":"dark_purple"},{"text":" - ","color":"gray"},{"text":"Infinite Void","color":"light_purple"},{"text":" whilst nearby someone ","color":"gray"},{"text":"currently using","color":"gold"},{"text":" or ","color":"red"},{"text":"performing ","color":"gold"},{"text":"this move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error6] run tellraw @s ["",{"text":"- You must be on ","color":"gray"},{"text":"solid ground ","color":"green"},{"text":"to cast this ","color":"gray"},{"text":"move!","color":"gold"}]
            execute if entity @s[tag=customUniversal.Error7] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use this attack whilst it's ","color":"gray"},{"text":"currently casting!","color":"aqua"}]
            execute if entity @s[tag=customUniversal.Error8] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CAN'T","color":"red"},{"text":" use this move whilst being targeted by ","color":"gray"},{"text":"Pact!","color":"aqua"}]

            execute if entity @s[tag=customUniversal.Error9] run scoreboard players operation @s customUniversal.CooldownMath = @s customEren.ShiftCooldown
            execute if entity @s[tag=customUniversal.Error9] run scoreboard players operation @s customUniversal.CooldownMath /= #divide customUniversal.CooldownMath
            execute if entity @s[tag=customUniversal.Error9] run tellraw @s ["",{"text":"- You can't attempt to ","color":"gray"},{"text":"shift","color":"gold"},{"text":" into the ","color":"gray"},{"text":"Attack Titan","color":"aqua"},{"text":" for another ","color":"gray"},{"score":{"name":"@s","objective":"customUniversal.CooldownMath"},"color":"red"},{"text":"s!","color":"red"}]

            execute if entity @s[tag=customUniversal.Error10] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"MUST ","color":"red"},{"text":"roll the dice before ","color":"gray"},{"text":"storing ","color":"aqua"},{"text":"a move!","color":"gray"}]
            execute if entity @s[tag=customUniversal.Error11] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"must ","color":"red"},{"text":"be looking at a ","color":"gray"},{"text":"block in range","color":"aqua"},{"text":" in order to use ","color":"gray"},{"text":"Acrobatics","color":"light_purple"}]
            execute if entity @s[tag=customUniversal.Error12] run tellraw @s ["",{"text":"- You've reached the ","color":"gray"},{"text":"maximum ","color":"red"},{"text":"number of ","color":"gray"},{"text":"traps!","color":"aqua"}]
            execute if entity @s[tag=customUniversal.Error13] run tellraw @s ["",{"text":"- Traps must be spaced ","color":"gray"},{"text":"at least 4 meters apart","color":"light_purple"},{"text":" from eachother!","color":"gray"}]

            execute if entity @s[tag=customUniversal.Error100] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CANNOT ","color":"red"},{"text":"use moves when ","color":"gray"},{"text":"picked up","color":"gold"},{"text":" by ","color":"gray"},{"text":"Lapis Blue","color":"aqua"}]
            execute if entity @s[tag=customUniversal.Error101] run tellraw @s ["",{"text":"- You ","color":"gray"},{"text":"CAN'T ","color":"red"},{"text":"use moves when in ","color":"gray"},{"text":"Domain Expansion ","color":"dark_purple"},{"text":"-","color":"gray"},{"text":" Infinite Void!","color":"light_purple"}]
            
            REPEAT (1,101) as i {
                tag @s remove customUniversal.Error<%i%>
            }

            playsound minecraft:entity.villager.no player @s ~ ~ ~ 0.5
            scoreboard players set @s customUniversal.MoveDelay 10
            scoreboard players set @s customUniversal.FailReturn 0
            tellraw @s ""
        }
    }

    dir toggle {
        function main {
            execute if entity @s[tag=customAbility.User] unless entity @s[tag=customUniversal.Animation] unless score @s customUniversal.ToggleDelay matches 1.. run {
                execute unless entity @s[tag=customAbility.Active] run {
                    # Toggle ON #
                    tag @s add customAbility.Active
                    tag @s add temp
                    scoreboard players set @s customUniversal.Toggle 1
                    execute if entity @s[tag=customAbility.Gojo] run {
                        function custom:abilities/gojo/toggle/on
                    }
                    execute if entity @s[tag=customAbility.TheWorld] run {
                        function custom:abilities/the_world/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Dice] run {
                        function custom:abilities/dice/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Billy] run {
                        function custom:abilities/billy/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Toji] run {
                        function custom:abilities/toji/toggle/on
                    }
                    execute if entity @s[tag=customAbility.Yuji] run {
                        function custom:abilities/yuji/toggle/on
                    }
                } else execute unless entity @s[tag=temp] run {
                    # Toggle OFF #
                    tag @s remove customAbility.Active
                    scoreboard players set @s customUniversal.Toggle 2
                    execute if entity @s[tag=customAbility.Gojo] run {
                        function custom:abilities/gojo/toggle/off
                    }
                    execute if entity @s[tag=customAbility.TheWorld] run {
                        function custom:abilities/the_world/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Dice] run {
                        function custom:abilities/dice/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Billy] run {
                        function custom:abilities/billy/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Toji] run {
                        function custom:abilities/toji/toggle/off
                    }
                    execute if entity @s[tag=customAbility.Yuji] run {
                        function custom:abilities/yuji/toggle/off
                    }
                }
                tag @s remove temp
            } 
            scoreboard players reset @s customUniversal.ToggleTrigger
        }
    }

    function fetch_block {
        loot insert 0 -63 0 mine ~ ~ ~ minecraft:stick[tool={can_destroy_blocks_in_creative:true,default_mining_speed:90,damage_per_block:90,rules:[]},enchantments={"minecraft:silk_touch":1}]
        data modify storage minecraft:custom universal.fetch_block.id set string block 0 -63 0 Items[0].id
        item replace block 0 -63 0 container.0 with minecraft:air
    }

    dir stable_player_display {
        function test {
            $function animated_java:$(branch)/remove/all 
            $execute rotated ~ 0 run function animated_java:$(branch)/summon {args:{}}
            $function custom:universal/stable_player_display/mask {branch:$(branch)}
            $execute as @n[tag=aj.$(branch).root] run function animated_java:$(branch)/animations/$(animation)/play
        }

        function set_skin {
            $execute as @n[tag=aj.$(branch).root] run block { {name:"$(name)"}
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.head] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/head",minecraft:custom_model_data={strings:["default"]}]
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.left_arm] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/left_arm",minecraft:custom_model_data={strings:["default"]}]
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.right_arm] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/right_arm",minecraft:custom_model_data={strings:["default"]}]
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.torso] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/torso",minecraft:custom_model_data={strings:["default"]}]
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.left_leg] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/left_leg",minecraft:custom_model_data={strings:["default"]}]
                $execute on passengers run item replace entity @s[tag=aj.$(branch).bone.right_leg] container.0 with player_head[profile={name:$(name)},minecraft:item_model="animated_java:blueprint/player_display/right_leg",minecraft:custom_model_data={strings:["default"]}]
            }
        }

        dir state {
            function model {
                $execute as @n[tag=aj.$(branch).root] run block { {branch:"$(branch)"}
                    $function animated_java:$(branch)/variants/default/apply
                    $execute as @n[tag=aj.$(branch).item_display.helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                    $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"minecraft:empty"}}}
                }
            }

            function skin {
                $execute as @n[tag=aj.$(branch).root] run block { {branch:$(branch)}
                    $function animated_java:$(branch)/variants/player_model/apply
                }
                $function custom:universal/stable_player_display/mask {branch:$(branch)}
            }
        }

        function mask {
            $loot replace entity @n[tag=aj.$(branch).bone.head] hotbar.0 loot minecraft:player/head
            $loot replace entity @n[tag=aj.$(branch).bone.right_arm] hotbar.0 loot minecraft:player/right_arm
            $loot replace entity @n[tag=aj.$(branch).bone.right_forearm] hotbar.0 loot minecraft:player/right_forearm
            $loot replace entity @n[tag=aj.$(branch).bone.left_arm] hotbar.0 loot minecraft:player/left_arm
            $loot replace entity @n[tag=aj.$(branch).bone.left_forearm] hotbar.0 loot minecraft:player/left_forearm
            $loot replace entity @n[tag=aj.$(branch).bone.waist] hotbar.0 loot minecraft:player/waist
            $loot replace entity @n[tag=aj.$(branch).bone.right_leg] hotbar.0 loot minecraft:player/right_leg
            $loot replace entity @n[tag=aj.$(branch).bone.lower_right_leg] hotbar.0 loot minecraft:player/lower_right_leg
            $loot replace entity @n[tag=aj.$(branch).bone.left_leg] hotbar.0 loot minecraft:player/left_leg
            $loot replace entity @n[tag=aj.$(branch).bone.lower_left_leg] hotbar.0 loot minecraft:player/lower_left_leg

            $data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:empty",chestplate_body:"minecraft:empty",chestplate_arms:"minecraft:empty",leggings_pants:"minecraft:empty",leggings_upper:"minecraft:empty",leggings_lower:"minecraft:empty",boots:"minecraft:empty",branch:$(branch)}}}
            execute if items entity @s armor.head #minecraft:head_armor run {
                execute if items entity @s armor.head minecraft:netherite_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/netherite/helmet"}}}
                execute if items entity @s armor.head minecraft:diamond_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/diamond/helmet"}}}
                execute if items entity @s armor.head minecraft:iron_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/iron/helmet"}}}
                execute if items entity @s armor.head minecraft:chainmail_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/chainmail/helmet"}}}
                execute if items entity @s armor.head minecraft:golden_helmet run data merge storage minecraft:custom {universal:{stable_player_display:{helmet:"minecraft:armor/gold/helmet"}}}
            }
            execute if items entity @s armor.chest #minecraft:chest_armor run {
                execute if items entity @s armor.chest minecraft:netherite_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/netherite/chestplate/arms",chestplate_body:"minecraft:armor/netherite/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:diamond_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/diamond/chestplate/arms",chestplate_body:"minecraft:armor/diamond/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:iron_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/iron/chestplate/arms",chestplate_body:"minecraft:armor/iron/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:chainmail_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/chainmail/chestplate/arms",chestplate_body:"minecraft:armor/chainmail/chestplate/body"}}}
                execute if items entity @s armor.chest minecraft:golden_chestplate run data merge storage minecraft:custom {universal:{stable_player_display:{chestplate_arms:"minecraft:armor/gold/chestplate/arms",chestplate_body:"minecraft:armor/gold/chestplate/body"}}}
            }

            execute if items entity @s armor.legs #minecraft:leg_armor run {
                execute if items entity @s armor.legs minecraft:netherite_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/netherite/leggings/pants",leggings_upper:"minecraft:armor/netherite/leggings/upper",leggings_lower:"minecraft:armor/netherite/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:diamond_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/diamond/leggings/pants",leggings_upper:"minecraft:armor/diamond/leggings/upper",leggings_lower:"minecraft:armor/diamond/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:iron_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/iron/leggings/pants",leggings_upper:"minecraft:armor/iron/leggings/upper",leggings_lower:"minecraft:armor/iron/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:chainmail_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/chainmail/leggings/pants",leggings_upper:"minecraft:armor/chainmail/leggings/upper",leggings_lower:"minecraft:armor/chainmail/leggings/lower"}}}
                execute if items entity @s armor.legs minecraft:golden_leggings run data merge storage minecraft:custom {universal:{stable_player_display:{leggings_pants:"minecraft:armor/gold/leggings/pants",leggings_upper:"minecraft:armor/gold/leggings/upper",leggings_lower:"minecraft:armor/gold/leggings/lower"}}}
            }

            execute if items entity @s armor.feet #minecraft:foot_armor run {
                execute if items entity @s armor.feet minecraft:netherite_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/netherite/boots"}}}
                execute if items entity @s armor.feet minecraft:diamond_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/diamond/boots"}}}
                execute if items entity @s armor.feet minecraft:iron_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/iron/boots"}}}
                execute if items entity @s armor.feet minecraft:chainmail_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/chainmail/boots"}}}
                execute if items entity @s armor.feet minecraft:golden_boots run data merge storage minecraft:custom {universal:{stable_player_display:{boots:"minecraft:armor/gold/boots"}}}
            }

            block { with storage minecraft:custom universal.stable_player_display
                $execute as @n[tag=aj.$(branch).item_display.helmet] run data merge entity @s {item:{components:{"minecraft:item_model":"$(helmet)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_body] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_body)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms)"}}}
                $execute as @n[tag=aj.$(branch).item_display.chestplate_arm_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(chestplate_arms)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_pants] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_pants)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_upper_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_lower_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_upper_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_upper)"}}}
                $execute as @n[tag=aj.$(branch).item_display.leggings_lower_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(leggings_lower)"}}}
                $execute as @n[tag=aj.$(branch).item_display.boots_l] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots)"}}}
                $execute as @n[tag=aj.$(branch).item_display.boots_r] run data merge entity @s {item:{components:{"minecraft:item_model":"$(boots)"}}}
            }
        }
    }

    dir armor {
        function hide {
            item modify entity @s armor.head custom:universal/hide_armor/helmet
            item modify entity @s armor.chest custom:universal/hide_armor/chest
            item modify entity @s armor.legs custom:universal/hide_armor/legs
            item modify entity @s armor.feet custom:universal/hide_armor/feet

            effect give @s minecraft:invisibility infinite 1 true
            tag @s add customUniversal.LockArmor
        }

        function reveal {
            execute if items entity @s armor.feet minecraft:leather_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/leather
            execute if items entity @s armor.feet minecraft:chainmail_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/chainmail
            execute if items entity @s armor.feet minecraft:iron_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/iron
            execute if items entity @s armor.feet minecraft:golden_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/golden
            execute if items entity @s armor.feet minecraft:diamond_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/diamond
            execute if items entity @s armor.feet minecraft:netherite_boots run item modify entity @s armor.feet custom:universal/reveal_armor/feet/netherite

            execute if items entity @s armor.chest minecraft:leather_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/leather
            execute if items entity @s armor.chest minecraft:chainmail_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/chainmail
            execute if items entity @s armor.chest minecraft:iron_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/iron
            execute if items entity @s armor.chest minecraft:golden_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/golden
            execute if items entity @s armor.chest minecraft:diamond_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/diamond
            execute if items entity @s armor.chest minecraft:netherite_chestplate run item modify entity @s armor.chest custom:universal/reveal_armor/chest/netherite

            execute if items entity @s armor.legs minecraft:leather_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/leather
            execute if items entity @s armor.legs minecraft:chainmail_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/chainmail
            execute if items entity @s armor.legs minecraft:iron_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/iron
            execute if items entity @s armor.legs minecraft:golden_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/golden
            execute if items entity @s armor.legs minecraft:diamond_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/diamond
            execute if items entity @s armor.legs minecraft:netherite_leggings run item modify entity @s armor.legs custom:universal/reveal_armor/legs/netherite

            execute if items entity @s armor.head minecraft:leather_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/leather
            execute if items entity @s armor.head minecraft:chainmail_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/chainmail
            execute if items entity @s armor.head minecraft:iron_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/iron
            execute if items entity @s armor.head minecraft:golden_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/golden
            execute if items entity @s armor.head minecraft:diamond_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/diamond
            execute if items entity @s armor.head minecraft:netherite_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/netherite
            execute if items entity @s armor.head minecraft:turtle_helmet run item modify entity @s armor.head custom:universal/reveal_armor/head/turtle
        }
    }
}

dir ui {
    dir player {
        function tick {
            execute if items entity @s weapon.* *[minecraft:custom_data={ui:1b}] run function custom:ui/player/teleport
            execute unless items entity @s weapon.* *[minecraft:custom_data={ui:1b}] if score @s ui.id matches 0.. run function custom:ui/player/close
        }

        function close {
            scoreboard players operation #search ui.id = @s ui.id
            execute as @e[type=chest_minecart,tag=ui] if score @s ui.id = #search ui.id run data remove entity @s Items
            execute as @e[tag=ui] if score @s ui.id = #search ui.id run kill @s
            scoreboard players reset @s ui.id
            function custom:ui/minecart/cleanup
        }

        function teleport {
            execute unless score @s ui.id matches 0.. run function custom:ui/player/open

            scoreboard players operation #search ui.id = @s ui.id
            execute at @s as @e[type=item_display,tag=ui] if score @s ui.id = #search ui.id run tp @s ~ ~1 ~
        }

        function open {
            summon item_display ~ ~ ~ {view_range:0f,width:0f,height:0f,teleport_duration:0,Tags:["ui","new"],Passengers:[{id:"minecraft:chest_minecart",Invulnerable:1b,Tags:["ui","new"],CustomDisplayTile:1b,DisplayState:{Name:"minecraft:air"},Passengers:[{id:"minecraft:marker",Tags:["ui","new"]}]}]}

            scoreboard players add .global ui.id 1
            scoreboard players operation @s ui.id = .global ui.id
            scoreboard players operation @e[tag=new] ui.id = .global ui.id

            scoreboard players set .type ui 1
            execute as @e[type=chest_minecart,tag=new] run function custom:ui/menu/pages/menu/open
            execute as @e[type=chest_minecart,tag=new] run function custom:ui/minecart/load_page

            tag @e remove new
        }

        function return {
            data remove block 0 -64 0 Items
            data modify block 0 -64 0 Items set from storage ui in
            loot give @s mine 0 -64 0 stick[minecraft:custom_data={drop_contents:1b}]
        }
    }

    dir menu {
        dir pages {
            dir menu {
                function mask {
                    $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(ability_item_model)","minecraft:item_name":{"color":"gold","italic":false,"text":"$(ability_name)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"$(ability_description)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_selection_page)"}}}},{Slot:9b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Settings Config"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the way Custom Abilities are used"}," ",[{"color":"blue","italic":false,"text":"Click"},{"color":"gray","italic":false,"text":" for "},{"color":"green","italic":false,"text":"Generic "},{"color":"gray","italic":false,"text":"access."}],[{"color":"blue","italic":false,"text":"Shift-Click "},{"color":"gray","italic":false,"text":"with "},{"color":"gold","italic":false,"text":"OP "},{"color":"gray","italic":false,"text":"for "},{"color":"red","italic":false,"text":"A"},{"color":"gold","italic":false,"text":"d"},{"color":"yellow","italic":false,"text":"m"},{"color":"green","italic":false,"text":"i"},{"color":"blue","italic":false,"text":"n"},{"color":"light_purple","italic":false,"text":"i"},{"color":"dark_purple","italic":false,"text":"s"},{"color":"red","italic":false,"text":"t"},{"color":"gold","italic":false,"text":"r"},{"color":"yellow","italic":false,"text":"a"},{"color":"green","italic":false,"text":"t"},{"color":"blue","italic":false,"text":"o"},{"color":"light_purple","italic":false,"text":"r "},{"color":"gray","italic":false,"text":"access"}]],"minecraft:custom_data":{ui_item:{settings_button:1b,empty:1b}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Help"},"minecraft:lore":[[{"text":"Information on various conditions that","italic":false,"color":"gray"}],[{"text":"are present on abilities","italic":false,"color":"gray"}],[{"text":"o Traits","italic":false,"color":"gray"}],[{"text":"o Tokens","italic":false,"color":"gray"}],[{"text":"o Cancelling","italic":false,"color":"gray"}],[{"text":"o Disconnecting","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"light_purple","italic":false,"text":"Passive(s)"},"minecraft:lore":$(ability_passive),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for $(ability_name)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_moveset_page)"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of $(ability_name)"}],"minecraft:custom_data":{ui_item:{cmd:"$(ability_skin_page)"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"light_purple","italic":false,"text":"Ability Selection"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Overview of all Custom Abilities"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/flip"}}}},{Slot:17b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Sta","italic":false,"color":"red"},{"text":"t","italic":false,"color":"yellow"},{"text":"ist","italic":false,"color":"yellow"},{"text":"i","italic":false,"color":"green"},{"text":"cs","italic":false,"color":"green"}],"minecraft:lore":[[{"text":"Observe various different sets of data","italic":false,"color":"gray"}],[{"text":"ranging from ","italic":false,"color":"gray"},{"text":"general ","italic":false,"color":"green"},{"text":"or specific to the","italic":false,"color":"gray"}],[{"text":"currently equipped ability.","italic":false,"color":"yellow"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{empty:1b}}}}]
                }

                function open {
                    execute if score @s customUI.SelectionPage matches 1.. run scoreboard players set @s customUI.SelectionPage 1
                    execute at @s as @p run function custom:ui/menu/pages/menu/player
                    function custom:ui/menu/pages/menu/mask with storage minecraft:ui custom.menu
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/menu/mask"
                }

                function same {
                    execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/menu/open
                }

                function flip {
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    tag @s remove customUI.StatisticsPage
                    function custom:ui/menu/pages/menu/open
                }

                function player {
                    block {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"No Ability"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"Select one for more features!"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:empty"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/menu/same"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/menu/same"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/menu/same"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_passive:[[{"text":"Select an ability to view Passive(s)","italic":false,"color":"gray"}]]}}}
                    }

                    execute if entity @s[tag=customAbility.TheWorld] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"The World"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"I Reject My Humanity, Jojo!"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/the_world/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/the_world/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/the_world/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/selection/the_world/skins/flip"}}}
                    }

                    execute if entity @s[tag=customAbility.Gojo] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"Satoru Gojo"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"The Honored One"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/gojo/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/gojo/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/gojo/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/selection/gojo/skins/flip"}}}
                    }

                    execute if entity @s[tag=customAbility.Billy] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"Billy"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"The Main Character"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/billy/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/billy/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/billy/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/menu/same"}}}
                        function custom:ui/menu/pages/selection/billy/passive {open:"{custom:{menu:{ability_passive",end:"}}}"}
                    }

                    execute if entity @s[tag=customAbility.Toji] run {
                        data merge storage minecraft:ui {custom:{menu:{ability_name:"Toji Fushiguro"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_description:"Kill all Sorcerers huh..? You're a Sorcerer."}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_item_model:"minecraft:interactables/custom/toji/default_skin"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_selection_page:"function custom:ui/menu/pages/selection/toji/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_moveset_page:"function custom:ui/menu/pages/selection/toji/moveset/flip"}}}
                        data merge storage minecraft:ui {custom:{menu:{ability_skin_page:"function custom:ui/menu/pages/selection/toji/skins/flip"}}}
                        function custom:ui/menu/pages/selection/toji/passive {open:"{custom:{menu:{ability_passive",end:"}}}"}
                    }
                }
            }

            dir statistics {
                function player {
                    data merge storage minecraft:ui {custom:{statistics:{ui_path:"minecraft:ui/custom/statistics"}}}
                    data merge storage minecraft:ui {custom:{statistics:{ability_general:[[{"text":"yo mama","italic":false}],"",[{"text":"a","italic":false}]]}}}

                    execute if entity @s[tag=customAbility.Billy] run {
                        function custom:universal/statistics/fetch/billy
                        block { with storage minecraft:custom billy.statistics
                            data merge storage minecraft:ui {custom:{statistics:{ui_path:"minecraft:ui/custom/billy/statistics"}}}
                            $data merge storage minecraft:ui {custom:{statistics:{ability_general:[[{"text":"Statistics with an unorganized category","italic":false,"color":"gray"}],"",[{"text":"Playtime: ","italic":false,"color":"gray"},{"text":"$(playtime_h)h $(playtime_m)m $(playtime_s)s","italic":false,"color":"aqua"}]]}}}
                            $data merge storage minecraft:ui {custom:{statistics:{ability_passive_or_awakening:[[{"text":"Statistics for Passives or Awakening","italic":false,"color":"gray"}],"",[{"text":"Passive #1: ","italic":false,"color":"gray"},{"text":"Maul","italic":false,"color":"yellow"}],[{"text":"o Activations: ","italic":false,"color":"gray"},{"text":"$(maul_activations)","italic":false,"color":"aqua"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"$(maul_damage)","italic":false,"color":"aqua"}],"",[{"text":"Passive #2: ","italic":false,"color":"gray"},{"text":"Homeland","italic":false,"color":"yellow"}],[{"text":"o Total Duration: ","italic":false,"color":"gray"},{"text":"$(homelandtime_h)h $(homelandtime_m)m $(homelandtime_s)s","italic":false,"color":"aqua"}]]}}}
                            $data merge storage minecraft:ui {custom:{statistics:{moves:[[{"text":"Statistics for all available moves","italic":false,"color":"gray"}],"",[{"text":"Move #1: ","italic":false,"color":"gray"},{"text":"Encourage","italic":false,"color":"yellow"}],[{"text":"o Casted: ","italic":false,"color":"gray"},{"text":"$(encourage_uses)","italic":false,"color":"aqua"}],[{"text":"o Players Buffed: ","italic":false,"color":"gray"},{"text":"$(encourage_buffedcount)","italic":false,"color":"aqua"}],"",[{"text":"Move  #2: ","italic":false,"color":"gray"},{"text":"Phase","italic":false,"color":"yellow"}],[{"text":"o Casted: ","italic":false,"color":"gray"},{"text":"$(phase_uses)","italic":false,"color":"aqua"}],[{"text":"o Distance Travelled: ","italic":false,"color":"gray"},{"text":"$(phase_distance)m","italic":false,"color":"aqua"}],"",[{"text":"Move #3: ","italic":false,"color":"gray"},{"text":"Snare","italic":false,"color":"yellow"}],[{"text":"o Casted: ","italic":false,"color":"gray"},{"text":"$(snare_uses)","italic":false,"color":"aqua"}],[{"text":"o Traps Triggered: ","italic":false,"color":"gray"},{"text":"$(snare_triggered)","italic":false,"color":"aqua"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"$(snare_damage)","italic":false,"color":"aqua"}]]}}}
                        }
                    }
                }

                function mask {
                    $data modify storage ui mask set value [{Slot:0b,id:"minecraft:arrow",components:{"minecraft:item_model":"minecraft:empty","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/open"}}}},{Slot:1b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Combat"},"minecraft:lore":[[{"text":"Statistics for the combat category","italic":false,"color":"gray"}],"",[{"text":"Damage: ","italic":false,"color":"gray"},{"text":"30","italic":false,"color":"aqua"}],[{"text":"Player Kills: ","italic":false,"color":"gray"},{"text":"30","italic":false,"color":"aqua"}],[{"text":"Entity Kills: ","italic":false,"color":"gray"},{"text":"30","italic":false,"color":"aqua"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:6b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the main menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Ability Progress"},"minecraft:lore":[[{"text":"Tracker for all unowned/owned abilities","italic":false,"color":"gray"}],"",[{"text":"Progress: ","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"aqua"},{"text":"/","italic":false,"color":"gray"},{"text":"11","italic":false,"color":"aqua"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin Progress"},"minecraft:lore":[[{"text":"Tracker for all unowned/owned skins","italic":false,"color":"gray"}],"",[{"text":"Billy: ","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"aqua"},{"text":"/","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"aqua"}],[{"text":"Overall: ","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"aqua"},{"text":"/","italic":false,"color":"gray"},{"text":"45 ","italic":false,"color":"aqua"},{"text":"(or)","italic":false,"color":"gray"},{"text":" ","italic":false,"color":"aqua"},{"text":"95%","italic":false,"color":"light_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Secret Interaction Progress"},"minecraft:lore":[[{"text":"Tracker for all discovered Secret Interactions","italic":false,"color":"gray"}],"",[{"text":"Billy: ","italic":false,"color":"gray"},{"text":"1","italic":false,"color":"aqua"},{"text":"/","italic":false,"color":"gray"},{"text":"1","italic":false,"color":"aqua"}],[{"text":"Overall: ","italic":false,"color":"gray"},{"text":"0","italic":false,"color":"aqua"},{"text":"/","italic":false,"color":"gray"},{"text":"1 ","italic":false,"color":"aqua"},{"text":"(or)","italic":false,"color":"gray"},{"text":" ","italic":false,"color":"aqua"},{"text":"0%","italic":false,"color":"light_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"blue","italic":false,"text":"General"},"minecraft:lore":$(ability_general),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"light_purple","italic":false,"text":"Passive(s) or Awakening"},"minecraft:lore":$(ability_passive_or_awakening),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moves"},"minecraft:lore":$(moves),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/statistics/same"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"$(ui_path)","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{empty:1b}}}}]
                }

                function open {
                    execute at @s as @p run function custom:ui/menu/pages/statistics/player
                    function custom:ui/menu/pages/statistics/mask with storage minecraft:ui custom.statistics
                    data modify storage ui current set from storage ui mask
                    execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/statistics/mask"
                }

                function flip {
                    tag @s add customUI.StatisticsPage
                    execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/statistics/open
                }

                function same {
                    execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                    function custom:ui/menu/pages/statistics/open
                }
            }

            dir settings {
                dir administrator {
                    function open {
                        execute at @s as @p run {
                            execute unless score @s customUI.SelectedOdds matches 1.. run scoreboard players set @s customUI.SelectedOdds 1
                            data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"Yes"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"gray"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"gray"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"gray"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_color:"red"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{debug_state:"No"}}}}
                            data merge storage minecraft:ui {custom:{settings:{administrator:{debug_color:"red"}}}}

                            execute if entity @s[tag=customSettings.NoCooldowns] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{cooldown_color:"green"}}}}
                            }

                            execute if entity @s[tag=customSettings.Immunity] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{immunity_color:"green"}}}}
                            }

                            execute if entity @s[tag=customSettings.NormalOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_normal:"red"}}}}
                            execute if entity @s[tag=customSettings.RiggedOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_rigged:"red"}}}}
                            execute if entity @s[tag=customSettings.DisabledOdds] run data merge storage minecraft:ui {custom:{settings:{administrator:{odds_disabled:"red"}}}}

                            execute if entity @s[tag=customSettings.Bypass] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{bypass_color:"green"}}}}
                            }

                            execute if entity @s[tag=customSettings.DebugLog] run {
                                data merge storage minecraft:ui {custom:{settings:{administrator:{debug_state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{settings:{administrator:{debug_color:"green"}}}}
                            }
                        }

                        function custom:ui/menu/pages/settings/administrator/mask with storage minecraft:ui custom.settings.administrator
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/settings/administrator/mask"
                    }

                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Cooldowns"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable cooldowns on moves"}," ",[{"color":"gray","italic":false,"text":"Cooldowns: "},{"color":"$(cooldown_color)","italic":false,"text":"$(cooldown_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/cooldowns"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Toggle Immunity"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Click to enable/disable immunity to all attacks"},{"color":"gray","italic":false,"text":"caused by Custom Abilities"}," ",[{"color":"gray","italic":false,"text":"Immunity: "},{"color":"$(immunity_color)","italic":false,"text":"$(immunity_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/immunity"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Randomization Mode"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Controls the chances of Secret Interactions,"},{"color":"gray","italic":false,"text":"Awakenings, and Dice Rolling"}," ",{"color":"gray","italic":false,"text":"Click to cycle between 3 different modes..."}," ",{"color":"$(odds_normal)","italic":false,"text":"Normal Odds"},{"color":"$(odds_rigged)","italic":false,"text":"Rigged Odds"},{"color":"$(odds_disabled)","italic":false,"text":"Disabled Odds"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/odds"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Bypass Ownership"},"minecraft:lore":[[{"text":"Click to enable/disable bypassing ownership","italic":false,"color":"gray"}],[{"text":"of all custom abilities and skins.","italic":false,"color":"gray"}],"",[{"text":"Bypass Ownership: ","italic":false,"color":"gray"},{"text":"$(bypass_state)","italic":false,"color":"$(bypass_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/bypass"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Debug Log"},"minecraft:lore":[[{"text":"Click to enable/disable the Debug log","italic":false,"color":"gray"}],[{"text":"for abilities","italic":false,"color":"gray"}],"",[{"text":"Debug Log: ","italic":false,"color":"gray"},{"text":"$(debug_state)","italic":false,"color":"$(debug_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/debug"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/administrator_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/administrator/same"}}}}]
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function cooldowns {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.NoCooldowns] run {
                                tag @s add customSettings.NoCooldowns
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.NoCooldowns] unless entity @s[tag=temp] run {
                                tag @s remove customSettings.NoCooldowns
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function immunity {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.Immunity] run {
                                tag @s add customSettings.Immunity
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.Immunity] unless entity @s[tag=temp] run {
                                tag @s remove customSettings.Immunity
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function odds {
                        execute at @s as @p run {
                            scoreboard players add @s customUI.SelectedOdds 1
                            execute if score @s customUI.SelectedOdds matches 4.. run scoreboard players set @s customUI.SelectedOdds 1
                            tag @s remove customSettings.NormalOdds
                            tag @s remove customSettings.RiggedOdds
                            tag @s remove customSettings.DisabledOdds

                            execute if score @s customUI.SelectedOdds matches 1 run {
                                tag @s add customSettings.NormalOdds
                            }
                            execute if score @s customUI.SelectedOdds matches 2 run {
                                tag @s add customSettings.RiggedOdds
                            }
                            execute if score @s customUI.SelectedOdds matches 3 run {
                                tag @s add customSettings.DisabledOdds
                            }

                            playsound minecraft:entity.experience_orb.pickup player @a ~ ~ ~ 0.25
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function bypass {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.Bypass] run {
                                playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                tag @s add customSettings.Bypass
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.Bypass] unless entity @s[tag=temp] run {
                                playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                tag @s remove customSettings.Bypass
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }

                    function debug {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.DebugLog] run {
                                playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                tag @s add customSettings.DebugLog
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.DebugLog] unless entity @s[tag=temp] run {
                                playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                tag @s remove customSettings.DebugLog
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/administrator/open
                    }
                }
                
                dir default {
                    function open {
                        execute at @s as @p run {
                            data merge storage minecraft:ui {custom:{settings:{default:{display_state:"Ability"}}}}
                            data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_state:"On"}}}}
                            data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_color:"green"}}}}

                            execute if entity @s[tag=customSettings.DisplayState] run data merge storage minecraft:ui {custom:{settings:{default:{display_state:"Player"}}}}

                            execute if entity @s[tag=customSettings.DisabledAwakeningMusic] run {
                                data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_state:"Off"}}}}
                                data merge storage minecraft:ui {custom:{settings:{default:{awakeningmusic_color:"red"}}}}
                            }
                        }

                        function custom:ui/menu/pages/settings/default/mask with storage minecraft:ui custom.settings.default
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/settings/default/mask"
                    }

                    function mask {
                        $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Display State"},"minecraft:lore":[[{"text":"Click to toggle the display state of","italic":false,"color":"gray"}],[{"text":"certain abilities between the default","italic":false,"color":"gray"}],[{"text":"model and player skin","italic":false,"color":"gray"}],"",[{"text":"State: ","italic":false,"color":"gray"},{"text":"$(display_state)","italic":false,"color":"light_purple"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/default/display"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Awakening Music"},"minecraft:lore":[[{"text":"Click to disable/enable music playing for","italic":false,"color":"gray"}],[{"text":"the duration of specific abilities.","italic":false,"color":"gray"}],"",[{"text":"Awakening Music: ","italic":false,"color":"gray"},{"text":"$(awakeningmusic_state)","italic":false,"color":"$(awakeningmusic_color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/default/awakening_music"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/default_settings","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/default/same"}}}}]
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/settings/default/open
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/settings/default/open
                    }

                    function display {
                        execute at @s as @p run {
                            playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.5
                            execute unless entity @s[tag=customSettings.DisplayState] run {
                                tag @s add customSettings.DisplayState
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.DisplayState] unless entity @s[tag=temp] run {
                                tag @s remove customSettings.DisplayState
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/default/open
                    }

                    function awakening_music {
                        execute at @s as @p run {
                            execute unless entity @s[tag=customSettings.DisabledAwakeningMusic] run {
                                playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                tag @s add customSettings.DisabledAwakeningMusic
                                tag @s add temp
                            }

                            execute if entity @s[tag=customSettings.DisabledAwakeningMusic] unless entity @s[tag=temp] run {
                                playsound minecraft:entity.experience_orb.pickup player @s ~ ~ ~ 0.5
                                tag @s remove customSettings.DisabledAwakeningMusic
                            }

                            tag @s remove temp
                        }
                        function custom:ui/menu/pages/settings/default/open
                    }
                }
            }

            dir selection {
                dir mask {
                    function 1 {
                        data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Main Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to Main Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/menu/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/default_skin","minecraft:item_name":{"color":"yellow","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/flip"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/yuji/default_skin","minecraft:item_name":{"color":"red","italic":false,"text":"Yuji Itadori"},"minecraft:lore":[{"color":"gray","italic":false,"text":"That is my role in this war."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/toji/default_skin","minecraft:item_name":{"color":"dark_gray","italic":false,"text":"Toji Fushiguro"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Kill all Sorcerers huh?... You're a Sorcerer."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/toji/flip"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I Reject My Humanity, Jojo!"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","italic":false,"text":"Mr. President"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Yare Yare Daze..."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","italic":false,"text":"Shrinkray"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Yare Yare Daze..."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"aqua","italic":false,"text":"DJ"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Yare Yare Daze..."}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/settings/open"}}}},{Slot:17b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Next Page"},"minecraft:lore":[{"color":"gray","italic":false,"text":"(2/3)"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/arrows/next"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/selection1","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/same"}}}}]
                    }

                    function 2 {
