                    dir avatar {
                        function mask {
                            $data modify storage ui mask set value [{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Selection Menu"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/flip"}}}},{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","text":"Secret Interaction(s)"},"minecraft:lore":[[{"text":"Unique secrets that you can find specific to this ability.","italic":false,"color":"gray"}],[{"text":"They can range anywhere from a simple change, to an","italic":false,"color":"gray"}],[{"text":"entirely different move. Hints are provided below.","italic":false,"color":"gray"}],[{"text":" ","color":"dark_purple"}],[{"text":"Interaction (1)","italic":false,"color":"gold"}],[{"text":"Not availiable.","italic":false,"color":"gray"}],[{"text":"Discovered: ","italic":false,"color":"gray"},{"text":"$(secret_interaction1state)","italic":false,"color":"$(secret_interaction1color)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Passive(s)"},"minecraft:lore":$(passive),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Moveset"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Description of all availible moves for The Avatar"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/moveset/flip"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"yellow","italic":false,"text":"Skin(s)"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Modify the appearance of The Avatar"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/skins/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar"},"minecraft:lore":[[{"text":"The past can be a great teacher.","italic":false,"color":"gray"}],"",[{"text":"Ability Cost","italic":false,"color":"gold"}],[{"text":"$(ability_item1count)/4 Gem Cluster(s)","italic":false,"color":"$(ability_item1color)"},{"text":" Rarely dropped from","italic":false,"color":"gray"}],[{"text":"breaking Stone or Deepslate","italic":false,"color":"gray"}],[{"text":"$(ability_item2count)/4 Phantom Feather(s)","italic":false,"color":"$(ability_item2color)"},{"text":" Uncommonly dropped","italic":false,"color":"gray"}],[{"text":"from killing Phantoms","italic":false,"color":"gray"}],[{"text":"$(ability_item3count)/2 Blaze Core(s)","italic":false,"color":"$(ability_item3color)"},{"text":" Rarely dropped from killing","italic":false,"color":"gray"}],[{"text":"blazes","italic":false,"color":"gray"}],[{"text":"$(ability_item4count)/1 Drowned Heart(s)","italic":false,"color":"$(ability_item4color)"},{"text":" ","italic":false,"color":"gray"},{"text":"Rarely dropped ","italic":false,"color":"gray"},{"text":"from","italic":false,"color":"gray"}],[{"text":"killing Drowned","italic":false,"color":"gray"}],[{"text":"Advancements:","italic":false,"color":"$(ability_advancement_color)"},{"text":" With Our Powers Combined!","italic":false,"color":"gray"}],"",[{"text":"Bypass","italic":false,"color":"gold"}],[{"text":"35Shadowgames ","italic":false,"color":"$(ability_usernamecolor)"},{"text":"as your Mojang username","italic":false,"color":"gray"}],"",[{"text":"Unlocked: ","italic":false,"color":"gray"},{"text":"$(ownership_state)","italic":false,"color":"$(ownership_color)"}],[{"text":"Equipped: ","italic":false,"color":"gray"},{"text":"$(equip_state)","italic":false,"color":"$(equip_color)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/abilities/selection/avatar/ability_price",name:"The Avatar",tag:"customAvatar.Ownership",toggle:"customAbility.Avatar",context:"customUniversal.AbilityContext",namespace:"avatar",cmd:"function custom:ui/menu/pages/abilities/selection/avatar/open"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/avatar/equip","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/same"}}}}]
                        }

                        function open {
                            execute at @s as @p run function custom:ui/menu/pages/abilities/selection/avatar/player

                            function custom:ui/menu/pages/abilities/selection/avatar/mask with storage minecraft:ui custom.selection.avatar
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/avatar/mask"
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/avatar/open
                        }

                        function passive {
                            $data merge storage minecraft:ui $(open):[[{"text":"Draft","italic":false,"color":"light_purple"},{"text":" is active whenever air mode is being hovered","italic":false,"color":"gray"}],[{"text":"and falling downwards. The user gains ","italic":false,"color":"gray"},{"text":"Slow Falling","italic":false,"color":"white"}],[{"text":"which can be canceled out by sneaking. Whilst ","italic":false,"color":"gray"},{"text":"sneaking,","italic":false,"color":"yellow"}],[{"text":"gain complete ","italic":false,"color":"gray"},{"text":"immunity ","italic":false,"color":"aqua"},{"text":"to fall damage. ","italic":false,"color":"gray"}],"",[{"text":"Dive ","italic":false,"color":"light_purple"},{"text":"is active whenever water mode is being hovered","italic":false,"color":"gray"}],[{"text":"and submerged in ","italic":false,"color":"gray"},{"text":"water.","italic":false,"color":"blue"},{"text":" The user gains the following","italic":false,"color":"gray"}],[{"text":"changes.","italic":false,"color":"gray"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Dolphins Grace I","italic":false,"color":"dark_aqua"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Conduit Power III","italic":false,"color":"aqua"}],"",[{"text":"Masonry ","italic":false,"color":"light_purple"},{"text":"activates whenever earth mode is being","italic":false,"color":"gray"}],[{"text":"hovered. The user gains the following changes","italic":false,"color":"gray"}],[{"text":"o Efficiency Multiplier: ","italic":false,"color":"gray"},{"text":"1.5x","italic":false,"color":"green"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Haste II","italic":false,"color":"yellow"}],"",[{"text":"Boil ","italic":false,"color":"light_purple"},{"text":"is active whenever fire mode is being hovered.","italic":false,"color":"gray"}],[{"text":"The user gains the following ","italic":false,"color":"gray"},{"text":"changes.","italic":false,"color":"gray"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Fire Resistance I","italic":false,"color":"red"}],[{"text":"o When submerged in","italic":false,"color":"gray"},{"text":" Lava..","italic":false,"color":"gold"},{"text":".","italic":false,"color":"gray"}],[{"text":"   ","italic":false},{"text":"o Damage Multiplier: ","italic":false,"color":"gray"},{"text":"1.25x","italic":false,"color":"green"}]]$(end)
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/abilities/selection/avatar/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1color:"red"}}}}
                                function custom:ui/menu/pages/abilities/selection/avatar/passive {open:"{custom:{selection:{avatar:{passive",end:"}}}}"}
                            }

                            execute if entity @s[tag=customAbility.Avatar] run {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customAvatar.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{ownership_state:"Yes"}}}}
                            }
                            
                            execute if entity @s[tag=customAvatar.SecretInteractionAscend] run {
                                data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1state:"Yes"}}}}
                                data merge storage minecraft:ui {custom:{selection:{avatar:{secret_interaction1color:"green"}}}}
                            }

                            function custom:ui/menu/pages/abilities/selection/avatar/ability_price
                        }

                        function ability_price {
                            data merge storage minecraft:ui {custom:{purchase:{type:"ability",clickID:1}}}

                            
                            # bypass #
                            tag @s add customUI.BypassCheck
                            function custom:ui/menu/pages/abilities/selection/purchase/check/username {product:"ability",storage:"avatar",username:"35ShadowGames"}

                            # gem cluster x4 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,gem_cluster:1b}]",number:1,required:4,product:"ability",storage:"avatar",name:"The Avatar"}

                            # phantom feather x4 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,phantom_feather:1b}]",number:2,required:4,product:"ability",storage:"avatar",name:"The Avatar"}

                            # blaze core x2 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,blaze_core:1b}]",number:3,required:2,product:"ability",storage:"avatar",name:"The Avatar"}

                            # drowned heart x1 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,drowned_heart:1b}]",number:4,required:1,product:"ability",storage:"avatar",name:"The Avatar"}

                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/abilities/selection/purchase/check/advancements {advancement:"minecraft:husbandry/froglights",product:"ability",storage:"avatar",name:"The Avatar"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{avatar:{ability_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                        }

                        dir moveset {
                            function open {
                                function custom:ui/menu/pages/abilities/selection/avatar/moveset/mask
                                data modify storage ui current set from storage ui mask
                                execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/avatar/moveset/mask"
                            }

                            function mask {
