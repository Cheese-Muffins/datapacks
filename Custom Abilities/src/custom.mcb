                                $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(move1_model)","minecraft:item_name":{"color":"aqua","text":"$(move1_name)"},"minecraft:lore":$(move1_lore),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/moveset/1"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/moveset/knife_throw","minecraft:item_name":{"color":"aqua","text":"Knife Throw"},"minecraft:lore":[[{"text":"Throw ","italic":false,"color":"gray"},{"text":"3","italic":false,"color":"gold"},{"text":" knives ahead of where you're looking","italic":false,"color":"gray"}],[{"text":"dealing ","italic":false,"color":"gray"},{"text":"damage ","italic":false,"color":"red"},{"text":"to anyone in their path. Colliding","italic":false,"color":"gray"}],[{"text":"with terrain will cause the knives to stop moving.","italic":false,"color":"gray"}],[{"text":"Rage Mode","italic":false,"color":"light_purple"},{"text":" increases the total number of knives","italic":false,"color":"gray"}],[{"text":"to ","italic":false,"color":"gray"},{"text":"5.","italic":false,"color":"gold"}],[{"text":"o Projectile Speed: ","italic":false,"color":"gray"},{"text":"45m/s","italic":false,"color":"green"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"10","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"17s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"Yes","italic":false,"color":"dark_red"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/moveset/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/moveset/barrage","minecraft:item_name":{"color":"aqua","text":"Barrage"},"minecraft:lore":