                            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(move1_model)","minecraft:item_name":{"color":"aqua","text":"$(move1_name)"},"minecraft:lore":$(move1_lore),"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/moveset/1"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/moveset/knife_throw","minecraft:item_name":{"color":"aqua","text":"Knife Throw"},"minecraft:lore":[[{"text":"Throw ","italic":false,"color":"gray"},{"text":"3","italic":false,"color":"gold"},{"text":" knives ahead of where you're looking","italic":false,"color":"gray"}],[{"text":"dealing ","italic":false,"color":"gray"},{"text":"damage ","italic":false,"color":"red"},{"text":"to anyone in their path. Colliding","italic":false,"color":"gray"}],[{"text":"with terrain will cause the knives to stop moving.","italic":false,"color":"gray"}],[{"text":"Rage Mode","italic":false,"color":"light_purple"},{"text":" increases the total number of knives","italic":false,"color":"gray"}],[{"text":"to ","italic":false,"color":"gray"},{"text":"5.","italic":false,"color":"gold"}],[{"text":"o Projectile Speed: ","italic":false,"color":"gray"},{"text":"45m/s","italic":false,"color":"green"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"10","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"17s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"Yes","italic":false,"color":"dark_red"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/moveset/same"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/moveset/barrage","minecraft:item_name":{"color":"aqua","text":"Barrage"},"minecraft:lore":[[{"text":"Send out a flurry of punches ","italic":false,"color":"gray"},{"text":"immobilizing","italic":false,"color":"white"}],[{"text":"and ","italic":false,"color":"gray"},{"text":"damaging ","italic":false,"color":"red"},{"text":"anything in front of you.","italic":false,"color":"gray"}],[{"text":"The final punch sent out launches victims","italic":false,"color":"gray"}],[{"text":"backwards with ","italic":false,"color":"gray"},{"text":"additional damage.","italic":false,"color":"red"}],[{"text":"o Duration: ","italic":false,"color":"gray"},{"text":"4s","italic":false,"color":"green"}],[{"text":"o Flurry Damage: ","italic":false,"color":"gray"},{"text":"2hp/0.5s","italic":false,"color":"green"}],[{"text":"o Final Punch Damage: ","italic":false,"color":"gray"},{"text":"5","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"23s","italic":false,"color":"gold"}],[{"text":"Cancelable:","italic":false,"color":"gray"},{"text":" No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/moveset/same"}}}},{Slot:13b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/moveset/flurry","minecraft:item_name":{"color":"aqua","text":"Flurry"},"minecraft:lore":[[{"text":"Strike a pose for a ","italic":false,"color":"gray"},{"text":"short ","italic":false,"color":"gold"},{"text":"amount of time, waiting","italic":false,"color":"gray"}],[{"text":"to be damaged by an entity.","italic":false,"color":"gray"}],[{"text":"o Duration: ","italic":false,"color":"gray"},{"text":"1.5s","italic":false,"color":"green"}],"",[{"text":"Damaged by an Entity","italic":false,"color":"light_purple"}],[{"text":"Spawn a dome of knives on the attacking entity,","italic":false,"color":"gray"}],[{"text":"dealing ","italic":false,"color":"gray"},{"text":"massive damage. ","italic":false,"color":"red"},{"text":"Additionally, the victim is","italic":false,"color":"gray"}],[{"text":"given nerfs for ","italic":false,"color":"gray"},{"text":"5s","italic":false,"color":"gold"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"6","italic":false,"color":"green"}],[{"text":"o Movement Speed: ","italic":false,"color":"gray"},{"text":"0.5x","italic":false,"color":"red"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Bleed III","italic":false,"color":"dark_red"}],"",[{"text":"Duration Expired","italic":false,"color":"light_purple"}],[{"text":"Become immobilized for ","italic":false,"color":"gray"},{"text":"1s ","italic":false,"color":"gold"},{"text":"following the end of this","italic":false,"color":"gray"}],[{"text":"move.","italic":false,"color":"gray"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"32s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/moveset/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to The World's Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/flip"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/the_world/moveset","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/moveset/same"}}}}]
                        }

                        function data {
                            execute unless score @s customUI.TheWorldMove1 matches 1.. run scoreboard players set @s customUI.TheWorldMove1 1

                            execute if score @s customUI.TheWorldMove1 matches 1 run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_name:"Time-Skip"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_lore:[[{"text":"Teleport forwards ","italic":false,"color":"gray"},{"text":"11m","italic":false,"color":"gold"},{"text":" in the direction you're","italic":false,"color":"gray"}],[{"text":"facing. This move can be used ","italic":false,"color":"gray"},{"text":"during ","italic":false,"color":"green"},{"text":"the casting","italic":false,"color":"gray"}],[{"text":"of other moves.","italic":false,"color":"gray"}],"",[{"text":"Click to view ","italic":false,"color":"gray"},{"text":"The World","italic":false,"color":"light_purple"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"12s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]]}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_model:"minecraft:interactables/custom/the_world/moveset/timeskip"}}}}
                            }

                            execute if score @s customUI.TheWorldMove1 matches 2 run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_name:"The World"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_lore:[[{"text":"Prepare to unleash your true power, completely","italic":false,"color":"gray"}],[{"text":"halting time in for the surrounding ","italic":false,"color":"gray"},{"text":"40m.","italic":false,"color":"gold"},{"text":" Mobs,","italic":false,"color":"gray"}],[{"text":"Projectiles and ","italic":false,"color":"gray"},{"text":"Custom Abilities","italic":false,"color":"aqua"},{"text":" are all victims to","italic":false,"color":"gray"}],[{"text":"your power.","italic":false,"color":"gray"}],[{"text":"o Duration: ","italic":false,"color":"gray"},{"text":"9s","italic":false,"color":"green"}],"",[{"text":"Click to view ","italic":false,"color":"gray"},{"text":"Time-Skip","italic":false,"color":"light_purple"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"50s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"Yes","italic":false,"color":"dark_red"}]]}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{move1_model:"minecraft:interactables/custom/the_world/moveset/timestop"}}}}
                            }
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/the_world/moveset/open
