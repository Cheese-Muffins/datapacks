                                data merge storage minecraft:ui {custom:{purchase:{tag:"customPresident.DefaultSkinBypass"}}}
                                data merge storage minecraft:ui {custom:{purchase:{toggle:"customPresident.SkinDefault"}}}
                                data merge storage minecraft:ui {custom:{purchase:{context:"customPresident.SkinContext"}}}
                                execute at @s as @p run function custom:ui/menu/pages/abilities/selection/purchase/main with storage minecraft:ui custom.purchase
                                function custom:ui/menu/pages/abilities/selection/president/skins/open

                                execute at @s as @p run {
                                    tag @s remove customUniversal.SkinContext
                                    tag @s remove customPresident.DefaultSkinBypass
                                }
                            }
                        }
                    }
                }
            }

            dir cassettes {
                dir menu {
                    function mask {
                        $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"green","italic":false,"text":"Play Cassette(s)"},"minecraft:lore":[[{"text":"Listen to music from your own","italic":false,"color":"gray"}],["",{"text":"c","italic":false,"color":"red"},{"text":"o","italic":false,"color":"gold"},{"text":"l","italic":false,"color":"yellow"},{"text":"l","italic":false,"color":"green"},{"text":"e","italic":false,"color":"blue"},{"text":"c","italic":false,"color":"light_purple"},{"text":"t","italic":false,"color":"dark_purple"},{"text":"i","italic":false,"color":"red"},{"text":"o","italic":false,"color":"gold"},{"text":"n","italic":false,"color":"yellow"}],"",[{"text":"Behavior Style","italic":false,"color":"gold"}],["",{"text":"Playing from: ","italic":false,"color":"gray"},{"text":"$(play_type)","italic":false,"color":"green"}],["",{"text":"Feedback: ","italic":false,"color":"gray"},{"text":"Search","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/cassettes/menu/play/main"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"red","italic":false,"text":"Stop Cassette(s)"},"minecraft:lore":[[{"text":"Pause all feedback from the","italic":false,"color":"gray"}],[{"text":"cassette ","italic":false,"color":"gold"},{"text":"player ","italic":false,"color":"gold"},{"text":"and ongoing","italic":false,"color":"gray"}],[{"text":"songs","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/cassettes/menu/stop"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Collection"},"minecraft:lore":[[{"text":"The complete list of all ","italic":false,"color":"gray"},{"text":"obtainable ","italic":false,"color":"green"},{"text":"cassettes.","italic":false,"color":"gray"}],[{"text":"View ","italic":false,"color":"gray"},{"text":"obtainments,","italic":false,"color":"dark_aqua"},{"text":" create ","italic":false,"color":"gray"},{"text":"playlists","italic":false,"color":"light_purple"},{"text":", or browse","italic":false,"color":"gray"}],[{"text":"bonus","italic":false,"color":"yellow"},{"text":" songs","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/cassettes/collection/flip"}}}},{Slot:15b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"dark_aqua","italic":false,"text":"Listening Parties"},"minecraft:lore":[[{"text":"Create ","italic":false,"color":"green"},{"text":"or ","italic":false,"color":"gray"},{"text":"join ","italic":false,"color":"green"},{"text":"ongoing parties to showoff","italic":false,"color":"gray"}],[{"text":"your collection to friends","italic":false,"color":"gray"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/flip"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":[{"text":"Sta","italic":false,"color":"red"},{"text":"t","italic":false,"color":"yellow"},{"text":"ist","italic":false,"color":"yellow"},{"text":"i","italic":false,"color":"green"},{"text":"cs","italic":false,"color":"green"}],"minecraft:lore":[[{"text":"Observe various sets of data such as","italic":false,"color":"gray"}],[{"text":"collection progress","italic":false,"color":"gold"},{"text":",","italic":false,"color":"gold"},{"text":" ","italic":false,"color":"gray"},{"text":"playlist information,","italic":false,"color":"light_purple"},{"text":" ","italic":false,"color":"gray"}],[{"text":"or the ","italic":false,"color":"gray"},{"text":"server leaderboard","italic":false,"color":"yellow"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/statistics/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/cassette/menu","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/cassettes/menu/same"}}}}]
                    }

                    function open {
                        execute at @s as @p run function custom:ui/menu/pages/cassettes/menu/player
                        function custom:ui/menu/pages/cassettes/menu/mask with storage minecraft:ui cassette.menu
                        data modify storage ui current set from storage ui mask
                        execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/cassettes/menu/mask"
                    }

                    function player {
                        execute unless score @s customUI.CollectionSort matches 1.. run scoreboard players set @s customUI.CollectionSort 1
                        execute unless score @s customCassette.PlayLast matches 1.. run scoreboard players set @s customCassette.PlayLast 1

                        execute if score @s customUI.CollectionSort matches 1..4 run data merge storage minecraft:ui {cassette:{menu:{play_type:"All"}}}
                        execute if score @s customUI.CollectionSort matches 5 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #1"}}}
                        execute if score @s customUI.CollectionSort matches 6 run data merge storage minecraft:ui {cassette:{menu:{play_type:"Playlist #2"}}}
                    }

                    function same {
                        execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/cassettes/menu/open
                    }

                    function flip {
                        execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                        function custom:ui/menu/pages/cassettes/menu/open
                    }

                    function stop {
                        execute at @s as @p run {
                            stopsound @s record
                            playsound minecraft:entity.experience_orb.pickup record @s ~ ~ ~ 0.5
                        }
                        function custom:ui/menu/pages/cassettes/menu/open
                    }
                    
                    dir play {
                        function main {
                            execute at @s as @p run {
                                scoreboard players reset @s customCassette.PlayIncremental
                                playsound minecraft:entity.experience_orb.pickup record @s ~ ~ ~ 0.5
                                execute if score @s customUI.CollectionSort matches 1..4 run function custom:ui/menu/pages/cassettes/menu/play/all
                                execute if score @s customUI.CollectionSort matches 5 run function custom:ui/menu/pages/cassettes/menu/play/playlist1
                            }
                            function custom:ui/menu/pages/cassettes/menu/open
                        }

                        function all {
                            scoreboard players add @s customCassette.PlayIncremental 1
                            execute unless score @s customCassette.PlayIncremental matches 200.. run {
                                execute store result score @s customCassette.PlayID run random value 1..105
                                execute store result storage minecraft:custom cassette.play.lookup int 1 run scoreboard players get @s customCassette.PlayID
                                execute store result storage minecraft:custom cassette.play.last_played int 1 run scoreboard players get @s customCassette.PlayLast
                                block { with storage minecraft:custom cassette.play
                                    $execute if entity @s[advancements={custom:cassettes/ownership/$(lookup)=true}] unless entity @s[tag=customCassette.Played_$(lookup)] run block { with storage minecraft:custom cassette.play
                                        $data modify storage minecraft:custom cassette.play merge from storage minecraft:custom cassette.index.$(lookup)
                                        function custom:ui/menu/pages/cassettes/menu/play/found with storage minecraft:custom cassette.play
                                    }
                                }
                                execute unless entity @s[tag=temp] run function custom:ui/menu/pages/cassettes/menu/play/all
                                tag @s remove temp
                            } else run {
                                function custom:ui/menu/pages/cassettes/menu/play/reshuffle {style:"all"}
                            }
                        }

                        function playlist1 {
                            scoreboard players add @s customCassette.PlayIncremental 1
                            execute unless score @s customCassette.PlayIncremental matches 200.. run {
                                execute store result score @s customCassette.PlayID run random value 1..105
                                execute store result storage minecraft:custom cassette.play.lookup int 1 run scoreboard players get @s customCassette.PlayID
                                execute store result storage minecraft:custom cassette.play.last_played int 1 run scoreboard players get @s customCassette.PlayLast
                                block { with storage minecraft:custom cassette.play
                                    $execute if entity @s[advancements={custom:cassettes/ownership/$(lookup)=true}] if entity @s[tag=customCassette.Playlist1_$(lookup)] unless entity @s[tag=customCassette.Played_$(lookup)] run block { with storage minecraft:custom cassette.play
                                        $data modify storage minecraft:custom cassette.play merge from storage minecraft:custom cassette.index.$(lookup)
                                        function custom:ui/menu/pages/cassettes/menu/play/found with storage minecraft:custom cassette.play
                                    }
                                }
                                execute unless entity @s[tag=temp] run function custom:ui/menu/pages/cassettes/menu/play/playlist1
                                tag @s remove temp
                            } else run {
                                function custom:ui/menu/pages/cassettes/menu/play/reshuffle {style:"playlist1"}
                            }
                        }

                        function reshuffle {
                            say refresh
                            scoreboard players reset @s customCassette.PlayIncremental
                            REPEAT (1,105) as i {
                                tag @s remove customCassette.Played_<%i%>
                            }
                            $function custom:ui/menu/pages/cassettes/menu/play/$(style)
                        }

                        function found {
                            $stopsound @s record minecraft:cassette.$(last_played)
                            $playsound minecraft:cassette.$(lookup) record @s

                            $tag @s add customCassette.Played_$(lookup)
                            $scoreboard players set @s customCassette.PlayLast $(lookup)
                            tag @s add temp
                        }
                    }
                }

                dir collection {
                    function mask {
                        $data modify storage ui mask set value [{Slot:1b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot1_model)","minecraft:tooltip_display":{hide_tooltip:$(slot1_visibility)},"minecraft:custom_model_data":{floats:[$(slot1_overlay)]},"minecraft:item_name":{"color":"$(slot1_color)","italic":false,"text":"$(slot1_name)"},"minecraft:lore":$(slot1_lore),"minecraft:custom_data":{ui_item:{cassette_item:1b,song_id:$(slot1_id)}}}},{Slot:2b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot2_model)","minecraft:tooltip_display":{hide_tooltip:$(slot2_visibility)},"minecraft:custom_model_data":{floats:[$(slot2_overlay)]},"minecraft:item_name":{"color":"$(slot2_color)","italic":false,"text":"$(slot2_name)"},"minecraft:lore":$(slot2_lore),"minecraft:custom_data":{ui_item:{cassette_item:1b,song_id:$(slot2_id)}}}},{Slot:3b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot3_model)","minecraft:tooltip_display":{hide_tooltip:$(slot3_visibility)},"minecraft:custom_model_data":{floats:[$(slot3_overlay)]},"minecraft:item_name":{"color":"$(slot3_color)","italic":false,"text":"$(slot3_name)"},"minecraft:lore":$(slot3_lore),"minecraft:custom_data":{ui_item:{cassette_item:1b,song_id:$(slot3_id)}}}},{Slot:4b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot4_model)","minecraft:tooltip_display":{hide_tooltip:$(slot4_visibility)},"minecraft:custom_model_data":{floats:[$(slot4_overlay)]},"minecraft:item_name":{"color":"$(slot4_color)","italic":false,"text":"$(slot4_name)"},"minecraft:lore":$(slot4_lore),"minecraft:custom_data":{ui_item:{cassette_item:1b,song_id:$(slot4_id)}}}},{Slot:5b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"$(slot5_model)","minecraft:tooltip_display":{hide_tooltip:$(slot5_visibility)},"minecraft:custom_model_data":{floats:[$(slot5_overlay)]},"minecraft:item_name":{"color":"$(slot5_color)","italic":false,"text":"$(slot5_name)"},"minecraft:lore":$(slo