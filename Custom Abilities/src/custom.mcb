"$(retro_item1count)/1 Mysterious Arrow(s):","italic":false,"color":"$(retro_item1color)"},{"text":" can be discovered in","italic":false,"color":"gray"}],[{"text":"Desert Pyramids","italic":false,"color":"gray"}],[{"text":"$(retro_item2count)/4 Time Fragment(s):","italic":false,"color":"$(retro_item2color)"},{"text":" Rarely dropped from killing","italic":false,"color":"gray"}],[{"text":"Endermen","italic":false,"color":"gray"}],[{"text":" ","italic":false,"color":"gray"}],[{"text":"Unlocked: ","italic":false,"color":"gray"},{"text":"$(retro_ownership_state)","italic":false,"color":"$(retro_ownership_color)"}],[{"text":"Equipped: ","italic":false,"color":"gray"},{"text":"$(retro_equip_state)","italic":false,"color":"$(retro_equip_color)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/retro",name:"Retro The World",namespace:"nil",tag:"customTheWorld.SkinRetro.Ownership",toggle:"customTheWorld.SkinRetro",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/pages/selection/the_world/skins/open"}}}},{Slot:14b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/the_world/shadow_the_world","minecraft:item_name":{"color":"white","italic":false,"text":"Shadow The World"},"minecraft:lore":[[{"text":"What is it that you desire?","italic":false,"color":"gray"}],[{"text":"Rarity: ","italic":false,"color":"gray"},{"text":"Legendary","italic":false,"color":"yellow"}],[{"text":" ","italic":false,"color":"gray"}],[{"text":"Skin Cost","italic":false,"color":"gold"}],[{"text":"$(shadow_item1count)/2 Mysterious Arrow(s):","italic":false,"color":"$(shadow_item1color)"},{"text":" can be discovered in","italic":false,"color":"gray"}],[{"text":"Desert Pyramids","italic":false,"color":"gray"}],[{"text":"$(shadow_item2count)/6 Time Fragment(s):","italic":false,"color":"$(shadow_item2color)"},{"text":" Rarely dropped from killing","italic":false,"color":"gray"}],[{"text":"Endermen","italic":false,"color":"gray"}],[{"text":"Advancement(s): ","italic":false,"color":"$(shadow_advancement_color)"},{"text":"Smithing with Style and Subspace","italic":false,"color":"gray"}],[{"text":"Bubble","italic":false,"color":"gray"}],[{"text":" ","italic":false,"color":"gray"}],[{"text":"Unlocked: ","italic":false,"color":"gray"},{"text":"$(shadow_ownership_state)","italic":false,"color":"$(shadow_ownership_color)"}],[{"text":"Equipped: ","italic":false,"color":"gray"},{"text":"$(shadow_equip_state)","italic":false,"color":"$(shadow_equip_color)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/the_world/skins/shadow",name:"Shadow The World",tag:"customTheWorld.SkinShadow.Ownership",toggle:"customTheWorld.SkinShadow",namespace:"nil",context:"customTheWorld.SkinContext",cmd:"function custom:ui/menu/pages/selection/the_world/skins/open"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The World Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/the_world/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/the_world/skins/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/the_world/skins/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/the_world/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{default_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinTW2] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinTW2.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinVampire] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinVampire.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinRetro] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinRetro.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{retro_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinShadow] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customTheWorld.SkinShadow.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{the_world:{shadow_ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/selection/the_world/skins/tw2
                            function custom:ui/menu/pages/selection/the_world/skins/vampire
                            function custom:ui/menu/pages/selection/the_world/skins/retro
                            function custom:ui/menu/pages/selection/the_world/skins/shadow
                        }

                        function default {
                            execute at @s as @p run {
                                tag @s add customUniversal.SkinContext
                                tag @s add customTheWorld.DefaultSkinBypass
                            }

                            data merge storage minecraft:ui {custom:{purchase:{tag:"customTheWorld.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customTheWorld.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customTheWorld.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/the_world/skins/open

                            execute at @s as @p run {
                                tag @s remove customUniversal.SkinContext
                                tag @s remove customTheWorld.DefaultSkinBypass
                            }
                        }

                        function tw2 {
                            data merge storage minecraft:ui {custom:{purchase:{type:"skin",clickID:1}}}

                            execute at @s as @p run tag @s add customUniversal.SkinContext
                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/selection/purchase/check/advancements {advancement:"minecraft:adventure/totem_of_undying",product:"tw2",storage:"the_world",name:"The World 2"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{the_world:{tw2_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                            execute at @s as @p run tag @s remove customUniversal.SkinContext
                        }

                        function vampire {
                            data merge storage minecraft:ui {custom:{purchase:{type:"skin",clickID:2}}}

                            execute at @s as @p run tag @s add customUniversal.SkinContext

                            function custom:ui/menu/pages/selection/purchase/check/items {item:"minecraft:golden_apple",number:1,required:4,product:"vampire",storage:"the_world",name:"Vampire The World"}

                            tag @s add customUniversal.AdvancementCheck
                            function custom:ui/menu/pages/selection/purchase/check/advancements {advancement:"minecraft:nether/get_wither_skull",product:"vampire",storage:"the_world",name:"Vampire The World"}
                            execute if entity @s[tag=customUniversal.AdvancementCheck] unless entity @s[tag=clickEvent] run data merge storage minecraft:ui {custom:{selection:{the_world:{vampire_advancement_color:"green"}}}}
                            tag @s remove customUniversal.AdvancementCheck
                            execute at @s as @p run tag @s remove customUniversal.SkinContext
                        }

                        function retro {
                            data merge storage minecraft:ui {custom:{purchase:{type:"skin",clickID:3}}}

                            execute at @s as @p run tag @s add customUniversal.SkinContext

                            # mysterious arrow #
                            function custom:ui/menu/pages/selection/purchase/check/items {item:"phantom_membrane[minecraft:custom_data={currency:1b,mysterious_arrow:1b}]",number:1,required:1,product:"retro",storage:"the_world",name:"Retro The World"}

                            # time fragments #
                            function custom:ui/menu/pages/selection/purchase/check/items {item:"phantom_membrane[minecraft:custom_data={currency:1b,time_fragment:1b}]",number:2,required:4,product:"retro",storage:"the_world",name:"Retro The World"}

                            execute at @s as @p run tag @s remove customUniversal.SkinContext
                        }

                        function shadow {
                            data merge storage minecraft:ui {custom:{purchase:{type:"skin",clickID:4}}}

                            execute at @s as @p run tag @s add customUniversal.SkinContext

                            # mysterious arrow #
