ctim is","italic":false,"color":"gray"}],[{"text":"given nerfs for ","italic":false,"color":"gray"},{"text":"5s","italic":false,"color":"gold"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"6","italic":false,"color":"green"}],[{"text":"o Movement Speed: ","italic":false,"color":"gray"},{"text":"0.5x","italic":false,"color":"red"}],[{"text":"o ","italic":false,"color":"gray"},{"text":"Bleed III","italic":false,"color":"dark_red"}],"",[{"text":"Duration Expired","italic":false,"color":"light_purple"}],[{"text":"Become immobilized for ","italic":false,"color":"gray"},{"text":"1s ","italic":false,"color":"gold"},{"text":"following the end of this","italic":false,"color":"gray"}],[{"text":"move.","italic":false,"color":"gray"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"32s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/moveset/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to The World's Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/flip"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/the_world/moveset","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/the_world/moveset/same"}}}}]
                            }

                            function data {
                                execute unless score @s customUI.TheWorldMove1 matches 1.. run scoreboard players set @s customUI.TheWorldMove1 1

                                execute if score @s customUI.TheWorldMove1 matches 1 run {
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_name:"Time-Skip"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_lore:[[{"text":"Teleport forwards ","italic":false,"color":"gray"},{"text":"11m","italic":false,"color":"gold"},{"text":" in the direction you're","italic":false,"color":"gray"}],[{"text":"facing. This move can be used ","italic":false,"color":"gray"},{"text":"during ","italic":false,"color":"green"},{"text":"the casting","italic":false,"color":"gray"}],[{"text":"of other moves.","italic":false,"color":"gray"}],"",[{"text":"Click to view ","italic":false,"color":"gray"},{"text":"The World","italic":false,"color":"light_purple"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"9s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]]}}}}
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_model:"minecraft:interactables/custom/the_world/moveset/timeskip"}}}}
                                }

                                execute if score @s customUI.TheWorldMove1 matches 2 run {
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_name:"The World"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_lore:[[{"text":"Prepare to unleash your true power, completely","italic":false,"color":"gray"}],[{"text":"halting time in for the surrounding ","italic":false,"color":"gray"},{"text":"40m.","italic":false,"color":"gold"},{"text":" Mobs,","italic":false,"color":"gray"}],[{"text":"Projectiles and ","italic":false,"color":"gray"},{"text":"Custom Abilities","italic":false,"color":"aqua"},{"text":" are all victims to","italic":false,"color":"gray"}],[{"text":"your power.","italic":false,"color":"gray"}],[{"text":"o Duration: ","italic":false,"color":"gray"},{"text":"9s","italic":false,"color":"green"}],"",[{"text":"Click to view ","italic":false,"color":"gray"},{"text":"Time-Skip","italic":false,"color":"light_purple"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"50s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"Yes","italic":false,"color":"dark_red"}]]}}}}
                                    data merge storage minecraft:ui {custom:{selection:{the_world:{move1_model:"minecraft:interactables/custom/the_world/moveset/timestop"}}}}
                                }
                            }

                            function same {
                                execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/the_world/moveset/open
                            }

