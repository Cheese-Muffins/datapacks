                        function data {
                            execute unless score @s customUI.Move5Swap matches 1 run {
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_icon:"quickfire"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_mode:"Quickfire"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_lore:[[{"color":"gray","italic":false,"text":"You MUST be outside of "},{"color":"aqua","italic":false,"text":"Domain Expansion: Infinite Void."}]," ",[{"color":"gray","italic":false,"text":"This move is "},{"color":"light_purple","italic":false,"text":"launched in the direction you're looking!"}],{"color":"gray","italic":false,"text":"After the initial windup, launch a combination of "},[{"color":"blue","italic":false,"text":"Lapis Blue "},{"color":"gray","italic":false,"text":"and "},{"color":"red","italic":false,"text":"Reversal Red "},{"color":"gray","italic":false,"text":"that annihilates anything"}],[{"color":"gray","italic":false,"text":"in its path. This is, "},{"color":"dark_purple","italic":false,"text":"Hollow... Purple."}]," ",{"color":"red","italic":false,"text":"27 Magic Damage"},[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]," ",[{"color":"gray","italic":false,"text":"Click to view the "},{"color":"blue","italic":false,"text":"secondary use "},{"color":"gray","italic":false,"text":"for this move!"}]]}}}
                            }
                            execute if score @s customUI.Move5Swap matches 1 run {
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_icon:"cutscene"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_mode:"Cutscene"}}}
                                data merge storage minecraft:ui {custom:{gojo:{hollow_purple_lore:[[{"color":"gray","italic":false,"text":"You MUST be using "},{"color":"aqua","italic":false,"text":"Domain Expansion: Infinite Void."}]," ",[{"color":"gray","italic":false,"text":"This move is "},{"color":"light_purple","italic":false,"text":"triggered by looking "},{"color":"gray","italic":false,"text":"at a "},{"color":"light_purple","italic":false,"text":"victim "},{"color":"gray","italic":false,"text":"that"}],[{"color":"gray","italic":false,"text":"is stunned by "},{"color":"aqua","italic":false,"text":"Infinite Void. "},{"color":"gray","italic":false,"text":"They are then hit by"}],[{"color":"gray","italic":false,"text":"an "},{"color":"gold","italic":false,"text":"unavoidable cutscene "},{"color":"gray","italic":false,"text":"that obliterates"}],[{"color":"gray","italic":false,"text":"anything caught in its wake. This is, "},{"color":"dark_purple","italic":false,"text":"Hollow... Purple."}]," ",{"color":"red","italic":false,"text":"42 Magic Damage"},[{"color":"gray","italic":false,"text":"This attack is "},{"color":"dark_red","italic":false,"text":"CANCELLABLE!"}]," ",[{"color":"gray","italic":false,"text":"Click to view the "},{"color":"blue","italic":false,"text":"primary use "},{"color":"gray","italic":false,"text":"for this move!"}]]}}}
                            }
                        }

                        function hollow_purple {
                            scoreboard players add @s customUI.Move5Swap 1
                            execute at @s as @p run playsound minecraft:entity.enderman.teleport player @s ~ ~ ~ 0.25
                            execute if score @s customUI.Move5Swap matches 2.. run scoreboard players reset @s customUI.Move5Swap
                            function custom:ui/menu/pages/selection/gojo/moveset/open
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/gojo/moveset/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/gojo/moveset/open
                        }
                    }

                    dir skins {
                        function open {
                            execute at @s as @p run function custom:ui/menu/pages/selection/gojo/skins/player

                            function custom:ui/menu/pages/selection/gojo/skins/mask with storage minecraft:ui custom.selection.gojo
                            data modify storage ui current set from storage ui mask
                            execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/selection/gojo/skins/mask"
                        }

                        function mask {
                            $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"Satoru Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The Honored One"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"aqua","italic":false,"text":"Default"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(default_equip_color)","italic":false,"text":"$(default_equip_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/skins/default"}}}},{Slot:11b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/wushu_skin","minecraft:item_name":{"color":"green","italic":false,"text":"Wushu Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Nah, I'd Win."},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"light_purple","italic":false,"text":"Epic"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"color":"$(wushu_item1color)","italic":false,"text":"$(wushu_item1count)/1 Blindfold(s) "},{"color":"gray","italic":false,"text":"can be rarely found in"}],{"color":"gray","italic":false,"text":"Ancient Cities"},{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(wushu_ownership_color)","italic":false,"text":"$(wushu_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(wushu_equip_color)","italic":false,"text":"$(wushu_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/gojo/skins/wushu",name:"Wushu Gojo",tag:"customGojo.SkinWushu.Ownership",toggle:"customGojo.SkinWushu",context:"customGojo.SkinContext",cmd:"function custom:ui/menu/pages/selection/gojo/skins/open"}}}},{Slot:12b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/gojo/beach_skin","minecraft:item_name":{"color":"green","italic":false,"text":"Beach Gojo"},"minecraft:lore":[{"color":"gray","italic":false,"text":"BWAHAHA SEACUCUMBER!"},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"light_purple","italic":false,"text":"Epic"}],{"color":"gray","italic":false,"text":" "},{"color":"gold","italic":false,"text":"Skin Cost"},[{"color":"$(beach_item1color)","italic":false,"text":"$(beach_item1count)/12 Honored Eyes(s) "},{"color":"gray","italic":false,"text":"rare drop from killing Spiders"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Unlocked: "},{"color":"$(beach_ownership_color)","italic":false,"text":"$(beach_ownership_state)"}],[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(beach_equip_color)","italic":false,"text":"$(beach_equip_state)"}]],"minecraft:custom_data":{ui_item:{purchaseable_item:1b,price:"function custom:ui/menu/pages/selection/gojo/skins/beach",name:"Beach Gojo",tag:"customGojo.SkinBeach.Ownership",toggle:"customGojo.SkinBeach",context:"customGojo.SkinContext",cmd:"function custom:ui/menu/pages/selection/gojo/skins/open"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Satoru Gojo Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/gojo/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/selection/gojo/skins/same"}}}}]
                        }

                        function same {
                            execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/gojo/skins/open
                        }

                        function flip {
                            execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                            function custom:ui/menu/pages/selection/gojo/skins/open
                        }

                        function player {
                            block {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_state:"No"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_color:"red"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_state:"No"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinDefault] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{default_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinWushu] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinWushu.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{wushu_ownership_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinBeach] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_equip_state:"Yes"}}}}
                            }

                            execute if entity @s[tag=customGojo.SkinBeach.Ownership] run {
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_color:"green"}}}}
                                data merge storage minecraft:ui {custom:{selection:{gojo:{beach_ownership_state:"Yes"}}}}
                            }

                            function custom:ui/menu/pages/selection/gojo/skins/wushu
                            function custom:ui/menu/pages/selection/gojo/skins/beach
                        }

                        function default {
                            execute at @s as @p run tag @s add customGojo.DefaultSkinBypass
                            data merge storage minecraft:ui {custom:{purchase:{tag:"customGojo.DefaultSkinBypass"}}}
                            data merge storage minecraft:ui {custom:{purchase:{toggle:"customGojo.SkinDefault"}}}
                            data merge storage minecraft:ui {custom:{purchase:{context:"customGojo.SkinContext"}}}
                            execute at @s as @p run function custom:ui/menu/pages/selection/purchase/main with storage minecraft:ui custom.purchase
                            function custom:ui/menu/pages/selection/gojo/skins/open
                            execute at @s as @p run tag @s remove customGojo.DefaultSkinBypass
                        }

                        function wushu {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:5819313}}}
                            function custom:ui/menu/pages/selection/inventory/check {item:"minecraft:arrow",required:1,number:1,product:"wushu",storage:"gojo",name:"Satoru Gojo"}
                        }

                        function beach {
                            data merge storage minecraft:ui {custom:{purchase:{clickID:8310301}}}
                            function custom:ui/menu/pages/selection/inventory/check {item:"minecraft:dirt",required:12,number:1,product:"beach",storage:"gojo",name:"Satoru Gojo"}
                        }
                    }
                }

