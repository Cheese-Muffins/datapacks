                        dir skins {
                            function open {
                                execute at @s as @p run function custom:ui/menu/pages/abilities/selection/president/skins/player

                                function custom:ui/menu/pages/abilities/selection/president/skins/mask with storage minecraft:ui custom.selection.president
                                data modify storage ui current set from storage ui mask
                                execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/president/skins/mask"
                            }

                            function mask {
                                $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/president/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"Mr. President"},"minecraft:lore":[{"color":"gray","italic":false,"text":"I'll fulfill my promise."},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"aqua","italic":false,"text":"Default"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(default_equip_color)","italic":false,"text":"$(default_equip_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/skins/default"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"Mr. President Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/president/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/president/skins/same"}}}}]
                            }

                            function same {
                                execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/president/skins/open
                            }

                            function flip {
                                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/president/skins/open
                            }

                            function player {
                                block {
                                    data merge storage minecraft:ui {custom:{selection:{president:{default_equip_color:"red"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{president:{default_equip_state:"No"}}}}
                                }

                                execute if entity @s[tag=customPresident.SkinDefault] run {
                                    data merge storage minecraft:ui {custom:{selection:{president:{default_equip_color:"green"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{president:{default_equip_state:"Yes"}}}}
                                }
                            }

                            function default {
                                execute at @s as @p run {
                                    tag @s add customUniversal.SkinContext
                                    tag @s add customPresident.DefaultSkinBypass
                                }

                                data merge storage minecraft:ui {custom:{purchase:{tag:"customPresident.DefaultSkinBypass"}}}
                                data merge storage minecraft:ui {custom:{purchase:{toggle:"customPresident.SkinDefault"}}}
                                data merge storage minecraft:ui {custom:{purchase:{context:"customPresident.SkinContext"}}}
                                execute at @s as @p run function custom:ui/menu/pages/abilities/selection/purchase/main with storage minecraft:ui custom.purchase
                                function custom:ui/menu/pages/abilities/selection/president/skins/open

                                execute at @s as @p run {
                                    tag @s remove customUniversal.SkinContext
                                    tag @s remove customPresident.DefaultSkinBypass
                                }
                            }
                        }
