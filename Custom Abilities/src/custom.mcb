                            # mysterious arrow x1 #
                            function custom:ui/menu/pages/abilities/selection/purchase/check/items {item:"minecraft:phantom_membrane[minecraft:custom_data={currency:1b,mysterious_arrow:1b}]",number:2,required:1,product:"ability",storage:"eren",name:"Eren Yeager"}

                            tag @s add customUniversal.AdvancementCheck
