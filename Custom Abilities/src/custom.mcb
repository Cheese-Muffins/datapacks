,"italic":false,"color":"gold"},{"text":" will cause the cube to","italic":false,"color":"gray"}],[{"text":"explode ","italic":false,"color":"red"},{"text":"dealing large ","italic":false,"color":"gray"},{"text":"AOE","italic":false,"color":"red"},{"text":" damage in the area.","italic":false,"color":"gray"}],[{"text":"o AOE Range:","italic":false,"color":"gray"},{"text":" 4m","italic":false,"color":"green"}],[{"text":"o Damage: ","italic":false,"color":"gray"},{"text":"9","italic":false,"color":"green"}],"",[{"text":"Cooldown: ","italic":false,"color":"gray"},{"text":"21s","italic":false,"color":"gold"}],[{"text":"Cancelable: ","italic":false,"color":"gray"},{"text":"No","italic":false,"color":"green"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/moveset/same"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","text":"Back"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to The Avatar's Menu"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/flip"}}}},{Slot:26b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:ui/custom/avatar/moveset","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/moveset/same"}}}}]
                            }

                            function same {
                                execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/avatar/moveset/open
                            }

                            function flip {
                                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/avatar/moveset/open
                            }
                        }

                        dir skins {
                            function open {
                                execute at @s as @p run function custom:ui/menu/pages/abilities/selection/avatar/skins/player

                                function custom:ui/menu/pages/abilities/selection/avatar/skins/mask with storage minecraft:ui custom.selection.avatar
                                data modify storage ui current set from storage ui mask
                                execute on passengers run data modify entity @s data.page.mask set value "function custom:ui/menu/pages/abilities/selection/avatar/skins/mask"
                            }

                            function mask {
                                $data modify storage ui mask set value [{Slot:10b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:interactables/custom/avatar/default_skin","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar"},"minecraft:lore":[{"color":"gray","italic":false,"text":"The past can be a great teacher."},[{"color":"gray","italic":false,"text":"Rarity: "},{"color":"aqua","italic":false,"text":"Default"}],{"color":"gray","italic":false,"text":" "},[{"color":"gray","italic":false,"text":"Equipped: "},{"color":"$(default_equip_color)","italic":false,"text":"$(default_equip_state)"}]],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/skins/default"}}}},{Slot:16b,id:"minecraft:arrow",count:1,components:{"minecraft:item_model":"minecraft:empty","minecraft:item_name":{"color":"gold","italic":false,"text":"The Avatar Overview"},"minecraft:lore":[{"color":"gray","italic":false,"text":"Return to the previous page"}],"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/flip"}}}},{Slot:26b,id:"minecraft:arrow","components":{"minecraft:item_model":"minecraft:ui/custom/avatar/skins","minecraft:tooltip_display":{hide_tooltip:true},"minecraft:custom_data":{ui_item:{cmd:"function custom:ui/menu/pages/abilities/selection/avatar/skins/same"}}}}]
                            }

                            function same {
                                execute at @s as @p run playsound minecraft:block.glass.break player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/avatar/skins/open
                            }

                            function flip {
                                execute at @s as @p run playsound minecraft:entity.villager.work_librarian player @s ~ ~ ~ 0.5
                                function custom:ui/menu/pages/abilities/selection/avatar/skins/open
                            }

                            function player {
                                block {
                                    data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_color:"red"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_state:"No"}}}}
                                }

                                execute if entity @s[tag=customAvatar.SkinDefault] run {
                                    data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_color:"green"}}}}
                                    data merge storage minecraft:ui {custom:{selection:{avatar:{default_equip_state:"Yes"}}}}
                                }
                            }

                            function default {
                                execute at @s as @p run {
                                    tag @s add customUniversal.SkinContext
                                    tag @s add customAvatar.DefaultSkinBypass
                                }

                                data merge storage minecraft:ui {custom:{purchase:{tag:"customAvatar.DefaultSkinBypass"}}}
                                data merge storage minecraft:ui {custom:{purchase:{toggle:"customAvatar.SkinDefault"}}}
                                data merge storage minecraft:ui {custom:{purchase:{context:"customAvatar.SkinContext"}}}
                                execute at @s as @p run function custom:ui/menu/pages/abilities/selection/purchase/main with storage minecraft:ui custom.purchase
                                function custom:ui/menu/pages/abilities/selection/avatar/skins/open

                                execute at @s as @p run {
                                    tag @s remove customUniversal.SkinContext
                                    tag @s remove customAvatar.DefaultSkinBypass
                                }
                            }
                        }
                    }

                    dir eren {
